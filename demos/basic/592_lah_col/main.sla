@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Lah 首列 L(n,1)=n!（L(4,1)=24，L(5,1)=120，L(6,1)=720；594 做阶乘对峙）。
// 意对标 586 lah（全表版互补；此处首列单序列，582 首列体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn lah(n: int, k: int) -> int {
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn main() -> i32 {
    println("{},{},{}", lah(4, 1), lah(5, 1), lah(6, 1));
    return 0;
}

@test "basic 592 lahcol"() {
    if lah(4, 1) != 24 { panic(59201); };
    if lah(5, 1) != 120 { panic(59202); };
    if lah(6, 1) != 720 { panic(59203); };
}
