@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/hashmap.sa"
@import "sa_std/core/option.sa"

// #14: `HashMap.get` / `Option.copied` / `Option.unwrap_or_default` SAB lowering
// (output verified via build-exe: `10,2,0`).
fn main() -> i32 {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 10);
    let ga = m.get("a").copied().unwrap_or_default();
    let gb = m.get("b").copied().unwrap_or_default();
    let gc = m.get("zzz").copied().unwrap_or_default();
    println("{},{},{}", ga, gb, gc);
    return 0;
}

@test "unit map get chain"() {
    let m = HashMap::new();
    if m.get("nope").copied().unwrap_or_default() != 0 {
        panic(14001);
    };
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 10);
    if m.get("a").copied().unwrap_or_default() != 10 {
        panic(14002);
    };
    if m.get("b").copied().unwrap_or_default() != 2 {
        panic(14003);
    };
    if m.get("zzz").copied().unwrap_or_default() != 0 {
        panic(14004);
    };
}
