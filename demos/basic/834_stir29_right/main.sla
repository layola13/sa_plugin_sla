@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类第 10 行右部 S(10,7)=5880，S(10,8)=750，S(10,9)=45（左部 826 互补，全行覆盖）。
// 意对标 826_stir29（左部版互补；835 做三向）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", sst(10, 7), sst(10, 8), sst(10, 9));
    return 0;
}

@test "basic 834 stir29 right"() {
    if sst(10, 7) != 5880 { panic(83401); };
    if sst(10, 8) != 750 { panic(83402); };
    if sst(10, 9) != 45 { panic(83403); };
    if sst(9, 7) != 462 { panic(83404); };
}
