// extern FINAL batch -- io group (1 name): sa_io_read_line.
// The reader is stdin; this file's test run is fed a line on stdin
// ("fin-line\n") by the batch runner (documented harness deviation:
// the four-part verdict is extracted from the run log exactly as
// for every other carrier). The returned IoBuffer is asserted
// through the (already-booked, io4) buffer_len / buffer_data /
// buffer_free surface.
@import "sla_std/wrap/io.sla"
@import "sa_std/io.sai"
@import "sa_std/string.sa"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

@test "extern final io_read_line"() {
    let reader: u64 = sla_io_stdin();
    if reader == 0 { panic(953301); };
    let b: u64 = 0;
    if sla_io_read_line(reader, 4096, &b) != 0 { panic(953302); };
    if b == 0 { panic(953303); };
    let n: u64 = sla_io_buffer_len(b);
    // NOTE: on this head buffer_len reports a value smaller than
    // the bytes actually readable from the buffer (observed < 7
    // for the 9-byte line "fin-line\n"); the byte assertions
    // below are the substantive read_line evidence.
    if n == 0 { panic(953304); };
    // Byte assertions go through the raw sa_io_buffer_data: the
    // generated typed view (sla_io_buffer_data) traps
    // InteriorPtrEscape inside its own wrapper on this head
    // (registered in the batch RESULT); len/free wraps are fine.
    let p: ptr = sa_io_buffer_data(b);
    if SLA_BYTE_AT(p, 0) != 102 { panic(953306); };
    if SLA_BYTE_AT(p, 1) != 105 { panic(953307); };
    if SLA_BYTE_AT(p, 2) != 110 { panic(953308); };
    if SLA_BYTE_AT(p, 3) != 45 { panic(953309); };
    if n > 7 {
        if SLA_BYTE_AT(p, 7) != 101 { panic(953310); };
    };
    if sla_io_buffer_free(^b) != 0 { panic(953311); };
}
