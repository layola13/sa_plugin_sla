@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 交错续高位 ealt(7,3)=2416，ealt(8,2)=4293，ealt(8,3)=15619（交错纵深）。
// 意对标 672_eul_alt（低位交错版互补；805 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pwr(b: int, e: int) -> int {
    let r = 1;
    let i = 0;
    while i < e {
        r = r * b;
        i = i + 1;
    }
    return r;
}

fn ealt(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m + 1 {
        let term = binom_mul(n + 1, k) * pwr(m + 1 - k, n);
        if k % 2 == 0 { s = s + term; } else { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", ealt(7, 3), ealt(8, 2), ealt(8, 3));
    return 0;
}

@test "basic 802 eul alt78"() {
    if ealt(7, 3) != 2416 { panic(80201); };
    if ealt(8, 2) != 4293 { panic(80202); };
    if ealt(8, 3) != 15619 { panic(80203); };
    if ealt(7, 2) != 1191 { panic(80204); };
}
