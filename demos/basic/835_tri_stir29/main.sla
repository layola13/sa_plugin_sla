@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类续三向：建表行和 × Bell 二项递推 × Aitken 三角（n=10：115975 三锁）。
// 意对标 827_stir2_row9（行源互补；776 Bell 体例收束二类续三行族）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn srow(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + sst(n, k);
        k = k + 1;
    }
    return s;
}

fn ccomb(n: int, k: int) -> int {
    if k > n { return 0; };
    if k == 0 { return 1; };
    if k == n { return 1; };
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = 1;
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn bell(n: int) -> int {
    let b: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        b.push(0);
        i = i + 1;
    }
    b[0] = 1;
    let m = 0;
    while m < n {
        let s = 0;
        let k = 0;
        while k <= m {
            s = s + ccomb(m, k) * b[k];
            k = k + 1;
        }
        b[m + 1] = s;
        m = m + 1;
    }
    return b[n];
}

fn aitken(n: int) -> int {
    let w = n + 1;
    let a: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        a.push(0);
        i = i + 1;
    }
    a[0] = 1;
    let m = 1;
    while m <= n {
        a[m * w] = a[(m - 1) * w + m - 1];
        let k = 1;
        while k <= m {
            a[m * w + k] = a[m * w + k - 1] + a[(m - 1) * w + k - 1];
            k = k + 1;
        }
        m = m + 1;
    }
    return a[n * w];
}

fn main() -> i32 {
    println("{},{},{}", srow(10), bell(10), aitken(10));
    return 0;
}

@test "basic 835 tri stir29"() {
    if srow(10) != 115975 { panic(83501); };
    if bell(10) != 115975 { panic(83502); };
    if aitken(10) != 115975 { panic(83503); };
    if bell(9) != 21147 { panic(83504); };
}
