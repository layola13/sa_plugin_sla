@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 递归×迭代×表三向 fib 对峙（120×143×237：10→55=55=55）。
// 双向已见 291，此处加表版收束三向。

fn fib_rec(n: int) -> int {
    if n <= 1 { return n; };
    return fib_rec(n - 1) + fib_rec(n - 2);
}

fn fib_iter(n: int) -> int {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

fn main() -> i32 {
    let fibs: Vec<i32> = Vec::new();
    let a = 0;
    let b = 1;
    let m = 0;
    while m <= 10 {
        fibs.push(a);
        let t = a + b;
        a = b;
        b = t;
        m = m + 1;
    }
    println("{},{},{}", fib_rec(10), fib_iter(10), fibs[10]);
    return 0;
}

@test "basic 308 tri fib"() {
    if fib_rec(10) != fib_iter(10) { panic(30801); };
    let fibs: Vec<i32> = Vec::new();
    let a = 0;
    let b = 1;
    let m = 0;
    while m <= 10 {
        fibs.push(a);
        let t = a + b;
        a = b;
        b = t;
        m = m + 1;
    }
    if fibs[10] != fib_rec(10) { panic(30802); };
    if fibs[10] != 55 { panic(30803); };
}
