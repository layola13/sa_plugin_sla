@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 第 8 列纵深 D(5,8)=13073，D(6,8)=40081，D(7,8)=108545（列视角复算）。
// 意对标 886_delan8（行视角互补；同值列复算）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{},{}", delan(5, 8), delan(6, 8), delan(7, 8));
    return 0;
}

@test "basic 893 delan col8"() {
    if delan(5, 8) != 13073 { panic(89301); };
    if delan(6, 8) != 40081 { panic(89302); };
    if delan(7, 8) != 108545 { panic(89303); };
    if delan(7, 8) != delan(8, 7) { panic(89304); };
}
