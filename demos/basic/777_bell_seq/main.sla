@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 序列前 10 项和 26443（B(8)=4140，B(9)=21147；前缀和循环求和）。
// 意对标 776_bell9（单值版互补；同式序列复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn bseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + bell(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", bell(8), bell(9), bseq(9));
    return 0;
}

@test "basic 777 bell seq"() {
    if bseq(9) != 26443 { panic(77701); };
    if bell(8) != 4140 { panic(77702); };
    if bell(9) != 21147 { panic(77703); };
    if bseq(5) != 76 { panic(77704); };
}
