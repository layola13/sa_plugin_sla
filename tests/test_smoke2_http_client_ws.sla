// ---------------- SSE ----------------

// SSE peer (single packed arg: port | code<<24): streams two events.
fn s2_sse_srv(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new_v2(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    let rp = [0u64; 4];
    if sla_http_server_resp_stream_new_v2(req, 200, &rp[0]) != 0 { panic(code + 3); };
    let sresp = (rp[0] as ptr);
    if sla_http_server_resp_stream_add_header_v2(sresp, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("text/event-stream"), STR_LEN("text/event-stream")) != 0 { panic(code + 4); };
    if sla_http_server_resp_stream_write_v2(sresp, STR_PTR("data: tick-1\n\n"), STR_LEN("data: tick-1\n\n"), 5000) != 0 { panic(code + 5); };
    if sla_http_server_resp_stream_flush_v2(sresp) != 0 { panic(code + 6); };
    sla_time_sleep_ms(100);
    if sla_http_server_resp_stream_write_v2(sresp, STR_PTR("data: tick-2\n\n"), STR_LEN("data: tick-2\n\n"), 5000) != 0 { panic(code + 7); };
    if sla_http_server_resp_stream_end_v2(sresp, 5000) != 0 { panic(code + 8); };
    sla_http_server_resp_stream_free_v2(sresp);
    sla_http_server_req_free_v2(req);
    sla_http_server_free_v2(srv);
}

fn s2_url(port: u64, suffix: ptr, suffix_len: u64, ob: ptr) -> u64 {
    let pre = "http://127.0.0.1:";
    let pp: ptr = STR_PTR(pre);
    let pl: u64 = STR_LEN(pre);
    let n: u64 = 0;
    let i: u64 = 0;
    while i < pl {
        let s: ptr = PTR_BYTE_ADD(pp, i);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
        i = i + 1;
    }
    let digits = [0u8; 8];
    let dp0: ptr = PTR_BYTE_ADD(&digits, 0);
    let v: u64 = port;
    let nd: u64 = 0;
    while v > 0 {
        let d: ptr = PTR_BYTE_ADD(dp0, nd);
        PTR_WRITE_U8(d, (48 + ((v % 10) as u8)));
        nd = nd + 1;
        v = v / 10;
    }
    let k: u64 = nd;
    while k > 0 {
        k = k - 1;
        let s: ptr = PTR_BYTE_ADD(dp0, k);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
    }
    let j: u64 = 0;
    while j < suffix_len {
        let s: ptr = PTR_BYTE_ADD(suffix, j);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
        j = j + 1;
    }
    return n;
}

@test "smoke2 sa_http_client_sse_post"() {
    let h = go s2_sse_srv(24810 + 66000 * 16777216);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24810, STR_PTR("/sse"), STR_LEN("/sse"), ubp);
    sla_time_sleep_ms(100);
    let hh = [0u64; 4];
    if sla_http_client_sse_post(ubp, ulen, STR_PTR("{}"), STR_LEN("{}"), STR_PTR(""), 0, &hh[0]) != 0 { panic(66010); };
    if hh[0] == 0 { panic(66011); };
    let handle = (hh[0] as ptr);
    // Drain so the peer can finish, then free.
    let done = [0u64; 4];
    let spins: u64 = 0;
    while spins < 300 {
        if sla_http_client_sse_poll(handle, &done[0]) != 0 { panic(66012); };
        if done[0] == 1 { break; };
        if done[0] == 2 { panic(66013); };
        sla_time_sleep_ms(50);
        spins = spins + 1;
    }
    if done[0] != 1 { panic(66014); };
    sla_http_client_sse_free(handle);
    sa_task_join(h);
}

@test "smoke2 sa_http_client_sse_poll"() {
    let h = go s2_sse_srv(24811 + 66020 * 16777216);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24811, STR_PTR("/sse"), STR_LEN("/sse"), ubp);
    sla_time_sleep_ms(100);
    let hh = [0u64; 4];
    if sla_http_client_sse_post(ubp, ulen, STR_PTR("{}"), STR_LEN("{}"), STR_PTR(""), 0, &hh[0]) != 0 { panic(66030); };
    let handle = (hh[0] as ptr);
    let done = [0u64; 4];
    let spins: u64 = 0;
    while spins < 300 {
        if sla_http_client_sse_poll(handle, &done[0]) != 0 { panic(66031); };
        if done[0] == 1 { break; };
        if done[0] == 2 { panic(66032); };
        sla_time_sleep_ms(50);
        spins = spins + 1;
    }
    if done[0] != 1 { panic(66033); };
    sla_http_client_sse_free(handle);
    sa_task_join(h);
}

