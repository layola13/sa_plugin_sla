// E1 extern carrier batch #1 -- tree_sitter query group (8 names):
// sa_ts_query_pattern_count, sa_ts_query_capture_count,
// sa_ts_query_capture_name, sa_ts_query_exec, sa_ts_query_next_match,
// sa_ts_query_match_capture, sa_ts_query_free, sa_ts_query_cursor_free.
// Substantive assertions over the generated thin wraps (sla_ts_*).
// Requires SA_TREE_SITTER_DIR=<sci>/artifacts/tree_sitter; every test
// panics loudly when the core library is unavailable (no silent pass).
@import "sla_std/wrap/tree_sitter.sla"
@import "sa_std/string.sa"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

fn ts_buf_starts(buf: ptr, lit: ptr, lit_len: u64) -> u32 {
    let i: u64 = 0;
    while i < lit_len {
        let a = SLA_BYTE_AT(buf, i);
        let b = SLA_BYTE_AT(lit, i);
        if a != b { return 0; };
        i = i + 1;
    }
    return 1;
}

fn ts_buf_eq(buf: ptr, buf_len: u64, lit: ptr, lit_len: u64) -> u32 {
    if buf_len != lit_len { return 0; };
    return ts_buf_starts(buf, lit, lit_len);
}

@test "extern ts sa_ts_query_pattern_count"() {
    if sla_ts_available() != 1 { panic(93501); };
    let q: u64 = 0;
    let eoff: u64 = 0;
    let ekind: u64 = 0;
    if sla_ts_query_new(STR_PTR("typescript"), STR_LEN("typescript"), STR_PTR("(function_declaration name: (identifier) @fname)"), STR_LEN("(function_declaration name: (identifier) @fname)"), &q, &eoff, &ekind) != 0 { panic(93502); };
    if q == 0 { panic(93503); };
    let count: u64 = 0;
    if sla_ts_query_pattern_count(q, &count) != 0 { panic(93504); };
    if count != 1 { panic(93505); };
    let q2: u64 = 0;
    if sla_ts_query_new(STR_PTR("typescript"), STR_LEN("typescript"), STR_PTR("(identifier) @x (number) @y"), STR_LEN("(identifier) @x (number) @y"), &q2, &eoff, &ekind) != 0 { panic(93506); };
    if sla_ts_query_pattern_count(q2, &count) != 0 { panic(93507); };
    if count != 2 { panic(93508); };
    sla_ts_query_free(^q2);
    sla_ts_query_free(^q);
}

