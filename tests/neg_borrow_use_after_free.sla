// expect: BorrowUseAfterInvalidation
// A view must not be read after its owner is freed: passing the owner
// to the consuming free invalidates every outstanding view.
@import "sa_std/fs.sai"
@import "sa_std/string.sa"

struct FsReadBuffer {
    raw: u64,
}

fn sla_fs_read_buffer_data(buffer: &FsReadBuffer) -> &[u8][buffer] {
    return __slice_view(sa_fs_read_buffer_data(buffer.raw), sa_fs_read_buffer_len(buffer.raw));
}

fn sla_fs_read_buffer_free(^buffer: FsReadBuffer) -> i32 {
    return sa_fs_read_buffer_free(buffer.raw);
}

fn bad() -> u64 {
    let owner = FsReadBuffer { raw: 7 };
    let view = sla_fs_read_buffer_data(&owner);
    let rc = sla_fs_read_buffer_free(^owner);
    return view.len();
}
