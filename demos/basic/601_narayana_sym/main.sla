@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana 对称性 N(n,k)==N(n,n-1-k)（N(5,1)=10 对 N(5,3)=10；N(6,1)=15 对 N(6,4)=15）。
// 意对标 596 narayana（单实现见源；553/574 对称体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{},{}", narayana(5, 1), narayana(5, 3), narayana(6, 1), narayana(6, 4));
    return 0;
}

@test "basic 601 narayana sym"() {
    if narayana(5, 1) != 10 { panic(60101); };
    if narayana(5, 3) != 10 { panic(60102); };
    if narayana(6, 1) != 15 { panic(60103); };
    if narayana(6, 4) != 15 { panic(60104); };
    if narayana(5, 1) != narayana(5, 3) { panic(60105); };
}
