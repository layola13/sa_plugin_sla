@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类次对角 c(n,n-1)=C(n,2)：c(6,5)=15，c(7,6)=21，c(8,7)=28（三角数恒等）。
// 意对标 686_stir17（内格版互补；695 做三向收束）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", cst(6, 5), cst(7, 6), cst(8, 7));
    return 0;
}

@test "basic 693 stir1 edge"() {
    if cst(6, 5) != 15 { panic(69301); };
    if cst(7, 6) != 21 { panic(69302); };
    if cst(8, 7) != 28 { panic(69303); };
    if binom_mul(8, 2) != 28 { panic(69304); };
}
