@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Schroder-Delannoy 桥式 S(n)=D(n,n)-D(n+1,n-1)（n=2：6，n=3：22，n=4：90）。
// 意对标 606_schroder × 611_delannoy_tab（两族桥接；623 做桥对峙）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn sminus(n: int) -> int {
    return delan(n, n) - delan(n + 1, n - 1);
}

fn main() -> i32 {
    println("{},{},{}", sminus(2), sminus(3), sminus(4));
    return 0;
}

@test "basic 622 schro delan bridge"() {
    if sminus(2) != 6 { panic(62201); };
    if sminus(3) != 22 { panic(62202); };
    if sminus(4) != 90 { panic(62203); };
    if sminus(5) != 394 { panic(62204); };
}
