@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 本原根计数（=φ(φ(p))：p=7 → 2，p=11 → 4）。
// 意对标 485 最小根的计数版（485 互补）。

fn powmod(base: int, exp: int, m: int) -> int {
    let r = 1;
    let b = base % m;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b % m; };
        b = b * b % m;
        e = e / 2;
    }
    return r;
}

fn order_mod(a: int, p: int) -> int {
    let k = 1;
    while k < p {
        if powmod(a, k, p) == 1 { return k; };
        k = k + 1;
    }
    return 0;
}

fn primroot_count(p: int) -> int {
    let c = 0;
    let a = 2;
    while a < p {
        if order_mod(a, p) == p - 1 { c = c + 1; };
        a = a + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", primroot_count(7), primroot_count(11), primroot_count(5));
    return 0;
}

@test "basic 502 primroot count"() {
    if primroot_count(7) != 2 { panic(50201); };
    if primroot_count(11) != 4 { panic(50202); };
    if primroot_count(5) != 2 { panic(50203); };
}
