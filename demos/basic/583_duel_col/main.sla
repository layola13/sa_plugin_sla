@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 首列对峙：c(n,1) == fact(n-1)（n=4：6 对 6；n=5：24 对 24；n=6：120 对 120）。
// 意对标 582 col（单实现见源；286 系对峙体例）。

fn stirling1(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{},{},{}", stirling1(4, 1), fact(3), stirling1(5, 1), fact(4), stirling1(6, 1), fact(5));
    return 0;
}

@test "basic 583 duel col"() {
    if stirling1(4, 1) != 6 { panic(58301); };
    if fact(3) != 6 { panic(58302); };
    if stirling1(5, 1) != 24 { panic(58303); };
    if fact(4) != 24 { panic(58304); };
    if stirling1(6, 1) != 120 { panic(58305); };
    if fact(5) != 120 { panic(58306); };
}
