@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 欧拉准则对峙（2^((p-1)/2) mod p vs Legendre(2|p)：7/11/5/3 全合）。
// 意对标 403 费马对峙的二次剩余版（397 互补）。

fn powmod(base: int, exp: int, m: int) -> int {
    let r = 1;
    let b = base % m;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b % m; };
        b = b * b % m;
        e = e / 2;
    }
    return r;
}

fn euler2(p: int) -> int {
    if powmod(2, (p - 1) / 2, p) == 1 { return 1; };
    return 0;
}

fn legendre2(p: int) -> int {
    let r = p % 8;
    if r == 1 { return 1; };
    if r == 7 { return 1; };
    return 0;
}

fn main() -> i32 {
    println("{},{},{},{}", euler2(7), legendre2(7), euler2(11), legendre2(11));
    return 0;
}

@test "basic 405 duel euler"() {
    if euler2(7) != 1 { panic(40501); };
    if legendre2(7) != 1 { panic(40502); };
    if euler2(11) != 0 { panic(40503); };
    if legendre2(11) != 0 { panic(40504); };
    if euler2(7) != legendre2(7) { panic(40505); };
    if euler2(11) != legendre2(11) { panic(40506); };
}
