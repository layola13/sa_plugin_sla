@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 嵌套 Vec 面（58 扁平行主序的嵌套版；意对标 tsgosa 172_sum_2d 的布局思想）：
// 存（1）+ 子表长（2）+ 穿透读求和（3）；定长嵌套读见缺口 #20（拒识区），
// 此处 Vec 嵌套三线全绿。

fn main() -> i32 {
    let outer: Vec<Vec<i32>> = Vec::new();
    let inner: Vec<i32> = Vec::new();
    inner.push(1);
    inner.push(2);
    outer.push(inner);
    println("{},{},{}", len(outer), len(outer[0]), outer[0][0] + outer[0][1]);
    return 0;
}

@test "basic 229 nest vec"() {
    let outer: Vec<Vec<i32>> = Vec::new();
    let inner: Vec<i32> = Vec::new();
    inner.push(1);
    inner.push(2);
    outer.push(inner);
    if len(outer) != 1 { panic(22901); };
    if len(outer[0]) != 2 { panic(22902); };
    if outer[0][0] + outer[0][1] != 3 { panic(22903); };
}
