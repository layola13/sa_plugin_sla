@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 交错续高位 eba(6,3)=23548，eba(7,2)=60657，eba(7,3)=259723（交错纵深）。
// 意对标 682_eulb_alt（低位交错版互补；815 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pwr(b: int, e: int) -> int {
    let r = 1;
    let i = 0;
    while i < e {
        r = r * b;
        i = i + 1;
    }
    return r;
}

fn eba(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        let term = binom_mul(n + 1, k) * pwr(2 * (m - k) + 1, n);
        if k % 2 == 0 { s = s + term; } else { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eba(6, 3), eba(7, 2), eba(7, 3));
    return 0;
}

@test "basic 812 eulb alt67"() {
    if eba(6, 3) != 23548 { panic(81201); };
    if eba(7, 2) != 60657 { panic(81202); };
    if eba(7, 3) != 259723 { panic(81203); };
    if eba(6, 2) != 10543 { panic(81204); };
}
