@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// #12: right-associative chain assignment (`a = b = 5`).
fn main() -> i32 {
    let a = 0;
    let b = 0;
    a = b = 5;
    println("{},{}", a, b);
    return 0;
}

@test "unit chain assign"() {
    let a = 0;
    let b = 0;
    a = b = 5;
    if a + b != 10 {
        panic(12001);
    };
}
