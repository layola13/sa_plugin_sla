@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1233_shift_varcount：变量位移计数（8,2）。
// 与 119/176 的字面量位移互补：此处计数来自局部绑定（顶层 `const`
// 作计数亦可，见 176；局部 `const` 不可用，探针结论见账本）。

fn main() -> i32 {
    let k = 3;
    println("{},{}", 1 << k, 16 >> k);
    return 0;
}

@test "basic 186 shift varcount"() {
    let k = 3;
    if 1 << k != 8 { panic(18601); };
    if 16 >> k != 2 { panic(18602); };
}
