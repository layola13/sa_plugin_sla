@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 小 Schröder 序列前 7 项 1,1,3,11,45,197,903（和 1161；前缀和循环求和）。
// 意对标 766_sschro（单值版互补；同式序列复算）。

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn sseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + ssho(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", ssho(0), ssho(1), sseq(6));
    return 0;
}

@test "basic 767 sschro seq"() {
    if sseq(6) != 1161 { panic(76701); };
    if ssho(0) != 1 { panic(76702); };
    if ssho(1) != 1 { panic(76703); };
    if sseq(4) != 61 { panic(76704); };
}
