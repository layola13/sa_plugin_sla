@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 第 5 行 1,237,1682,1682,237,1（行和 3840=2^5·5!；行和循环求和）。
// 意对标 677_eulb_row（低位行互补；同式高位行复算）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn ebsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eub(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eub(5, 1), eub(5, 2), ebsum(5));
    return 0;
}

@test "basic 683 eulb row5"() {
    if eub(5, 1) != 237 { panic(68301); };
    if eub(5, 2) != 1682 { panic(68302); };
    if ebsum(5) != 3840 { panic(68303); };
    if eub(5, 5) != 1 { panic(68304); };
}
