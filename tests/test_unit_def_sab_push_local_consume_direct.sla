@import "sa_std/vec.sa"

// DEF-SAB-VALUE-ACCOUNTING regression (#28): pushing an owned local Vec
// into a Vec<Vec<..>> moves the handle into the container. The SAB backend
// recorded that consumption only for temporaries, not for local bindings,
// so the caller's exit cleanup freed the element a second time after the
// callee chain (find_arch -> signature_equals) had already freed it.
// Pristine SAB: signal 6, free(): invalid pointer. SA text passes.
fn def_push_consume_signature_equals(left: Vec<i32>, right: Vec<i32>) -> bool {
    if len(left) != len(right) {
        return false;
    };
    let i: i64 = 0;
    let cnt = len(left) as i64;
    while i < cnt {
        if left[i] != right[i] {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn def_push_consume_find(component_ids: Vec<i32>, candidates: Vec<Vec<i32>>) -> i64 {
    let i: i64 = 0;
    let cnt = len(candidates) as i64;
    while i < cnt {
        if def_push_consume_signature_equals(candidates[i], component_ids) {
            return i;
        };
        i = i + 1;
    }
    return -1;
}

fn def_push_consume_run_case() -> i64 {
    let ids: Vec<i32> = Vec::new();
    ids.push(1);
    ids.push(2);
    let cands: Vec<Vec<i32>> = Vec::new();
    let a: Vec<i32> = Vec::new();
    a.push(9);
    cands.push(a);
    return def_push_consume_find(ids, cands);
}

@test "def sab vec push local consumed once"() {
    if def_push_consume_run_case() != -1 {
        panic(53120);
    };
}
