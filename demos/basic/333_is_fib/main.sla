@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// fib 成员判定（8→1，9→0，13→1）。
// 意对标 tsgosa 173_fib_loop 的成员版（237 为表版）：5n²±4 完全平方即 fib 数
//（321 的判定口径之数论应用，与 325 同构）。

fn is_square(n: int) -> int {
    let r = 0;
    while (r + 1) * (r + 1) <= n {
        r = r + 1;
    }
    return if r * r == n { 1 } else { 0 };
}

fn is_fib(n: int) -> int {
    return if is_square(5 * n * n + 4) == 1 || is_square(5 * n * n - 4) == 1 { 1 } else { 0 };
}

fn main() -> i32 {
    println("{},{},{}", is_fib(8), is_fib(9), is_fib(13));
    return 0;
}

@test "basic 333 is fib"() {
    if is_fib(8) != 1 { panic(33301); };
    if is_fib(9) != 0 { panic(33302); };
    if is_fib(13) != 1 { panic(33303); };
}
