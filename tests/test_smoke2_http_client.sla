@test "smoke2 sa_http_client_req_send_async"() {
    let h = go s2_echo1a(24606 + 0 * 65536 + 65120 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24606, STR_PTR("/async"), STR_LEN("/async"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65123); };
    let rq = [0u64; 4];
