@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 表商对峙：表版 vs 商版（n=8：545835 对 545835；n=9：7087261 对 7087261）。
// 意对标 872_fubp9 × 866_fub9（表源与商源合流；743 体例续高位）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn pbin(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fubp(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + pbin(n, k) * fubp(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", fubp(8), fub(8), fubp(9), fub(9));
    return 0;
}

@test "basic 870 duel fubp9"() {
    if fubp(8) != 545835 { panic(87001); };
    if fub(8) != 545835 { panic(87002); };
    if fubp(9) != 7087261 { panic(87003); };
    if fub(9) != 7087261 { panic(87004); };
}
