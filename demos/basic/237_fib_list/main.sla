@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 173_fib_loop 的表版（143 为单值版：前 8 项，末项 13）。
// 双变量滚动（143 口径）+ 逐项入表组合。

fn main() -> i32 {
    let fibs: Vec<i32> = Vec::new();
    let a = 0;
    let b = 1;
    let k = 0;
    while k < 8 {
        fibs.push(a);
        let t = a + b;
        a = b;
        b = t;
        k = k + 1;
    }
    println("{},{}", len(fibs), fibs[7]);
    return 0;
}

@test "basic 237 fib list"() {
    let fibs: Vec<i32> = Vec::new();
    let a = 0;
    let b = 1;
    let k = 0;
    while k < 8 {
        fibs.push(a);
        let t = a + b;
        a = b;
        b = t;
        k = k + 1;
    }
    if len(fibs) != 8 { panic(23701); };
    if fibs[7] != 13 { panic(23702); };
    if fibs[0] + fibs[1] != 1 { panic(23703); };
}
