@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 160_pow2：2 的幂序列（8 个：1..128）。
// SLA 无 `**` 运算符（`2 ** 3` 会被解析为解引用），此处用翻倍循环表达；
// 与 49 的 2^10 标量循环互补，此处落 Vec 并断言 len/首/尾。

fn main() -> i32 {
    let pows: Vec<i32> = Vec::new();
    let p = 1;
    let i = 0;
    while i < 8 {
        pows.push(p);
        p = p * 2;
        i = i + 1;
    }
    println("{},{},{}", len(pows), pows[0], pows[7]);
    return 0;
}

@test "basic 52 pow2 series"() {
    let pows: Vec<i32> = Vec::new();
    let p = 1;
    let i = 0;
    while i < 8 {
        pows.push(p);
        p = p * 2;
        i = i + 1;
    }
    if len(pows) != 8 { panic(5201); };
    if pows[0] != 1 { panic(5202); };
    if pows[7] != 128 { panic(5203); };
}
