@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 扩展 Euclid（Bezout：240x+46y=2，x=-9，y=47）。
// 意对标 347 gcd 链的系数版（347 互补）。

fn egcd_g(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn egcd_x(a: int, b: int) -> int {
    let r0 = a;
    let r1 = b;
    let s0 = 1;
    let s1 = 0;
    while r1 != 0 {
        let q = r0 / r1;
        let r2 = r0 - q * r1;
        let s2 = s0 - q * s1;
        r0 = r1;
        r1 = r2;
        s0 = s1;
        s1 = s2;
    }
    return s0;
}

fn egcd_y(a: int, b: int) -> int {
    let r0 = a;
    let r1 = b;
    let t0 = 0;
    let t1 = 1;
    while r1 != 0 {
        let q = r0 / r1;
        let r2 = r0 - q * r1;
        let t2 = t0 - q * t1;
        r0 = r1;
        r1 = r2;
        t0 = t1;
        t1 = t2;
    }
    return t0;
}

fn main() -> i32 {
    println("{},{}", egcd_g(240, 46), 240 * egcd_x(240, 46) + 46 * egcd_y(240, 46));
    return 0;
}

@test "basic 436 egcd"() {
    if egcd_g(240, 46) != 2 { panic(43601); };
    if 240 * egcd_x(240, 46) + 46 * egcd_y(240, 46) != 2 { panic(43602); };
    if 48 * egcd_x(48, 18) + 18 * egcd_y(48, 18) != 6 { panic(43603); };
}
