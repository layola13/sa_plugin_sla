// expect: BorrowOriginNotABinding
// The argument fed to the annotated origin parameter must be a
// place (a binding), not a freshly produced temporary handle.
@import "sa_std/fs.sai"

struct FsReadBuffer {
    raw: u64,
}

fn sla_fs_read_buffer_data(buffer: &FsReadBuffer) -> &[u8][buffer] {
    return __slice_view(sa_fs_read_buffer_data(buffer.raw), sa_fs_read_buffer_len(buffer.raw));
}

fn bad() -> u64 {
    let view = sla_fs_read_buffer_data(FsReadBuffer { raw: 7 });
    return view.len();
}
