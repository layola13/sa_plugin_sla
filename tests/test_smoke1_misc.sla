    if rc2 != 0 { panic(56211); };
    if rd[0] != 3 { panic(56212); };
    if buf[0] != 104 { panic(56213); };
    if buf[2] != 10 { panic(56214); };
    let code = [0u64; 4];
    sla_std_process_wait(proc[0], &code[0]);
    sla_std_process_close(proc[0]);
