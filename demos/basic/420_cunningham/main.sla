@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Cunningham 链长（一类：p→2p+1 皆素；chain(2)=5，chain(3)=2）。
// 意对标 419 Sophie 的链版（419 互补）。

fn is_prime(n: int) -> int {
    if n < 2 { return 0; };
    if n == 2 { return 1; };
    if n % 2 == 0 { return 0; };
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return 0; };
        d = d + 2;
    }
    return 1;
}

fn chain_len(p: int) -> int {
    let c = 0;
    let m = p;
    while is_prime(m) == 1 {
        c = c + 1;
        m = 2 * m + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", chain_len(2), chain_len(3), chain_len(5));
    return 0;
}

@test "basic 420 cunningham"() {
    if chain_len(2) != 5 { panic(42001); };
    if chain_len(3) != 2 { panic(42002); };
    if chain_len(5) != 4 { panic(42003); };
}
