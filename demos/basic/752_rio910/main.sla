@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 续高位 R(8)=91，R(9)=232，R(10)=603（短递推续高位；644 体例续）。
// 意对标 644_rio8（n=8 版互补；753 做续桥对峙）。

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", rio(8), rio(9), rio(10));
    return 0;
}

@test "basic 752 rio910"() {
    if rio(8) != 91 { panic(75201); };
    if rio(9) != 232 { panic(75202); };
    if rio(10) != 603 { panic(75203); };
    if rio(7) != 36 { panic(75204); };
}
