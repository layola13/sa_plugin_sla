@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 高位对峙：二项递推 vs 加权和（n=8：545835 对 545835；n=9：7087261 对 7087261）。
// 意对标 866_fub9 × 867_fubw9（高位源与对峙体例合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fubw(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + fact(k) * svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", fub(8), fubw(8), fub(9), fubw(9));
    return 0;
}

@test "basic 868 duel fub9"() {
    if fub(8) != 545835 { panic(86801); };
    if fubw(8) != 545835 { panic(86802); };
    if fub(9) != 7087261 { panic(86803); };
    if fubw(9) != 7087261 { panic(86804); };
}
