@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 楔形数双实现对峙（ω+无平方 vs 计重+去重：30 皆判是，60 皆判否）。
// 意对标 394 Catalan 对峙的形态版（416 互补）。

fn omega(n: int) -> int {
    if n < 2 { return 0; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        if m % d == 0 {
            c = c + 1;
            while m % d == 0 { m = m / d; }
        };
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    return c;
}

fn is_squarefree(n: int) -> int {
    if n < 1 { return 0; };
    let d = 2;
    while d * d <= n {
        if n % (d * d) == 0 { return 0; };
        d = d + 1;
    }
    return 1;
}

fn sph_a(n: int) -> int {
    if omega(n) != 3 { return 0; };
    if is_squarefree(n) != 1 { return 0; };
    return 1;
}

fn big_omega(n: int) -> int {
    if n < 2 { return 0; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        while m % d == 0 {
            c = c + 1;
            m = m / d;
        }
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    return c;
}

fn sph_b(n: int) -> int {
    if big_omega(n) != 3 { return 0; };
    if omega(n) != 3 { return 0; };
    return 1;
}

fn main() -> i32 {
    println("{},{},{}", sph_a(30), sph_b(30), sph_a(60));
    return 0;
}

@test "basic 423 duel sphenic"() {
    if sph_a(30) != 1 { panic(42301); };
    if sph_b(30) != 1 { panic(42302); };
    if sph_a(60) != 0 { panic(42303); };
    if sph_b(60) != 0 { panic(42304); };
    if sph_a(30) != sph_b(30) { panic(42305); };
}
