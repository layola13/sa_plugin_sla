@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 三角数成员判定（6→1，7→0，10→1）。
// 意对标 tsgosa 137_tri 的成员版（71/245 为取值版）：8n+1 完全平方即三角数
//（321 的判定口径之数论应用）。

fn is_square(n: int) -> int {
    let r = 0;
    while (r + 1) * (r + 1) <= n {
        r = r + 1;
    }
    return if r * r == n { 1 } else { 0 };
}

fn is_tri(n: int) -> int {
    return is_square(8 * n + 1);
}

fn main() -> i32 {
    println("{},{}", is_tri(6), is_tri(7));
    return 0;
}

@test "basic 325 is tri"() {
    if is_tri(6) != 1 { panic(32501); };
    if is_tri(7) != 0 { panic(32502); };
    if is_tri(10) != 1 { panic(32503); };
    if is_tri(1) != 1 { panic(32504); };
}
