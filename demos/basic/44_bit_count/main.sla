@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 148_bit_count：29 = 11101b，置位 4 个。

fn bit_count(mut_x: i32) -> i32 {
    let x = mut_x;
    let n: i32 = 0;
    while x != 0 {
        n = n + (x & 1);
        x = x >> 1;
    }
    return n;
}

fn main() -> i32 {
    println("{}", bit_count(29));
    return 0;
}

@test "basic 44 bit count"() {
    if bit_count(29) != 4 { panic(4401); };
    if bit_count(0) != 0 { panic(4402); };
    if bit_count(7) != 3 { panic(4403); };
}
