@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 二项式行和 Σ_k C(n,k) = 2^n（n=5→32，n=8→256，n=10→1024；表求和）。
// 意对标 546 pascal（单格版互补；此处行求和，550 做闭式对峙）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn row_sum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", row_sum(5), row_sum(8), row_sum(10));
    return 0;
}

@test "basic 547 rowsum"() {
    if row_sum(5) != 32 { panic(54701); };
    if row_sum(8) != 256 { panic(54702); };
    if row_sum(10) != 1024 { panic(54703); };
}
