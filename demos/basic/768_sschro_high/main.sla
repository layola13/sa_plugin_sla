@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 小 Schröder 高位 s(7)=4279（s(6)=903 对 903；短递推一步 `[39·903-985]/8`）。
// 意对标 766_sschro（低位版互补；770 做高位对峙）。

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", ssho(6), ssho(7));
    return 0;
}

@test "basic 768 sschro high"() {
    if ssho(7) != 4279 { panic(76801); };
    if ssho(6) != 903 { panic(76802); };
    if ssho(5) != 197 { panic(76803); };
}
