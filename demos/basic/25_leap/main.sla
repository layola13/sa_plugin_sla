@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 180_leap：闰年判断（2000=1, 1900=0, 2024=1）。

fn is_leap(y: i32) -> i32 {
    if y % 400 == 0 {
        return 1;
    };
    if y % 100 == 0 {
        return 0;
    };
    if y % 4 == 0 {
        return 1;
    };
    return 0;
}

fn main() -> i32 {
    println("{},{},{}", is_leap(2000), is_leap(1900), is_leap(2024));
    return 0;
}

@test "basic 25 leap year"() {
    if is_leap(2000) != 1 { panic(2501); };
    if is_leap(1900) != 0 { panic(2502); };
    if is_leap(2024) != 1 { panic(2503); };
    if is_leap(2023) != 0 { panic(2504); };
}
