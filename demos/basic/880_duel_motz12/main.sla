@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 续高位四对峙：迭代 vs 直和（n=11：5798 对 5798；n=12：15511 对 15511）。
// 意对标 879_motz12 × 878_duel_motz11（高位源与对峙体例合流）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cmot(n: int) -> int {
    let s = 0;
    let k = 0;
    while 2 * k <= n {
        s = s + binom_mul(n, 2 * k) * binom_mul(2 * k, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", moz(11), cmot(11), moz(12), cmot(12));
    return 0;
}

@test "basic 880 duel motz12"() {
    if moz(11) != 5798 { panic(88001); };
    if cmot(11) != 5798 { panic(88002); };
    if moz(12) != 15511 { panic(88003); };
    if cmot(12) != 15511 { panic(88004); };
}
