@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 序列前 6 项 1,1,2,4,9,21（和 38；前缀和循环求和）。
// 意对标 626_motzkin（单值版互补；同式序列复算）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn mozseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + moz(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", moz(0), moz(1), mozseq(5));
    return 0;
}

@test "basic 627 motz seq"() {
    if mozseq(5) != 38 { panic(62701); };
    if moz(0) != 1 { panic(62702); };
    if moz(1) != 1 { panic(62703); };
    if mozseq(3) != 8 { panic(62704); };
}
