@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 120_lcm：递归 gcd + lcm = (a / g) * b。

fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a;
    } else {
        return gcd(b, a % b);
    };
}

fn lcm(a: int, b: int) -> int {
    let g = gcd(a, b);
    return (a / g) * b;
}

fn main() -> i32 {
    let g = gcd(48, 18);
    println("{},{}", g, (48 / g) * 18);
    return 0;
}

@test "basic 21 gcd lcm"() {
    if gcd(48, 18) != 6 { panic(2101); };
    if lcm(48, 18) != 144 { panic(2102); };
    if lcm(7, 5) != 35 { panic(2103); };
}
