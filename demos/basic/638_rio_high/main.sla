@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 高位 R(6)=15（R(5)=6 对 6；短递推一步 `5·21/7`）。
// 意对标 636_riordan（低位版互补；640 做高位对峙）。

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", rio(5), rio(6));
    return 0;
}

@test "basic 638 rio high"() {
    if rio(6) != 15 { panic(63801); };
    if rio(5) != 6 { panic(63802); };
    if rio(4) != 3 { panic(63803); };
}
