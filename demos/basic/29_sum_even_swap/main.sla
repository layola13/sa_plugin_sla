@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 192_sum_even / 195_swap：偶数求和 + 变量交换。

fn sum_even(limit: i32) -> i32 {
    let t: i32 = 0;
    for i in 1..(limit + 1) {
        if i % 2 == 0 {
            t = t + i;
        };
    }
    return t;
}

fn main() -> i32 {
    println("{}", sum_even(10));
    let a: i32 = 3;
    let b: i32 = 7;
    let t = a;
    a = b;
    b = t;
    println("{},{}", a, b);
    return 0;
}

@test "basic 29 sum even swap"() {
    if sum_even(10) != 30 { panic(2901); };
    let a: i32 = 3;
    let b: i32 = 7;
    let t = a;
    a = b;
    b = t;
    if a != 7 { panic(2902); };
    if b != 3 { panic(2903); };
}
