@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 189_nest_if3 / 175_min3 / 199_for_step2：
// sign(200)=2, sign(5)=1, sign(-3)=-1, sign(0)=0；min3(3,1,2)=1；步长2求和 0+2+..+8=20。

fn sign(x: i32) -> i32 {
    if x > 0 {
        if x > 100 {
            return 2;
        };
        return 1;
    } else if x < 0 {
        return -1;
    };
    return 0;
}

fn min3(a: i32, b: i32, c: i32) -> i32 {
    let m: i32 = a;
    if b < m {
        m = b;
    };
    if c < m {
        m = c;
    };
    return m;
}

fn step_sum(limit: i32, step: i32) -> i32 {
    let t: i32 = 0;
    let i: i32 = 0;
    while i < limit {
        t = t + i;
        i = i + step;
    }
    return t;
}

fn main() -> i32 {
    println("{},{},{},{}", sign(200), sign(5), sign(-3), sign(0));
    println("{}", min3(3, 1, 2));
    println("{}", step_sum(10, 2));
    return 0;
}

@test "basic 50 nested sign min step"() {
    if sign(200) != 2 { panic(5001); };
    if sign(5) != 1 { panic(5002); };
    if sign(-3) != -1 { panic(5003); };
    if sign(0) != 0 { panic(5004); };
    if min3(3, 1, 2) != 1 { panic(5005); };
    if step_sum(10, 2) != 20 { panic(5006); };
}
