@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1228_shift_sign 的 `<<`/`>>` 部（2147483648,-2）。
// 32 位边界亦为 64 位语义：`1 << 31` 得正数 2147483648（TS 得
// -2147483648）；`-8 >> 2` 算术右移得 -2（与 TS 一致）；`>>>` 不可用。

fn main() -> i32 {
    println("{},{}", 1 << 31, -8 >> 2);
    return 0;
}

@test "basic 168 shift 32bit"() {
    if 1 << 31 != 2147483648 { panic(16801); };
    if -8 >> 2 != -2 { panic(16802); };
    if 1 << 30 != 1073741824 { panic(16803); };
}
