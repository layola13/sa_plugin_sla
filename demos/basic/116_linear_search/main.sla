@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 323_unannot_scan：indexOf/includes/lastIndexOf（2,1,3，和 312）。
// SLA 无 `indexOf/includes` 方法，用显式循环 + 索引表达同一语义
//（与 17/21 的查找口径一致）。

fn index_of(a: [i32; 4], v: i32) -> i32 {
    let i = 0;
    while i < 4 {
        if a[i] == v { return i; };
        i = i + 1;
    }
    return -1;
}

fn includes(a: [i32; 4], v: i32) -> bool {
    return index_of(a, v) != -1;
}

fn last_index_of(a: [i32; 4], v: i32) -> i32 {
    let r: i32 = -1;
    let i = 0;
    while i < 4 {
        if a[i] == v { r = i; };
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [i32; 4] = [5, 3, 8, 1];
    let r1 = index_of(a, 8);
    let r2 = 0;
    if includes(a, 3) { r2 = 1; };
    let r3 = last_index_of(a, 1);
    println("{},{},{}", r1, r2, r3);
    return 0;
}

@test "basic 116 linear search"() {
    let a: [i32; 4] = [5, 3, 8, 1];
    if index_of(a, 8) != 2 { panic(11601); };
    if index_of(a, 7) != -1 { panic(11602); };
    if includes(a, 3) != true { panic(11603); };
    if includes(a, 9) != false { panic(11604); };
    if last_index_of(a, 1) != 3 { panic(11605); };
    if index_of(a, 8) + 10 + 300 != 312 { panic(11606); };
}
