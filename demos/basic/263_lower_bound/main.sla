@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 101_bsearch 的下界版（17 为等值版：7→3，11→5，1→0）。
// 半开区间二分（`lo<hi` + `hi=mid` 收敛）。

fn lower_bound(a: [int; 5], target: int) -> int {
    let lo = 0;
    let hi = 5;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if a[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid;
        };
    }
    return lo;
}

fn main() -> i32 {
    let a = [2, 4, 6, 8, 10];
    println("{},{},{}", lower_bound(a, 7), lower_bound(a, 11), lower_bound(a, 1));
    return 0;
}

@test "basic 263 lower bound"() {
    let a = [2, 4, 6, 8, 10];
    if lower_bound(a, 7) != 3 { panic(26301); };
    if lower_bound(a, 11) != 5 { panic(26302); };
    if lower_bound(a, 1) != 0 { panic(26303); };
    if lower_bound(a, 8) != 3 { panic(26304); };
}
