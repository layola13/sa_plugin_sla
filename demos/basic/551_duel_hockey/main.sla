@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// hockey 对峙：直接对角求和 == 查表 C(n+1,k+1)
//（k=2,n=6：35 对 35；k=3,n=7：70 对 70）。
// 意对标 548 hockey（单实现见源；286 系对峙体例）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn hockey(k: int, n: int) -> int {
    let s = 0;
    let i = k;
    while i <= n {
        s = s + binom(i, k);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", hockey(2, 6), binom(7, 3), hockey(3, 7), binom(8, 4));
    return 0;
}

@test "basic 551 duel hockey"() {
    if hockey(2, 6) != 35 { panic(55101); };
    if binom(7, 3) != 35 { panic(55102); };
    if hockey(3, 7) != 70 { panic(55103); };
    if binom(8, 4) != 70 { panic(55104); };
    if hockey(2, 6) != binom(7, 3) { panic(55105); };
    if hockey(3, 7) != binom(8, 4) { panic(55106); };
}
