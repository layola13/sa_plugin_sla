@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 最小本原根（g(7)=3，g(5)=2，g(11)=2）。
// 意对标 397 费马测试的阶版（397/484 互补）。

fn powmod(base: int, exp: int, m: int) -> int {
    let r = 1;
    let b = base % m;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b % m; };
        b = b * b % m;
        e = e / 2;
    }
    return r;
}

fn order_mod(a: int, p: int) -> int {
    let k = 1;
    while k < p {
        if powmod(a, k, p) == 1 { return k; };
        k = k + 1;
    }
    return 0;
}

fn primroot(p: int) -> int {
    let a = 2;
    while a < p {
        if order_mod(a, p) == p - 1 { return a; };
        a = a + 1;
    }
    return 0;
}

fn main() -> i32 {
    println("{},{},{}", primroot(7), primroot(5), primroot(11));
    return 0;
}

@test "basic 485 primroot"() {
    if primroot(7) != 3 { panic(48501); };
    if primroot(5) != 2 { panic(48502); };
    if primroot(11) != 2 { panic(48503); };
}
