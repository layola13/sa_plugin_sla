@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 临时变量 vs 异或交换对峙（127×173：同入 12,34→34,12=34,12）。
// 双实现一致性锁定（单实现见 127/173；同输入是关键，异输入只证自洽）。

fn main() -> i32 {
    let x = 12;
    let y = 34;
    let t1 = x;
    x = y;
    y = t1;
    let p = 12;
    let q = 34;
    p = p ^ q;
    q = p ^ q;
    p = p ^ q;
    println("{},{},{},{}", x, y, p, q);
    return 0;
}

@test "basic 300 duel swap"() {
    let x = 12;
    let y = 34;
    let t1 = x;
    x = y;
    y = t1;
    let p = 12;
    let q = 34;
    p = p ^ q;
    q = p ^ q;
    p = p ^ q;
    if x != p { panic(30001); };
    if y != q { panic(30002); };
    if x != 34 { panic(30003); };
    if y != 12 { panic(30004); };
}
