@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 第一类 Stirling 数（无符号）c(n,k)=c(n-1,k-1)+(n-1)·c(n-1,k)
//（c(4,*)=6,11,6,1；c(5,2)=50；拍扁表，580 做行值）。
// 意对标 531 stirling2（第二类版互补；此处权为 n-1）。

fn stirling1(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{},{}", stirling1(4, 1), stirling1(4, 2), stirling1(4, 3), stirling1(5, 2));
    return 0;
}

@test "basic 576 stirling1"() {
    if stirling1(4, 1) != 6 { panic(57601); };
    if stirling1(4, 2) != 11 { panic(57602); };
    if stirling1(4, 3) != 6 { panic(57603); };
    if stirling1(5, 2) != 50 { panic(57604); };
}
