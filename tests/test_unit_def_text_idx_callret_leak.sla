@import "sa_std/vec.sa"
@import "sa_std/hashmap.sa"
@import "sa_std/string.sai"
@import "sa_std/str.sla"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/core/option.sa"

// DEF-TEXT-IDX-CALLRET-LEAK (HashMap arm): an index read whose target
// is a call result (make_map()[key]) left the map temp Active at
// function exit on the TEXT backend (MemoryLeak 1012) — the
// .index_expr HashMap arm in src/codegen.zig released the value
// pointer and the key but never retired the target temp. The fix
// retires it when callArgNeedsRelease(target); identifier targets
// are locals and correctly untouched.
// TEST ORDER IS LOAD-BEARING: `sa sla test` reports a MemoryLeak
// only for the LAST @test function in a file (stage-7 bisect:
// red-first/green-last passes on pristine, green-first/red-last
// traps 1012). The bound control therefore comes FIRST and the
// call-result shape LAST. Do not reorder, and do not add a test
// after the call-result one. Pre-fix: the last test traps 1012 on
// text; post-fix: both pass on both backends.

fn fb_mk_a() -> String {
    let b: Vec<u8> = Vec::new();
    b.push(97u8);
    let sl: Slice<u8> = VEC_AS_SLICE(b);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return s; },
        Err(e) => { panic(40320 + e); },
    }
}

fn fb_mk_b() -> String {
    let b: Vec<u8> = Vec::new();
    b.push(98u8);
    let sl: Slice<u8> = VEC_AS_SLICE(b);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return s; },
        Err(e) => { panic(40320 + e); },
    }
}

fn make_map() -> HashMap<String, i64> {
    let m: HashMap<String, i64> = HashMap::new();
    m.insert(fb_mk_a(), 9);
    m.insert(fb_mk_b(), 10);
    return m;
}

fn make_map2() -> HashMap<String, i64> {
    let m = HashMap::new();
    m.insert(fb_mk_a(), 9);
    m.insert(fb_mk_b(), 10);
    return m;
}

@test "def text idx callret leak hashmap bound"() {
    let mm = make_map2();
    if mm[fb_mk_a()] != 9 { panic(71442); };
}

@test "def text idx callret leak hashmap"() {
    if make_map()[fb_mk_a()] != 9 { panic(71441); };
}
