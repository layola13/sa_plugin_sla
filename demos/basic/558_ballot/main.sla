@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Ballot 数 ballot(p,q)=(p-q+1)·C(p+q,q)/(p+1)（p≥q，精确整除）。
// ballot(3,3)=5，ballot(4,2)=9，ballot(4,4)=14（末项即 C(4)）。
// 意对标 351 catalan（商式版互补；此处为双参 Ballot 族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ballot(p: int, q: int) -> int {
    return (p - q + 1) * binom_mul(p + q, q) / (p + 1);
}

fn main() -> i32 {
    println("{},{},{}", ballot(3, 3), ballot(4, 2), ballot(4, 4));
    return 0;
}

@test "basic 558 ballot"() {
    if ballot(3, 3) != 5 { panic(55801); };
    if ballot(4, 2) != 9 { panic(55802); };
    if ballot(4, 4) != 14 { panic(55803); };
    if ballot(5, 0) != 1 { panic(55804); };
}
