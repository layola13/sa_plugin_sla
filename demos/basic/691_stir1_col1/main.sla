@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类首列即阶乘：c(6,1)=120，c(7,1)=720，c(8,1)=5040（首列恒等单锁）。
// 意对标 686_stir17（内格版互补；692 做首列对峙）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(6, 1), cst(7, 1), cst(8, 1));
    return 0;
}

@test "basic 691 stir1 col1"() {
    if cst(6, 1) != 120 { panic(69101); };
    if cst(7, 1) != 720 { panic(69102); };
    if cst(8, 1) != 5040 { panic(69103); };
    if cst(5, 1) != 24 { panic(69104); };
}
