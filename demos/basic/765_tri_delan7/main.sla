@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 续三向：拍扁建表 × 二项直和 × 容斥和（(7,7)：48639 三锁）。
// 容斥 D(m,n)=sum C(m,k)C(n+m-k,m)（3432+12012+16632+11550+4200+756+56+1=48639）。
// 意对标 758_delan_high7（高位源互补；625 三向体例收束 Delannoy 续族）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ddel(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        if k <= n {
            let p = 1;
            let j = 0;
            while j < k {
                p = p * 2;
                j = j + 1;
            }
            s = s + binom_mul(m, k) * binom_mul(n, k) * p;
        };
        k = k + 1;
    }
    return s;
}

fn ddel2(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        s = s + binom_mul(m, k) * binom_mul(n + m - k, m);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", delan(7, 7), ddel(7, 7), ddel2(7, 7));
    return 0;
}

@test "basic 765 tri delan7"() {
    if delan(7, 7) != 48639 { panic(76501); };
    if ddel(7, 7) != 48639 { panic(76502); };
    if ddel2(7, 7) != 48639 { panic(76503); };
    if ddel2(5, 5) != 1683 { panic(76504); };
}
