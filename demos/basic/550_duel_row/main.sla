@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 行和对峙：表求和 Σ_k C(n,k) == 闭式 2^n（n=8：256 对 256；n=10：1024 对 1024）。
// 意对标 547 rowsum（单实现见源；286 系对峙体例）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn row_sum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom(n, k);
        k = k + 1;
    }
    return s;
}

fn pow2(n: int) -> int {
    let r = 1;
    let i = 0;
    while i < n {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{}", row_sum(8), pow2(8), row_sum(10), pow2(10));
    return 0;
}

@test "basic 550 duel row"() {
    if row_sum(8) != 256 { panic(55001); };
    if pow2(8) != 256 { panic(55002); };
    if row_sum(10) != 1024 { panic(55003); };
    if pow2(10) != 1024 { panic(55004); };
    if row_sum(9) != pow2(9) { panic(55005); };
}
