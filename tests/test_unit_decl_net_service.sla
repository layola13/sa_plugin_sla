@import "sa_std/dns.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/status.sla"

// DEF-DECL-REST carrier: SAB registry declared entry
// net_service_port_by_name from sa_std/dns.sla (the /etc/services
// lookup pair). Arms pin the IANA assignments present in the
// venue's /etc/services and the measured SA_STD_ERR_NOT_FOUND
// (3) for misses. The sibling entry net_service_name_by_port is
// WITHHELD from this file: its SAB build segfaults at the pinned
// head (signal 11 in a one-test minim, text backend green; the
// inner dns_services_scan over the same file content passes on
// SAB, so the fault sits in the wrapper's own SAB lowering) --
// registered as a defect in the line's RESULT with the minim
// kept under evidence/. Panic codes 685xx.

fn bytes_of(s: String) -> Vec<u8> {
    let v: Vec<u8> = Vec::new();
    let p: ptr = STR_PTR(s);
    let n: u64 = len(s) as u64;
    let i: u64 = 0;
    while i < n {
        v.push(PTR_BYTE_AT(p, i));
        i = i + 1;
    }
    return v;
}

@test "decl net service port by name"() {
    match net_service_port_by_name(bytes_of("http"), bytes_of("tcp")) {
        Ok(p) => { if p != 80 { panic(68501); }; },
        Err(e) => { panic(68502); },
    };
    match net_service_port_by_name(bytes_of("https"), bytes_of("tcp")) {
        Ok(p) => { if p != 443 { panic(68503); }; },
        Err(e) => { panic(68504); },
    };
    match net_service_port_by_name(bytes_of("domain"), bytes_of("udp")) {
        Ok(p) => { if p != 53 { panic(68505); }; },
        Err(e) => { panic(68506); },
    };
    match net_service_port_by_name(bytes_of("no-such-service-xyz"), bytes_of("tcp")) {
        Ok(p) => { panic(68507); },
        Err(e) => { if e != 3 { panic(68508); }; },
    };
    match net_service_port_by_name(bytes_of("http"), bytes_of("sctp")) {
        Ok(p) => { panic(68509); },
        Err(e) => { if e != 3 { panic(68510); }; },
    };
}
