@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 商式纵深 qsch(10)=1037718，qsch(11)=5293446（商式上移一位）。
// 意对标 793_schro_qseq（n=7/8/9 版互补；905 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn qsch(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom_mul(n + k, k) * binom_mul(n, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", qsch(10), qsch(11), qsch(9));
    return 0;
}

@test "basic 903 schro qseq11"() {
    if qsch(10) != 1037718 { panic(90301); };
    if qsch(11) != 5293446 { panic(90302); };
    if qsch(9) != 206098 { panic(90303); };
    if qsch(12) != 27297738 { panic(90304); };
}
