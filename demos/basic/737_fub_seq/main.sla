@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 序列前 8 项 1,1,3,13,75,541,4683,47293（和 52610；前缀和循环求和）。
// 意对标 736_fub7（单值版互补；同式序列复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn fseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + fub(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", fub(0), fub(1), fseq(7));
    return 0;
}

@test "basic 737 fub seq"() {
    if fseq(7) != 52610 { panic(73701); };
    if fub(0) != 1 { panic(73702); };
    if fub(1) != 1 { panic(73703); };
    if fseq(5) != 634 { panic(73704); };
}
