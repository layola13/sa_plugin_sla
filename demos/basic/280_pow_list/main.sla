@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 176_pow_sum 的表版（62 为求和版：2^0–2^4，末项 16）。
// 嵌套累乘（113 口径）+ 逐项入表组合。

fn main() -> i32 {
    let p2: Vec<i32> = Vec::new();
    let e = 0;
    while e <= 4 {
        let p = 1;
        let j = 0;
        while j < e {
            p = p * 2;
            j = j + 1;
        }
        p2.push(p);
        e = e + 1;
    }
    println("{},{}", len(p2), p2[4]);
    return 0;
}

@test "basic 280 pow list"() {
    let p2: Vec<i32> = Vec::new();
    let e = 0;
    while e <= 4 {
        let p = 1;
        let j = 0;
        while j < e {
            p = p * 2;
            j = j + 1;
        }
        p2.push(p);
        e = e + 1;
    }
    if len(p2) != 5 { panic(28001); };
    if p2[4] != 16 { panic(28002); };
    if p2[0] != 1 { panic(28003); };
}
