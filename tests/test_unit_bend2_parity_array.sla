// Bend2 P1-6 parity corpus: Array group (base.bend @faeb02e, 30 clauses
// incl. the atomic law family, which belongs to P2-5). Bend Array is a
// persistent 2^depth tree whose get/set mask the index (wrap) instead
// of failing. Our anchor is the fixed array [T; N]: any N, in-place,
// index traps out of range. Cases assert in-range value semantics;
// the wrap-vs-trap and depth-vs-length differences live in the parity
// table. fork/join rows are handed to P1-8 per the batch brief.
@import "sa_std/string.sa"
@import "sa_std/vec.sa"

@test "bend2 array new size get set"() {
    // Array.new(d, v) builds 2^d cells of v; ours: [v; N] fill literal
    let a: [i64; 4] = [7; 4];
    if len(a) != 4 { panic(75001); };
    if a.len() != 4 { panic(75002); };
    if a[0] != 7 { panic(75003); };
    if a[3] != 7 { panic(75004); };
    // Array.set value semantics in range (Bend masks the index and
    // returns a new array; ours assigns in place)
    a[2] = 9;
    if a[2] != 9 { panic(75005); };
    // Array.get
    if a[1] != 7 { panic(75006); };
}

@test "bend2 array swap clone"() {
    let a: [i64; 4] = [1, 2, 3, 4];
    // Array.swap(arr, i, v) replaces cell i and returns the OLD value
    // (it is set-with-old, not an exchange of two cells)
    let old = a[1];
    a[1] = 20;
    if old != 2 { panic(75007); };
    if a[1] != 20 { panic(75008); };
    // Exchanging two cells in place (temp composition)
    let t = a[0];
    a[0] = a[3];
    a[3] = t;
    if a[0] != 4 { panic(75009); };
    if a[3] != 1 { panic(75010); };
    // Array.clone: no entry (assigning an array moves it); deep copy
    // by an element loop proves the value semantics
    let b: [i64; 4] = [0; 4];
    let i = 0;
    while i < 4 {
        b[i] = a[i];
        i = i + 1;
    }
    if b[1] != 20 { panic(75011); };
    b[1] = 99;
    if a[1] != 20 { panic(75012); };
}

@test "bend2 array to_list map write show"() {
    let a: [i64; 4] = [1, 2, 3, 4];
    // Array.to_list by an element loop (iter().collect() is the SAB
    // gap already registered in test_unit_sab_iter_collect_gap.sla)
    let v: Vec<i64> = Vec::new();
    let i = 0;
    while i < len(a) {
        v.push(a[i]);
        i = i + 1;
    }
    if len(v) != 4 { panic(75013); };
    if v[2] != 3 { panic(75014); };
    // Array.map by a loop into a fresh array
    let w: [i64; 4] = [0; 4];
    let j = 0;
    while j < len(a) {
        w[j] = a[j] * 10;
        j = j + 1;
    }
    if w[0] != 10 { panic(75015); };
    if w[3] != 40 { panic(75016); };
    // Array.show / Array.write text form: "[1, 2, 3, 4]"
    let s = format("[{}", a[0]);
    let k = 1;
    while k < len(a) {
        s = format("{}, {}", s, a[k]);
        k = k + 1;
    }
    s = format("{}]", s);
    if !str_eq(s, "[1, 2, 3, 4]") { panic(75017); };
    // Iterator surface that does exist on arrays today
    if a.iter().sum() != 10 { panic(75018); };
}
