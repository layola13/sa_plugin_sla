@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 加权和 F(9)=sum k!S(9,k)=7087261（741 体例续高位）。
// 意对标 866_fub9（递推版互补；同式加权复算）。

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fubw(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + fact(k) * svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", fubw(9), fubw(8));
    return 0;
}

@test "basic 867 fubw9"() {
    if fubw(9) != 7087261 { panic(86701); };
    if fubw(8) != 545835 { panic(86702); };
    if fubw(7) != 47293 { panic(86703); };
    if svt(9, 4) != 7770 { panic(86704); };
}
