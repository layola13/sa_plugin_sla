@import "sa_std/vec.sa"
@import "sa_std/hashmap.sa"
@import "sa_std/string.sai"
@import "sa_std/str.sla"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/core/option.sa"

// Regression (DEF-PROBE-A): the expression result of the imported
// macros MAP_KEYS / MAP_VALUES / SET_KEYS used to be typed `.infer`
// by the checker -- the fixed result-kind table cannot express
// `Vec<Elem>` -- so every consumer of the produced Vec was untyped.
// On the SAB backend `len(ks)` degraded into a fabricated call to a
// nonexistent `sla__len` (UnknownRegister trap); on the text backend
// it only worked by falling into the STRING_LEN arm, whose layout
// coincides with Vec's. The checker now derives `Vec<Elem>` from the
// collection argument for these macros. The let-only shape always
// passed (control); every consuming shape below trapped pre-fix on
// the SAB backend.
//
// The annotated shape at the bottom builds its keys as String
// variables: with string-LITERAL keys the checker's generic
// inference binds the map's K to raw_ptr instead of String (a
// separate inference defect, registered as an adjacent finding of
// the PROBE-A line), which would make the annotation mismatch about
// K, not about the macro result typing this file regresses.

fn mkstr_a() -> String {
    let b: Vec<u8> = Vec::new();
    b.push(97u8);
    let sl: Slice<u8> = VEC_AS_SLICE(b);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return s; },
        Err(e) => { panic(40320 + e); },
    }
}

fn mkstr_b() -> String {
    let b: Vec<u8> = Vec::new();
    b.push(98u8);
    let sl: Slice<u8> = VEC_AS_SLICE(b);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return s; },
        Err(e) => { panic(40320 + e); },
    }
}

@test "map keys result let only (control)"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ks = MAP_KEYS(m);
}

@test "map keys result len free fn"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ks = MAP_KEYS(m);
    if len(ks) != 2 { panic(40101); };
}

@test "map keys result len method"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ks = MAP_KEYS(m);
    if ks.len() != 2 { panic(40703); };
}

@test "map keys result alias len"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ks = MAP_KEYS(m);
    let ks2 = ks;
    if len(ks2) != 2 { panic(40706); };
}

@test "map keys result annotated len"() {
    let m = HashMap::new();
    m.insert(mkstr_a(), 1);
    m.insert(mkstr_b(), 2);
    let ks: Vec<String> = MAP_KEYS(m);
    if len(ks) != 2 { panic(40710); };
}
