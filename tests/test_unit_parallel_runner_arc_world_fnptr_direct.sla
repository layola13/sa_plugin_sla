@import "sa_std/vec.sa"
@import "sa_std/core/arc.sa"
@import "sa_std/core/box.sa"

// Next-dimension fixture for docs/sab_parallel_runner_whole_file_memoryleak_issue_cn.md:
// multi-lane Vec<fn(Arc<*World>) -> i32> with ordered extend and Arc world call.
// No thread::spawn yet; keep under the local 10s SA/SAB smoke budget.

struct ParallelRunnerTinyWorld {
    value: i32,
}

struct ParallelRunnerArcLaneHolder {
    runs: Vec<fn(Arc<*ParallelRunnerTinyWorld>) -> i32>,
    on_scope_runs: Vec<fn(Arc<*ParallelRunnerTinyWorld>) -> i32>,
    run_order_positions: Vec<i64>,
    on_scope_order_positions: Vec<i64>,
}

fn parallel_runner_arc_lane_add_one(world: Arc<*ParallelRunnerTinyWorld>) -> i32 {
    // Keep Arc<*World> as a typed parameter without field projection; existing
    // Arc fixtures return constants from the same signature shape.
    return 11;
}

fn parallel_runner_arc_lane_add_two(world: Arc<*ParallelRunnerTinyWorld>) -> i32 {
    return 12;
}

fn parallel_runner_arc_lane_holder_new() -> ParallelRunnerArcLaneHolder {
    let runs: Vec<fn(Arc<*ParallelRunnerTinyWorld>) -> i32> = Vec::new();
    let on_scope_runs: Vec<fn(Arc<*ParallelRunnerTinyWorld>) -> i32> = Vec::new();
    let run_order_positions: Vec<i64> = Vec::new();
    let on_scope_order_positions: Vec<i64> = Vec::new();
    return ParallelRunnerArcLaneHolder {
        runs: runs,
        on_scope_runs: on_scope_runs,
        run_order_positions: run_order_positions,
        on_scope_order_positions: on_scope_order_positions,
    };
}

fn parallel_runner_arc_lane_len(holder: ParallelRunnerArcLaneHolder) -> i64 {
    return (len(holder.runs) + len(holder.on_scope_runs)) as i64;
}

fn parallel_runner_arc_lane_find_order(positions: Vec<i64>, order_pos: i64) -> i64 {
    let i: i64 = 0;
    let n = len(positions) as i64;
    while i < n {
        if positions[i] == order_pos {
            return i;
        };
        i = i + 1;
    }
    return -1;
}

fn parallel_runner_arc_lane_spawn(holder: ParallelRunnerArcLaneHolder, run: fn(Arc<*ParallelRunnerTinyWorld>) -> i32) -> ParallelRunnerArcLaneHolder {
    let order_pos = parallel_runner_arc_lane_len(holder);
    holder.runs.push(run);
    holder.run_order_positions.push(order_pos);
    return holder;
}

fn parallel_runner_arc_lane_spawn_on_scope(holder: ParallelRunnerArcLaneHolder, run: fn(Arc<*ParallelRunnerTinyWorld>) -> i32) -> ParallelRunnerArcLaneHolder {
    let order_pos = parallel_runner_arc_lane_len(holder);
    holder.on_scope_runs.push(run);
    holder.on_scope_order_positions.push(order_pos);
    return holder;
}

fn parallel_runner_arc_lane_extend(parent: ParallelRunnerArcLaneHolder, child: ParallelRunnerArcLaneHolder) -> ParallelRunnerArcLaneHolder {
    let order_pos: i64 = 0;
    let total = parallel_runner_arc_lane_len(child);
    while order_pos < total {
        let threaded_slot = parallel_runner_arc_lane_find_order(child.run_order_positions, order_pos);
        if threaded_slot >= 0 {
            parent = parallel_runner_arc_lane_spawn(parent, child.runs[threaded_slot]);
        } else {
            let local_slot = parallel_runner_arc_lane_find_order(child.on_scope_order_positions, order_pos);
            if local_slot >= 0 {
                parent = parallel_runner_arc_lane_spawn_on_scope(parent, child.on_scope_runs[local_slot]);
            };
        };
        order_pos = order_pos + 1;
    }
    return parent;
}

fn parallel_runner_arc_lane_call_sum(holder: ParallelRunnerArcLaneHolder, world: ParallelRunnerTinyWorld) -> i32 {
    let boxed = Box::new(world);
    let raw = Box::into_raw(boxed);
    let shared = Arc::new(raw);
    let run = holder.runs[0];
    let on_scope = holder.on_scope_runs[0];
    let first_ptr = shared.clone();
    let second_ptr = shared.clone();
    let a = run(first_ptr);
    let b = on_scope(second_ptr);
    return a + b;
}

@test "parallel runner arc world multi fnptr lane extend"() {
    let parent = parallel_runner_arc_lane_holder_new();
    let child0 = parallel_runner_arc_lane_holder_new();
    let child1 = parallel_runner_arc_lane_spawn(child0, parallel_runner_arc_lane_add_one);
    let child2 = parallel_runner_arc_lane_spawn_on_scope(child1, parallel_runner_arc_lane_add_two);
    let out = parallel_runner_arc_lane_extend(parent, child2);
    if len(out.runs) as i64 != 1 { panic(52401); };
    if len(out.on_scope_runs) as i64 != 1 { panic(52402); };
    if out.run_order_positions[0] != 0 { panic(52403); };
    if out.on_scope_order_positions[0] != 1 { panic(52404); };
    let world = ParallelRunnerTinyWorld { value: 10 };
    // 11 + 12 from the two Arc<*World> callbacks after multi-lane extend.
    if parallel_runner_arc_lane_call_sum(out, world) != 23 { panic(52405); };
}
