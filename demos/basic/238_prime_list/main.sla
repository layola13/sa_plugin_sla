@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 183_prime_upto 的表版（46 为计数版：20 以内 8 个，末项 19）。
// 试除判定（46 口径）+ 命中入表组合。

fn main() -> i32 {
    let primes: Vec<i32> = Vec::new();
    let c = 2;
    while c <= 20 {
        let d = 2;
        let is_p = 1;
        while d * d <= c {
            if c % d == 0 { is_p = 0; };
            d = d + 1;
        }
        if is_p == 1 { primes.push(c); };
        c = c + 1;
    }
    println("{},{}", len(primes), primes[7]);
    return 0;
}

@test "basic 238 prime list"() {
    let primes: Vec<i32> = Vec::new();
    let c = 2;
    while c <= 20 {
        let d = 2;
        let is_p = 1;
        while d * d <= c {
            if c % d == 0 { is_p = 0; };
            d = d + 1;
        }
        if is_p == 1 { primes.push(c); };
        c = c + 1;
    }
    if len(primes) != 8 { panic(23801); };
    if primes[7] != 19 { panic(23802); };
    if primes[0] != 2 { panic(23803); };
}
