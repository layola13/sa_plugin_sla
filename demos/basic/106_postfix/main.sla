@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 268_postfix：后置自增语义（0,1,1,0,10,1）。
// SLA 尚无 `++`/`--`（parser 直接拒绝 `Unexpected prefix token: plus`），
// 此处用显式 `i = i + 1` / `i = i - 1` 表达同一语义（含索引步进）。

fn main() -> i32 {
    let i = 0;
    let p0 = i;
    i = i + 1;
    let p1 = i;
    i = i - 1;
    let a = [10, 20, 30];
    let j = 0;
    let p3 = a[j];
    j = j + 1;
    println("{},{},{},{},{},{}", p0, p1, i, i, p3, j);
    return 0;
}

@test "basic 106 postfix"() {
    let i = 0;
    if i != 0 { panic(10601); };
    i = i + 1;
    if i != 1 { panic(10602); };
    i = i - 1;
    if i != 0 { panic(10603); };
    let a = [10, 20, 30];
    let j = 0;
    if a[j] != 10 { panic(10604); };
    j = j + 1;
    if j != 1 { panic(10605); };
}
