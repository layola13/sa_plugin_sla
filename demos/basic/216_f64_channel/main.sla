@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 278_f64_channel：f64 通道（变量 + 加法 + 函数返回 + 相等判定）。
// 裸 f64 不直打（打印截断见 #29），此处以比较转 int 旗输出（1,1,1；
// 与 125/194 的比较断言口径一致）。

fn f() -> f64 {
    return 7.5;
}

fn main() -> i32 {
    let y: f64 = 7.5;
    let c = y + 0.5;
    println("{},{},{}", if c == 8.0 { 1 } else { 0 }, if f() == 7.5 { 1 } else { 0 }, if y == 7.5 { 1 } else { 0 });
    return 0;
}

@test "basic 216 f64 channel"() {
    let y: f64 = 7.5;
    let c = y + 0.5;
    if c != 8.0 { panic(21601); };
    if f() != 7.5 { panic(21602); };
    if y != 7.5 { panic(21603); };
}
