@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// C(5)=42 三向收束：Narayana 行和 == Catalan 卷积 == 商式 B(5)/6
//（42 对 42 对 42；Catalan 弧收官，316 系三向体例）。
// 意对标 598 narayana6 × 556 cat_conv × 351 catalan（三源单实现见各源）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nar_row(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + narayana(n, k);
        k = k + 1;
    }
    return s;
}

fn cat_conv(n: int) -> int {
    let c: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        c.push(0);
        i = i + 1;
    }
    c[0] = 1;
    let m = 1;
    while m <= n {
        let acc = 0;
        let j = 0;
        while j < m {
            acc = acc + c[j] * c[m - 1 - j];
            j = j + 1;
        }
        c[m] = acc;
        m = m + 1;
    }
    return c[n];
}

fn cat_div(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{}", nar_row(5), cat_conv(5), cat_div(5));
    return 0;
}

@test "basic 605 tri narcat"() {
    if nar_row(5) != 42 { panic(60501); };
    if cat_conv(5) != 42 { panic(60502); };
    if cat_div(5) != 42 { panic(60503); };
    if nar_row(4) != 14 { panic(60504); };
}
