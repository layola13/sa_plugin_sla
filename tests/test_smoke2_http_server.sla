// ---------------- v1 websocket tests ----------------

fn s2_upgrade_v1(srv: ptr, cli: u64, code: i32) -> ptr {
    s2_raw_write(cli, s2_ws_upgrade_req(), s2_ws_upgrade_req_len(), code);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 1); };
    let req = (aq[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_server_websocket_upgrade(req, &wc[0]) != 0 { panic(code + 2); };
    if wc[0] == 0 { panic(code + 3); };
    // Note: a successful upgrade consumes the request handle.
    return (wc[0] as ptr);
}

@test "smoke2 sa_http_server_websocket_upgrade"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24418, pp, 64590);
    let cli = s2_raw_conn(pc[0], 64592);
    let ws = s2_upgrade_v1(srv, cli, 64593);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_read_head(cli, bp, 1024, 64597);
    if !s2_contains(bp, total, STR_PTR("101"), STR_LEN("101")) { panic(64598); };
    sla_http_server_websocket_free(ws);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_websocket_write"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24419, pp, 64600);
    let cli = s2_raw_conn(pc[0], 64602);
    let ws = s2_upgrade_v1(srv, cli, 64603);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_read_head(cli, bp, 1024, 64607);
    // Client sends one masked text frame "hi-ws1".
    let fbuf = [0u8; 64];
    let fp: ptr = PTR_BYTE_ADD(&fbuf, 0);
    let flen = s2_ws_frame(fp, 1, STR_PTR("hi-ws1"), STR_LEN("hi-ws1"));
    s2_raw_write(cli, fp, flen, 64608);
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_websocket_read(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(64609); };
    if op[0] != 1 { panic(64610); };
    if !s2_mem_eq((dp[0] as ptr), dl[0], STR_PTR("hi-ws1"), STR_LEN("hi-ws1")) { panic(64611); };
    if sla_http_server_websocket_write(ws, 1, STR_PTR("srv-push"), STR_LEN("srv-push")) != 0 { panic(64612); };
    // Server frame is unmasked: 0x81, len, payload.
    s2_read_exact(cli, bp, 10, 64613);
    if buf[0] != 129 { panic(64614); };
    if buf[1] != 8 { panic(64615); };
    if !s2_mem_eq_tail(bp, 2, STR_PTR("srv-push"), STR_LEN("srv-push")) { panic(64616); };
    sla_http_server_websocket_free(ws);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

