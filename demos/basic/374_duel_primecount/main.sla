@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 素数计数双实现对峙（试除计数 vs 跳偶计数：<=20 皆为 8）。
// 意对标 364 判定对峙的计数版（373 互补）。

fn count_trial(limit: int) -> int {
    let c = 0;
    let k = 2;
    while k <= limit {
        let prime = 1;
        if k >= 2 {
            let d = 2;
            while d * d <= k {
                if k % d == 0 { prime = 0; };
                d = d + 1;
            }
        };
        if k < 2 { prime = 0; };
        if prime == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn is_prime_wheel(n: int) -> int {
    if n < 2 { return 0; };
    if n == 2 { return 1; };
    if n % 2 == 0 { return 0; };
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return 0; };
        d = d + 2;
    }
    return 1;
}

fn count_wheel(limit: int) -> int {
    let c = 0;
    let k = 2;
    while k <= limit {
        if is_prime_wheel(k) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{}", count_trial(20), count_wheel(20));
    return 0;
}

@test "basic 374 duel primecount"() {
    if count_trial(20) != 8 { panic(37401); };
    if count_wheel(20) != 8 { panic(37402); };
    if count_trial(20) != count_wheel(20) { panic(37403); };
    if count_trial(10) != 4 { panic(37404); };
}
