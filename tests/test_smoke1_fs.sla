// Smoke wave 1 (hand-written, honest handle chains) for register-2
// externs in sa_std/fs.sai. One @test per register-2 extern; each test
// builds a real handle in a temp dir, exercises the full lifecycle and
// asserts substantive outputs. Panic codes 51xxx.
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/process.sla"
@import "sla_std/wrap/net.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"


fn s1_mkdir() {
    sla_fs_mkdir_p(STR_PTR("smoke1_fs"), STR_LEN("smoke1_fs"));
}

fn s1_len_of(path: ptr, path_len: u64) -> u64 {
    let cell = [0u64; 4];
    let rc = sla_std_fs_len(path, path_len, &cell[0]);
    if rc != 0 { panic(51001); };
    return cell[0];
}

@test "smoke1 sa_fs_file_close"() {
    s1_mkdir();
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/close.txt"), STR_LEN("smoke1_fs/close.txt"), 7);
    if fd <= 0 { panic(51010); };
    let rc = sla_fs_file_close(fd as u64);
    if rc != 0 { panic(51011); };
    // Second close of the same handle must fail loudly (invalid handle = 2).
    let rc2 = sla_fs_file_close(fd as u64);
    if rc2 == 0 { panic(51012); };
}

@test "smoke1 sa_fs_file_write"() {
    s1_mkdir();
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/write.txt"), STR_LEN("smoke1_fs/write.txt"), 6);
    if fd <= 0 { panic(51020); };
    let rc = sla_fs_file_write(fd as u64, STR_PTR("abc"), STR_LEN("abc"));
    if rc != 0 { panic(51021); };
    let rc2 = sla_fs_file_close(fd as u64);
    if rc2 != 0 { panic(51022); };
    if s1_len_of(STR_PTR("smoke1_fs/write.txt"), STR_LEN("smoke1_fs/write.txt")) != 3 { panic(51023); };
}

@test "smoke1 sa_fs_file_write_all"() {
    s1_mkdir();
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/writeall.txt"), STR_LEN("smoke1_fs/writeall.txt"), 6);
    if fd <= 0 { panic(51030); };
    let rc = sla_fs_file_write_all(fd as u64, STR_PTR("abcde"), STR_LEN("abcde"));
    if rc != 0 { panic(51031); };
    sla_fs_file_close(fd as u64);
    if s1_len_of(STR_PTR("smoke1_fs/writeall.txt"), STR_LEN("smoke1_fs/writeall.txt")) != 5 { panic(51032); };
}

@test "smoke1 sa_fs_file_read"() {
    s1_mkdir();
    let wrc = sla_fs_write_file(STR_PTR("smoke1_fs/read.txt"), STR_LEN("smoke1_fs/read.txt"), STR_PTR("hello"), STR_LEN("hello"));
    if wrc != 0 { panic(51040); };
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/read.txt"), STR_LEN("smoke1_fs/read.txt"), 1);
    if fd <= 0 { panic(51041); };
    let buf = [0u8; 64];
    let rc = sla_fs_file_read(fd as u64, &buf[0], 64);
    if rc != 0 { panic(51042); };
    if buf[0] != 104 { panic(51043); };
    if buf[1] != 101 { panic(51044); };
    if buf[4] != 111 { panic(51045); };
    sla_fs_file_close(fd as u64);
}

@test "smoke1 sa_fs_file_read_exact"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/readexact.txt"), STR_LEN("smoke1_fs/readexact.txt"), STR_PTR("hello"), STR_LEN("hello"));
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/readexact.txt"), STR_LEN("smoke1_fs/readexact.txt"), 1);
    if fd <= 0 { panic(51050); };
    let buf = [0u8; 64];
    let s1bp1: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc = sla_fs_file_read_exact(fd as u64, s1bp1, 5);
    if rc != 0 { panic(51051); };
    if buf[0] != 104 { panic(51052); };
    if buf[4] != 111 { panic(51053); };
    // Reading past EOF with read_exact must fail.
    let s1bp2: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc2 = sla_fs_file_read_exact(fd as u64, s1bp2, 1);
    if rc2 == 0 { panic(51054); };
    sla_fs_file_close(fd as u64);
}

@test "smoke1 sa_fs_file_flush"() {
    s1_mkdir();
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/flush.txt"), STR_LEN("smoke1_fs/flush.txt"), 6);
    if fd <= 0 { panic(51060); };
    sla_fs_file_write_all(fd as u64, STR_PTR("xy"), STR_LEN("xy"));
    let rc = sla_fs_file_flush(fd as u64);
    if rc != 0 { panic(51061); };
    sla_fs_file_close(fd as u64);
    if s1_len_of(STR_PTR("smoke1_fs/flush.txt"), STR_LEN("smoke1_fs/flush.txt")) != 2 { panic(51062); };
}

