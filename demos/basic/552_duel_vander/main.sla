@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Vandermonde 对峙：卷积求和 == 查表 C(r+s,n)
//（r=s=4,n=4：70 对 70；r=3,s=5,n=4：70 对 70）。
// 意对标 549 vander（单实现见源；286 系对峙体例）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn vander(r: int, s: int, n: int) -> int {
    let acc = 0;
    let k = 0;
    while k <= n {
        if k <= r {
            let j = n - k;
            if j >= 0 {
                if j <= s {
                    acc = acc + binom(r, k) * binom(s, j);
                };
            };
        };
        k = k + 1;
    }
    return acc;
}

fn main() -> i32 {
    println("{},{},{},{}", vander(4, 4, 4), binom(8, 4), vander(3, 5, 4), binom(8, 4));
    return 0;
}

@test "basic 552 duel vander"() {
    if vander(4, 4, 4) != 70 { panic(55201); };
    if binom(8, 4) != 70 { panic(55202); };
    if vander(3, 5, 4) != 70 { panic(55203); };
    if vander(4, 4, 4) != binom(8, 4) { panic(55204); };
    if vander(3, 5, 4) != binom(8, 4) { panic(55205); };
}
