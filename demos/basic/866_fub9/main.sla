@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 续高位 F(9)=7087261（二项递推，同式再上一位）。
// 意对标 738_fub8（n=8 版互补；868 做递推/加权对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", fub(9), fub(8));
    return 0;
}

@test "basic 866 fub9"() {
    if fub(9) != 7087261 { panic(86601); };
    if fub(8) != 545835 { panic(86602); };
    if fub(7) != 47293 { panic(86603); };
    if binom_mul(9, 4) != 126 { panic(86604); };
}
