@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 高位 B(5,2)=1682（B(5,1)=237 对 237；`5·230+7·76`）。
// 意对标 676_eulb（低位版互补；680 做高位对峙）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{}", eub(5, 1), eub(5, 2));
    return 0;
}

@test "basic 678 eulb high"() {
    if eub(5, 2) != 1682 { panic(67801); };
    if eub(5, 1) != 237 { panic(67802); };
    if eub(4, 2) != 230 { panic(67803); };
}
