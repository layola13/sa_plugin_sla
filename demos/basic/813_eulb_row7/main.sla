@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 第 7 行 1,2179,60657,259723,259723,60657,2179,1（行和 645120=2^7·7!）。
// 意对标 807_eulb_row6（低位行互补；同式高位行复算）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn ebsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eub(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eub(7, 1), eub(7, 2), ebsum(7));
    return 0;
}

@test "basic 813 eulb row7"() {
    if eub(7, 1) != 2179 { panic(81301); };
    if eub(7, 2) != 60657 { panic(81302); };
    if ebsum(7) != 645120 { panic(81303); };
    if eub(7, 0) != 1 { panic(81304); };
}
