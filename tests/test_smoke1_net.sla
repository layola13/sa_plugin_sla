    let buf = [0u8; 64];
    let rd = [0u64; 4];
    sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rd[0] != 4 { panic(59084); };
    if buf[0] != 112 { panic(59085); };
    if buf[3] != 103 { panic(59086); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
