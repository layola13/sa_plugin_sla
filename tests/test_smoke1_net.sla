    if rc != 0 { panic(59851); };
    let rc2 = sla_std_net_udp_leave_multicast_v4(a, STR_PTR("233.1.1.1"), STR_LEN("233.1.1.1"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc2 != 0 { panic(59852); };
