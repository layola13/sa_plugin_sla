@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 费马测试双实现对峙（连乘 vs 平方乘：7 皆判素，341 皆误判）。
// 意对标 355 模幂三向的费马版（397 互补）。

fn ferm_loop(n: int) -> int {
    if n < 2 { return 0; };
    let r = 1;
    let i = 0;
    while i < n - 1 {
        r = r * 2 % n;
        i = i + 1;
    }
    if r == 1 { return 1; };
    return 0;
}

fn powmod(base: int, exp: int, m: int) -> int {
    let r = 1;
    let b = base % m;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b % m; };
        b = b * b % m;
        e = e / 2;
    }
    return r;
}

fn ferm_sqmul(n: int) -> int {
    if n < 2 { return 0; };
    if powmod(2, n - 1, n) == 1 { return 1; };
    return 0;
}

fn main() -> i32 {
    println("{},{},{}", ferm_loop(7), ferm_sqmul(7), ferm_loop(341));
    return 0;
}

@test "basic 403 duel fermat"() {
    if ferm_loop(7) != 1 { panic(40301); };
    if ferm_sqmul(7) != 1 { panic(40302); };
    if ferm_loop(9) != 0 { panic(40303); };
    if ferm_sqmul(9) != 0 { panic(40304); };
    if ferm_loop(341) != ferm_sqmul(341) { panic(40305); };
}
