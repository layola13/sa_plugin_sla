@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 中项分数（mediant(1/3,1/2)=2/5；交叉相乘定位居间）。
// 意对标 478 Farey 的构造版（478 互补）。

fn mediant_pack(a: int, b: int, c: int, d: int) -> int {
    return (a + c) * 100 + (b + d);
}

fn mediant_between(a: int, b: int, c: int, d: int) -> int {
    if a * (b + d) >= (a + c) * b { return 0; };
    if (a + c) * d >= (b + d) * c { return 0; };
    return 1;
}

fn main() -> i32 {
    println("{},{}", mediant_pack(1, 3, 1, 2), mediant_between(1, 3, 1, 2));
    return 0;
}

@test "basic 479 mediant"() {
    if mediant_pack(1, 3, 1, 2) != 205 { panic(47901); };
    if mediant_between(1, 3, 1, 2) != 1 { panic(47902); };
    if mediant_pack(0, 1, 1, 1) != 102 { panic(47903); };
}
