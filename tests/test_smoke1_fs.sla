@test "smoke1 sa_fs_metadata_blocks"() {
    s1_mkdir();
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/big.bin"), STR_LEN("smoke1_fs/big.bin"), 6);
    if fd <= 0 { panic(51450); };
    let chunk = [0u8; 4096];
    let i: u64 = 0;
    while i < 25 {
        let s1bp7: ptr = PTR_BYTE_ADD(&chunk, 0);
        sla_fs_file_write_all(fd as u64, s1bp7, 4096);
        i = i + 1;
    }
    sla_fs_file_close(fd as u64);
    let m = s1_meta(STR_PTR("smoke1_fs/big.bin"), STR_LEN("smoke1_fs/big.bin"), 51451);
    if sla_fs_metadata_blocks(m) == 0 { panic(51452); };
    sla_std_fs_metadata_free(m);
}

