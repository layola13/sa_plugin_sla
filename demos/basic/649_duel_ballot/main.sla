@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Ballot 双实现对峙：拍扁建表 vs 商式（(4,2)：9 对 9；(4,3)：14 对 14）。
// 商式 B(n,k)=(n-k+1)C(n+k,k)/(n+1)（先乘后除精确整除）。
// 意对标 646_ballot × 商式版（两源单实现见各源；286 系对峙体例）。

fn btab(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn] + t[mm * w + nn - 1];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bclo(n: int, k: int) -> int {
    return (n - k + 1) * binom_mul(n + k, k) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{},{}", btab(4, 2), bclo(4, 2), btab(4, 3), bclo(4, 3));
    return 0;
}

@test "basic 649 duel ballot"() {
    if btab(4, 2) != 9 { panic(64901); };
    if bclo(4, 2) != 9 { panic(64902); };
    if btab(4, 3) != 14 { panic(64903); };
    if bclo(4, 3) != 14 { panic(64904); };
}
