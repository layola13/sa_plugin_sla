@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 行和对峙：二项递推 vs 二类行和（n=9：21147 对 21147；n=10：115975 对 115975）。
// 意对标 782_bell_rowsum × 776_bell9（行源与递推源合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn bsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", bell(9), bsum(9), bell(10), bsum(10));
    return 0;
}

@test "basic 783 duel bellrow"() {
    if bell(9) != 21147 { panic(78301); };
    if bsum(9) != 21147 { panic(78302); };
    if bell(10) != 115975 { panic(78303); };
    if bsum(10) != 115975 { panic(78304); };
}
