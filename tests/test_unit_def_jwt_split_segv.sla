@import "sa_std/jwt.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/status.sla"

// DEF-JWT-SPLIT-SEGV regression corpus.
// Root cause: jwt_split read the header alg bytes out of the parsed
// JSON document AFTER sa_json_free(doc) released the document's
// storage (sa_json_object_get_string returns a raw (ptr,len) into
// the document). Any well-formed token segfaulted on both backends.
// The fix copies the alg bytes out before freeing the document.
// Panic codes 681xx.

fn bytes_of(s: String) -> Vec<u8> {
    let v: Vec<u8> = Vec::new();
    let p: ptr = STR_PTR(s);
    let n: u64 = len(s) as u64;
    let i: u64 = 0;
    while i < n {
        v.push(PTR_BYTE_AT(p, i));
        i = i + 1;
    }
    return v;
}

fn veq(v: &Vec<u8>, s: String) -> bool {
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    let n: u64 = 0;
    SLICE_GET_LEN(n, sl);
    if n != (len(s) as u64) { return false; };
    let p: ptr = STR_PTR(s);
    let i: u64 = 0;
    while i < n {
        let b: u8 = 0;
        SLICE_GET(b, sl, i);
        if b != PTR_BYTE_AT(p, i) { return false; };
        i = i + 1;
    }
    return true;
}

@test "def jwt split literal token"() {
    let tok = bytes_of("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1MSJ9.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
    let parts = jwt_split(tok, STR_PTR("HS256"), STR_LEN("HS256"));
    if parts.status != 0 { panic(68151); };
    if !veq(&parts.payload, "{\"sub\":\"u1\"}") { panic(68152); };
    let sl: Slice<u8> = VEC_AS_SLICE(parts.sig);
    let nsig: u64 = 0;
    SLICE_GET_LEN(nsig, sl);
    if nsig != 32 { panic(68153); };
    if !veq(&parts.input, "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1MSJ9") { panic(68154); };
}

@test "def jwt split wrong alg rejected"() {
    let tok = bytes_of("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1MSJ9.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
    let parts = jwt_split(tok, STR_PTR("RS256"), STR_LEN("RS256"));
    if parts.status != -202 { panic(68161); };
}

@test "def jwt verify hs256 roundtrip"() {
    match jwt_sign_hs256(bytes_of("topsecret"), bytes_of("{\"sub\":\"u1\"}")) {
        Ok(tok) => {
            match jwt_verify_hs256(tok, bytes_of("topsecret")) {
                Ok(claims) => {
                    if !veq(&claims, "{\"sub\":\"u1\"}") { panic(68171); };
                },
                Err(e) => { panic(68172); },
            };
        },
        Err(e) => { panic(68173); },
    };
}

@test "def jwt verify hs256 wrong secret"() {
    match jwt_sign_hs256(bytes_of("topsecret"), bytes_of("{\"sub\":\"u1\"}")) {
        Ok(tok) => {
            match jwt_verify_hs256(tok, bytes_of("wrongsecret")) {
                Ok(claims) => { panic(68181); },
                Err(e) => {
                    if e != -203 { panic(68182); };
                },
            };
        },
        Err(e) => { panic(68183); },
    };
}

@test "def jwt verify rs256 alg confusion rejected"() {
    match jwt_sign_hs256(bytes_of("topsecret"), bytes_of("{\"sub\":\"u1\"}")) {
        Ok(tok) => {
            match jwt_verify_rs256(tok, bytes_of("dummy-key")) {
                Ok(claims) => { panic(68191); },
                Err(e) => {
                    if e != -202 { panic(68192); };
                },
            };
        },
        Err(e) => { panic(68193); },
    };
}
