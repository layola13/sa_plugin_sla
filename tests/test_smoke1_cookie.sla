@test "smoke1 sa_cookie_serialize"() {
    let h = s1_new(54200);
    sla_cookie_set_path(h, STR_PTR("/"), STR_LEN("/"));
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_cookie_serialize(h, &p[0], &l[0]);
    if rc != 0 { panic(54201); };
    if l[0] <= 7 { panic(54202); };
    if s1_streq((p[0] as ptr), 7, STR_PTR("sid=abc"), STR_LEN("sid=abc")) == false { panic(54203); };
    sla_cookie_free(^h);
}

