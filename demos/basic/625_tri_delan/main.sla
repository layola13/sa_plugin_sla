@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 三向：拍扁建表 × 二项直和 × 容斥和（(5,5)：1683 三锁）。
// 容斥 D(m,n)=sum C(m,k)C(n+m-k,m)（252,630,560,210,30,1 精确求和）。
// 意对标 617_delannoy_high（高位源互补；605 三向体例收束 Delannoy 族）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ddel(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        if k <= n {
            let p = 1;
            let j = 0;
            while j < k {
                p = p * 2;
                j = j + 1;
            }
            s = s + binom_mul(m, k) * binom_mul(n, k) * p;
        };
        k = k + 1;
    }
    return s;
}

fn ddel2(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        s = s + binom_mul(m, k) * binom_mul(n + m - k, m);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", delan(5, 5), ddel(5, 5), ddel2(5, 5));
    return 0;
}

@test "basic 625 tri delan"() {
    if delan(5, 5) != 1683 { panic(62501); };
    if ddel(5, 5) != 1683 { panic(62502); };
    if ddel2(5, 5) != 1683 { panic(62503); };
    if ddel2(3, 3) != 63 { panic(62504); };
}
