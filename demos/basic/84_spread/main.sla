@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 29_spread_elem：`[...a, 4]` 展开（长 4 + 尾元 4 = 8）。
// SLA 暂无展开语法，用拷贝循环 + `push` 表达（写法见 39/53/83）。

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    let c: Vec<i32> = Vec::new();
    for i in 0..3 {
        c.push(a[i]);
    }
    c.push(4);
    let cl = len(c) as i32;
    println("{}", cl + c[3]);
    return 0;
}

@test "basic 84 spread"() {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    let c: Vec<i32> = Vec::new();
    for i in 0..3 {
        c.push(a[i]);
    }
    c.push(4);
    if len(c) != 4 { panic(8401); };
    let cl = len(c) as i32;
    if cl + c[3] != 8 { panic(8402); };
}
