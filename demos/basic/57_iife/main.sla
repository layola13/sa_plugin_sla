@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 170_iife：立即调用函数表达式 `(() => 42)()`。
// 缺口 #13 已修复：闭包字面量可直接调用（`(|x| ...)()` 经 callee 契约直达
// `genClosureCall`，双后端一致）；先绑定再调用仍为等价写法保留于此。

fn main() -> i32 {
    let v = 0;
    {
        let f = || 42;
        v = f();
    }
    println("{}", v);
    println("{}", (|x: int| x * 2)(21));
    return 0;
}

@test "basic 57 iife"() {
    let f = || 42;
    if f() != 42 { panic(5701); };
    if (|x: int| x * 2)(21) != 42 { panic(5702); };
}
