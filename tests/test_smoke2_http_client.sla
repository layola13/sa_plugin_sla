// smoke-wave2: honest smokes for sa_std/http_client.sai remaining entries.
// Peers are loopback echo servers started by the tests themselves
// (goroutines on unique ports). Every test asserts return values, status
// codes and body bytes.
@import "sla_std/wrap/http_server.sla"
@import "sla_std/wrap/http_client.sla"
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/time.sla"
@import "sa_std/task.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s2_mem_eq(p: ptr, n: u64, q: ptr, m: u64) -> bool {
    if n != m { return false; };
    let i: u64 = 0;
    while i < n {
        let a: ptr = PTR_BYTE_ADD(p, i);
        let b: ptr = PTR_BYTE_ADD(q, i);
        if PTR_READ_U8(a) != PTR_READ_U8(b) { return false; };
        i = i + 1;
    }
    return true;
}

fn s2_contains(p: ptr, n: u64, q: ptr, m: u64) -> bool {
    if m == 0 { return true; };
    if n < m { return false; };
    let i: u64 = 0;
    while i + m <= n {
        let base: ptr = PTR_BYTE_ADD(p, i);
        if s2_mem_eq(base, m, q, m) { return true; };
        i = i + 1;
    }
    return false;
}

// Append src bytes into dst at *n; returns nothing, *n advanced via cell.
fn s2_append(dst: ptr, ncell: ptr, src: ptr, m: u64) -> void {
    let n: u64 = (PTR_READ_U64(ncell) as u64);
    let i: u64 = 0;
    while i < m {
        let s: ptr = PTR_BYTE_ADD(src, i);
        let d: ptr = PTR_BYTE_ADD(dst, n + i);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        i = i + 1;
    }
    PTR_WRITE_U64(ncell, n + m);
}

fn s2_append_lit(dst: ptr, ncell: ptr, lit: ptr, lit_len: u64) -> void {
    s2_append(dst, ncell, lit, lit_len);
}

// "http://127.0.0.1:<port><suffix>" into outb; returns length.
fn s2_url(port: u64, suffix: ptr, suffix_len: u64, ob: ptr) -> u64 {
    let nc = [0u64; 4];
    let ncp: ptr = PTR_BYTE_ADD(&nc, 0);
    PTR_WRITE_U64(ncp, 0);
    s2_append_lit(ob, ncp, STR_PTR("http://127.0.0.1:"), STR_LEN("http://127.0.0.1:"));
    let digits = [0u8; 8];
    let dp0: ptr = PTR_BYTE_ADD(&digits, 0);
    let v: u64 = port;
    let nd: u64 = 0;
    while v > 0 {
        let d: ptr = PTR_BYTE_ADD(dp0, nd);
        PTR_WRITE_U8(d, (48 + ((v % 10) as u8)));
        nd = nd + 1;
        v = v / 10;
    }
    let rev = [0u8; 8];
    let rp0: ptr = PTR_BYTE_ADD(&rev, 0);
    let k: u64 = 0;
    while k < nd {
        let s: ptr = PTR_BYTE_ADD(dp0, nd - 1 - k);
        let d: ptr = PTR_BYTE_ADD(rp0, k);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        k = k + 1;
    }
    s2_append(ob, ncp, rp0, nd);
    s2_append(ob, ncp, suffix, suffix_len);
    return nc[0];
}

// ---------------- v1 echo server (goroutine) ----------------
// mode 0: body = path + "|" + request body
// mode 1: fixed body "client-body-1"
// mode 2: status 404, body "nf"
// mode 3: fixed body "0123456789ABCDEF"
// mode 4: body = Authorization header value (or "none")
// mode 5: body = X-Req header value (or "none")
fn s2_echo1_tail(req: ptr, srv: ptr, status: u16, ob: ptr, n: u64, code: i32) -> void {
    let rp = [0u64; 4];
    if sla_http_server_resp_new(req, status, &rp[0]) != 0 { panic(code + 5); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_send(resp, ob, n) != 0 { panic(code + 6); };
    sla_http_server_resp_free(resp);
    sla_http_server_req_free(req);
    sla_http_server_free(srv);
}

// Split peers in the shape the text backend accepts (probe M V5):
// at most two else-if branches plus a fall-through tail, branch-local
// names unique per branch. The six-mode single-function form traps
// the text backend (W2-DEF-TEXT-ECHO-USEAFTERMOVE, minim on file).
fn s2_echo1a(arg: u64) -> void {
    // go entry convention is a single argument: port | mode<<16 | code<<24.
    let port: u64 = arg & 65535;
    let mode: u64 = (arg >> 16) & 255;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    if mode == 1 {
        let obufA = [0u8; 1024];
        let obA: ptr = PTR_BYTE_ADD(&obufA, 0);
        let ncA = [0u64; 4];
        let ncpA: ptr = PTR_BYTE_ADD(&ncA, 0);
        PTR_WRITE_U64(ncpA, 0);
        { let srcp: ptr = STR_PTR("client-body-1"); let cnt: u64 = STR_LEN("client-body-1"); let base: u64 = (PTR_READ_U64(ncpA) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obA, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpA, base + cnt); }
        s2_echo1_tail(req, srv, 200, obA, ncA[0], code);
        return;
    } else if mode == 2 {
        let obufB = [0u8; 1024];
        let obB: ptr = PTR_BYTE_ADD(&obufB, 0);
        let ncB = [0u64; 4];
        let ncpB: ptr = PTR_BYTE_ADD(&ncB, 0);
        PTR_WRITE_U64(ncpB, 0);
        { let srcp: ptr = STR_PTR("nf"); let cnt: u64 = STR_LEN("nf"); let base: u64 = (PTR_READ_U64(ncpB) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obB, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpB, base + cnt); }
        s2_echo1_tail(req, srv, 404, obB, ncB[0], code);
        return;
    };
    // mode 0 (tail): body = path + "|" + request body
    let obufT = [0u8; 1024];
        let obT: ptr = PTR_BYTE_ADD(&obufT, 0);
        let ncT = [0u64; 4];
        let ncpT: ptr = PTR_BYTE_ADD(&ncT, 0);
        PTR_WRITE_U64(ncpT, 0);
    let pp = [0u64; 4];
    let pl = [0u64; 4];
    if sla_http_server_req_get_path(req, &pp[0], &pl[0]) != 0 { panic(code + 3); };
    { let srcp: ptr = (pp[0] as ptr); let cnt: u64 = pl[0]; let base: u64 = (PTR_READ_U64(ncpT) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obT, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpT, base + cnt); }
    { let srcp: ptr = STR_PTR("|"); let cnt: u64 = 1; let base: u64 = (PTR_READ_U64(ncpT) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obT, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpT, base + cnt); }
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_req_get_body(req, &dp[0], &dl[0]) != 0 { panic(code + 4); };
    { let srcp: ptr = (dp[0] as ptr); let cnt: u64 = dl[0]; let base: u64 = (PTR_READ_U64(ncpT) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obT, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpT, base + cnt); }
    s2_echo1_tail(req, srv, 200, obT, ncT[0], code);
}

fn s2_echo1b(arg: u64) -> void {
    // go entry convention is a single argument: port | mode<<16 | code<<24.
    let port: u64 = arg & 65535;
    let mode: u64 = (arg >> 16) & 255;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    if mode == 4 {
        let obufA = [0u8; 1024];
        let obA: ptr = PTR_BYTE_ADD(&obufA, 0);
        let ncA = [0u64; 4];
        let ncpA: ptr = PTR_BYTE_ADD(&ncA, 0);
        PTR_WRITE_U64(ncpA, 0);
        let hpA = [0u64; 4];
        let hlA = [0u64; 4];
        let grcA = sla_http_server_req_get_header(req, STR_PTR("Authorization"), STR_LEN("Authorization"), &hpA[0], &hlA[0]);
        let spA: ptr = STR_PTR("none");
        let slA: u64 = 4;
        if grcA == 0 { spA = (hpA[0] as ptr); slA = hlA[0]; };
        { let srcp: ptr = spA; let cnt: u64 = slA; let base: u64 = (PTR_READ_U64(ncpA) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obA, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpA, base + cnt); }
        s2_echo1_tail(req, srv, 200, obA, ncA[0], code);
        return;
    } else if mode == 5 {
        let obufB = [0u8; 1024];
        let obB: ptr = PTR_BYTE_ADD(&obufB, 0);
        let ncB = [0u64; 4];
        let ncpB: ptr = PTR_BYTE_ADD(&ncB, 0);
        PTR_WRITE_U64(ncpB, 0);
        let hpB = [0u64; 4];
        let hlB = [0u64; 4];
        let grcB = sla_http_server_req_get_header(req, STR_PTR("X-Req"), STR_LEN("X-Req"), &hpB[0], &hlB[0]);
        let spB: ptr = STR_PTR("none");
        let slB: u64 = 4;
        if grcB == 0 { spB = (hpB[0] as ptr); slB = hlB[0]; };
        { let srcp: ptr = spB; let cnt: u64 = slB; let base: u64 = (PTR_READ_U64(ncpB) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obB, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpB, base + cnt); }
        s2_echo1_tail(req, srv, 200, obB, ncB[0], code);
        return;
    };
    // mode 3 (tail): fixed range body
    let obufT = [0u8; 1024];
        let obT: ptr = PTR_BYTE_ADD(&obufT, 0);
        let ncT = [0u64; 4];
        let ncpT: ptr = PTR_BYTE_ADD(&ncT, 0);
        PTR_WRITE_U64(ncpT, 0);
    { let srcp: ptr = STR_PTR("0123456789ABCDEF"); let cnt: u64 = STR_LEN("0123456789ABCDEF"); let base: u64 = (PTR_READ_U64(ncpT) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obT, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpT, base + cnt); }
    s2_echo1_tail(req, srv, 200, obT, ncT[0], code);
}

// ---------------- v2 echo server (goroutine) ----------------
// mode 0: body = target + "|" + request body
// mode 1: fixed body + header X-Echo: wave2
// mode 8: sleep 800ms, then fixed body "slow-body"
fn s2_echo2_tail(req: ptr, srv: ptr, ob: ptr, n: u64, code: i32, with_hdr: bool, assert_send: bool) -> void {
    let rp = [0u64; 4];
    if sla_http_server_resp_new_v2(req, 200, &rp[0]) != 0 { panic(code + 5); };
    let resp = (rp[0] as ptr);
    let hrc: i32 = 0;
    if with_hdr { hrc = sla_http_server_resp_add_header_v2(resp, STR_PTR("X-Echo"), STR_LEN("X-Echo"), STR_PTR("wave2"), STR_LEN("wave2")); };
    if hrc != 0 { panic(code + 6); };
    let send_rc = sla_http_server_resp_send_v2(resp, ob, n, 5000);
    let bad_send: bool = assert_send && (send_rc != 0);
    if bad_send { panic(code + 7); };
    sla_http_server_resp_free_v2(resp);
    sla_http_server_req_free_v2(req);
    sla_http_server_free_v2(srv);
}

fn s2_echo2(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let mode: u64 = (arg >> 16) & 255;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new_v2(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    let arc = sla_http_server_accept_v2(srv, 30000, &aq[0]);
    let tolerate: bool = (arc != 0) && (mode == 8);
    if tolerate { sla_http_server_free_v2(srv); return; };
    if arc != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    if mode == 1 {
        let obufA = [0u8; 1024];
        let obA: ptr = PTR_BYTE_ADD(&obufA, 0);
        let ncA = [0u64; 4];
        let ncpA: ptr = PTR_BYTE_ADD(&ncA, 0);
        PTR_WRITE_U64(ncpA, 0);
        { let srcp: ptr = STR_PTR("client-body-1"); let cnt: u64 = STR_LEN("client-body-1"); let base: u64 = (PTR_READ_U64(ncpA) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obA, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpA, base + cnt); }
        s2_echo2_tail(req, srv, obA, ncA[0], code, true, true);
        return;
    };
    if mode == 8 {
        sla_time_sleep_ms(800);
        let obufB = [0u8; 1024];
        let obB: ptr = PTR_BYTE_ADD(&obufB, 0);
        let ncB = [0u64; 4];
        let ncpB: ptr = PTR_BYTE_ADD(&ncB, 0);
        PTR_WRITE_U64(ncpB, 0);
        { let srcp: ptr = STR_PTR("slow-body"); let cnt: u64 = STR_LEN("slow-body"); let base: u64 = (PTR_READ_U64(ncpB) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(obB, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncpB, base + cnt); }
        s2_echo2_tail(req, srv, obB, ncB[0], code, false, false);
        return;
    };
    let outb = [0u8; 1024];
    let ob: ptr = PTR_BYTE_ADD(&outb, 0);
    let nc = [0u64; 4];
    let ncp: ptr = PTR_BYTE_ADD(&nc, 0);
    PTR_WRITE_U64(ncp, 0);
    let tp = [0u64; 4];
    let tl = [0u64; 4];
    if sla_http_server_req_get_target_v2(req, &tp[0], &tl[0]) != 0 { panic(code + 3); };
    { let srcp: ptr = (tp[0] as ptr); let cnt: u64 = tl[0]; let base: u64 = (PTR_READ_U64(ncp) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(ob, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncp, base + cnt); }
    { let srcp: ptr = STR_PTR("|"); let cnt: u64 = 1; let base: u64 = (PTR_READ_U64(ncp) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(ob, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncp, base + cnt); }
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_req_get_body(req, &dp[0], &dl[0]) != 0 { panic(code + 4); };
    { let srcp: ptr = (dp[0] as ptr); let cnt: u64 = dl[0]; let base: u64 = (PTR_READ_U64(ncp) as u64); let i: u64 = 0; while i < cnt { let s: ptr = PTR_BYTE_ADD(srcp, i); let d: ptr = PTR_BYTE_ADD(ob, base + i); PTR_WRITE_U8(d, PTR_READ_U8(s)); i = i + 1; } PTR_WRITE_U64(ncp, base + cnt); }
    s2_echo2_tail(req, srv, ob, nc[0], code, false, true);
}


// Shared response-body assertion helper: body bytes equal the literal.
fn s2_body_eq(resp: ptr, lit: ptr, lit_len: u64) -> bool {
    let bp = [0u64; 4];
    let bl = [0u64; 4];
    if sla_http_client_resp_body_slice(resp, &bp[0], &bl[0]) != 0 { return false; };
    return s2_mem_eq((bp[0] as ptr), bl[0], lit, lit_len);
}

fn s2_body_contains(resp: ptr, lit: ptr, lit_len: u64) -> bool {
    let bp = [0u64; 4];
    let bl = [0u64; 4];
    if sla_http_client_resp_body_slice(resp, &bp[0], &bl[0]) != 0 { return false; };
    return s2_contains((bp[0] as ptr), bl[0], lit, lit_len);
}

// ---------------- non-v2 client tests ----------------

@test "smoke2 sa_http_client_req_new"() {
    let h = go s2_echo1a(24600 + 0 * 65536 + 65000 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24600, STR_PTR("/echo"), STR_LEN("/echo"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65003); };
    let rq = [0u64; 4];
    if sla_http_client_req_new((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65004); };
    if rq[0] == 0 { panic(65005); };
    let rs = [0u64; 4];
    if sla_http_client_req_send((rq[0] as ptr), &rs[0]) != 0 { panic(65006); };
    let resp = (rs[0] as ptr);
    if !s2_body_contains(resp, STR_PTR("/echo"), STR_LEN("/echo")) { panic(65007); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free((rq[0] as ptr));
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

@test "smoke2 sa_http_client_req_new_joined"() {
    let h = go s2_echo1a(24601 + 0 * 65536 + 65020 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24601, STR_PTR("/base/"), STR_LEN("/base/"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65023); };
    let rq = [0u64; 4];
    if sla_http_client_req_new_joined((cl[0] as ptr), 1, ubp, ulen, STR_PTR("leaf"), STR_LEN("leaf"), 1, &rq[0]) != 0 { panic(65024); };
    let rs = [0u64; 4];
    if sla_http_client_req_send((rq[0] as ptr), &rs[0]) != 0 { panic(65025); };
    let resp = (rs[0] as ptr);
    if !s2_body_contains(resp, STR_PTR("/base/leaf"), STR_LEN("/base/leaf")) { panic(65026); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free((rq[0] as ptr));
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

@test "smoke2 sa_http_client_req_add_header"() {
    let h = go s2_echo1b(24602 + 5 * 65536 + 65040 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24602, STR_PTR("/hdr"), STR_LEN("/hdr"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65043); };
    let rq = [0u64; 4];
    if sla_http_client_req_new((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65044); };
    let req = (rq[0] as ptr);
    if sla_http_client_req_add_header(req, STR_PTR("X-Req"), STR_LEN("X-Req"), STR_PTR("hello-hdr"), STR_LEN("hello-hdr")) != 0 { panic(65045); };
    let rs = [0u64; 4];
    if sla_http_client_req_send(req, &rs[0]) != 0 { panic(65046); };
    let resp = (rs[0] as ptr);
    if !s2_body_eq(resp, STR_PTR("hello-hdr"), STR_LEN("hello-hdr")) { panic(65047); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

@test "smoke2 sa_http_client_req_add_openai_auth"() {
    let h = go s2_echo1b(24603 + 4 * 65536 + 65060 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24603, STR_PTR("/auth"), STR_LEN("/auth"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65063); };
    let rq = [0u64; 4];
