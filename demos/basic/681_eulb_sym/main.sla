@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 对称性：B(4,1)=B(4,3)=76，B(5,1)=B(5,4)=237（镜像双算一致）。
// 意对标 676_eulb（单格版互补；行列镜像互锁，619 体例）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{},{}", eub(4, 1), eub(4, 3), eub(5, 1), eub(5, 4));
    return 0;
}

@test "basic 681 eulb sym"() {
    if eub(4, 1) != 76 { panic(68101); };
    if eub(4, 3) != 76 { panic(68102); };
    if eub(5, 1) != 237 { panic(68103); };
    if eub(5, 4) != 237 { panic(68104); };
}
