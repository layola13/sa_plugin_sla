@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类续高位二对峙：建表 vs 递归（(9,4)：67284 对 67284；(9,5)：22449 对 22449）。
// 意对标 816_stir19 × 819_duel_stir19（内格源与对峙体例合流）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rcs(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rcs(n - 1, k - 1) + (n - 1) * rcs(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", cst(9, 4), rcs(9, 4), cst(9, 5), rcs(9, 5));
    return 0;
}

@test "basic 820 duel stir194"() {
    if cst(9, 4) != 67284 { panic(82001); };
    if rcs(9, 4) != 67284 { panic(82002); };
    if cst(9, 5) != 22449 { panic(82003); };
    if rcs(9, 5) != 22449 { panic(82004); };
}
