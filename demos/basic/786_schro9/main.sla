@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 续高位 S(9)=206098（S(8)=41586 对 41586；卷积和 164512）。
// 意对标 773_schro78（S(7/8) 版互补；789 做迭代/商式对峙）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", sch(8), sch(9));
    return 0;
}

@test "basic 786 schro9"() {
    if sch(9) != 206098 { panic(78601); };
    if sch(8) != 41586 { panic(78602); };
    if sch(7) != 8558 { panic(78603); };
}
