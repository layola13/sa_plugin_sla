@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 9 行 1,36,336,1176,1764,1176,336,36,1（行和 4862=Catalan(9)；循环求和）。
// 意对标 846_nar9（单格版互补；同式行复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", nar(9, 4), nar(9, 5), nsum(9));
    return 0;
}

@test "basic 847 nar row9"() {
    if nar(9, 4) != 1764 { panic(84701); };
    if nar(9, 5) != 1176 { panic(84702); };
    if nsum(9) != 4862 { panic(84703); };
    if nar(8, 4) != 490 { panic(84704); };
}
