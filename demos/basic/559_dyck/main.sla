@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Dyck 路经数（网格 DP，不越过对角线）：D(n,n)=C(n)
//（D(3,3)=5，D(4,4)=14，D(5,5)=42；562 做卷积对峙）。
// 意对标 531 stirling2（同为拍扁二维表；此处为正方形网格带对角守卫）。

fn dyck(n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let a = 0;
    while a <= n {
        let b = 0;
        while b <= n {
            if a + b > 0 {
                if b <= a {
                    let up = 0;
                    if a > 0 { up = t[(a - 1) * w + b]; };
                    let lf = 0;
                    if b > 0 { lf = t[a * w + b - 1]; };
                    t[a * w + b] = up + lf;
                };
            };
            b = b + 1;
        }
        a = a + 1;
    }
    return t[n * w + n];
}

fn main() -> i32 {
    println("{},{},{}", dyck(3), dyck(4), dyck(5));
    return 0;
}

@test "basic 559 dyck"() {
    if dyck(3) != 5 { panic(55901); };
    if dyck(4) != 14 { panic(55902); };
    if dyck(5) != 42 { panic(55903); };
}
