@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 直和高位 M(9)=835，M(10)=2188（633 体例续高位；同式再上两位）。
// 意对标 633_motz_closed（低位直和版互补；755 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cmot(n: int) -> int {
    let s = 0;
    let k = 0;
    while 2 * k <= n {
        s = s + binom_mul(n, 2 * k) * binom_mul(2 * k, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", cmot(9), cmot(10));
    return 0;
}

@test "basic 754 motz alt910"() {
    if cmot(9) != 835 { panic(75401); };
    if cmot(10) != 2188 { panic(75402); };
    if cmot(8) != 323 { panic(75403); };
}
