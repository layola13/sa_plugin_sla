// DEF-E0 regression: `using` static extension on a sa_std type
// (Vec<i32>) written by a user module.
mod vec_ext {
    pub fn len_plus(v: Vec<i32>) -> i32 {
        return v.len() + 100;
    }

    pub fn is_empty_ext(v: Vec<i32>) -> bool {
        return v.len() == 0;
    }
}

using vec_ext;

@test "using ext: std vec extension"() {
    let v: Vec<i32> = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    if v.len_plus() != 103 { panic(34300); };
    let e: Vec<i32> = Vec::new();
    if e.is_empty_ext() != true { panic(34301); };
}
