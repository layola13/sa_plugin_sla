// extern FINAL batch -- thread group (6 names):
// pthread_spawn, pthread_spawn_detached, pthread_drop,
// sa_thread_as_pthread_t, sa_thread_into_pthread_t,
// sa_thread_raw_pthread_join.
// (sa_pthread_join lives in test_extern_final_thread_join.sla: the
// registry-handle join path has a historical libc-crash record, so it
// is isolated in its own file/binary.)
// Handles are opaque i32 slots owned by the sa_std runtime
// (thread.sai header); pthread_spawn returns the slot id (>0),
// pthread_spawn_detached returns an i32 status (0 = ok).
// Spawn-entry calls go through the raw externs (sa_std/thread.sai):
// an SLA fn value materializes to a callable address only at a raw
// extern ptr boundary, never through an SLA-level wrap fn's ptr
// parameter (checker TypeMismatch) -- same shape as the in-tree
// fn-pointer corpus (test_unit_fn_ptr_extern.sla). All other calls
// go through the generated wraps. Assertions are behavioral: every
// spawned worker bumps a distinct global counter exactly once, and
// a raw pthread join must observe the counter already at 1.
@import "sla_std/wrap/thread.sla"
@import "sa_std/thread.sai"
@import "sa_std/globals.sai"
@import "sa_std/string.sa"
@import "sa_std/time.sai"

fn fin_th_cell(name: ptr, name_len: u64) -> u64 {
    let v: u64 = 0;
    let rc: i32 = sa_global_u64_get(name, name_len, &v);
    if rc != 0 { return 0; };
    return v;
}

fn fin_th_wait(name: ptr, name_len: u64, want: u64) -> bool {
    let i: i32 = 0;
    while i < 400 {
        if fin_th_cell(name, name_len) == want { return true; };
        if sa_time_sleep_ms(5) != 0 { return false; };
        i = i + 1;
    }
    return fin_th_cell(name, name_len) == want;
}

fn fin_th_worker_a(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fin.th.a"), STR_LEN("fin.th.a"), 1, &out);
}

fn fin_th_worker_b(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fin.th.b"), STR_LEN("fin.th.b"), 1, &out);
}

fn fin_th_worker_c(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fin.th.c"), STR_LEN("fin.th.c"), 1, &out);
}

fn fin_th_worker_d(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fin.th.d"), STR_LEN("fin.th.d"), 1, &out);
}

@test "extern final pthread_spawn as_pthread_t raw_pthread_join"() {
    let h: i32 = pthread_spawn(fin_th_worker_a, 0);
    if h <= 0 { panic(950101); };
    let raw: u64 = 0;
    let rc: i32 = sla_thread_as_pthread_t(h, &raw);
    if rc != 0 { panic(950102); };
    if raw == 0 { panic(950103); };
    // as_ is the non-consuming (borrow) conversion: a second call
    // must yield the same raw value for the same handle.
    let raw2: u64 = 0;
    if sla_thread_as_pthread_t(h, &raw2) != 0 { panic(950104); };
    if raw2 != raw { panic(950105); };
    // NOTE: this raw value is NOT accepted by
    // sa_thread_raw_pthread_join (deterministic invalid-handle on
    // both backends -- the raw-owner table is only fed by the
    // into_ transfer). That composition gap is registered as a
    // defect candidate in the batch RESULT; here the thread is
    // completed through the registry join instead.
    let oc = [0u8; 8];
    if sa_pthread_join(h, &oc[0]) != 0 { panic(950106); };
    if fin_th_cell(STR_PTR("fin.th.a"), STR_LEN("fin.th.a")) != 1 { panic(950107); };
}

@test "extern final pthread_spawn into_pthread_t raw_pthread_join"() {
    let h: i32 = pthread_spawn(fin_th_worker_b, 0);
    if h <= 0 { panic(950111); };
    let raw: u64 = 0;
    let rc: i32 = sla_thread_into_pthread_t(h, &raw);
    if rc != 0 { panic(950112); };
    if raw == 0 { panic(950113); };
    let oc = [0u8; 8];
    let rc2: i32 = sa_thread_raw_pthread_join(raw, &oc[0]);
    if rc2 != 0 { panic(950114); };
    if fin_th_cell(STR_PTR("fin.th.b"), STR_LEN("fin.th.b")) != 1 { panic(950115); };
}

@test "extern final pthread_spawn_detached"() {
    let rc: i32 = pthread_spawn_detached(fin_th_worker_c, 0);
    if rc != 0 { panic(950121); };
    if fin_th_wait(STR_PTR("fin.th.c"), STR_LEN("fin.th.c"), 1) != true { panic(950122); };
}

@test "extern final pthread_drop"() {
    let h: i32 = pthread_spawn(fin_th_worker_d, 0);
    if h <= 0 { panic(950131); };
    sla_wrap_pthread_drop(h);
    // Dropping the registry handle must not kill the thread: it runs
    // to completion detached.
    if fin_th_wait(STR_PTR("fin.th.d"), STR_LEN("fin.th.d"), 1) != true { panic(950132); };
}
