@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类续高位建表 c(n,k)=c(n-1,k-1)+(n-1)c(n-1,k)（上三角守卫，646 范式）。
// c(7,2)=1764，c(7,3)=1624，c(7,4)=735（689 做建表/递归对峙）。
// 意对标 576_stir1（低位建表版互补；此处为 n=7 高位行）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(7, 2), cst(7, 3), cst(7, 4));
    return 0;
}

@test "basic 686 stir17"() {
    if cst(7, 2) != 1764 { panic(68601); };
    if cst(7, 3) != 1624 { panic(68602); };
    if cst(7, 4) != 735 { panic(68603); };
    if cst(6, 2) != 274 { panic(68604); };
}
