@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 续高位三 E(9,1)=502，E(9,2)=14608，E(9,3)=88234（同式再上一行）。
// 意对标 798_eul8（n=8 版互补；918 做建表/交错对峙）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{}", eul(9, 1), eul(9, 2), eul(9, 3));
    return 0;
}

@test "basic 916 eul9"() {
    if eul(9, 1) != 502 { panic(91601); };
    if eul(9, 2) != 14608 { panic(91602); };
    if eul(9, 3) != 88234 { panic(91603); };
    if eul(8, 2) != 4293 { panic(91604); };
}
