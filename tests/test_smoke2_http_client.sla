@test "smoke2 sa_http_client_resp_read_chunk"() {
    let h = go s2_echo1b(24616 + 3 * 65536 + 65320 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24616, STR_PTR("/rc"), STR_LEN("/rc"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65323); };
    let rq = [0u64; 4];
    if sla_http_client_req_new((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65324); };
    let rs = [0u64; 4];
    if sla_http_client_req_send((rq[0] as ptr), &rs[0]) != 0 { panic(65325); };
    let resp = (rs[0] as ptr);
    let rd = [0u64; 4];
    if sla_http_client_resp_body_reader(resp, &rd[0]) != 0 { panic(65326); };
    let reader = (rd[0] as ptr);
    let acc = [0u8; 64];
    let ap: ptr = PTR_BYTE_ADD(&acc, 0);
    let chunk = [0u8; 8];
    let total: u64 = 0;
    let guard: u64 = 0;
    while guard < 10 {
        let ol = [0u64; 4];
        if sla_http_client_resp_read_chunk(reader, &chunk[0], 5, &ol[0]) != 0 { panic(65327); };
        if ol[0] == 0 { break; };
        let cp: ptr = PTR_BYTE_ADD(&chunk, 0);
        let i: u64 = 0;
        while i < ol[0] {
            let s: ptr = PTR_BYTE_ADD(cp, i);
            let d: ptr = PTR_BYTE_ADD(ap, total + i);
            PTR_WRITE_U8(d, PTR_READ_U8(s));
            i = i + 1;
        }
        total = total + ol[0];
        guard = guard + 1;
    }
    if total != 16 { panic(65328); };
    if !s2_mem_eq(ap, 16, STR_PTR("0123456789ABCDEF"), STR_LEN("0123456789ABCDEF")) { panic(65329); };
    sla_http_client_body_reader_free(reader);
    sla_http_client_resp_free(resp);
    sla_http_client_req_free((rq[0] as ptr));
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

