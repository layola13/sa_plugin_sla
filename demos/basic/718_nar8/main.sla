@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 8 行高位 N(8,1)=28，N(8,2)=196，N(8,3)=490（同式再上一位）。
// 意对标 716_nar7（n=7 版互补；720 做高位对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(8, 1), nar(8, 2), nar(8, 3));
    return 0;
}

@test "basic 718 nar8"() {
    if nar(8, 1) != 28 { panic(71801); };
    if nar(8, 2) != 196 { panic(71802); };
    if nar(8, 3) != 490 { panic(71803); };
    if nar(8, 4) != 490 { panic(71804); };
}
