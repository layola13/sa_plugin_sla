// F2-A C1 corpus: a field whose type has no declaration in
// scope is unverifiable; the closed-world criterion rejects it.
struct MysteryWrap { m: Mystery }

fn id_mystery_wrap(w: MysteryWrap) -> MysteryWrap { return w; }

fn neg_unverifiable(p: MysteryWrap) -> i32 {
    arena {
        let w = id_mystery_wrap(p);
    }
    return 0;
}
