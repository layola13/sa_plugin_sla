// DEF-E0 regression: `using` static extension on a primitive receiver
// (i32), including chained extension calls. Before the fix every
// extension call failed with "Undefined call" because the resolver was
// only reachable through the channel-method receiver probe.
mod score_math {
    pub fn add_bonus(value: i32, bonus: i32) -> i32 {
        return value + bonus;
    }

    pub fn double(value: i32) -> i32 {
        return value + value;
    }
}

using score_math;

@test "using ext: primitive extension chains"() {
    let base: i32 = 10;
    let score = base.add_bonus(5).double();
    if score != 30 { panic(34000); };
}
