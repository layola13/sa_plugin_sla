@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 区间素数计数（<=50 有 15 个）。
// 意对标 358 求和版的计数版（357 单值版互补）。

fn is_prime(n: int) -> int {
    if n < 2 { return 0; };
    if n == 2 { return 1; };
    if n % 2 == 0 { return 0; };
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return 0; };
        d = d + 2;
    }
    return 1;
}

fn prime_count(limit: int) -> int {
    let c = 0;
    let k = 2;
    while k <= limit {
        if is_prime(k) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", prime_count(50), prime_count(30), prime_count(10));
    return 0;
}

@test "basic 373 prime count"() {
    if prime_count(50) != 15 { panic(37301); };
    if prime_count(30) != 10 { panic(37302); };
    if prime_count(10) != 4 { panic(37303); };
}
