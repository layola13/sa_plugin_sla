// E1 extern carrier batch #1 -- tree_sitter node group (14 names):
// sa_ts_node_type, sa_ts_node_text, sa_ts_node_byte_range,
// sa_ts_node_child_count, sa_ts_node_named_child_count, sa_ts_node_child,
// sa_ts_node_child_by_field, sa_ts_node_parent, sa_ts_node_is_named,
// sa_ts_node_is_missing, sa_ts_node_has_error, sa_ts_node_start_point,
// sa_ts_node_end_point, sa_ts_node_free.
// Substantive assertions over the generated thin wraps (sla_ts_*).
// Requires SA_TREE_SITTER_DIR=<sci>/artifacts/tree_sitter; every test
// panics loudly when the core library is unavailable (no silent pass).
// Grammar facts (typescript v0.23.2) for "let x = 1;":
//   program -> [lexical_declaration]; decl children: "let",
//   variable_declarator, ";"; declarator children: identifier, "=", number;
//   ranges: decl (0,10), declarator (4,9), identifier (4,5).
@import "sla_std/wrap/tree_sitter.sla"
@import "sa_std/string.sa"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

fn ts_buf_starts(buf: ptr, lit: ptr, lit_len: u64) -> u32 {
    let i: u64 = 0;
    while i < lit_len {
        let a = SLA_BYTE_AT(buf, i);
        let b = SLA_BYTE_AT(lit, i);
        if a != b { return 0; };
        i = i + 1;
    }
    return 1;
}

fn ts_buf_eq(buf: ptr, buf_len: u64, lit: ptr, lit_len: u64) -> u32 {
    if buf_len != lit_len { return 0; };
    return ts_buf_starts(buf, lit, lit_len);
}

@test "extern ts sa_ts_node_type"() {
    if sla_ts_available() != 1 { panic(93201); };
    let parser: u64 = 0;
    if sla_ts_parser_new(&parser) != 0 { panic(93202); };
    if sla_ts_parser_set_language(parser, STR_PTR("typescript"), STR_LEN("typescript")) != 0 { panic(93203); };
    let tree: u64 = 0;
    if sla_ts_parse(parser, STR_PTR("let x = 1;"), STR_LEN("let x = 1;"), &tree) != 0 { panic(93204); };
    let root: u64 = 0;
    if sla_ts_tree_root(tree, &root) != 0 { panic(93205); };
    let buf = [0u8; 64];
    let bp: ptr = SLA_PTR_ADD(&buf[0], 0);
    let tlen: u64 = 0;
    if sla_ts_node_type(root, &buf[0], 64, &tlen) != 0 { panic(93206); };
    if ts_buf_eq(bp, tlen, STR_PTR("program"), STR_LEN("program")) != 1 { panic(93207); };
    let decl: u64 = 0;
    if sla_ts_node_child(root, 0, 1, &decl) != 0 { panic(93208); };
    if sla_ts_node_type(decl, &buf[0], 64, &tlen) != 0 { panic(93209); };
    if ts_buf_eq(bp, tlen, STR_PTR("lexical_declaration"), STR_LEN("lexical_declaration")) != 1 { panic(93210); };
    sla_ts_node_free(^decl);
    sla_ts_node_free(^root);
    sla_ts_tree_free(^tree);
    sla_ts_parser_free(^parser);
}

