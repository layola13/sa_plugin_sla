@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 续高位三 D(8,2)=145，D(8,3)=833，D(8,4)=3649（同式再上一行）。
// 意对标 756_delan7（n=7 版互补；889 做建表/直和对峙）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{},{}", delan(8, 2), delan(8, 3), delan(8, 4));
    return 0;
}

@test "basic 886 delan8"() {
    if delan(8, 2) != 145 { panic(88601); };
    if delan(8, 3) != 833 { panic(88602); };
    if delan(8, 4) != 3649 { panic(88603); };
    if delan(7, 3) != 575 { panic(88604); };
}
