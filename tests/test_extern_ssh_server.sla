// SSH extern carrier batch -- server group (13 names):
// sa_std_ssh_server_listen, sa_std_ssh_server_bind_close,
// sa_std_ssh_server_accept, sa_std_ssh_server_auth_next,
// sa_std_ssh_server_auth_accept, sa_std_ssh_server_auth_deny,
// sa_std_ssh_server_channel_accept, sa_std_ssh_server_channel_exec,
// sa_std_ssh_channel_write, sa_std_ssh_channel_read,
// sa_std_ssh_channel_send_exit, sa_std_ssh_channel_close,
// sa_std_ssh_server_session_close.
// Loopback rounds against the sa server itself (host key
// /tmp/sshtest/sa_hostkey, generated by the gate script): the server
// runs in a thread::spawn thread and returns a stage code (0 = every
// in-thread assertion held; negative = failing stage), while the main
// thread drives the sa client (password rounds) or the system ssh
// client via the process surface (stdin round). Every server-thread
// error path closes the session (and channel when open) before
// returning, so a failed assertion disconnects the peer instead of
// deadlocking the round.
// Pointer handles are not registry-validated by the impl, so only
// null-handle (2) edges are exercised for close/accept, never bogus
// or double closes.
// KNOWN GAP (see RESULT.md): the auth_next publickey kind (2) cannot
// be exercised against the real OpenSSH client on this assembly --
// probe_ssh_pubkey{,2}.sla + the client's DEBUG3 trace show the
// offered public key is default-rejected inside auth_next (legacy
// key extraction path) and the client falls back to an empty
// password attempt; the stdin round below therefore authenticates
// the system client by password (kind 1) instead. The password kind
// of auth_next is exercised by all three rounds.
@import "sla_std/wrap/ssh.sla"
@import "sla_std/wrap/time.sla"
@import "sla_std/wrap/process.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

fn ssh_buf_eq(h: u64, lit: ptr, litn: u64) -> u32 {
    let n: u64 = sla_std_ssh_buffer_len(h);
    if n != litn { return 0; };
    let sb = SshBuffer { raw: h };
    let v = sla_std_ssh_buffer_data(&sb);
    if v.len() != litn { return 0; };
    let i: u64 = 0;
    while i < litn {
        let b = SLA_BYTE_AT(lit, i);
        if v[i] != b { return 0; };
        i = i + 1;
    }
    return 1;
}

fn ssh_raw_eq(p: ptr, n: u64, lit: ptr, litn: u64) -> u32 {
    if n != litn { return 0; };
    let i: u64 = 0;
    while i < n {
        let a = SLA_BYTE_AT(p, i);
        let b = SLA_BYTE_AT(lit, i);
        if a != b { return 0; };
        i = i + 1;
    }
    return 1;
}

fn ssh_listen(port: u32) -> u64 {
    let bh: u64 = 0;
    let rc: i32 = sla_std_ssh_server_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), port, STR_PTR("/tmp/sshtest/sa_hostkey"), STR_LEN("/tmp/sshtest/sa_hostkey"), &bh);
    if rc != 0 { panic(98001); };
    if bh == 0 { panic(98002); };
    return bh;
}

fn ssh_bind_close(bh: u64) {
    let bp: ptr = bh as ptr;
    if sla_std_ssh_server_bind_close(^bp) != 0 { panic(98003); };
}

fn srv_fail(sp: ptr, code: i32) -> i32 {
    let rc: i32 = sla_std_ssh_server_session_close(^sp);
    if rc != 0 { return -900 - code; };
    return code;
}

fn srv_fail_ch(sp: ptr, chp: ptr, code: i32) -> i32 {
    let rc1: i32 = sla_std_ssh_channel_close(^chp);
    let rc2: i32 = sla_std_ssh_server_session_close(^sp);
    if rc1 != 0 { return -800 - code; };
    if rc2 != 0 { return -900 - code; };
    return code;
}

// Server thread: one password-auth exec round. deny_first=1 expects a
// first attempt with password "wrongpw" (denied), then "s3cret".
// Stage codes: -1 accept, -2/-8 auth_next, -3/-9 kind, -4/-10 user,
// -5 wrong secret (deny round), -11 secret, -12 buffer free,
// -13 auth_accept, -7 auth_deny, -14 channel_accept, -15/-16/-17
// channel_exec, -18 cmd free, -19/-20 channel_write, -22 send_exit,
// -23 channel_close, -24 server_session_close.
fn ssh_srv_password(bind_h: u64, deny_first: u64) -> i32 {
    let ss: u64 = 0;
    if sla_std_ssh_server_accept((bind_h as ptr), &ss) != 0 { return -1; };
    let sp: ptr = ss as ptr;
    let kind: u64 = 0;
    let uh: u64 = 0;
    let sh: u64 = 0;
    let st: u64 = 0;
    if sla_std_ssh_server_auth_next(sp, &kind, &uh, &sh, &st) != 0 { return srv_fail(sp, -2); };
    if kind != 1 { return srv_fail(sp, -3); };
    if ssh_buf_eq(uh, STR_PTR("alice"), STR_LEN("alice")) != 1 { return srv_fail(sp, -4); };
    if deny_first == 1 {
        if ssh_buf_eq(sh, STR_PTR("wrongpw"), STR_LEN("wrongpw")) != 1 { return srv_fail(sp, -5); };
        if sla_std_ssh_buffer_free(^uh) != 0 { return srv_fail(sp, -12); };
        if sla_std_ssh_buffer_free(^sh) != 0 { return srv_fail(sp, -12); };
        if sla_std_ssh_server_auth_deny(sp) != 0 { return srv_fail(sp, -7); };
        let kind2: u64 = 0;
        let uh2: u64 = 0;
        let sh2: u64 = 0;
        let st2: u64 = 0;
        if sla_std_ssh_server_auth_next(sp, &kind2, &uh2, &sh2, &st2) != 0 { return srv_fail(sp, -8); };
        if kind2 != 1 { return srv_fail(sp, -9); };
        if ssh_buf_eq(uh2, STR_PTR("alice"), STR_LEN("alice")) != 1 { return srv_fail(sp, -10); };
        if ssh_buf_eq(sh2, STR_PTR("s3cret"), STR_LEN("s3cret")) != 1 { return srv_fail(sp, -11); };
        if sla_std_ssh_buffer_free(^uh2) != 0 { return srv_fail(sp, -12); };
        if sla_std_ssh_buffer_free(^sh2) != 0 { return srv_fail(sp, -12); };
    } else {
        if ssh_buf_eq(sh, STR_PTR("s3cret"), STR_LEN("s3cret")) != 1 { return srv_fail(sp, -11); };
        if sla_std_ssh_buffer_free(^uh) != 0 { return srv_fail(sp, -12); };
        if sla_std_ssh_buffer_free(^sh) != 0 { return srv_fail(sp, -12); };
    };
    if sla_std_ssh_server_auth_accept(sp) != 0 { return srv_fail(sp, -13); };
    let ch: u64 = 0;
    if sla_std_ssh_server_channel_accept(sp, &ch) != 0 { return srv_fail(sp, -14); };
    let chp: ptr = ch as ptr;
    let ck: u64 = 0;
    let cmdh: u64 = 0;
    if sla_std_ssh_server_channel_exec(sp, &ck, &cmdh) != 0 { return srv_fail_ch(sp, chp, -15); };
    if ck != 1 { return srv_fail_ch(sp, chp, -16); };
    if ssh_buf_eq(cmdh, STR_PTR("ping"), STR_LEN("ping")) != 1 { return srv_fail_ch(sp, chp, -17); };
    if sla_std_ssh_buffer_free(^cmdh) != 0 { return srv_fail_ch(sp, chp, -18); };
    let wr: u64 = 0;
    if sla_std_ssh_channel_write(chp, 0, STR_PTR("pong:ping"), STR_LEN("pong:ping"), &wr) != 0 { return srv_fail_ch(sp, chp, -19); };
    if wr != 9 { return srv_fail_ch(sp, chp, -20); };
    let _slp: i32 = sla_time_sleep_ms(150);
    if sla_std_ssh_channel_send_exit(chp, 3) != 0 { return srv_fail_ch(sp, chp, -22); };
    if sla_std_ssh_channel_close(^chp) != 0 { return srv_fail(sp, -23); };
    if sla_std_ssh_server_session_close(^sp) != 0 { return -24; };
    return 0;
}

// Server thread: password auth (user "carol" / "s3cret") from the
// system ssh client, exec "cat", echo the client's stdin back.
// Stage codes: -131 accept, -133 auth_next, -134 kind, -135 user,
// -136 secret, -137 buffer free, -138 auth_accept, -139
// channel_accept, -140/-141/-142 channel_exec, -143 cmd free,
// -144 read rounds, -145 channel_read, -146 overlong stdin,
// -147 stdin length, -148 stdin bytes, -149/-150 channel_write,
// -151 send_exit, -152 channel_close, -153 session close.
fn ssh_srv_pw_read(bind_h: u64) -> i32 {
    let ss: u64 = 0;
    if sla_std_ssh_server_accept((bind_h as ptr), &ss) != 0 { return -131; };
    let sp: ptr = ss as ptr;
    let kind: u64 = 0;
    let uh: u64 = 0;
    let sh: u64 = 0;
    let st: u64 = 0;
    if sla_std_ssh_server_auth_next(sp, &kind, &uh, &sh, &st) != 0 { return srv_fail(sp, -133); };
    if kind != 1 { return srv_fail(sp, -134); };
    if ssh_buf_eq(uh, STR_PTR("carol"), STR_LEN("carol")) != 1 { return srv_fail(sp, -135); };
    if ssh_buf_eq(sh, STR_PTR("s3cret"), STR_LEN("s3cret")) != 1 { return srv_fail(sp, -136); };
    if sla_std_ssh_buffer_free(^uh) != 0 { return srv_fail(sp, -137); };
    if sla_std_ssh_buffer_free(^sh) != 0 { return srv_fail(sp, -137); };
    if sla_std_ssh_server_auth_accept(sp) != 0 { return srv_fail(sp, -138); };
    let ch: u64 = 0;
    if sla_std_ssh_server_channel_accept(sp, &ch) != 0 { return srv_fail(sp, -139); };
    let chp: ptr = ch as ptr;
    let ck: u64 = 0;
    let cmdh: u64 = 0;
    if sla_std_ssh_server_channel_exec(sp, &ck, &cmdh) != 0 { return srv_fail_ch(sp, chp, -140); };
    if ck != 1 { return srv_fail_ch(sp, chp, -141); };
    if ssh_buf_eq(cmdh, STR_PTR("cat"), STR_LEN("cat")) != 1 { return srv_fail_ch(sp, chp, -142); };
    if sla_std_ssh_buffer_free(^cmdh) != 0 { return srv_fail_ch(sp, chp, -143); };
    let rbuf = [0u8; 64];
    let rp: ptr = SLA_PTR_ADD(&rbuf[0], 0);
    let tbuf = [0u8; 64];
    let tp: ptr = SLA_PTR_ADD(&tbuf[0], 0);
    let total: u64 = 0;
    let reads: u64 = 0;
    let eof: u64 = 0;
    while eof == 0 {
        if reads >= 8 { return srv_fail_ch(sp, chp, -144); };
        reads = reads + 1;
        let n: u64 = 0;
        if sla_std_ssh_channel_read(chp, 0, &tbuf[0], 64, &n) != 0 { return srv_fail_ch(sp, chp, -145); };
        if n == 0 { eof = 1; };
        let j: u64 = 0;
        while j < n {
            let b = SLA_BYTE_AT(tp, j);
            let off: u64 = total + j;
            SLA_BYTE_PUT(rp, off, b);
            j = j + 1;
        }
        total = total + n;
        if total > 13 { return srv_fail_ch(sp, chp, -146); };
    }
    if total != 13 { return srv_fail_ch(sp, chp, -147); };
    if ssh_raw_eq(rp, total, STR_PTR("stdin-data-42"), STR_LEN("stdin-data-42")) != 1 { return srv_fail_ch(sp, chp, -148); };
    let wr: u64 = 0;
    if sla_std_ssh_channel_write(chp, 0, rp, total, &wr) != 0 { return srv_fail_ch(sp, chp, -149); };
    if wr != 13 { return srv_fail_ch(sp, chp, -150); };
    let _slp: i32 = sla_time_sleep_ms(150);
    if sla_std_ssh_channel_send_exit(chp, 0) != 0 { return srv_fail_ch(sp, chp, -151); };
    if sla_std_ssh_channel_close(^chp) != 0 { return srv_fail(sp, -152); };
    if sla_std_ssh_server_session_close(^sp) != 0 { return -153; };
    return 0;
}

fn ssh_client_connect(port: u32, code_base: i32) -> u64 {
    let s: u64 = 0;
    if sla_std_ssh_client_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), port, &s) != 0 { panic(code_base); };
    if s == 0 { panic(code_base + 1); };
    return s;
}

@test "extern ssh sa_std_ssh_server_listen"() {
    let bh: u64 = ssh_listen(55528);
    ssh_bind_close(bh);
    // Missing host key file: listen fails loudly, no bind issued.
    let bad: u64 = 0;
    let brc: i32 = sla_std_ssh_server_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 55530, STR_PTR("/tmp/sshtest/nope"), STR_LEN("/tmp/sshtest/nope"), &bad);
    if brc == 0 { panic(98101); };
    if bad != 0 { panic(98102); };
}

@test "extern ssh sa_std_ssh_server_bind_close"() {
    let bh: u64 = ssh_listen(55529);
    let bp: ptr = bh as ptr;
    if sla_std_ssh_server_bind_close(^bp) != 0 { panic(98201); };
    // Null bind: bad handle (2) for close and for accept alike.
    let z: u64 = 0;
    let zp: ptr = z as ptr;
    if sla_std_ssh_server_bind_close(^zp) != 2 { panic(98202); };
    let scell: u64 = 0;
    let z2: u64 = 0;
    let zp2: ptr = z2 as ptr;
    if sla_std_ssh_server_accept(zp2, &scell) != 2 { panic(98203); };
    if scell != 0 { panic(98204); };
}

@test "extern ssh sa_std_ssh_server_session_close"() {
    // Null session: bad handle (2). Live-session closes are exercised
    // at the end of every server round below.
    let z: u64 = 0;
    let zp: ptr = z as ptr;
    if sla_std_ssh_server_session_close(^zp) != 2 { panic(98301); };
}

@test "extern ssh server password round"() {
    let bh: u64 = ssh_listen(55524);
    let handle = thread::spawn(^|| ssh_srv_password(bh, 0));
    let s: u64 = ssh_client_connect(55524, 98401);
    let sp: ptr = s as ptr;
    if sla_std_ssh_auth_password(sp, STR_PTR("alice"), STR_LEN("alice"), STR_PTR("s3cret"), STR_LEN("s3cret")) != 0 { panic(98403); };
    let so: u64 = 0;
    let se: u64 = 0;
    let ex: u64 = 0;
    if sla_std_ssh_exec(sp, STR_PTR("ping"), STR_LEN("ping"), &so, &se, &ex) != 0 { panic(98404); };
    if ex != 3 { panic(98405); };
    if ssh_buf_eq(so, STR_PTR("pong:ping"), STR_LEN("pong:ping")) != 1 { panic(98406); };
    if sla_std_ssh_buffer_free(^so) != 0 { panic(98407); };
    if sla_std_ssh_buffer_free(^se) != 0 { panic(98408); };
    if sla_std_ssh_session_close(^sp) != 0 { panic(98409); };
    let code: i32 = handle.join().unwrap();
    if code != 0 { panic(98410); };
    ssh_bind_close(bh);
}

@test "extern ssh server auth deny round"() {
    let bh: u64 = ssh_listen(55525);
    let handle = thread::spawn(^|| ssh_srv_password(bh, 1));
    let s: u64 = ssh_client_connect(55525, 98501);
    let sp: ptr = s as ptr;
    // Wrong password: the server denies (client sees access denied 4).
    let rc1: i32 = sla_std_ssh_auth_password(sp, STR_PTR("alice"), STR_LEN("alice"), STR_PTR("wrongpw"), STR_LEN("wrongpw"));
    if rc1 != 4 { panic(98503); };
    // Correct password on the same session: accepted on the retry.
    if sla_std_ssh_auth_password(sp, STR_PTR("alice"), STR_LEN("alice"), STR_PTR("s3cret"), STR_LEN("s3cret")) != 0 { panic(98504); };
    let so: u64 = 0;
    let se: u64 = 0;
    let ex: u64 = 0;
    if sla_std_ssh_exec(sp, STR_PTR("ping"), STR_LEN("ping"), &so, &se, &ex) != 0 { panic(98505); };
    if ex != 3 { panic(98506); };
    if ssh_buf_eq(so, STR_PTR("pong:ping"), STR_LEN("pong:ping")) != 1 { panic(98507); };
    if sla_std_ssh_buffer_free(^so) != 0 { panic(98508); };
    if sla_std_ssh_buffer_free(^se) != 0 { panic(98509); };
    if sla_std_ssh_session_close(^sp) != 0 { panic(98510); };
    let code: i32 = handle.join().unwrap();
    if code != 0 { panic(98511); };
    ssh_bind_close(bh);
}

@test "extern ssh server stdin round (system client)"() {
    let bh: u64 = ssh_listen(55526);
    let handle = thread::spawn(^|| ssh_srv_pw_read(bh));
    // Drive the system ssh client with password auth (askpass helper
    // from the gate script): printf pipes "stdin-data-42" into
    // `ssh ... cat`; the server thread asserts the password attempt,
    // the exec request and the exact stdin bytes, echoes them back,
    // so the client must exit 0 and cli_out.txt must hold the echo.
    let rec = [0u64; 6];
    let x: u64 = 0;
    PTR_ADDR(x, STR_PTR("sh"));
    rec[0] = x;
    rec[1] = 2;
    let y: u64 = 0;
    PTR_ADDR(y, STR_PTR("-c"));
    rec[2] = y;
    rec[3] = 2;
    let z: u64 = 0;
    PTR_ADDR(z, STR_PTR("printf stdin-data-42 | SSH_ASKPASS=/tmp/sshtest/askpass.sh SSH_ASKPASS_REQUIRE=force ssh -o PreferredAuthentications=password -o PubkeyAuthentication=no -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p 55526 carol@127.0.0.1 cat > /tmp/sshtest/cli_out.txt 2> /tmp/sshtest/cli_err.txt"));
    rec[4] = z;
    rec[5] = STR_LEN("printf stdin-data-42 | SSH_ASKPASS=/tmp/sshtest/askpass.sh SSH_ASKPASS_REQUIRE=force ssh -o PreferredAuthentications=password -o PubkeyAuthentication=no -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p 55526 carol@127.0.0.1 cat > /tmp/sshtest/cli_out.txt 2> /tmp/sshtest/cli_err.txt");
    let cell = [0u64; 4];
    let bp: ptr = PTR_BYTE_ADD(&rec, 0);
    if sla_std_process_spawn(bp, 3, &cell[0]) != 0 { panic(98601); };
    let ph: u64 = cell[0];
    if ph == 0 { panic(98602); };
    let wout = [0u64; 4];
    if sla_std_process_wait(ph, &wout[0]) != 0 { panic(98603); };
    sla_std_process_close(ph);
    if wout[0] != 0 { panic(98604); };
    let code: i32 = handle.join().unwrap();
    if code != 0 { panic(98605); };
    ssh_bind_close(bh);
}
