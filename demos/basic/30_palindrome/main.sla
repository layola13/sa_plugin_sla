@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 103_palindrome：字符串 charCodeAt 在 SLA 侧易触字符串物化坑
//（见 POTENTIAL_ISSUES #3/#5），此处用等价的 int 数组回文锁定双指针语义。

fn is_pal(a: [int; 4]) -> i32 {
    let n = 4;
    for i in 0..2 {
        if a[i] != a[n - 1 - i] {
            return 0;
        };
    }
    return 1;
}

fn main() -> i32 {
    println("{},{}", is_pal([1, 2, 2, 1]), is_pal([1, 2, 3, 4]));
    return 0;
}

@test "basic 30 palindrome"() {
    if is_pal([1, 2, 2, 1]) != 1 { panic(3001); };
    if is_pal([1, 2, 3, 4]) != 0 { panic(3002); };
}
