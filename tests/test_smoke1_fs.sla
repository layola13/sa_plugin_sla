@test "smoke1 sa_fs_file_seek"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/seek.txt"), STR_LEN("smoke1_fs/seek.txt"), STR_PTR("0123456789"), STR_LEN("0123456789"));
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/seek.txt"), STR_LEN("smoke1_fs/seek.txt"), 1);
    if fd <= 0 { panic(51100); };
    let buf = [0u8; 64];
    let rc = sla_fs_file_seek(fd as u64, 0, 3);
    if rc != 0 { panic(51101); };
    let s1bp3: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc2 = sla_fs_file_read_exact(fd as u64, s1bp3, 2);
    if rc2 != 0 { panic(51102); };
    if buf[0] != 51 { panic(51103); };
    if buf[1] != 52 { panic(51104); };
    let rc3 = sla_fs_file_seek(fd as u64, 2, 0 - 2);
    if rc3 != 0 { panic(51105); };
    let s1bp4: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc4 = sla_fs_file_read_exact(fd as u64, s1bp4, 2);
    if rc4 != 0 { panic(51106); };
    if buf[0] != 56 { panic(51107); };
    if buf[1] != 57 { panic(51108); };
    sla_fs_file_close(fd as u64);
}

@test "smoke1 sa_fs_fchown"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/chown.txt"), STR_LEN("smoke1_fs/chown.txt"), STR_PTR("z"), STR_LEN("z"));
    // No-op form (no uid/gid asserted) must succeed on an owned file.
    let fd = sla_fs_file_open(STR_PTR("smoke1_fs/chown.txt"), STR_LEN("smoke1_fs/chown.txt"), 1);
    if fd <= 0 { panic(51110); };
    let rc = sla_fs_fchown(fd as u64, 0, 0, 0, 0);
    if rc != 0 { panic(51111); };
    sla_fs_file_close(fd as u64);
    // Same-owner uid form must also succeed.
    let uid = sla_std_process_user_id();
    let fd2 = sla_fs_file_open(STR_PTR("smoke1_fs/chown.txt"), STR_LEN("smoke1_fs/chown.txt"), 1);
    if fd2 <= 0 { panic(51112); };
    let rc2 = sla_fs_fchown(fd2 as u64, uid, 0, 1, 0);
    if rc2 != 0 { panic(51113); };
    sla_fs_file_close(fd2 as u64);
}

@test "smoke1 sa_std_fs_file_read"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/stdread.txt"), STR_LEN("smoke1_fs/stdread.txt"), STR_PTR("abcdef"), STR_LEN("abcdef"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_open_read(STR_PTR("smoke1_fs/stdread.txt"), STR_LEN("smoke1_fs/stdread.txt"), &cell[0]);
    if rc != 0 { panic(51120); };
    if cell[0] == 0 { panic(51121); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc2 = sla_std_fs_file_read(cell[0], &buf[0], 64, &rd[0]);
    if rc2 != 0 { panic(51122); };
    if rd[0] != 6 { panic(51123); };
    if buf[0] != 97 { panic(51124); };
    if buf[5] != 102 { panic(51125); };
    sla_std_close(cell[0]);
}

