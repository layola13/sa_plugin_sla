@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/future.sa"
@import "sa_std/core/waker.sa"
@import "sa_std/pin.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/box.sa"
@import "sa_std/thread.sa"
@import "sa_std/time.sla"

// Rosetta 314: await across a real Pending suspension.
// future::defer_ready(v) returns Pending on the first poll and Ready(v) on
// the second, so the async state machine below suspends at the .await and
// resumes on re-poll. Unlike demo 009 (whose block_on panics when the future
// is not immediately ready), this block_on loops with a 1ms backoff until
// the future completes.

fn unix_now_ns() -> u64 {
    let started = Instant::now();
    return started.raw_ns();
}

async fn step_value(x: i32) -> i32 {
    let v = future::defer_ready(x).await;
    return v * 2;
}

async fn run() -> i32 {
    let first = step_value(10).await;
    let second = step_value(first + 1).await;
    return second;
}

fn block_on(future: future<i32>) -> i32 {
    let data: ptr = PTR_NULL();
    let raw = RAW_WAKER_NEW(data, data);
    let waker = WAKER_FROM_RAW(raw);
    let context = CONTEXT_FROM_WAKER(waker);
    let boxed = Box::new(future);
    let future_ref = *boxed;
    let pinned = stack_alloc();
    PIN_MUT_NEW(pinned, future_ref);

    let deadline = unix_now_ns() + 2000000000;
    while unix_now_ns() < deadline {
        let poll = FUTURE_READY_POLL_STATE(PIN_MUT_GET_MUT(pinned));
        let ready = POLL_IS_READY(poll);
        if ready == true {
            let value: i32 = POLL_VALUE(poll);
            return value;
        };
        THREAD_SLEEP_MS(1);
    }
    panic(314);
}

fn pending_resume_total() -> i32 {
    return block_on(run());
}

fn main() -> i32 {
    let result = pending_resume_total();
    println("{}", result);
    return result;
};

@test "rosetta 314 314_async_await_pending_resume"() {
    let got = pending_resume_total();
    if got != 42 {
        panic(314);
    };
};
