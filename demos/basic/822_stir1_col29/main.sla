@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 2 列纵深 c(7,2)=1764，c(8,2)=13068，c(9,2)=109584（列纵深续高位）。
// 意对标 816_stir19（单格版互补；同式列复算）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(7, 2), cst(8, 2), cst(9, 2));
    return 0;
}

@test "basic 822 stir1 col29"() {
    if cst(7, 2) != 1764 { panic(82201); };
    if cst(8, 2) != 13068 { panic(82202); };
    if cst(9, 2) != 109584 { panic(82203); };
    if cst(6, 2) != 274 { panic(82204); };
}
