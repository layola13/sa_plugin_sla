@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 高位 M(6)=51（M(5)=21 对 21；卷积和 30）。
// 意对标 626_motzkin（低位版互补；630 做高位对峙）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", moz(5), moz(6));
    return 0;
}

@test "basic 628 motz high"() {
    if moz(6) != 51 { panic(62801); };
    if moz(5) != 21 { panic(62802); };
    if moz(4) != 9 { panic(62803); };
}
