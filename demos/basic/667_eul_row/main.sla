@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 5 行 1,26,66,26,1（行和 120=5!；行和循环求和）。
// 意对标 666_eulerian（单格版互补；同式行复算）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eul(5, 1), eul(5, 2), esum(5));
    return 0;
}

@test "basic 667 eul row"() {
    if eul(5, 1) != 26 { panic(66701); };
    if eul(5, 2) != 66 { panic(66702); };
    if esum(5) != 120 { panic(66703); };
    if eul(5, 0) != 1 { panic(66704); };
}
