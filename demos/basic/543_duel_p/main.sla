@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 全分拆双实现对峙：背包 DP == 五边形递推（n=10：42 对 42；n=8,9 同锁）。
// 意对标 536 p8 × 542 pent_extend（两源单实现见各源；286 系对峙体例）。

fn part_all(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    while k <= n {
        let s = k;
        while s <= n {
            dp[s] = dp[s] + dp[s - k];
            s = s + 1;
        }
        k = k + 1;
    }
    return dp[n];
}

fn pent_part(n: int) -> int {
    let p: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        p.push(0);
        i = i + 1;
    }
    p[0] = 1;
    let m = 1;
    while m <= n {
        let acc = 0;
        let k = 1;
        while k * (3 * k - 1) / 2 <= m {
            let g1 = k * (3 * k - 1) / 2;
            let g2 = k * (3 * k + 1) / 2;
            let sgn = 0 - 1;
            if k % 2 == 1 { sgn = 1; };
            acc = acc + sgn * p[m - g1];
            if g2 <= m { acc = acc + sgn * p[m - g2]; };
            k = k + 1;
        }
        p[m] = acc;
        m = m + 1;
    }
    return p[n];
}

fn main() -> i32 {
    println("{},{},{},{}", part_all(10), pent_part(10), part_all(8), pent_part(8));
    return 0;
}

@test "basic 543 duelp"() {
    if part_all(10) != 42 { panic(54301); };
    if pent_part(10) != 42 { panic(54302); };
    if part_all(9) != 30 { panic(54303); };
    if pent_part(9) != 30 { panic(54304); };
    if part_all(10) != pent_part(10) { panic(54305); };
}
