@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 行和桥续高位：ebsum(6)=46080，ebsum(7)=645120（p2f 陪锁）。
// 意对标 807_eulb_row6 × 684_eulb_fact（两族桥接续高位；815 做三向收束）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn ebsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eub(n, k);
        k = k + 1;
    }
    return s;
}

fn p2f(n: int) -> int {
    let p = 1;
    let i = 0;
    while i < n {
        p = p * 2;
        i = i + 1;
    }
    let f = 1;
    let j = 1;
    while j <= n {
        f = f * j;
        j = j + 1;
    }
    return p * f;
}

fn main() -> i32 {
    println("{},{},{},{}", ebsum(6), p2f(6), ebsum(7), p2f(7));
    return 0;
}

@test "basic 814 eulb fact67"() {
    if ebsum(6) != 46080 { panic(81401); };
    if p2f(6) != 46080 { panic(81402); };
    if ebsum(7) != 645120 { panic(81403); };
    if p2f(7) != 645120 { panic(81404); };
}
