// DEF-4 regression corpus: stack_alloc materialized inside a loop body
// must rewind at the back-edge. On the 6004af4 basepoint the host LLVM
// lowering emits each stack_alloc as a dynamic alloca in the loop block,
// so every iteration bumps the native stack pointer and the process
// SIGSEGVs once the accumulated frame growth crosses the stack limit
// (distilled probe: death between 20k and 40k iterations at
// ulimit -s 2048, both backends; also dead at the 8 MiB default).
// The fix lives in the sci host lowering (llvm.stacksave at loop
// headers, llvm.stackrestore on backward edges); SLA codegen is
// unchanged. Chan/select variants are the slaredis register C shapes:
// channel ops textually inside a loop body overflowed the 256 KiB
// goroutine fixed stack within thousands of iterations pre-fix
// (plain recv: baseline SAB signal 6; five-arm select: baseline SAB
// signal 6). The select variant uses buffered arms (cap 8192) on
// purpose: unbuffered rendezvous select under the SAB backend wedges
// at a few thousand iterations on BOTH the basepoint and the fixed
// host (step-function control shape, where no loop rewind touches the
// select frame, wedges identically) -- a separate pre-existing waiter
// defect that the basepoint's stack overflow had been masking, filed
// with the DEF-R6 waiter-semantics cluster. Buffering keeps this
// corpus aimed at the stack ratchet only.
@import "sa_std/ptr.sa"
@import "sa_std/task.sai"
@import "sa_std/core/box.sa"

fn bump(p: &u64) -> u64 {
    let cur = *p;
    *p = cur + 1;
    return 0;
}

@test "def4 out-param cell in while body rewinds"() {
    let n: u64 = 0;
    let acc: u64 = 0;
    while n < 2500000 {
        let cell: u64 = 0;
        let rc = bump(&cell);
        if rc == 0 {
            let cell2: u64 = 10;
            let rc2 = bump(&cell2);
            acc = acc + rc2 + cell2;
        };
        acc = acc + cell;
        n = n + 1;
    }
    // per iteration: cell becomes 1, cell2 becomes 11 -> acc += 12
    if acc != 30000000 { panic(1601); };
}

struct RecvJob {
    ch: Chan<u64>,
    out: Chan<u64>,
    rounds: u64,
}

fn recv_loop_worker(job: *RecvJob) {
    let i: u64 = 0;
    while i < (*job).rounds {
        let (v, closed) = (*job).ch.recv();
        if closed { panic(1602); };
        (*job).out.send(v + 1);
        i = i + 1;
    }
}

@test "def4 chan plain recv inside loop body rewinds"() {
    let ch_in: Chan<u64> = Chan::new(0);
    let ch_out: Chan<u64> = Chan::new(0);
    let job = Box::into_raw(Box::new(RecvJob { ch: ch_in, out: ch_out, rounds: 100000 }));
    let h = go recv_loop_worker(job);
    let i: u64 = 0;
    let sum: u64 = 0;
    while i < 100000 {
        (*job).ch.send(i);
        let (r, closed) = (*job).out.recv();
        if closed { panic(1603); };
        sum = sum + r;
        i = i + 1;
    }
    let st = sa_task_join(h);
    if st != 0 { panic(1604); };
    if sum != 5000050000 { panic(1605); };
    (*job).ch.destroy();
    (*job).out.destroy();
    let done_job = unsafe { Box::from_raw(job) };
}

struct SelJob {
    a: Chan<u64>,
    b: Chan<u64>,
    c: Chan<u64>,
    d: Chan<u64>,
    e: Chan<u64>,
    done: Chan<u64>,
    rounds: u64,
}

fn select_loop_worker(job: *SelJob) {
    let got: u64 = 0;
    let sum: u64 = 0;
    while got < (*job).rounds {
        select {
            case let v = (*job).a.recv() {
                sum = sum + v;
                got = got + 1;
            }
            case let v = (*job).b.recv() {
                sum = sum + v;
                got = got + 1;
            }
            case let v = (*job).c.recv() {
                sum = sum + v;
                got = got + 1;
            }
            case let v = (*job).d.recv() {
                sum = sum + v;
                got = got + 1;
            }
            case let v = (*job).e.recv() {
                sum = sum + v;
                got = got + 1;
            }
        }
    }
    (*job).done.send(sum);
}

@test "def4 five arm select inside loop body rewinds"() {
    let ca: Chan<u64> = Chan::new(8192);
    let cb: Chan<u64> = Chan::new(8192);
    let cc: Chan<u64> = Chan::new(8192);
    let cd: Chan<u64> = Chan::new(8192);
    let ce: Chan<u64> = Chan::new(8192);
    let cdone: Chan<u64> = Chan::new(1);
    let job = Box::into_raw(Box::new(SelJob {
        a: ca, b: cb, c: cc, d: cd, e: ce,
        done: cdone, rounds: 20000,
    }));
    let h = go select_loop_worker(job);
    let i: u64 = 0;
    while i < 20000 {
        let m = i % 5;
        if m == 0 { (*job).a.send(i + 1); };
        if m == 1 { (*job).b.send(i + 1); };
        if m == 2 { (*job).c.send(i + 1); };
        if m == 3 { (*job).d.send(i + 1); };
        if m == 4 { (*job).e.send(i + 1); };
        i = i + 1;
    }
    let (sum, closed) = (*job).done.recv();
    if closed { panic(1606); };
    let st = sa_task_join(h);
    if st != 0 { panic(1607); };
    if sum != 200010000 { panic(1608); };
    (*job).a.destroy();
    (*job).b.destroy();
    (*job).c.destroy();
    (*job).d.destroy();
    (*job).e.destroy();
    (*job).done.destroy();
    let done_job = unsafe { Box::from_raw(job) };
}
