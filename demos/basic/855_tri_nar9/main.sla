@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 续三向：行和 × Catalan 商式 × Catalan 卷积（n=9：4862 三锁）。
// 意对标 847_nar_row9（行源互补；725 三向体例收束 Narayana 续三行族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn catc(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let i = 0;
    while i < n {
        s = s + catc(i) * catc(n - 1 - i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", nsum(9), catd(9), catc(9));
    return 0;
}

@test "basic 855 tri nar9"() {
    if nsum(9) != 4862 { panic(85501); };
    if catd(9) != 4862 { panic(85502); };
    if catc(9) != 4862 { panic(85503); };
    if nsum(8) != 1430 { panic(85504); };
}
