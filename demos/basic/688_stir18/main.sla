@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 8 行高位 c(8,1)=5040，c(8,2)=13068，c(8,3)=13132（同式再上一位）。
// 意对标 686_stir17（n=7 版互补；690 做高位对峙）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(8, 1), cst(8, 2), cst(8, 3));
    return 0;
}

@test "basic 688 stir18"() {
    if cst(8, 1) != 5040 { panic(68801); };
    if cst(8, 2) != 13068 { panic(68802); };
    if cst(8, 3) != 13132 { panic(68803); };
    if cst(8, 4) != 6769 { panic(68804); };
}
