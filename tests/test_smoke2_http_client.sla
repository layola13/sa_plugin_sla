@test "smoke2 sa_http_client_req_new_v2"() {
    let h = go s2_echo2(24620 + 0 * 65536 + 65420 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24620, STR_PTR("/echo2?q=1"), STR_LEN("/echo2?q=1"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65423); };
    let rq = [0u64; 4];
    if sla_http_client_req_new_v2((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65424); };
    if rq[0] == 0 { panic(65425); };
    let rs = [0u64; 4];
    if sla_http_client_req_send_v2((rq[0] as ptr), &rs[0]) != 0 { panic(65426); };
    let resp = (rs[0] as ptr);
    if !s2_body_contains(resp, STR_PTR("/echo2?q=1"), STR_LEN("/echo2?q=1")) { panic(65427); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free((rq[0] as ptr));
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

