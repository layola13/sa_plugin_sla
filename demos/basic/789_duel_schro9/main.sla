@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 续高位对峙：迭代 vs 商式（n=8：41586 对 41586；n=9：206098 对 206098）。
// 商式 S(n)=sum C(n+k,k)C(n,k)/(k+1)（n=9：1+45+660+4620+18018+42042+60060+51480+24310+4862）。
// 意对标 786_schro9 × 商式版（两源单实现见各源；286 系对峙体例）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn qsch(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom_mul(n + k, k) * binom_mul(n, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", sch(8), qsch(8), sch(9), qsch(9));
    return 0;
}

@test "basic 789 duel schro9"() {
    if sch(8) != 41586 { panic(78901); };
    if qsch(8) != 41586 { panic(78902); };
    if sch(9) != 206098 { panic(78903); };
    if qsch(9) != 206098 { panic(78904); };
}
