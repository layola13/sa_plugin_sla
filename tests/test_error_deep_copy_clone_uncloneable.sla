@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/hashmap.sa"

// DEF-deep-copy negative: `.clone()` on a struct whose closure
// contains a HashMap must be rejected at check time with
// UncloneableClone naming the field and the map type.

struct MapDeep { m: HashMap<i32, i32>, n: i32 }

fn bad(a: MapDeep) -> i32 {
    let b: MapDeep = a.clone();
    return b.n;
}
