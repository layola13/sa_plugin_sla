@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Mihăilescu 特例搜索（≤20 平方-立方差 1 仅 (9,8) 一组）。
// 意对标 397 伪素数记档的幂差版（397 互补；属定理实例非缺口）。

fn mihailescu_count(limit: int) -> int {
    let c = 0;
    let a = 2;
    while a <= limit {
        let b = 2;
        while b <= limit {
            let d = a * a - b * b * b;
            if d == 1 { c = c + 1; };
            if d == 0 - 1 { c = c + 1; };
            b = b + 1;
        }
        a = a + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{}", mihailescu_count(20), 2 * 2 * 2 + 1 - 3 * 3);
    return 0;
}

@test "basic 493 mihailescu"() {
    if mihailescu_count(20) != 1 { panic(49301); };
}
