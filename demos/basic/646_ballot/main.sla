@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Ballot 三角建表 B(n,k)=B(n-1,k)+B(n,k-1)（上三角守卫，546 范式变体）。
// B(3,2)=5，B(4,2)=9，B(4,3)=14（649 做建表/商式对峙）。
// 意对标 351_catalan（对角线即 Catalan；此处为全三角）。

fn btab(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn] + t[mm * w + nn - 1];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", btab(3, 2), btab(4, 2), btab(4, 3));
    return 0;
}

@test "basic 646 ballot"() {
    if btab(3, 2) != 5 { panic(64601); };
    if btab(4, 2) != 9 { panic(64602); };
    if btab(4, 3) != 14 { panic(64603); };
    if btab(2, 2) != 2 { panic(64604); };
}
