@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1231_pow 的平方乘版（49/113 为循环连乘版：1024,243,1）。
// TS 用 `**`（SLA 无该 token），此处二进制幂（`e%2` 分支 + 底数平方）。

fn pow_sqmul(base: int, exp: int) -> int {
    let r = 1;
    let b = base;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b; };
        b = b * b;
        e = e / 2;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", pow_sqmul(2, 10), pow_sqmul(3, 5), pow_sqmul(5, 0));
    return 0;
}

@test "basic 258 pow sqmul"() {
    if pow_sqmul(2, 10) != 1024 { panic(25801); };
    if pow_sqmul(3, 5) != 243 { panic(25802); };
    if pow_sqmul(5, 0) != 1 { panic(25803); };
}
