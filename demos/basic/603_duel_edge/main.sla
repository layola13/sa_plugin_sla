@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 边值对峙：N(n,1) == 三角数 n·(n-1)/2（n=4：6 对 6；n=5：10 对 10；n=6：15 对 15）。
// 意对标 602 narayana_edge（单实现见源；286 系对峙体例，584 同形）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn tri(n: int) -> int {
    return n * (n - 1) / 2;
}

fn main() -> i32 {
    println("{},{},{},{},{},{}", narayana(4, 1), tri(4), narayana(5, 1), tri(5), narayana(6, 1), tri(6));
    return 0;
}

@test "basic 603 duel edge"() {
    if narayana(4, 1) != 6 { panic(60301); };
    if tri(4) != 6 { panic(60302); };
    if narayana(5, 1) != 10 { panic(60303); };
    if tri(5) != 10 { panic(60304); };
    if narayana(6, 1) != 15 { panic(60305); };
    if tri(6) != 15 { panic(60306); };
}
