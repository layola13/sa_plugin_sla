@test "smoke1 sa_std_net_tcp_stream_send_file"() {
    sla_fs_mkdir_p(STR_PTR("smoke1_net"), STR_LEN("smoke1_net"));
    sla_fs_write_file(STR_PTR("smoke1_net/sendfile.txt"), STR_LEN("smoke1_net/sendfile.txt"), STR_PTR("sendfile!"), STR_LEN("sendfile!"));
    let fcell = [0u64; 4];
    let frc = sla_std_fs_open_read(STR_PTR("smoke1_net/sendfile.txt"), STR_LEN("smoke1_net/sendfile.txt"), &fcell[0]);
    if frc != 0 { panic(59350); };
    let lh = s1_listen(59351);
    let port = s1_port_of_listener(lh, 59352);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let sent = [0u64; 4];
    let next = [0u64; 4];
    let rc = sla_std_net_tcp_stream_send_file(srv[0], fcell[0], 0, 9, &sent[0], &next[0]);
    if rc != 0 { panic(59353); };
    if sent[0] != 9 { panic(59354); };
    if next[0] != 9 { panic(59355); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    sla_std_net_tcp_stream_read(cli[0], &buf[0], 64, &rd[0]);
    if rd[0] != 9 { panic(59356); };
    if buf[0] != 115 { panic(59357); };
    if buf[8] != 33 { panic(59358); };
    sla_std_close(fcell[0]);
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

