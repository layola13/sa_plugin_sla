@test "smoke1 sa_json_string_len"() {
    let s = sla_json_parse(STR_PTR("\"hello\""), STR_LEN("\"hello\""));
    if s == 0 { panic(52250); };
    if sla_json_string_len(s) != 5 { panic(52251); };
}

@test "smoke1 sa_json_value_count"() {
    let doc = s1_doc();
    let cnt = [0u64; 4];
    let rc = sla_json_value_count(doc, &cnt[0]);
    if rc != 0 { panic(52260); };
    if cnt[0] != 7 { panic(52261); };
    let arr = s1_get(doc, STR_PTR("arr"), STR_LEN("arr"), 52262);
    let rc2 = sla_json_value_count(arr, &cnt[0]);
    if rc2 != 0 { panic(52263); };
    if cnt[0] != 3 { panic(52264); };
}

@test "smoke1 sa_json_stringify"() {
    let doc = s1_doc();
    let cell = [0u64; 4];
    let rc = sla_json_stringify(doc, &cell[0]);
    if rc != 0 { panic(52270); };
    if cell[0] == 0 { panic(52271); };
    if sla_json_buffer_len(cell[0]) == 0 { panic(52272); };
}

@test "smoke1 sa_json_buffer_len"() {
    let doc = sla_json_parse(STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"));
    let cell = [0u64; 4];
    let rc = sla_json_stringify(doc, &cell[0]);
    if rc != 0 { panic(52280); };
    let n = sla_json_buffer_len(cell[0]);
    if n < 7 { panic(52281); };
    // Deterministic: re-stringify gives the same length.
    let cell2 = [0u64; 4];
    sla_json_stringify(doc, &cell2[0]);
    if sla_json_buffer_len(cell2[0]) != n { panic(52282); };
}

@test "smoke1 sa_json_writer_field_node"() {
    let w = [0u64; 4];
    let rc = sla_json_writer_new(0, 0, 0, 0, 0, &w[0]);
    if rc != 0 { panic(52290); };
    sla_json_writer_begin_object(w[0]);
    let child = sla_json_parse(STR_PTR("[1,2]"), STR_LEN("[1,2]"));
    let rc2 = sla_json_writer_field_node(w[0], STR_PTR("child"), STR_LEN("child"), child);
    if rc2 != 0 { panic(52291); };
    sla_json_writer_end_object(w[0]);
    let out = [0u64; 4];
    let rc3 = sla_json_writer_finish(w[0], &out[0]);
    if rc3 != 0 { panic(52292); };
    if sla_json_buffer_len(out[0]) < 15 { panic(52293); };
    sla_json_writer_free(^w[0]);
    sla_std_close(child);
}

@test "smoke1 sa_json_writer_write_node"() {
    let w = [0u64; 4];
    let rc = sla_json_writer_new(0, 0, 0, 0, 0, &w[0]);
    if rc != 0 { panic(52300); };
    sla_json_writer_begin_array(w[0]);
    let child = sla_json_parse(STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"));
    let rc2 = sla_json_writer_write_node(w[0], child);
    if rc2 != 0 { panic(52301); };
    sla_json_writer_end_array(w[0]);
    let out = [0u64; 4];
    let rc3 = sla_json_writer_finish(w[0], &out[0]);
    if rc3 != 0 { panic(52302); };
    if sla_json_buffer_len(out[0]) < 9 { panic(52303); };
    sla_json_writer_free(^w[0]);
    sla_std_close(child);
}

@test "smoke1 sa_json_stream_next"() {
    // Token codes (SA_JSON_TOKEN_*): OBJECT_BEGIN 0, OBJECT_END 1,
    // ARRAY_BEGIN 2, ARRAY_END 3, TRUE 4, FALSE 5, NULL 6, NUMBER 7,
    // STRING 9, END_OF_DOCUMENT 15.
    let s = sla_json_stream_new(STR_PTR("{\"a\":[1,true,false,null,\"s\"]}"), STR_LEN("{\"a\":[1,true,false,null,\"s\"]}"));
    if s == 0 { panic(52310); };
    if sla_json_stream_next(s) != 0 { panic(52311); };
    if sla_json_stream_next(s) != 9 { panic(52312); };
    if sla_json_stream_next(s) != 2 { panic(52313); };
    if sla_json_stream_next(s) != 7 { panic(52314); };
    if sla_json_stream_next(s) != 4 { panic(52315); };
    if sla_json_stream_next(s) != 5 { panic(52316); };
    if sla_json_stream_next(s) != 6 { panic(52317); };
    if sla_json_stream_next(s) != 9 { panic(52318); };
    if sla_json_stream_next(s) != 3 { panic(52319); };
    if sla_json_stream_next(s) != 1 { panic(52320); };
    if sla_json_stream_next(s) != 15 { panic(52321); };
    sla_std_close(s);
}

@test "smoke1 sa_json_stream_get_slice_len"() {
    let s = sla_json_stream_new(STR_PTR("[\"abc\",12]"), STR_LEN("[\"abc\",12]"));
    if s == 0 { panic(52330); };
    if sla_json_stream_next(s) != 2 { panic(52331); };
    // Structural tokens carry no text slice.
    if sla_json_stream_get_slice_len(s) != 0 { panic(52332); };
    if sla_json_stream_next(s) != 9 { panic(52333); };
    if sla_json_stream_get_slice_len(s) != 3 { panic(52334); };
    if sla_json_stream_next(s) != 7 { panic(52335); };
    if sla_json_stream_get_slice_len(s) != 2 { panic(52336); };
    if sla_json_stream_next(s) != 3 { panic(52337); };
    sla_std_close(s);
}

@test "smoke1 sa_json_scanner_next"() {
    let cell = [0u64; 4];
    let rc = sla_json_scanner_new(&cell[0]);
    if rc != 0 { panic(52340); };
    sla_json_scanner_feed(cell[0], STR_PTR("[1]"), STR_LEN("[1]"));
    sla_json_scanner_end_input(cell[0]);
    // SaJsonToken record: kind u32 @ cell0 low half, text_ptr @ cell1,
    // text_len @ cell2.
    let tok = [0u64; 3];
    let rc2 = sla_json_scanner_next(cell[0], &tok[0]);
    if rc2 != 0 { panic(52341); };
    if tok[0] != 2 { panic(52342); };
    let rc3 = sla_json_scanner_next(cell[0], &tok[0]);
    if rc3 != 0 { panic(52343); };
    if tok[0] != 7 { panic(52344); };
    if tok[2] != 1 { panic(52345); };
    if tok[1] == 0 { panic(52346); };
    if PTR_BYTE_AT((tok[1] as ptr), 0) != 49 { panic(52347); };
    let rc4 = sla_json_scanner_next(cell[0], &tok[0]);
    if rc4 != 0 { panic(52348); };
    if tok[0] != 3 { panic(52349); };
    let rc5 = sla_json_scanner_next(cell[0], &tok[0]);
    if rc5 != 0 { panic(52350); };
    if tok[0] != 15 { panic(52351); };
    sla_json_scanner_free(^cell[0]);
}
