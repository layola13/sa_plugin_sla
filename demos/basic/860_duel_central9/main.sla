@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 中央二项对峙：乘式直算 vs Pascal 建表（(18,9)：48620 对 48620；(20,10)：184756 对 184756）。
// 意对标 859_central18 × 546_pascal（两源单实现见各源；730 体例续高位）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn ccomb(n: int, k: int) -> int {
    if k > n { return 0; };
    if k == 0 { return 1; };
    if k == n { return 1; };
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = 1;
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{},{}", binom_mul(18, 9), ccomb(18, 9), binom_mul(20, 10), ccomb(20, 10));
    return 0;
}

@test "basic 860 duel central9"() {
    if binom_mul(18, 9) != 48620 { panic(86001); };
    if ccomb(18, 9) != 48620 { panic(86002); };
    if binom_mul(20, 10) != 184756 { panic(86003); };
    if ccomb(20, 10) != 184756 { panic(86004); };
}
