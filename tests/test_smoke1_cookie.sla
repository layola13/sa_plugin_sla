@test "smoke1 sa_cookie_is_expired"() {
    let h = s1_new(54220);
    sla_cookie_set_expires(h, 1000);
    let out = [0u64; 4];
    let rc = sla_cookie_is_expired(h, 2000000000, &out[0]);
    if rc != 0 { panic(54221); };
    if out[0] != 1 { panic(54222); };
    sla_cookie_set_expires(h, 1893456000);
    let rc2 = sla_cookie_is_expired(h, 1700000000, &out[0]);
    if rc2 != 0 { panic(54223); };
    if out[0] != 0 { panic(54224); };
    sla_cookie_free(^h);
}
