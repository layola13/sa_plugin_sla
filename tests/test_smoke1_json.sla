@test "smoke1 sa_json_object_set_f64"() {
    let obj = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let rc = sla_json_object_set_f64(obj, STR_PTR("f"), STR_LEN("f"), 2.5);
    if rc != 0 { panic(52140); };
    let v = [0u64; 4];
    sla_json_object_get_f64(obj, STR_PTR("f"), STR_LEN("f"), &v[0]);
    if v[0] == 0 { panic(52141); };
    let rc2 = sla_json_object_set_f64(obj, STR_PTR("f"), STR_LEN("f"), 0.0);
    if rc2 != 0 { panic(52142); };
    sla_json_object_get_f64(obj, STR_PTR("f"), STR_LEN("f"), &v[0]);
    if v[0] != 0 { panic(52143); };
