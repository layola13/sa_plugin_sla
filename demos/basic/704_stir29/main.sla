@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类第 9 行高位 S(9,2)=255，S(9,3)=3025，S(9,4)=7770（同式再上一位）。
// 意对标 698_stir28（n=8 版互补；705 做三向收束）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", svt(9, 2), svt(9, 3), svt(9, 4));
    return 0;
}

@test "basic 704 stir29"() {
    if svt(9, 2) != 255 { panic(70401); };
    if svt(9, 3) != 3025 { panic(70402); };
    if svt(9, 4) != 7770 { panic(70403); };
    if svt(9, 5) != 6951 { panic(70404); };
}
