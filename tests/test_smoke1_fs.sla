@test "smoke1 sa_fs_read_buffer_len"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/rbuf.txt"), STR_LEN("smoke1_fs/rbuf.txt"), STR_PTR("hello world"), STR_LEN("hello world"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_read_file(STR_PTR("smoke1_fs/rbuf.txt"), STR_LEN("smoke1_fs/rbuf.txt"), 1024, &cell[0]);
    if rc != 0 { panic(51620); };
    if cell[0] == 0 { panic(51621); };
    if sla_fs_read_buffer_len(cell[0]) != 11 { panic(51622); };
    sla_fs_read_buffer_free(^cell[0]);
}

@test "smoke1 sa_fs_read_buffer_free"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/rbuf2.txt"), STR_LEN("smoke1_fs/rbuf2.txt"), STR_PTR("data"), STR_LEN("data"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_read_file(STR_PTR("smoke1_fs/rbuf2.txt"), STR_LEN("smoke1_fs/rbuf2.txt"), 1024, &cell[0]);
    if rc != 0 { panic(51630); };
    if sla_fs_read_buffer_len(cell[0]) != 4 { panic(51631); };
    let rc2 = sla_fs_read_buffer_free(^cell[0]);
    if rc2 != 0 { panic(51632); };
}

