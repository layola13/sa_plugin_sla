@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 整系数二次方程求根（x²-5x+6=0 → 3,2）。
// 判别式 + 整数开方（117 口径）+ 求根公式组合。

fn main() -> i32 {
    let qa = 1;
    let qb = 0 - 5;
    let qc = 6;
    let dd = qb * qb - 4 * qa * qc;
    let r = 0;
    while (r + 1) * (r + 1) <= dd {
        r = r + 1;
    }
    let x1 = (0 - qb + r) / (2 * qa);
    let x2 = (0 - qb - r) / (2 * qa);
    println("{},{}", x1, x2);
    return 0;
}

@test "basic 329 quad roots"() {
    let qa = 1;
    let qb = 0 - 5;
    let qc = 6;
    let dd = qb * qb - 4 * qa * qc;
    if dd != 1 { panic(32901); };
    let r = 0;
    while (r + 1) * (r + 1) <= dd {
        r = r + 1;
    }
    if (0 - qb + r) / (2 * qa) != 3 { panic(32902); };
    if (0 - qb - r) / (2 * qa) != 2 { panic(32903); };
}
