@import "sa_std/string.sa"

// B-lit regression: repeated identical format(f) calls with a variable
// argument must share one cached macro template on the SAB backend.
// Pre-fix (sla 84ca7b3a): string_format.sa bypassed the plain template
// cache, so every call site fresh-flattened the FORMAT_* bodies and
// peak RSS grew ~52 MB per call (~52 GB at K=1000: OOM / RSS-cap kill).
// Post-fix: identical calls share one cached template (~2.9 MB/call).
// The SA backend passes on both (the defect is SAB-only).
@test "sab lit format cache dedups repeated format calls"() {
    let f: String = format("hello");
    let a1 = format("{}", f);
    let a2 = format("{}", f);
    let a3 = format("{}", f);
    let a4 = format("{}", f);
    let a5 = format("{}", f);
