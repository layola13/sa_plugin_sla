@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 147_median：TS 用 toSorted 取中位数；SLA 无排序 std 方法，
// 此处用插入排序（见 16_insert_sort）排好 [7,1,5,3,9] -> [1,3,5,7,9] 再取中位数 5。

fn sort5(^a: [int; 5]) -> [int; 5] {
    for i in 1..5 {
        let k = a[i];
        let j = i - 1;
        while j >= 0 && a[j] > k {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = k;
    }
    return a;
}

fn median_of5(a: [int; 5]) -> int {
    let s = sort5(^a);
    return s[2];
}

fn main() -> i32 {
    let a = [7, 1, 5, 3, 9];
    let s = sort5(^a);
    println("{},{}", s[2], s[0] + s[4]);
    return 0;
}

@test "basic 38 median sorted"() {
    let a = [7, 1, 5, 3, 9];
    if median_of5(a) != 5 { panic(3801); };
    let b = [7, 1, 5, 3, 9];
    let s = sort5(^b);
    if s[0] + s[4] != 10 { panic(3802); };
}
