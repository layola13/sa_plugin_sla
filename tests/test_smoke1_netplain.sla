@test "smoke1 sa_net_tcp_stream_flush"() {
    let srv = s1_np_pair_srv(63300);
    sla_net_tcp_stream_write(srv, STR_PTR("hi"), STR_LEN("hi"));
    let rc = sla_net_tcp_stream_flush(srv);
    if rc != 0 { panic(63301); };
    sla_std_close(srv);
}

@test "smoke1 sa_net_tcp_stream_shutdown"() {
    let srv = s1_np_pair_srv(63310);
    let rc = sla_net_tcp_stream_shutdown(srv, 1);
    if rc != 0 { panic(63311); };
    let rc2 = sla_net_tcp_stream_shutdown(srv, 2);
    if rc2 != 0 { panic(63313); };
    // NOTE: writing after a full shutdown still reports success --
    // registered as W1-DEF-NET-WRITE-AFTER-SHUTDOWN with its own
    // minim (test_smoke1_defect_net_shutdown.sla); not asserted here.
    sla_std_close(srv);
}
