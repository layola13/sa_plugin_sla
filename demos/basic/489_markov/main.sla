@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Markov 数判定与计数（x²+y²+z²=3xyz；≤30 有 6 组）。
// 意对标 428 出租车数的三元版（428 互补；492 做三向）。

fn is_markov(a: int, b: int, c: int) -> int {
    if a * a + b * b + c * c == 3 * a * b * c { return 1; };
    return 0;
}

fn markov_count(limit: int) -> int {
    let n = 0;
    let a = 1;
    while a <= limit {
        let b = a;
        while b <= limit {
            let c = b;
            while c <= limit {
                if is_markov(a, b, c) == 1 { n = n + 1; };
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return n;
}

fn main() -> i32 {
    println("{},{},{}", is_markov(2, 5, 29), is_markov(1, 2, 3), markov_count(30));
    return 0;
}

@test "basic 489 markov"() {
    if is_markov(2, 5, 29) != 1 { panic(48901); };
    if is_markov(1, 2, 3) != 0 { panic(48902); };
    if markov_count(30) != 5 { panic(48903); };
}
