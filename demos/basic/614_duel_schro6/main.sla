@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Schroder 高位二对峙：迭代 vs 递归（n=5：394 对 394；n=6：1806 对 1806）。
// 意对标 613_schro6 × 609_duel_schro（高位源与对峙体例合流）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rsch(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 2; };
    let s = rsch(n - 1);
    let k = 0;
    while k < n {
        s = s + rsch(k) * rsch(n - 1 - k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", sch(5), rsch(5), sch(6), rsch(6));
    return 0;
}

@test "basic 614 duel schro6"() {
    if sch(5) != 394 { panic(61401); };
    if rsch(5) != 394 { panic(61402); };
    if sch(6) != 1806 { panic(61403); };
    if rsch(6) != 1806 { panic(61404); };
}
