    let req = (rq[0] as ptr);
    let op = [0u64; 4];
    if sla_http_client_req_send_async(req, &op[0]) != 0 { panic(65125); };
    let opp = (op[0] as ptr);
    let ready = [0u64; 4];
    let spins: u64 = 0;
    while spins < 1000 {
        if sla_http_client_async_poll(opp, &ready[0]) != 0 { panic(65126); };
        if ready[0] != 0 { break; };
        sla_time_sleep_ms(10);
        spins = spins + 1;
    }
    if ready[0] == 0 { panic(65127); };
    let rs = [0u64; 4];
    if sla_http_client_async_take_response(opp, &rs[0]) != 0 { panic(65128); };
    let resp = (rs[0] as ptr);
    if sla_http_client_resp_status(resp) != 200 { panic(65129); };
    if !s2_body_contains(resp, STR_PTR("/async"), STR_LEN("/async")) { panic(65130); };
    if sla_http_client_async_free(opp) != 0 { panic(65131); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

