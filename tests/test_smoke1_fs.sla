    if rc != 0 { panic(51150); };
    if cell[0] == 0 { panic(51151); };
    let wr = [0u64; 4];
    let rc2 = sla_std_fs_file_write(cell[0], STR_PTR("xyz"), STR_LEN("xyz"), &wr[0]);
    if rc2 != 0 { panic(51152); };
    if wr[0] != 3 { panic(51153); };
    sla_std_close(cell[0]);
    if s1_len_of(STR_PTR("smoke1_fs/stdwrite.txt"), STR_LEN("smoke1_fs/stdwrite.txt")) != 3 { panic(51154); };
