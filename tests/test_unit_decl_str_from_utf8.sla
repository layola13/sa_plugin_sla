fn b0() -> Vec<u8> { return Vec::new(); }
fn b2(x: u8, y: u8) -> Vec<u8> { let v: Vec<u8> = Vec::new(); v.push(x); v.push(y); return v; }
fn b3(x: u8, y: u8, z: u8) -> Vec<u8> { let v: Vec<u8> = Vec::new(); v.push(x); v.push(y); v.push(z); return v; }
fn b4(w: u8, x: u8, y: u8, z: u8) -> Vec<u8> { let v: Vec<u8> = Vec::new(); v.push(w); v.push(x); v.push(y); v.push(z); return v; }

fn from_utf8_string(v: Vec<u8>) -> String {
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return s; },
        Err(e) => { panic(67500 + e); },
    }
}

fn from_utf8_err(v: Vec<u8>) -> i32 {
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    let res: Result<String, i32> = str_from_utf8(sl);
    match res {
        Ok(s) => { return 0 - 1; },
        Err(e) => { return e; },
    }
}

@test "str from utf8 e acute ok"() {
    let s: String = from_utf8_string(b2(195, 169));
    let bs = s.as_bytes();
    if len(bs) != 2 { panic(67511); };
    if bs[0] != 195 { panic(67512); };
    if bs[1] != 169 { panic(67513); };
}

@test "str from utf8 emoji ok"() {
    let s: String = from_utf8_string(b4(240, 159, 152, 128));
    let bs = s.as_bytes();
    if len(bs) != 4 { panic(67514); };
    if bs[0] != 240 { panic(67515); };
    if bs[3] != 128 { panic(67516); };
}

@test "str from utf8 ascii ok"() {
    let s: String = from_utf8_string(b3(97, 98, 99));
    let bs = s.as_bytes();
    if len(bs) != 3 { panic(67517); };
    if bs[1] != 98 { panic(67518); };
}

@test "str from utf8 empty ok"() {
    let s: String = from_utf8_string(b0());
    let bs = s.as_bytes();
    if len(bs) != 0 { panic(67519); };
}

@test "str from utf8 a ff err"() {
    if from_utf8_err(b2(97, 255)) != 1 { panic(67520); };
}

@test "str from utf8 surrogate err"() {
    if from_utf8_err(b3(237, 160, 128)) != 1 { panic(67521); };
}

@test "str from utf8 overlong err"() {
    if from_utf8_err(b2(192, 128)) != 1 { panic(67522); };
}

@test "utf8 char count packed"() {
    let a: [u8; 3] = [97, 195, 169];
    let p: ptr = PTR_BYTE_ADD(&a, 0);
    let c: u64 = sa_str_utf8_char_count(p, 3);
    if c != 2 { panic(67523); };
}
