@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 对峙：商式 == 递推（(4,2)：36 对 36；(5,3)：120 对 120）。
// 意对标 586 lah × 589 lah_rec（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn lah(n: int, k: int) -> int {
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn lah_rec(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn + kk - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{},{}", lah(4, 2), lah_rec(4, 2), lah(5, 3), lah_rec(5, 3));
    return 0;
}

@test "basic 590 duel lah"() {
    if lah(4, 2) != 36 { panic(59001); };
    if lah_rec(4, 2) != 36 { panic(59002); };
    if lah(5, 3) != 120 { panic(59003); };
    if lah_rec(5, 3) != 120 { panic(59004); };
    if lah(5, 3) != lah_rec(5, 3) { panic(59005); };
}
