@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 916_nested_struct 的四层延伸（195 覆盖三层时注明
// “四层以上未探”，此处补齐：穿透读得 7）。

struct L4 { v: i32 }
struct L3 { inner: L4 }
struct L2 { mid: L3 }
struct L1 { top: L2 }

fn main() -> i32 {
    let o = L1 { top: L2 { mid: L3 { inner: L4 { v: 7 } } } };
    println("{}", o.top.mid.inner.v);
    return 0;
}

@test "basic 224 nest4"() {
    let o = L1 { top: L2 { mid: L3 { inner: L4 { v: 7 } } } };
    if o.top.mid.inner.v != 7 { panic(22401); };
}
