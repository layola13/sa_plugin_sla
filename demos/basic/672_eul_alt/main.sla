@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 交错和 E(n,m)=sum (-1)^k C(n+1,k)(m+1-k)^n（E(4,1)=11，E(5,2)=66，E(6,3)=302）。
// 意对标 666_eulerian（建表版互补；675 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pwr(b: int, e: int) -> int {
    let r = 1;
    let i = 0;
    while i < e {
        r = r * b;
        i = i + 1;
    }
    return r;
}

fn ealt(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m + 1 {
        let term = binom_mul(n + 1, k) * pwr(m + 1 - k, n);
        if k % 2 == 0 { s = s + term; } else { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", ealt(4, 1), ealt(5, 2), ealt(6, 3));
    return 0;
}

@test "basic 672 eul alt"() {
    if ealt(4, 1) != 11 { panic(67201); };
    if ealt(5, 2) != 66 { panic(67202); };
    if ealt(6, 3) != 302 { panic(67203); };
    if ealt(3, 1) != 4 { panic(67204); };
}
