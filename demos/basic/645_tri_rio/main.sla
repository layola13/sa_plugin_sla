@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 三向：短递推 × 卷积 × 桥序（n=5：6 三锁）。
// 意对标 638_rio_high（高位源互补；605 三向体例收束 Riordan 族）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn rconv(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let s = 0;
    let k = 0;
    while k <= n - 2 {
        s = s + rconv(k) * moz(n - 2 - k);
        k = k + 1;
    }
    return s;
}

fn rbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return moz(n - 1) - rbr(n - 1);
}

fn main() -> i32 {
    println("{},{},{}", rio(5), rconv(5), rbr(5));
    return 0;
}

@test "basic 645 tri rio"() {
    if rio(5) != 6 { panic(64501); };
    if rconv(5) != 6 { panic(64502); };
    if rbr(5) != 6 { panic(64503); };
    if rbr(4) != 3 { panic(64504); };
}
