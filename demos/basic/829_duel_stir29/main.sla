@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类续高位对峙：建表 vs 递归（(10,2)：511 对 511；(10,3)：9330 对 9330）。
// 意对标 826_stir29 × 递归版（两源单实现见各源；819 体例续高位）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rss(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rss(n - 1, k - 1) + k * rss(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", sst(10, 2), rss(10, 2), sst(10, 3), rss(10, 3));
    return 0;
}

@test "basic 829 duel stir29"() {
    if sst(10, 2) != 511 { panic(82901); };
    if rss(10, 2) != 511 { panic(82902); };
    if sst(10, 3) != 9330 { panic(82903); };
    if rss(10, 3) != 9330 { panic(82904); };
}
