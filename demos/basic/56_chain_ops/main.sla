@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 165_chain：链式赋值 `a = b = 5`。
// 缺口 #12 已修复：parser 将 `=` 链 desugar 为一次性求值的块
// （`{ let __chainK = value; b = __chainK; a = __chainK; }`），此处直写链式。

fn main() -> i32 {
    let a = 0;
    let b = 0;
    a = b = 5;
    println("{},{}", a, b);
    return 0;
}

@test "basic 56 chain ops"() {
    let a = 0;
    let b = 0;
    a = b = 5;
    if a != 5 { panic(5601); };
    if b != 5 { panic(5602); };
}
