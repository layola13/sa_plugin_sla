@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 桥序 F(n)=(Catalan(n)-F(n-1))/2（F(4)=6，F(5)=18，F(6)=57）。
// 意对标 656_fine × 351_catalan（两族桥接；665 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cat(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn fbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return (cat(n) - fbr(n - 1)) / 2;
}

fn main() -> i32 {
    println("{},{},{}", fbr(4), fbr(5), fbr(6));
    return 0;
}

@test "basic 663 fine bridge"() {
    if fbr(4) != 6 { panic(66301); };
    if fbr(5) != 18 { panic(66302); };
    if fbr(6) != 57 { panic(66303); };
    if fbr(7) != 186 { panic(66304); };
}
