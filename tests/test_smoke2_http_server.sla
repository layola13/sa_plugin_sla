// ---------------- v2 websocket tests ----------------

fn s2_upgrade_v2(srv: ptr, cli: u64, code: i32) -> ptr {
    s2_raw_write(cli, s2_ws_upgrade_req(), s2_ws_upgrade_req_len(), code);
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(code + 1); };
    let req = (aq[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_server_websocket_upgrade_v2(req, &wc[0]) != 0 { panic(code + 2); };
    if wc[0] == 0 { panic(code + 3); };
    return (wc[0] as ptr);
}

@test "smoke2 sa_http_server_websocket_upgrade_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24452, pp, 64890);
    let cli = s2_raw_conn(pc[0], 64892);
    let ws = s2_upgrade_v2(srv, cli, 64893);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_read_head(cli, bp, 1024, 64897);
    if !s2_contains(bp, total, STR_PTR("101"), STR_LEN("101")) { panic(64898); };
    sla_http_server_websocket_free_v2(ws);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

@test "smoke2 sa_http_server_websocket_poll_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24453, pp, 64900);
    let cli = s2_raw_conn(pc[0], 64902);
    let ws = s2_upgrade_v2(srv, cli, 64903);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_read_head(cli, bp, 1024, 64907);
    // Idle socket: per the std contract (sa_http_server.zig
    // pollWebSocketV2 -> pollStream), a poll that times out with no
    // events returns a non-ok timeout status, not ok+0. Pin both facts.
    let ev = [0u64; 4];
    if sla_http_server_websocket_poll_v2(ws, 1, 300, &ev[0]) == 0 { panic(64908); };
    if ev[0] != 0 { panic(64909); };
    // After the client sends a frame, poll must report readable.
    let fbuf = [0u8; 64];
    let fp: ptr = PTR_BYTE_ADD(&fbuf, 0);
    let flen = s2_ws_frame(fp, 1, STR_PTR("poll-me"), STR_LEN("poll-me"));
    s2_raw_write(cli, fp, flen, 64910);
    if sla_http_server_websocket_poll_v2(ws, 1, 5000, &ev[0]) != 0 { panic(64911); };
    if ev[0] == 0 { panic(64912); };
    sla_http_server_websocket_free_v2(ws);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

@test "smoke2 sa_http_server_websocket_write_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24454, pp, 64920);
    let cli = s2_raw_conn(pc[0], 64922);
    let ws = s2_upgrade_v2(srv, cli, 64923);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_read_head(cli, bp, 1024, 64927);
    // Server pushes a fixed payload; the raw peer parses the frame.
    let wr = [0u64; 4];
    if sla_http_server_websocket_write_v2(ws, 1, STR_PTR("srv-v2-push"), STR_LEN("srv-v2-push"), &wr[0]) != 0 { panic(64932); };
    if wr[0] != 11 { panic(64933); };
    s2_read_exact(cli, bp, 13, 64934);
    if buf[0] != 129 { panic(64935); };
    if buf[1] != 11 { panic(64936); };
    if !s2_mem_eq_tail(bp, 2, STR_PTR("srv-v2-push"), STR_LEN("srv-v2-push")) { panic(64937); };
    sla_http_server_websocket_free_v2(ws);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

@test "smoke2 sa_http_server_websocket_close_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24455, pp, 64940);
    let cli = s2_raw_conn(pc[0], 64942);
    let ws = s2_upgrade_v2(srv, cli, 64943);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_read_head(cli, bp, 1024, 64947);
    if sla_http_server_websocket_close_v2(ws, 1000, STR_PTR(""), 0) != 0 { panic(64948); };
    // The peer must observe a close frame (0x88) as the next frame.
    s2_read_exact(cli, bp, 2, 64949);
    if buf[0] != 136 { panic(64950); };
    sla_http_server_websocket_free_v2(ws);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

@test "smoke2 sa_http_server_websocket_free_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24456, pp, 64960);
    let cli = s2_raw_conn(pc[0], 64962);
    let ws = s2_upgrade_v2(srv, cli, 64963);
    if sla_http_server_websocket_free_v2(ws) != 0 { panic(64967); };
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

fn s2_sf_peer(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let code: i32 = (arg >> 24) as i32;
    let fd = sla_fs_file_open(STR_PTR("smoke2_sendfile.txt"), STR_LEN("smoke2_sendfile.txt"), 1);
    if fd <= 0 { panic(code); };
    let sc = [0u64; 4];
    if sla_http_server_new_v2(&sc[0]) != 0 { panic(code + 1); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 2); };
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(code + 3); };
    let req = (aq[0] as ptr);
    let rp = [0u64; 4];
    if sla_http_server_resp_new_v2(req, 200, &rp[0]) != 0 { panic(code + 4); };
    let resp = (rp[0] as ptr);
    let raw = [0u64; 4];
    if sla_std_fd_as_raw((fd as u64), &raw[0]) != 0 { panic(code + 8); };
    let sent = [0u64; 4];
    if sla_http_server_resp_send_file_v2(resp, (raw[0] as i64), 0, 14, 5000, &sent[0]) != 0 { panic(code + 9); };
    if sent[0] != 14 { panic(code + 10); };
    sla_http_server_resp_free_v2(resp);
    sla_http_server_req_free_v2(req);
    sla_http_server_free_v2(srv);
}

@test "smoke2 sa_http_server_resp_send_file_v2"() {
    if sla_fs_write_file(STR_PTR("smoke2_sendfile.txt"), STR_LEN("smoke2_sendfile.txt"), STR_PTR("hello-sendfile"), STR_LEN("hello-sendfile")) != 0 { panic(64760); };
    let h = go s2_sf_peer(24950 + 64761 * 16777216);
    let url = "http://127.0.0.1:24950/f";
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(64762); };
    let rq = [0u64; 4];
    if sla_http_client_req_new((cl[0] as ptr), 1, STR_PTR(url), STR_LEN(url), &rq[0]) != 0 { panic(64763); };
    let req = (rq[0] as ptr);
    let rs = [0u64; 4];
    if sla_http_client_req_send(req, &rs[0]) != 0 { panic(64764); };
    let resp = (rs[0] as ptr);
    if sla_http_client_resp_status(resp) != 200 { panic(64765); };
    // The body must be the file's exact bytes: a registry handle that
    // merely collides numerically with some unrelated open fd would
    // send that fd's content instead (or fail), so status+sent counts
    // alone cannot prove this entry.
    let bp = [0u64; 4];
    let bl = [0u64; 4];
    if sla_http_client_resp_body_slice(resp, &bp[0], &bl[0]) != 0 { panic(64766); };
    if bl[0] != 14 { panic(64767); };
    let got: ptr = (bp[0] as ptr);
    let want: ptr = STR_PTR("hello-sendfile");
    let i: u64 = 0;
    while i < 14 {
        let a: ptr = PTR_BYTE_ADD(got, i);
        let b: ptr = PTR_BYTE_ADD(want, i);
        if PTR_READ_U8(a) != PTR_READ_U8(b) { panic(64768); };
        i = i + 1;
    }
    sla_http_client_resp_free(resp);
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}
