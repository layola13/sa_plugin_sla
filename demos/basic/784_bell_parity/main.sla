@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 奇偶性 Touchard 同余 B(n) mod 2 周期 3（B(8)=0，B(9)=1，B(10)=1）。
// 意对标 776_bell9（单值版互补；数论性质单锁）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", bell(8) % 2, bell(9) % 2, bell(10) % 2);
    return 0;
}

@test "basic 784 bell parity"() {
    if bell(8) % 2 != 0 { panic(78401); };
    if bell(9) % 2 != 1 { panic(78402); };
    if bell(10) % 2 != 1 { panic(78403); };
    if bell(7) % 2 != 1 { panic(78404); };
}
