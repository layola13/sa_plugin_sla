// Smoke wave 2: register-2 externs in sa_std/http_server.sai (v1 + v2).
// Peer is a raw TCP client built from the net wraps: the request bytes
// are written into the listen backlog before accept runs, so every test
// is single-threaded and hermetic on 127.0.0.1 with per-test ports.
// Panic codes 644xx.
@import "sla_std/wrap/http_server.sla"
@import "sla_std/wrap/http_client.sla"
@import "sla_std/wrap/net.sla"
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/os/fd.sla"
@import "sa_std/task.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s2_mem_eq(p: ptr, n: u64, lit: ptr, m: u64) -> bool {
    if n != m { return false; };
    let i: u64 = 0;
    while i < n {
        let bp: ptr = PTR_BYTE_ADD(p, i);
        let bq: ptr = PTR_BYTE_ADD(lit, i);
        if PTR_READ_U8(bp) != PTR_READ_U8(bq) { return false; };
        i = i + 1;
    }
    return true;
}

fn s2_contains(p: ptr, n: u64, lit: ptr, m: u64) -> bool {
    if n < m { return false; };
    let i: u64 = 0;
    while i + m <= n {
        if s2_mem_eq_tail(p, i, lit, m) { return true; };
        i = i + 1;
    }
    return false;
}

fn s2_mem_eq_tail(p: ptr, off: u64, lit: ptr, m: u64) -> bool {
    let j: u64 = 0;
    while j < m {
        let bp: ptr = PTR_BYTE_ADD(p, off + j);
        let bq: ptr = PTR_BYTE_ADD(lit, j);
        if PTR_READ_U8(bp) != PTR_READ_U8(bq) { return false; };
        j = j + 1;
    }
    return true;
}

fn s2_srv1(base: u64, out_port: ptr, code: i32) -> ptr {
    let i: u64 = 0;
    while i < 30 {
        let sc = [0u64; 4];
        if sla_http_server_new(&sc[0]) != 0 { panic(code); };
        let srv = (sc[0] as ptr);
        if sla_http_server_start(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), ((base + i) as u16)) == 0 {
            PTR_WRITE_U64(out_port, base + i);
            return srv;
        };
        sla_http_server_free(srv);
        i = i + 1;
    }
    panic(code + 1);
    return PTR_NULL();
}

fn s2_srv2(base: u64, out_port: ptr, code: i32) -> ptr {
    let i: u64 = 0;
    while i < 30 {
        let sc = [0u64; 4];
        if sla_http_server_new_v2(&sc[0]) != 0 { panic(code); };
        let srv = (sc[0] as ptr);
        if sla_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), ((base + i) as u16)) == 0 {
            PTR_WRITE_U64(out_port, base + i);
            return srv;
        };
        sla_http_server_free_v2(srv);
        i = i + 1;
    }
    panic(code + 1);
    return PTR_NULL();
}

fn s2_raw_conn(port: u64, code: i32) -> u64 {
    let cli = [0u64; 4];
    if sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]) != 0 { panic(code); };
    sla_std_net_tcp_stream_set_read_timeout(cli[0], 3000000000);
    return cli[0];
}

fn s2_raw_write(cli: u64, p: ptr, n: u64, code: i32) -> void {
    let wr = [0u64; 4];
    if sla_std_net_tcp_stream_write(cli, p, n, &wr[0]) != 0 { panic(code); };
    if wr[0] != n { panic(code + 1); };
}

// Read until EOF or read timeout; copy into bp (cap bytes); return total.
fn s2_raw_read_all(cli: u64, bp: ptr, cap: u64) -> u64 {
    let total: u64 = 0;
    let scratch = [0u8; 512];
    let done = false;
    while !done {
        let rd = [0u64; 4];
        let rc = sla_std_net_tcp_stream_read(cli, &scratch[0], 512, &rd[0]);
        if rc != 0 || rd[0] == 0 {
            done = true;
        } else {
            let i: u64 = 0;
            while i < rd[0] {
                if total + i < cap {
                    let dp: ptr = PTR_BYTE_ADD(bp, total + i);
                    PTR_WRITE_U8(dp, scratch[i]);
                };
                i = i + 1;
            }
            total = total + rd[0];
        };
    }
    return total;
}

fn s2_read_exact(cli: u64, bp: ptr, n: u64, code: i32) -> void {
    let got: u64 = 0;
    let scratch = [0u8; 512];
    while got < n {
        let want = n - got;
        let rd = [0u64; 4];
        let rc = sla_std_net_tcp_stream_read(cli, &scratch[0], want, &rd[0]);
        if rc != 0 { panic(code); };
        if rd[0] == 0 { panic(code + 1); };
        let i: u64 = 0;
        while i < rd[0] {
            let dp: ptr = PTR_BYTE_ADD(bp, got + i);
            PTR_WRITE_U8(dp, scratch[i]);
            i = i + 1;
        }
        got = got + rd[0];
    }
}

// Read response head (up to and including CRLFCRLF); return total bytes.
fn s2_read_head(cli: u64, bp: ptr, cap: u64, code: i32) -> u64 {
    let total: u64 = 0;
    let scratch = [0u8; 512];
    let found = false;
    while !found {
        let rd = [0u64; 4];
        let rc = sla_std_net_tcp_stream_read(cli, &scratch[0], 512, &rd[0]);
        if rc != 0 || rd[0] == 0 { panic(code); };
        let i: u64 = 0;
        while i < rd[0] {
            if total + i < cap {
                let dp: ptr = PTR_BYTE_ADD(bp, total + i);
                PTR_WRITE_U8(dp, scratch[i]);
            };
            i = i + 1;
        }
        total = total + rd[0];
        if s2_contains(bp, total, STR_PTR("\r\n\r\n"), STR_LEN("\r\n\r\n")) { found = true; };
        if total > 8192 { panic(code + 1); };
    }
    return total;
}

// Build a masked client->server WS frame at bp; return frame length.
fn s2_ws_frame(bp: ptr, opcode: u8, payload: ptr, plen: u64) -> u64 {
    let b0: ptr = PTR_BYTE_ADD(bp, 0);
    PTR_WRITE_U8(b0, 128 + opcode);
    let b1: ptr = PTR_BYTE_ADD(bp, 1);
    PTR_WRITE_U8(b1, (128 + plen) as u8);
    let mask = [0u8; 4];
    mask[0] = 42;
    mask[1] = 17;
    mask[2] = 92;
    mask[3] = 9;
    let k: u64 = 0;
    while k < 4 {
        let mp: ptr = PTR_BYTE_ADD(bp, 2 + k);
        PTR_WRITE_U8(mp, mask[k]);
        k = k + 1;
    }
    let i: u64 = 0;
    while i < plen {
        let sp: ptr = PTR_BYTE_ADD(payload, i);
        let dp: ptr = PTR_BYTE_ADD(bp, 6 + i);
        PTR_WRITE_U8(dp, PTR_READ_U8(sp) ^ mask[i % 4]);
        i = i + 1;
    }
    return 6 + plen;
}

fn s2_ws_upgrade_req() -> ptr {
    return STR_PTR("GET /ws HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
}

fn s2_ws_upgrade_req_len() -> u64 {
    return STR_LEN("GET /ws HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
}

// ---------------- v1 tests ----------------

@test "smoke2 sa_http_server_start"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24401, pp, 64410);
    // Listener is live: a raw TCP connect succeeds.
    let cli = s2_raw_conn(pc[0], 64412);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_accept"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24402, pp, 64420);
    let cli = s2_raw_conn(pc[0], 64422);
    let req_lit = "GET /a HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64423);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64424); };
    if aq[0] == 0 { panic(64425); };
    sla_http_server_req_free((aq[0] as ptr));
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_req_get_method"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24403, pp, 64430);
    let cli = s2_raw_conn(pc[0], 64432);
    let req_lit = "POST /m HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64433);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64434); };
    let req = (aq[0] as ptr);
    let mp = [0u64; 4];
    let ml = [0u64; 4];
    if sla_http_server_req_get_method(req, &mp[0], &ml[0]) != 0 { panic(64435); };
    if !s2_mem_eq((mp[0] as ptr), ml[0], STR_PTR("POST"), STR_LEN("POST")) { panic(64436); };
    sla_http_server_req_free(req);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_req_get_path"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24404, pp, 64440);
    let cli = s2_raw_conn(pc[0], 64442);
    let req_lit = "GET /v1path?q=9 HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64443);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64444); };
    let req = (aq[0] as ptr);
    let vp = [0u64; 4];
    let vl = [0u64; 4];
    if sla_http_server_req_get_path(req, &vp[0], &vl[0]) != 0 { panic(64445); };
    if !s2_mem_eq((vp[0] as ptr), vl[0], STR_PTR("/v1path"), STR_LEN("/v1path")) { panic(64446); };
    sla_http_server_req_free(req);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_req_get_header"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24405, pp, 64450);
    let cli = s2_raw_conn(pc[0], 64452);
    let req_lit = "GET /h HTTP/1.1\r\nHost: 127.0.0.1\r\nX-T: zz\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64453);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64454); };
    let req = (aq[0] as ptr);
    let vp = [0u64; 4];
    let vl = [0u64; 4];
    if sla_http_server_req_get_header(req, STR_PTR("X-T"), STR_LEN("X-T"), &vp[0], &vl[0]) != 0 { panic(64455); };
    if !s2_mem_eq((vp[0] as ptr), vl[0], STR_PTR("zz"), STR_LEN("zz")) { panic(64456); };
    // Absent header must report failure, not fabricate a value.
    let xp = [0u64; 4];
    let xl = [0u64; 4];
    if sla_http_server_req_get_header(req, STR_PTR("X-Absent"), STR_LEN("X-Absent"), &xp[0], &xl[0]) == 0 { panic(64457); };
    sla_http_server_req_free(req);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

