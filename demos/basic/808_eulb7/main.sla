@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 第 7 行高位 B(7,1)=2179，B(7,2)=60657，B(7,3)=259723（同式再上一位）。
// 意对标 806_eulb6（n=6 版互补；810 做高位对峙）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{}", eub(7, 1), eub(7, 2), eub(7, 3));
    return 0;
}

@test "basic 808 eulb7"() {
    if eub(7, 1) != 2179 { panic(80801); };
    if eub(7, 2) != 60657 { panic(80802); };
    if eub(7, 3) != 259723 { panic(80803); };
    if eub(7, 4) != 259723 { panic(80804); };
}
