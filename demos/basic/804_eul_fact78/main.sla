@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 行和桥续高位：esum(7)=5040，esum(8)=40320（fact(7/8) 陪锁）。
// 意对标 797_eul_row7 × 230_fact_iter（两族桥接续高位；805 做三向收束）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{}", esum(7), fact(7), esum(8), fact(8));
    return 0;
}

@test "basic 804 eul fact78"() {
    if esum(7) != 5040 { panic(80401); };
    if fact(7) != 5040 { panic(80402); };
    if esum(8) != 40320 { panic(80403); };
    if fact(8) != 40320 { panic(80404); };
}
