@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 26_sort 的选择版（16 插入/38 冒泡/98 拷贝：首 1 末 5）。
// 手写选择排序（16/38 的第三种手排；`sort` 方法暂无）。

fn main() -> i32 {
    let s = [3, 1, 4, 1, 5];
    let i = 0;
    while i < 5 {
        let m = i;
        let j = i + 1;
        while j < 5 {
            if s[j] < s[m] { m = j; };
            j = j + 1;
        }
        let t = s[i];
        s[i] = s[m];
        s[m] = t;
        i = i + 1;
    }
    println("{},{}", s[0], s[4]);
    return 0;
}

@test "basic 262 select sort"() {
    let s = [3, 1, 4, 1, 5];
    let i = 0;
    while i < 5 {
        let m = i;
        let j = i + 1;
        while j < 5 {
            if s[j] < s[m] { m = j; };
            j = j + 1;
        }
        let t = s[i];
        s[i] = s[m];
        s[m] = t;
        i = i + 1;
    }
    if s[0] != 1 { panic(26201); };
    if s[4] != 5 { panic(26202); };
    if s[2] != 3 { panic(26203); };
}
