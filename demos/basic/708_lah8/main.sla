@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 第 8 行高位 L(8,2)=141120，L(8,3)=141120，L(8,4)=58800（同式再上一位）。
// 意对标 706_lah7（n=7 版互补；710 做高位对峙）。

fn ltb(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm + nn - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", ltb(8, 2), ltb(8, 3), ltb(8, 4));
    return 0;
}

@test "basic 708 lah8"() {
    if ltb(8, 2) != 141120 { panic(70801); };
    if ltb(8, 3) != 141120 { panic(70802); };
    if ltb(8, 4) != 58800 { panic(70803); };
    if ltb(8, 5) != 11760 { panic(70804); };
}
