@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 出租车数表示计数（1729=1³+12³=9³+10³ 有 2 种；4104 亦 2 种）。
// 意对标 426 勾股平方和的立方版（426 互补）。

fn cube_reps(n: int) -> int {
    let c = 0;
    let a = 1;
    while a * a * a < n {
        let b = a;
        while b * b * b <= n {
            if a * a * a + b * b * b == n { c = c + 1; };
            b = b + 1;
        }
        a = a + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", cube_reps(1729), cube_reps(4104), cube_reps(1000));
    return 0;
}

@test "basic 428 taxicab"() {
    if cube_reps(1729) != 2 { panic(42801); };
    if cube_reps(4104) != 2 { panic(42802); };
    if cube_reps(1000) != 0 { panic(42803); };
}
