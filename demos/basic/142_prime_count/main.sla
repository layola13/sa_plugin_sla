@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 183_prime_upto：试除法素数计数（30 以内 10 个）。
// 与 18 的筛法互补：此处为单数试除 + 区间计数（`i*i <= n` 剪枝）。

fn is_prime(n: i32) -> bool {
    if n < 2 { return false; };
    let i = 2;
    while i * i <= n {
        if n % i == 0 { return false; };
        i = i + 1;
    }
    return true;
}

fn main() -> i32 {
    let c = 0;
    let i = 2;
    while i < 30 {
        if is_prime(i) { c = c + 1; };
        i = i + 1;
    }
    println("{}", c);
    return 0;
}

@test "basic 142 prime count"() {
    if is_prime(2) != true { panic(14201); };
    if is_prime(1) != false { panic(14202); };
    if is_prime(9) != false { panic(14203); };
    if is_prime(29) != true { panic(14204); };
    let c = 0;
    let i = 2;
    while i < 30 {
        if is_prime(i) { c = c + 1; };
        i = i + 1;
    }
    if c != 10 { panic(14205); };
}
