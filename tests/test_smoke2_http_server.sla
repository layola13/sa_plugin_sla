    let srv = s2_srv2(24441, pp, 64750);
    let cli = s2_raw_conn(pc[0], 64752);
    let req_lit = "GET /p?q=1&x=2 HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v2(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64753);
    let qp = [0u64; 4];
    let ql = [0u64; 4];
    if sla_http_server_req_get_query_v2(req, &qp[0], &ql[0]) != 0 { panic(64755); };
    if !s2_mem_eq((qp[0] as ptr), ql[0], STR_PTR("q=1&x=2"), STR_LEN("q=1&x=2")) { panic(64756); };
    sla_http_server_req_free_v2(req);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

// sa_http_server_resp_send_file_v2 is NOT in this green file: it is
// blocked by W2-DEF-SENDFILE-FD-GAP (needs a raw OS fd; the SLA fs
// surface only yields registry handles). The honest attempt lives in
// minims/minim_server_send_file_fd.sla; see WAVE2_REPORT.

@test "smoke2 sa_http_server_req_peer_addr_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24443, pp, 64780);
    let cli = s2_raw_conn(pc[0], 64782);
    let req_lit = "GET /pa HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v2(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64783);
    let big = [0u64; 8];
    let ol = [0u64; 4];
    let op2 = [0u64; 4];
    if sla_http_server_req_peer_addr_v2(req, &big[0], 64, &ol[0], &op2[0]) != 0 { panic(64785); };
    let bp2: ptr = PTR_BYTE_ADD(&big, 0);
    if !s2_mem_eq(bp2, ol[0], STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1")) { panic(64786); };
    // Peer port must equal the raw client's own local port.
    let la = [0u64; 4];
    if sla_std_net_tcp_stream_local_addr(cli, &la[0]) != 0 { panic(64787); };
    if op2[0] != (sla_net_addr_port(la[0]) as u64) { panic(64788); };
    sla_http_server_req_free_v2(req);
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

