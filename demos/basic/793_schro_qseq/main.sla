@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 商式高位 qsch(7)=8558，qsch(8)=41586，qsch(9)=206098（商式纵深）。
// 意对标 789_duel_schro9（对峙版互补；795 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn qsch(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom_mul(n + k, k) * binom_mul(n, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", qsch(7), qsch(8), qsch(9));
    return 0;
}

@test "basic 793 schro qseq"() {
    if qsch(7) != 8558 { panic(79301); };
    if qsch(8) != 41586 { panic(79302); };
    if qsch(9) != 206098 { panic(79303); };
    if qsch(6) != 1806 { panic(79304); };
}
