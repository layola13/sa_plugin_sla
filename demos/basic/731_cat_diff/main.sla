@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 反射差式 C(n)=C(2n,n)-C(2n,n+1)（C(4)=14，C(5)=42，C(6)=132）。
// 意对标 351_catalan（商式版互补；735 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catdf(n: int) -> int {
    return binom_mul(2 * n, n) - binom_mul(2 * n, n + 1);
}

fn main() -> i32 {
    println("{},{},{}", catdf(4), catdf(5), catdf(6));
    return 0;
}

@test "basic 731 cat diff"() {
    if catdf(4) != 14 { panic(73101); };
    if catdf(5) != 42 { panic(73102); };
    if catdf(6) != 132 { panic(73103); };
    if catdf(3) != 5 { panic(73104); };
}
