@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Vec 下标写（226 为定长数组版：9,2,12）。
// 直接覆写 + 读-改-写组合。

fn main() -> i32 {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v[0] = 9;
    v[2] = v[2] + v[0];
    println("{},{},{}", v[0], v[1], v[2]);
    return 0;
}

@test "basic 248 vec write"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v[0] = 9;
    v[2] = v[2] + v[0];
    if v[0] != 9 { panic(24801); };
    if v[1] != 2 { panic(24802); };
    if v[2] != 12 { panic(24803); };
}
