@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 9 行 1,502,14608,88234,156190,88234,14608,502,1（行和 362880=9!；循环求和）。
// 意对标 916_eul9（单格版互补；同式行复算）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eul(9, 4), eul(9, 5), esum(9));
    return 0;
}

@test "basic 917 eul row9"() {
    if eul(9, 4) != 156190 { panic(91701); };
    if eul(9, 5) != 88234 { panic(91702); };
    if esum(9) != 362880 { panic(91703); };
    if eul(8, 3) != 15619 { panic(91704); };
}
