@test "smoke2 sa_http_client_req_send_async_v2"() {
    let h = go s2_echo2(24626 + 0 * 65536 + 65540 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24626, STR_PTR("/async2"), STR_LEN("/async2"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65543); };
    let rq = [0u64; 4];
    if sla_http_client_req_new_v2((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65544); };
    let req = (rq[0] as ptr);
    let op = [0u64; 4];
    if sla_http_client_req_send_async_v2(req, &op[0]) != 0 { panic(65545); };
    if op[0] == 0 { panic(65546); };
    let opp = (op[0] as ptr);
    let ready = [0u64; 4];
    if sla_http_client_async_poll_v2(opp, 10000, &ready[0]) != 0 { panic(65547); };
    if ready[0] == 0 { panic(65548); };
    let rs = [0u64; 4];
    if sla_http_client_async_take_response_v2(opp, &rs[0]) != 0 { panic(65549); };
    let resp = (rs[0] as ptr);
    if !s2_body_contains(resp, STR_PTR("/async2"), STR_LEN("/async2")) { panic(65550); };
    sla_http_client_resp_free(resp);
    sla_http_client_async_free_v2(opp);
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

