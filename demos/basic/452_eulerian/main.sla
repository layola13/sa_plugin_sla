@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Eulerian 数（A(4,1)=11，A(4,2)=11，A(3,1)=4）。
// 意对标 451 Bell 的排列版（451 互补；455 做对峙）。

fn eulerian(n: int, m: int) -> int {
    if n == 0 { return 0; };
    if m < 0 { return 0; };
    if m == 0 { return 1; };
    if m >= n { return 0; };
    return (n - m) * eulerian(n - 1, m - 1) + (m + 1) * eulerian(n - 1, m);
}

fn main() -> i32 {
    println("{},{},{}", eulerian(4, 1), eulerian(4, 2), eulerian(3, 1));
    return 0;
}

@test "basic 452 eulerian"() {
    if eulerian(4, 1) != 11 { panic(45201); };
    if eulerian(4, 2) != 11 { panic(45202); };
    if eulerian(3, 1) != 4 { panic(45203); };
}
