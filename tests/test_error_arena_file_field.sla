// expect: ArenaUnsafe
// F2-A C1 corpus: a struct with a File field is not arena-safe
// (design section 2.2, external resource row; diagnostic quadruple
// names root type / field path / forbidden type / class).
struct FileWrap { f: File }

fn id_file_wrap(w: FileWrap) -> FileWrap { return w; }

fn neg_file_field(p: FileWrap) -> i32 {
    arena {
        let w = id_file_wrap(p);
    }
    return 0;
}
