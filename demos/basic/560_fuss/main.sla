@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Fuss-Catalan 三元数 fuss(3,n)=C(3n,n)/(2n+1)（n=2→3，n=3→12，n=4→55）。
// 意对标 351 catalan（二元商式版互补；此处为三元商式，564 做卷积对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fuss(n: int) -> int {
    return binom_mul(3 * n, n) / (2 * n + 1);
}

fn main() -> i32 {
    println("{},{},{}", fuss(2), fuss(3), fuss(4));
    return 0;
}

@test "basic 560 fuss"() {
    if fuss(2) != 3 { panic(56001); };
    if fuss(3) != 12 { panic(56002); };
    if fuss(4) != 55 { panic(56003); };
    if fuss(1) != 1 { panic(56004); };
}
