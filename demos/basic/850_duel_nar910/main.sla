@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 高位二对峙：行和 vs Catalan 商式（n=8：1430 对 1430；n=9：4862 对 4862）。
// 意对标 847_nar_row9 × 720_duel_nar8（行源与对峙体例合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{},{}", nsum(8), catd(8), nsum(9), catd(9));
    return 0;
}

@test "basic 850 duel nar910"() {
    if nsum(8) != 1430 { panic(85001); };
    if catd(8) != 1430 { panic(85002); };
    if nsum(9) != 4862 { panic(85003); };
    if catd(9) != 4862 { panic(85004); };
}
