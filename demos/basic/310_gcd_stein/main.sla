@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 119_gcd3 的 Stein 版（17 取模/256 减法之第三实现：6,1）。
// 二进制 gcd（公因子 2 提取 + 奇偶归约；286 的双向已见，此处加第三向）。

fn gcd_stein(a: int, b: int) -> int {
    let x = a;
    let y = b;
    let shift = 0;
    while x % 2 == 0 && y % 2 == 0 {
        x = x / 2;
        y = y / 2;
        shift = shift + 1;
    }
    while x != y {
        if x % 2 == 0 {
            x = x / 2;
        } else if y % 2 == 0 {
            y = y / 2;
        } else if x > y {
            x = (x - y) / 2;
        } else {
            y = (y - x) / 2;
        };
    }
    let r = x;
    let i = 0;
    while i < shift {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{}", gcd_stein(48, 18), gcd_stein(7, 13));
    return 0;
}

@test "basic 310 gcd stein"() {
    if gcd_stein(48, 18) != 6 { panic(31001); };
    if gcd_stein(7, 13) != 1 { panic(31002); };
    if gcd_stein(100, 75) != 25 { panic(31003); };
}
