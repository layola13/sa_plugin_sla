@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 双实现对峙：短递推 vs 桥序（n=4：6 对 6；n=5：18 对 18）。
// 桥序 F(n)=(Catalan(n)-F(n-1))/2（C(5)-F(4)=42-6=36，半之 18）。
// 意对标 656_fine × 桥序版（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cat(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn fbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return (cat(n) - fbr(n - 1)) / 2;
}

fn main() -> i32 {
    println("{},{},{},{}", fsho(4), fbr(4), fsho(5), fbr(5));
    return 0;
}

@test "basic 659 duel fine"() {
    if fsho(4) != 6 { panic(65901); };
    if fbr(4) != 6 { panic(65902); };
    if fsho(5) != 18 { panic(65903); };
    if fbr(5) != 18 { panic(65904); };
}
