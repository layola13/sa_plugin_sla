@import "sa_std/slot_pool.sla"

// Regression: PTR_READ_U64 used as an expression was typed as a raw
// pointer by the imported-macro result-kind table (the explicit
// raw_pointer entry shadowed the generic _READ_U64 -> u64 rule), so
// any comparison or arithmetic on its result failed the checker with
// error.TypeMismatch (binary_expr). Corpus origin: reg-shard4
// REG4-CHECKER-PTR-READ (minims sp7/sp8d); the slot_pool corpus file
// could not compile at all. Both forms below failed pre-fix on both
// backends; the write/index controls (sp8c form) always passed.

@test "ptr_read_u64 direct comparison"() {
    let p0 = slot_pool_new();
    let (p1, i0) = slot_pool_alloc(p0, 8);
    let g0: ptr = slot_pool_get(&p1, 0, 8);
    PTR_WRITE_U64(g0, 111);
    if PTR_READ_U64(g0) != 111 { panic(49601); };
    if PTR_READ_U64(g0) == 112 { panic(49602); };
}

@test "ptr_read_u64 bound then compared"() {
    let p0 = slot_pool_new();
    let (p1, i0) = slot_pool_alloc(p0, 8);
    let (p2, i1) = slot_pool_alloc(p1, 8);
    let g0: ptr = slot_pool_get(&p2, 0, 8);
    let g1: ptr = slot_pool_get(&p2, 1, 8);
    PTR_WRITE_U64(g0, 77);
    let r0 = PTR_READ_U64(g0);
    let r1 = PTR_READ_U64(g1);
    if r0 != 77 { panic(49611); };
    if r1 != 0 { panic(49612); };
}

@test "ptr_read_u64 arithmetic and typed binding"() {
    let p0 = slot_pool_new();
    let (p1, i0) = slot_pool_alloc(p0, 8);
    let g0: ptr = slot_pool_get(&p1, 0, 8);
    PTR_WRITE_U64(g0, 111);
    let r: u64 = PTR_READ_U64(g0);
    if r + 1 != 112 { panic(49621); };
    if PTR_READ_U64(g0) + 1 != 112 { panic(49622); };
    let want: u64 = 111;
    if PTR_READ_U64(g0) != want { panic(49623); };
}
