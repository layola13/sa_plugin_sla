@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 三向：短递推 × 卷积 × 桥序（n=5：18 三锁）。
// 意对标 658_fine_high（高位源互补；605 三向体例收束 Fine 族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cat(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn fbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return (cat(n) - fbr(n - 1)) / 2;
}

fn fconv(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let s = 0;
    let k = 2;
    while k <= n {
        s = s + cat(k - 1) * fconv(n - k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", fsho(5), fconv(5), fbr(5));
    return 0;
}

@test "basic 665 tri fine"() {
    if fsho(5) != 18 { panic(66501); };
    if fconv(5) != 18 { panic(66502); };
    if fbr(5) != 18 { panic(66503); };
    if fbr(4) != 6 { panic(66504); };
}
