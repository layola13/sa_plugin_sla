@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 430_find_last：逆向查找（2,-1）。
// SLA 无 `findLast`（闭包作参数拒识，见 385），用倒序循环表达
//（与 116/140 的正向查找方向互补，160 覆盖倒序求和）。

fn find_last(a: [i32; 3], v: i32) -> i32 {
    let n = len(a) as i32;
    let i = n - 1;
    while i >= 0 {
        if a[i] == v { return i; };
        i = i - 1;
    }
    return -1;
}

fn main() -> i32 {
    let a: [i32; 3] = [1, 2, 3];
    println("{},{}", find_last(a, 3), find_last(a, 9));
    return 0;
}

@test "basic 181 find last"() {
    let a: [i32; 3] = [1, 2, 3];
    if find_last(a, 3) != 2 { panic(18101); };
    if find_last(a, 1) != 0 { panic(18102); };
    if find_last(a, 9) != -1 { panic(18103); };
}
