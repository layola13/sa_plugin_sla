@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 续高位 M(9)=835（M(8)=323 对 323；卷积和 512）。
// 意对标 634_motz8（n=8 版互补；749 做迭代/直和对峙）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", moz(8), moz(9));
    return 0;
}

@test "basic 746 motz9"() {
    if moz(9) != 835 { panic(74601); };
    if moz(8) != 323 { panic(74602); };
    if moz(7) != 127 { panic(74603); };
}
