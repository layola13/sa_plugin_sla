@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 列对峙二：建表 vs 直和（(6,8)：40081 对 40081；(7,8)：108545 对 108545）。
// 意对标 893_delan_col8 × 889_duel_delan8（列源与对峙体例合流）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ddel(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        if k <= n {
            let p = 1;
            let j = 0;
            while j < k {
                p = p * 2;
                j = j + 1;
            }
            s = s + binom_mul(m, k) * binom_mul(n, k) * p;
        };
        k = k + 1;
    }
    return s;
}

fn ddel2(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        s = s + binom_mul(m, k) * binom_mul(n + m - k, m);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", delan(6, 8), ddel(6, 8), delan(7, 8), ddel(7, 8));
    return 0;
}

@test "basic 894 duel delan col8"() {
    if delan(6, 8) != 40081 { panic(89401); };
    if ddel(6, 8) != 40081 { panic(89402); };
    if delan(7, 8) != 108545 { panic(89403); };
    if ddel(7, 8) != 108545 { panic(89404); };
}
