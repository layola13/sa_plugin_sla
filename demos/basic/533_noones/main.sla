@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 无 1 部数分拆：最小部 ≥2（n=6→4，n=7→4，n=8→7）。
// 意对标 529 coinchange（同为完全背包；此处硬币为 {2..n} 全集）。

fn noones_part(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 2;
    while k <= n {
        let s = k;
        while s <= n {
            dp[s] = dp[s] + dp[s - k];
            s = s + 1;
        }
        k = k + 1;
    }
    return dp[n];
}

fn main() -> i32 {
    println("{},{},{}", noones_part(6), noones_part(7), noones_part(8));
    return 0;
}

@test "basic 533 noones"() {
    if noones_part(6) != 4 { panic(53301); };
    if noones_part(7) != 4 { panic(53302); };
    if noones_part(8) != 7 { panic(53303); };
}
