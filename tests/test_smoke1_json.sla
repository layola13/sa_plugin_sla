@test "smoke1 sa_json_as_f64"() {
    let i = sla_json_parse(STR_PTR("42"), STR_LEN("42"));
    let v = [0u64; 4];
    let rc = sla_json_as_f64(i, &v[0]);
    if rc != 0 { panic(52090); };
    if v[0] == 0 { panic(52091); };
    let bits42 = v[0];
    let z = sla_json_parse(STR_PTR("0"), STR_LEN("0"));
    let rc2 = sla_json_as_f64(z, &v[0]);
    if rc2 != 0 { panic(52092); };
    if v[0] != 0 { panic(52093); };
    let h = sla_json_parse(STR_PTR("42.5"), STR_LEN("42.5"));
    sla_json_as_f64(h, &v[0]);
    if v[0] == bits42 { panic(52094); };
    if v[0] == 0 { panic(52095); };
}

