    sla_std_close(cell[0]);
}

@test "smoke1 sa_std_net_udp_leave_multicast_v6"() {
    let cell = [0u64; 4];
    let rc0 = sla_std_net_udp_bind(STR_PTR("::1"), STR_LEN("::1"), 0, &cell[0]);
    if rc0 != 0 { panic(59880); };
    let rc = sla_std_net_udp_join_multicast_v6(cell[0], STR_PTR("ff02::2"), STR_LEN("ff02::2"), 1);
    if rc != 0 { panic(59881); };
    let rc2 = sla_std_net_udp_leave_multicast_v6(cell[0], STR_PTR("ff02::2"), STR_LEN("ff02::2"), 1);
    if rc2 != 0 { panic(59882); };
    sla_std_close(cell[0]);
}

