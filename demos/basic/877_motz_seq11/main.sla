@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 序列前 12 项和 9360（M(11)=5798；前缀和循环求和）。
// 意对标 876_motz11（单值版互补；同式序列复算）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn mseq(n: int) -> int {
    let s = 0;
    let i = 0;
    while i <= n {
        s = s + moz(i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", mseq(11), mseq(10));
    return 0;
}

@test "basic 877 motz seq11"() {
    if mseq(11) != 9360 { panic(87701); };
    if mseq(10) != 3562 { panic(87702); };
    if mseq(9) != 1374 { panic(87703); };
    if moz(11) != 5798 { panic(87704); };
}
