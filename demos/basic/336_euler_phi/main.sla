@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 欧拉函数（φ(9)=6，φ(10)=4）。
// 意对标 tsgosa 183_prime_upto 的计数版（46 为素数版）：互素计数（17 口径）。

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn phi(n: int) -> int {
    let c = 0;
    let k = 1;
    while k < n {
        if gcd(k, n) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{}", phi(9), phi(10));
    return 0;
}

@test "basic 336 euler phi"() {
    if phi(9) != 6 { panic(33601); };
    if phi(10) != 4 { panic(33602); };
    if phi(7) != 6 { panic(33603); };
}
