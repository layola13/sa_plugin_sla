    if buf[1] != 67 { panic(51173); };
    if buf[2] != 68 { panic(51174); };
    if buf[0] != 46 { panic(51175); };
    sla_std_close(cell[0]);
}

@test "smoke1 sa_std_fs_file_seek"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/stdseek.txt"), STR_LEN("smoke1_fs/stdseek.txt"), STR_PTR("0123456789"), STR_LEN("0123456789"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_open_read(STR_PTR("smoke1_fs/stdseek.txt"), STR_LEN("smoke1_fs/stdseek.txt"), &cell[0]);
    if rc != 0 { panic(51180); };
    let pos = [0u64; 4];
    let rc2 = sla_std_fs_file_seek(cell[0], 0, 4, &pos[0]);
    if rc2 != 0 { panic(51181); };
    if pos[0] != 4 { panic(51182); };
    let rc3 = sla_std_fs_file_seek(cell[0], 1, 2, &pos[0]);
    if rc3 != 0 { panic(51183); };
    if pos[0] != 6 { panic(51184); };
    let rc4 = sla_std_fs_file_seek(cell[0], 2, 0 - 1, &pos[0]);
    if rc4 != 0 { panic(51185); };
    if pos[0] != 9 { panic(51186); };
    sla_std_close(cell[0]);
}

@test "smoke1 sa_std_close"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/close2.txt"), STR_LEN("smoke1_fs/close2.txt"), STR_PTR("q"), STR_LEN("q"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_open_read(STR_PTR("smoke1_fs/close2.txt"), STR_LEN("smoke1_fs/close2.txt"), &cell[0]);
    if rc != 0 { panic(51190); };
    let rc2 = sla_std_close(cell[0]);
    if rc2 != 0 { panic(51191); };
    let rc3 = sla_std_close(cell[0]);
    if rc3 == 0 { panic(51192); };
}

@test "smoke1 sa_std_fs_dir_entries_get"() {
    s1_mkdir();
    sla_fs_remove_dir_all(STR_PTR("smoke1_fs/entries"), STR_LEN("smoke1_fs/entries"));
    sla_fs_mkdir_p(STR_PTR("smoke1_fs/entries"), STR_LEN("smoke1_fs/entries"));
    sla_fs_write_file(STR_PTR("smoke1_fs/entries/a.txt"), STR_LEN("smoke1_fs/entries/a.txt"), STR_PTR("1"), STR_LEN("1"));
    sla_fs_write_file(STR_PTR("smoke1_fs/entries/b.txt"), STR_LEN("smoke1_fs/entries/b.txt"), STR_PTR("2"), STR_LEN("2"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_read_dir_entries(STR_PTR("smoke1_fs/entries"), STR_LEN("smoke1_fs/entries"), 16, &cell[0]);
    if rc != 0 { panic(51200); };
    let ent = [0u64; 4];
    let rc2 = sla_std_fs_dir_entries_get(cell[0], 0, &ent[0]);
    if rc2 != 0 { panic(51201); };
    if ent[0] == 0 { panic(51202); };
    if sla_fs_dir_entry_name_len(ent[0]) == 0 { panic(51203); };
    sla_fs_dir_entry_free(^ent[0]);
    sla_fs_dir_entries_free(^cell[0]);
}

@test "smoke1 sa_fs_dir_entries_len"() {
    s1_mkdir();
    sla_fs_remove_dir_all(STR_PTR("smoke1_fs/entries2"), STR_LEN("smoke1_fs/entries2"));
    sla_fs_mkdir_p(STR_PTR("smoke1_fs/entries2"), STR_LEN("smoke1_fs/entries2"));
    sla_fs_write_file(STR_PTR("smoke1_fs/entries2/a.txt"), STR_LEN("smoke1_fs/entries2/a.txt"), STR_PTR("1"), STR_LEN("1"));
    sla_fs_write_file(STR_PTR("smoke1_fs/entries2/b.txt"), STR_LEN("smoke1_fs/entries2/b.txt"), STR_PTR("2"), STR_LEN("2"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_read_dir_entries(STR_PTR("smoke1_fs/entries2"), STR_LEN("smoke1_fs/entries2"), 16, &cell[0]);
    if rc != 0 { panic(51210); };
    if sla_fs_dir_entries_len(cell[0]) != 2 { panic(51211); };
    sla_fs_dir_entries_free(^cell[0]);
}

@test "smoke1 sa_fs_dir_entries_free"() {
    s1_mkdir();
    sla_fs_remove_dir_all(STR_PTR("smoke1_fs/entries3"), STR_LEN("smoke1_fs/entries3"));
    sla_fs_mkdir_p(STR_PTR("smoke1_fs/entries3"), STR_LEN("smoke1_fs/entries3"));
    sla_fs_write_file(STR_PTR("smoke1_fs/entries3/a.txt"), STR_LEN("smoke1_fs/entries3/a.txt"), STR_PTR("1"), STR_LEN("1"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_read_dir_entries(STR_PTR("smoke1_fs/entries3"), STR_LEN("smoke1_fs/entries3"), 16, &cell[0]);
    if rc != 0 { panic(51220); };
    if sla_fs_dir_entries_len(cell[0]) != 1 { panic(51221); };
    let rc2 = sla_fs_dir_entries_free(^cell[0]);
    if rc2 != 0 { panic(51222); };
}

fn s1_meta(path: ptr, path_len: u64, code: i32) -> u64 {
    let cell = [0u64; 4];
    let rc = sla_std_fs_metadata(path, path_len, &cell[0]);
    if rc != 0 { panic(code); };
    if cell[0] == 0 { panic(code + 1); };
    return cell[0];
}

fn s1_meta_file() -> u64 {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/meta.txt"), STR_LEN("smoke1_fs/meta.txt"), STR_PTR("0123456789"), STR_LEN("0123456789"));
    return s1_meta(STR_PTR("smoke1_fs/meta.txt"), STR_LEN("smoke1_fs/meta.txt"), 51230);
}

@test "smoke1 sa_std_fs_metadata_free"() {
    let m = s1_meta_file();
    let rc = sla_std_fs_metadata_free(m);
    if rc != 0 { panic(51240); };
}

@test "smoke1 sa_fs_metadata_is_file"() {
    let m = s1_meta_file();
    if sla_fs_metadata_is_file(m) != 1 { panic(51250); };
    sla_std_fs_metadata_free(m);
}

@test "smoke1 sa_fs_metadata_is_directory"() {
    s1_mkdir();
    let m = s1_meta(STR_PTR("smoke1_fs"), STR_LEN("smoke1_fs"), 51260);
    if sla_fs_metadata_is_directory(m) != 1 { panic(51262); };
    if sla_fs_metadata_is_file(m) != 0 { panic(51263); };
    sla_std_fs_metadata_free(m);
}

@test "smoke1 sa_fs_metadata_is_symlink"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/target.txt"), STR_LEN("smoke1_fs/target.txt"), STR_PTR("t"), STR_LEN("t"));
    sla_fs_remove_file(STR_PTR("smoke1_fs/link.txt"), STR_LEN("smoke1_fs/link.txt"));
    let rc = sla_fs_symlink(STR_PTR("smoke1_fs/target.txt"), STR_LEN("smoke1_fs/target.txt"), STR_PTR("smoke1_fs/link.txt"), STR_LEN("smoke1_fs/link.txt"));
    if rc != 0 { panic(51270); };
    // Metadata (stat) follows links -> not a symlink; the lstat face is what
    // the sa_fs_metadata_* getters use if they report symlink-ness. We only
    // assert the getter agrees with is_file on the target here.
    let m = s1_meta(STR_PTR("smoke1_fs/link.txt"), STR_LEN("smoke1_fs/link.txt"), 51271);
    if sla_fs_metadata_is_symlink(m) == 1 {
        if sla_fs_metadata_is_file(m) != 0 { panic(51272); };
    } else {
        if sla_fs_metadata_is_file(m) != 1 { panic(51273); };
    };
    sla_std_fs_metadata_free(m);
}

@test "smoke1 sa_fs_metadata_is_block_device"() {
    let m = s1_meta_file();
