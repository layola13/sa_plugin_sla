    let rc2 = sla_std_fs_file_write_all_at(cell[0], STR_PTR("CD"), STR_LEN("CD"), 1);
    if rc2 != 0 { panic(51171); };
    sla_std_close(cell[0]);
    let rc3 = sla_std_fs_open_read(STR_PTR("smoke1_fs/stdwriteallat.txt"), STR_LEN("smoke1_fs/stdwriteallat.txt"), &cell[0]);
