@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 续高位商式 N(n,k)=C(n,k)C(n,k+1)/n（先乘后除精确整除）。
// N(7,1)=21，N(7,2)=105，N(7,3)=175（719 做行和对峙）。
// 意对标 596_narayana（n≤6 版互补；此处为 n=7 高位行）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(7, 1), nar(7, 2), nar(7, 3));
    return 0;
}

@test "basic 716 nar7"() {
    if nar(7, 1) != 21 { panic(71601); };
    if nar(7, 2) != 105 { panic(71602); };
    if nar(7, 3) != 175 { panic(71603); };
    if nar(6, 2) != 50 { panic(71604); };
}
