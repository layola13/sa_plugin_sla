@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1071_closure_arr：捕获数组的闭包（8）。
// 闭包捕获数组 + 参数索引（与 20 的标量捕获互补；闭包体仅表达式，
// 块体/赋值捕获不可解析，探针结论见账本）。

fn main() -> i32 {
    let a: [i32; 3] = [1, 2, 3];
    let f = |i: int| a[i] * 2;
    println("{}", f(0) + f(2));
    return 0;
}

@test "basic 164 closure array"() {
    let a: [i32; 3] = [1, 2, 3];
    let f = |i: int| a[i] * 2;
    if f(0) + f(2) != 8 { panic(16401); };
    if f(1) != 4 { panic(16402); };
}
