@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1250_mask_idioms：十六进制字面量掩码（255,511）。
// SLA 支持 `0x` 前缀（`0o`/`0b` 不可解析，InvalidCharacter）；
// 与 76 的位运算口径一致，此处主覆盖字面量进制。

fn main() -> i32 {
    let x = 255;
    println("{},{},{}", x & 0xFF, x | 0x100, 0x10 + 0x1);
    return 0;
}

@test "basic 145 hex mask"() {
    if 0xFF != 255 { panic(14501); };
    let x = 255;
    if (x & 0xFF) != 255 { panic(14502); };
    if (x | 0x100) != 511 { panic(14503); };
    if 0x10 + 0x1 != 17 { panic(14504); };
}
