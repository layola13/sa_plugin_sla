@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 09_array_methods：push/len + 手写 map/filter/forEach 等价循环。
// 不依赖迭代器协议（Phase 6 未完成），全部用 while 显式循环表达。

fn vec_sum(values: Vec<i32>) -> i32 {
    let t: i32 = 0;
    let i: i32 = 0;
    while i < len(values) as i32 {
        t = t + values[i];
        i = i + 1;
    }
    return t;
}

fn vec_sum_squares(values: Vec<i32>) -> i32 {
    let t: i32 = 0;
    let i: i32 = 0;
    while i < len(values) as i32 {
        let x = values[i];
        t = t + x * x;
        i = i + 1;
    }
    return t;
}

fn vec_count_even(values: Vec<i32>) -> i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while i < len(values) as i32 {
        if values[i] % 2 == 0 {
            n = n + 1;
        };
        i = i + 1;
    }
    return n;
}

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    a.push(4);
    println("{}", len(a));
    println("{}", vec_sum_squares(a));
    println("{}", vec_count_even(a));
    println("{}", vec_sum(a));
    return 0;
}

@test "basic 09 vec push len sum"() {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    a.push(4);
    if len(a) != 4 { panic(901); };
    if vec_sum(a) != 10 { panic(902); };
    if vec_sum_squares(a) != 30 { panic(903); };
    if vec_count_even(a) != 2 { panic(904); };
}
