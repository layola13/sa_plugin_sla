@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 本原勾股数组计数（斜边 ≤30 有 5 组）。
// 意对标 338 勾股判定的计数版（338/339 互补）。

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn prim_pyth_count(limit: int) -> int {
    let c = 0;
    let a = 1;
    while a <= limit {
        let b = a + 1;
        while b <= limit {
            let c2 = a * a + b * b;
            let h = 1;
            while h <= limit {
                if h * h == c2 {
                    if gcd(a, b) == 1 { c = c + 1; };
                };
                h = h + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{}", prim_pyth_count(30), prim_pyth_count(15));
    return 0;
}

@test "basic 426 prim pyth"() {
    if prim_pyth_count(30) != 5 { panic(42601); };
    if prim_pyth_count(15) != 2 { panic(42602); };
}
