@test "smoke2 sa_http_client_req_set_max_response_bytes_v2"() {
    let h = go s2_echo2(24624 + 1 * 65536 + 65500 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24624, STR_PTR("/cap"), STR_LEN("/cap"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65503); };
    let rq = [0u64; 4];
    if sla_http_client_req_new_v2((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65504); };
    let req = (rq[0] as ptr);
    if sla_http_client_req_set_max_response_bytes_v2(req, 4) != 0 { panic(65505); };
    // Invariant: the send must fail, or the delivered body must fit the cap.
    let rs = [0u64; 4];
    let src = sla_http_client_req_send_v2(req, &rs[0]);
    if src == 0 {
        let resp = (rs[0] as ptr);
        if sla_http_client_resp_body_len(resp) > 4 { panic(65506); };
        sla_http_client_resp_free(resp);
    };
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

