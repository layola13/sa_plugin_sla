@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类双实现对峙：建表 vs 递归（(7,2)：63 对 63；(7,3)：301 对 301）。
// 意对标 696_stir27 × 递归版（两源单实现见各源；286 系对峙体例）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rs2(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rs2(n - 1, k - 1) + k * rs2(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", svt(7, 2), rs2(7, 2), svt(7, 3), rs2(7, 3));
    return 0;
}

@test "basic 699 duel stir27"() {
    if svt(7, 2) != 63 { panic(69901); };
    if rs2(7, 2) != 63 { panic(69902); };
    if svt(7, 3) != 301 { panic(69903); };
    if rs2(7, 3) != 301 { panic(69904); };
}
