@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 第 4 行 1,76,230,76,1（行和 384=2^4·4!；行和循环求和）。
// 意对标 676_eulb（单格版互补；同式行复算）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn ebsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eub(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eub(4, 1), eub(4, 2), ebsum(4));
    return 0;
}

@test "basic 677 eulb row"() {
    if eub(4, 1) != 76 { panic(67701); };
    if eub(4, 2) != 230 { panic(67702); };
    if ebsum(4) != 384 { panic(67703); };
    if eub(4, 0) != 1 { panic(67704); };
}
