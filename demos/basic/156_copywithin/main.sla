@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 981_copywithin：重叠拷贝（3,4）。
// SLA 无 `copyWithin` 方法，用显式循环前向覆盖表达（与 89/103 的
// 手工切片口径一致；源区间在目标之后，前向即安全）；

fn main() -> i32 {
    let a: [i32; 4] = [1, 2, 3, 4];
    let i = 0;
    while i < 2 {
        a[i] = a[i + 2];
        i = i + 1;
    }
    println("{},{}", a[0], a[1]);
    return 0;
}

@test "basic 156 copywithin"() {
    let a: [i32; 4] = [1, 2, 3, 4];
    let i = 0;
    while i < 2 {
        a[i] = a[i + 2];
        i = i + 1;
    }
    if a[0] != 3 { panic(15601); };
    if a[1] != 4 { panic(15602); };
    if a[2] != 3 { panic(15603); };
}
