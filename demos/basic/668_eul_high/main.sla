@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 高位 E(6,2)=302（E(6,1)=57 对 57；`4·26+3·66`）。
// 意对标 666_eulerian（低位版互补；670 做高位对峙）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{}", eul(6, 1), eul(6, 2));
    return 0;
}

@test "basic 668 eul high"() {
    if eul(6, 2) != 302 { panic(66801); };
    if eul(6, 1) != 57 { panic(66802); };
    if eul(5, 2) != 66 { panic(66803); };
}
