    let b1 = [0u8; 2];
    let b2 = [0u8; 2];
    let iovs = [0u64; 4];
    let p1: u64 = 0;
    let s1bp3: ptr = PTR_BYTE_ADD(&b1, 0);
    PTR_ADDR(p1, s1bp3);
    iovs[0] = p1;
    iovs[1] = 2;
    let p2: u64 = 0;
    let s1bp4: ptr = PTR_BYTE_ADD(&b2, 0);
    PTR_ADDR(p2, s1bp4);
    iovs[2] = p2;
    iovs[3] = 2;
    let rd = [0u64; 4];
    let from = [0u64; 4];
    let rc = sla_std_net_udp_recv_from_vectored(a, &iovs[0], 2, &rd[0], &from[0]);
    if rc != 0 { panic(59584); };
    if rd[0] != 4 { panic(59585); };
    if b1[0] != 118 { panic(59586); };
    if b2[1] != 33 { panic(59587); };
    if (sla_net_addr_port(from[0]) as u64) != bport { panic(59588); };
    sla_std_close(a);
    sla_std_close(b);
}

