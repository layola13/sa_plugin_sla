@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 172_sum_2d：2x3 二维求和（1..6，总和 21）。
// SLA 无嵌套数组字面量，按 19/28 的行主序扁平布局用 [int; 6] + 双层 while。

fn main() -> i32 {
    let m = [1, 2, 3, 4, 5, 6];
    let t = 0;
    let i = 0;
    while i < 2 {
        let j = 0;
        while j < 3 {
            t = t + m[i * 3 + j];
            j = j + 1;
        }
        i = i + 1;
    }
    println("{}", t);
    return 0;
}

@test "basic 58 sum 2d"() {
    let m = [1, 2, 3, 4, 5, 6];
    let t = 0;
    for i in 0..2 {
        for j in 0..3 {
            t = t + m[i * 3 + j];
        }
    }
    if t != 21 { panic(5801); };
}
