@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 序列前 12 项和 820988（B(11)=678570；前缀和循环求和）。
// 意对标 906_bell11（单值版互补；同式序列复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn bseq(n: int) -> int {
    let s = 0;
    let i = 0;
    while i <= n {
        s = s + bell(i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", bseq(11), bseq(10));
    return 0;
}

@test "basic 907 bell seq11"() {
    if bseq(11) != 820988 { panic(90701); };
    if bseq(10) != 142418 { panic(90702); };
    if bseq(9) != 26443 { panic(90703); };
    if bell(11) != 678570 { panic(90704); };
}
