@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 119_gcd3 的减法版（17/80 为取模版：6,1）。
// 更相减损（`x!=y` 循环相减）；与 51 的累减口径一致。

fn gcd_sub(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while x != y {
        if x > y {
            x = x - y;
        } else {
            y = y - x;
        };
    }
    return x;
}

fn main() -> i32 {
    println("{},{}", gcd_sub(48, 18), gcd_sub(7, 13));
    return 0;
}

@test "basic 256 gcd sub"() {
    if gcd_sub(48, 18) != 6 { panic(25601); };
    if gcd_sub(7, 13) != 1 { panic(25602); };
    if gcd_sub(12, 12) != 12 { panic(25603); };
}
