@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Jacobi 符号（(2|15)=1，(2|21)=-1 以差表之，(3|15)=0）。
// 意对标 499 Legendre 的合数版（499 互补）。

fn powmod(base: int, exp: int, m: int) -> int {
    let r = 1;
    let b = base % m;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = r * b % m; };
        b = b * b % m;
        e = e / 2;
    }
    return r;
}

fn legendre_pm(a: int, p: int) -> int {
    let r = powmod(a % p, (p - 1) / 2, p);
    if r == 1 { return 1; };
    if r == 0 { return 0; };
    return 0 - 1;
}

fn jacobi(a: int, n: int) -> int {
    let r = 1;
    let m = n;
    let d = 2;
    while d * d <= m {
        while m % d == 0 {
            r = r * legendre_pm(a, d);
            m = m / d;
        }
        d = d + 1;
    }
    if m > 1 { r = r * legendre_pm(a, m); };
    return r;
}

fn main() -> i32 {
    println("{},{},{}", jacobi(2, 15), jacobi(2, 21), jacobi(3, 15));
    return 0;
}

@test "basic 500 jacobi"() {
    if jacobi(2, 15) != 1 { panic(50001); };
    if jacobi(2, 21) != 0 - 1 { panic(50002); };
    if jacobi(3, 15) != 0 { panic(50003); };
}
