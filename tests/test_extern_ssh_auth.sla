// SSH extern carrier batch -- password auth (1 name):
// sa_std_ssh_auth_password.
// Requires two live OpenSSH test instances set up by the gate script:
// 127.0.0.1:55522 (public-key only, password auth disabled) and
// 127.0.0.1:55523 (user satest, password "s3cret-ssh"). Every failed
// premise panics loudly (no silent pass). Status codes per ssh.sai:
// 0 ok, 4 access denied.
@import "sla_std/wrap/ssh.sla"
@import "sa_std/string.sa"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

fn ssh_buf_eq(h: u64, lit: ptr, litn: u64) -> u32 {
    let n: u64 = sla_std_ssh_buffer_len(h);
    if n != litn { return 0; };
    let sb = SshBuffer { raw: h };
    let v = sla_std_ssh_buffer_data(&sb);
    if v.len() != litn { return 0; };
    let i: u64 = 0;
    while i < litn {
        let b = SLA_BYTE_AT(lit, i);
        if v[i] != b { return 0; };
        i = i + 1;
    }
    return 1;
}

fn ssh_conn_port(port: u32) -> u64 {
    let s: u64 = 0;
    let rc: i32 = sla_std_ssh_client_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), port, &s);
    if rc != 0 { panic(97301); };
    if s == 0 { panic(97302); };
    return s;
}

fn ssh_close(s: u64) {
    let sp: ptr = s as ptr;
    if sla_std_ssh_session_close(^sp) != 0 { panic(97303); };
}

@test "extern ssh sa_std_ssh_auth_password"() {
    // Against the key-only instance (55522) password auth is refused (4).
    let s1: u64 = ssh_conn_port(55522);
    let sp1: ptr = s1 as ptr;
    let rc1: i32 = sla_std_ssh_auth_password(sp1, STR_PTR("root"), STR_LEN("root"), STR_PTR("s3cret-ssh"), STR_LEN("s3cret-ssh"));
    if rc1 != 4 { panic(97401); };
    ssh_close(s1);
    // Password instance (55523): unknown user denies (4). This runs on
    // its OWN session: probe_ssh_auth.sla proved that after a
    // nonexistent-user attempt, later auth on the SAME session fails
    // even with the right password (A/B/D patterns pass; C fails),
    // while same-user wrong-password retries are fine.
    let s2: u64 = ssh_conn_port(55523);
    let sp2: ptr = s2 as ptr;
    let rc2: i32 = sla_std_ssh_auth_password(sp2, STR_PTR("nosuchuser"), STR_LEN("nosuchuser"), STR_PTR("s3cret-ssh"), STR_LEN("s3cret-ssh"));
    if rc2 != 4 { panic(97402); };
    ssh_close(s2);
    // Fresh session: wrong password denies (4), and the correct
    // password succeeds on retry within the same session.
    let s2b: u64 = ssh_conn_port(55523);
    let sp2b: ptr = s2b as ptr;
    let rc3: i32 = sla_std_ssh_auth_password(sp2b, STR_PTR("satest"), STR_LEN("satest"), STR_PTR("wrongpw"), STR_LEN("wrongpw"));
    if rc3 != 4 { panic(97403); };
    let rc4: i32 = sla_std_ssh_auth_password(sp2b, STR_PTR("satest"), STR_LEN("satest"), STR_PTR("s3cret-ssh"), STR_LEN("s3cret-ssh"));
    if rc4 != 0 { panic(97404); };
    // The authenticated session really executes commands.
    let so: u64 = 0;
    let se: u64 = 0;
    let ex: u64 = 0;
    let rc5: i32 = sla_std_ssh_exec(sp2b, STR_PTR("echo pw-ok"), STR_LEN("echo pw-ok"), &so, &se, &ex);
    if rc5 != 0 { panic(97405); };
    if ex != 0 { panic(97406); };
    if ssh_buf_eq(so, STR_PTR("pw-ok\n"), STR_LEN("pw-ok\n")) != 1 { panic(97407); };
    if sla_std_ssh_buffer_free(^so) != 0 { panic(97408); };
    if sla_std_ssh_buffer_free(^se) != 0 { panic(97409); };
    ssh_close(s2b);
}
