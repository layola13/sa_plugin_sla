// Smoke wave 1: register-2 externs in sa_std/http_cookie.sai.
// Handles from sla_cookie_new / sla_cookie_parse_set_cookie (real
// Set-Cookie strings). Panic codes 54xxx.
@import "sla_std/wrap/http_cookie.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"


fn s1_streq(p: ptr, l: u64, lit: ptr, litl: u64) -> bool {
    if l != litl { return false; };
    let i: u64 = 0;
    while i < l {
        if PTR_BYTE_AT(p, i) != PTR_BYTE_AT(lit, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn s1_new(code: i32) -> u64 {
    let h = sla_cookie_new(STR_PTR("sid"), STR_LEN("sid"), STR_PTR("abc"), STR_LEN("abc"));
    if h == 0 { panic(code); };
    return h;
}

fn s1_parsed(code: i32) -> u64 {
    let h = sla_cookie_parse_set_cookie(STR_PTR("sid=abc; Path=/app; Max-Age=3600; Secure; HttpOnly"), STR_LEN("sid=abc; Path=/app; Max-Age=3600; Secure; HttpOnly"));
    if h == 0 { panic(code); };
    return h;
}

@test "smoke1 sa_cookie_free"() {
    let h = s1_new(54010);
    let rc = sla_cookie_free(^h);
    if rc != 0 { panic(54011); };
}

@test "smoke1 sa_cookie_name"() {
    let h = s1_parsed(54020);
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_cookie_name(h, &p[0], &l[0]);
    if rc != 0 { panic(54021); };
    if s1_streq((p[0] as ptr), l[0], STR_PTR("sid"), STR_LEN("sid")) == false { panic(54022); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_value"() {
    let h = s1_parsed(54030);
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_cookie_value(h, &p[0], &l[0]);
    if rc != 0 { panic(54031); };
    if s1_streq((p[0] as ptr), l[0], STR_PTR("abc"), STR_LEN("abc")) == false { panic(54032); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_domain"() {
    let h = sla_cookie_parse_set_cookie(STR_PTR("sid=abc; Domain=example.com"), STR_LEN("sid=abc; Domain=example.com"));
    if h == 0 { panic(54040); };
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_cookie_domain(h, &p[0], &l[0]);
    if rc != 0 { panic(54041); };
    if s1_streq((p[0] as ptr), l[0], STR_PTR("example.com"), STR_LEN("example.com")) == false { panic(54042); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_path"() {
    let h = s1_parsed(54050);
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_cookie_path(h, &p[0], &l[0]);
    if rc != 0 { panic(54051); };
    if s1_streq((p[0] as ptr), l[0], STR_PTR("/app"), STR_LEN("/app")) == false { panic(54052); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_expires"() {
    let h = sla_cookie_parse_set_cookie(STR_PTR("e=1; Expires=Tue, 01 Jan 2030 00:00:00 GMT"), STR_LEN("e=1; Expires=Tue, 01 Jan 2030 00:00:00 GMT"));
    if h == 0 { panic(54060); };
    let out = [0u64; 4];
    let rc = sla_cookie_expires(h, &out[0]);
    if rc != 0 { panic(54061); };
    if out[0] != 1893456000 { panic(54062); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_max_age"() {
    let h = s1_parsed(54070);
    let out = [0u64; 4];
    let rc = sla_cookie_max_age(h, &out[0]);
    if rc != 0 { panic(54071); };
    if out[0] != 3600 { panic(54072); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_flags"() {
    let h = s1_parsed(54080);
    let sec = [0u64; 4];
    let ho = [0u64; 4];
    let part = [0u64; 4];
    let rc = sla_cookie_flags(h, &sec[0], &ho[0], &part[0]);
    if rc != 0 { panic(54081); };
    if sec[0] != 1 { panic(54082); };
    if ho[0] != 1 { panic(54083); };
    if part[0] != 0 { panic(54084); };
    sla_cookie_free(^h);
}

@test "smoke1 sa_cookie_same_site"() {
    let h = sla_cookie_parse_set_cookie(STR_PTR("sid=abc; SameSite=Lax"), STR_LEN("sid=abc; SameSite=Lax"));
    if h == 0 { panic(54090); };
    let out = [0u64; 4];
    let rc = sla_cookie_same_site(h, &out[0]);
    if rc != 0 { panic(54091); };
    if out[0] == 0 { panic(54092); };
    sla_cookie_free(^h);
}



