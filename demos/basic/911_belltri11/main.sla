@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell Aitken 三角续高位 B(11)=678570，B(12)=4213597（781 体例续高位）。
// 意对标 906_bell11（递推版互补；915 做三向收束）。

fn bt(n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = t[(mm - 1) * w + mm - 1];
        let nn = 1;
        while nn <= mm {
            t[mm * w + nn] = t[mm * w + nn - 1] + t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w];
}

fn main() -> i32 {
    println("{},{},{}", bt(11), bt(12), bt(10));
    return 0;
}

@test "basic 911 belltri11"() {
    if bt(11) != 678570 { panic(91101); };
    if bt(12) != 4213597 { panic(91102); };
    if bt(10) != 115975 { panic(91103); };
    if bt(9) != 21147 { panic(91104); };
}
