@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana 边值 N(n,1)=C(n,2)（n=4→6，n=5→10，n=6→15；603 做三角数对峙）。
// 意对标 596 narayana（全表版互补；此处边列单序列，582 首列体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", narayana(4, 1), narayana(5, 1), narayana(6, 1));
    return 0;
}

@test "basic 602 narayana edge"() {
    if narayana(4, 1) != 6 { panic(60201); };
    if narayana(5, 1) != 10 { panic(60202); };
    if narayana(6, 1) != 15 { panic(60203); };
}
