// DEF-TEXT-BRANCH-MERGE-STACKSLOT-RELEASE regression: a binding that
// lives in an assigned-value stack slot (`st = stack_alloc N`, because
// the binding is field-mutated after creation) is store-moved into a
// struct literal inside one branch of an if without else. Branch-merge
// compensation settles a store-moved name on the consuming side with a
// bare release (emitBranchSettle), which for a stack-slot register
// emits `!st` -- a stack allocation cannot be released explicitly, and
// the SA host traps StackEscape 1025 (slaredis
// @sla__run_server_goroutine, the `aof` slot moved into AofJob). Slot
// registers are released implicitly at scope exit and must never be
// explicitly released by merge compensation. Fails on the base head
// (the build is rejected), passes after the fix.

struct SlotState {
    enabled: bool,
    tick: u64,
    payload: Vec<u8>,
}

struct SlotJob {
    wst: SlotState,
    tag: u64,
}

fn make_slot_state(on: bool) -> SlotState {
    return SlotState { enabled: on, tick: 0, payload: Vec::new() };
}

fn slot_job_score(j: SlotJob) -> u64 {
    return j.wst.tick + j.tag + len(j.wst.payload) as u64;
}

fn branch_moves_slot(flag: bool) -> u64 {
    let st = make_slot_state(flag);
    if st.enabled {
        st.tick = 5;
    };
    let total: u64 = 0;
    if flag {
        let job = SlotJob { wst: st, tag: 2 };
        total = slot_job_score(job);
    };
    return total;
}

@test "branch merge stackslot release"() {
    if branch_moves_slot(true) != 7 { panic(405); };
    if branch_moves_slot(false) != 0 { panic(406); };
}
