// View-types stage 1: reassigning the root struct while a borrow of
// one of its fields is still live (and used afterwards). The checker
// must reject the reassignment with a BorrowConflict diagnostic.
// Before stage 1 the SAB backend rejected it only at offset 0 while
// the text backend ran it and produced a wrong result (the write
// through the stale borrow landed in the reassigned struct).
struct Pair { a: i64, b: i64 }

fn bad_root_reassign() {
    let s = Pair { a: 1, b: 2 };
    let x = &s.a;
    s = Pair { a: 9, b: 9 };
    *x = 5;
}

fn main() -> i32 {
    bad_root_reassign();
    return 0;
}
