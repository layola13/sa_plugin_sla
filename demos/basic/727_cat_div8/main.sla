@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 商式 C(7)=429，C(8)=1430（C(2n,n)/(n+1) 先除后认知精确整除）。
// 意对标 351_catalan（低位商式版互补；728 做卷积/商式对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{}", catd(7), catd(8));
    return 0;
}

@test "basic 727 cat div8"() {
    if catd(7) != 429 { panic(72701); };
    if catd(8) != 1430 { panic(72702); };
    if catd(6) != 132 { panic(72703); };
}
