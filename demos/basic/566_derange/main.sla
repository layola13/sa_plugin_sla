@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 错排数 !n=(n-1)·(!(n-1)+!(n-2))（!3..!6=2,9,44,265；568 做容斥对峙）。
// 意对标 125 fact（阶乘版互补；此处为固定点自由计数）。

fn derange(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let a = 1;
    let b = 0;
    let i = 2;
    let cur = 0;
    while i <= n {
        cur = (i - 1) * (b + a);
        a = b;
        b = cur;
        i = i + 1;
    }
    return cur;
}

fn main() -> i32 {
    println("{},{},{},{}", derange(3), derange(4), derange(5), derange(6));
    return 0;
}

@test "basic 566 derange"() {
    if derange(3) != 2 { panic(56601); };
    if derange(4) != 9 { panic(56602); };
    if derange(5) != 44 { panic(56603); };
    if derange(6) != 265 { panic(56604); };
}
