@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Schroder 高位 S(5)=394（S(4)=90 对 90；同式高位复算）。
// 意对标 606_schroder（低位版互补；610 做高位对峙）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", sch(4), sch(5));
    return 0;
}

@test "basic 608 schro high"() {
    if sch(5) != 394 { panic(60801); };
    if sch(4) != 90 { panic(60802); };
    if sch(3) != 22 { panic(60803); };
    if sch(2) != 6 { panic(60804); };
}
