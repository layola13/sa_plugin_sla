@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 递推版 L(n,k)=L(n-1,k-1)+(n+k-1)·L(n-1,k)（拍扁表）。
// L(4,2)=36，L(5,2)=240，L(5,3)=120（590 做商式对峙）。
// 意对标 586 lah（商式版互补；此处为加权递推，531 范式）。

fn lah_rec(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn + kk - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", lah_rec(4, 2), lah_rec(5, 2), lah_rec(5, 3));
    return 0;
}

@test "basic 589 lahrec"() {
    if lah_rec(4, 2) != 36 { panic(58901); };
    if lah_rec(5, 2) != 240 { panic(58902); };
    if lah_rec(5, 3) != 120 { panic(58903); };
    if lah_rec(3, 3) != 1 { panic(58904); };
}
