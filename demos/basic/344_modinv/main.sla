@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 模逆元（inv(3,11)=4，验算 3*4%11=1；不可逆归 0）。
// 扩展 Euclid（80 的逆元版；初版转录错已修正，见账本）。

fn modinv(a: int, m: int) -> int {
    let t = 0;
    let newt = 1;
    let r = m;
    let newr = a % m;
    while newr != 0 {
        let q = r / newr;
        let tt = t;
        t = newt;
        newt = tt - q * newt;
        let rr = r;
        r = newr;
        newr = rr - q * newr;
    }
    if r > 1 { return 0; };
    if t < 0 { t = t + m; };
    return t;
}

fn main() -> i32 {
    println("{},{}", modinv(3, 11), 3 * modinv(3, 11) % 11);
    return 0;
}

@test "basic 344 modinv"() {
    if modinv(3, 11) != 4 { panic(34401); };
    if 3 * modinv(3, 11) % 11 != 1 { panic(34402); };
    if modinv(2, 4) != 0 { panic(34403); };
}
