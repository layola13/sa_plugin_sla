@test "smoke2 sa_http_client_async_cancel_v2"() {
    // The peer delays its response by 800ms, so the cancel lands mid-flight.
    let h = go s2_echo2(24629 + 8 * 65536 + 65600 * 16777216);
    sla_time_sleep_ms(150);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24629, STR_PTR("/slow"), STR_LEN("/slow"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65603); };
    let rq = [0u64; 4];
    if sla_http_client_req_new_v2((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65604); };
    let req = (rq[0] as ptr);
    let op = [0u64; 4];
    if sla_http_client_req_send_async_v2(req, &op[0]) != 0 { panic(65605); };
    let opp = (op[0] as ptr);
    if sla_http_client_async_cancel_v2(opp) != 0 { panic(65606); };
    if sla_http_client_async_free_v2(opp) != 0 { panic(65607); };
    sla_http_client_req_free(req);
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

