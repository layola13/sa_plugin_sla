@test "smoke1 sa_std_net_udp_leave_multicast_v4"() {
    let a = s1_udp(59860);
    let rc = sla_std_net_udp_join_multicast_v4(a, STR_PTR("233.1.1.2"), STR_LEN("233.1.1.2"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc != 0 { panic(59861); };
    let rc2 = sla_std_net_udp_leave_multicast_v4(a, STR_PTR("233.1.1.2"), STR_LEN("233.1.1.2"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc2 != 0 { panic(59862); };
    // Leaving twice must fail: membership is gone.
    let rc3 = sla_std_net_udp_leave_multicast_v4(a, STR_PTR("233.1.1.2"), STR_LEN("233.1.1.2"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc3 == 0 { panic(59863); };
    sla_std_close(a);
}

