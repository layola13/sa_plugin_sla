@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 893_nested_continue：嵌套循环 continue（8）。
// SLA 有 `continue`（探针：while 版求和 37，与 TS 一致）；
// label 跳出不支持（#9），此处只用普通 continue（32 覆盖 break）。

fn main() -> i32 {
    let t = 0;
    let i = 0;
    while i < 4 {
        let j = 0;
        while j < 4 {
            if (i + j) % 2 == 0 { j = j + 1; continue; };
            t = t + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    println("{}", t);
    return 0;
}

@test "basic 146 nested continue"() {
    let t = 0;
    let i = 0;
    while i < 4 {
        let j = 0;
        while j < 4 {
            if (i + j) % 2 == 0 { j = j + 1; continue; };
            t = t + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    if t != 8 { panic(14601); };
}
