@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类次对角续 c(7,6)=21，c(8,7)=28，c(9,8)=36（三角数恒等续高位）。
// 意对标 693_stir1_edge（低位次对角版互补；825 做三向收束）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", cst(7, 6), cst(8, 7), cst(9, 8));
    return 0;
}

@test "basic 821 stir1 edge9"() {
    if cst(7, 6) != 21 { panic(82101); };
    if cst(8, 7) != 28 { panic(82102); };
    if cst(9, 8) != 36 { panic(82103); };
    if binom_mul(9, 2) != 36 { panic(82104); };
}
