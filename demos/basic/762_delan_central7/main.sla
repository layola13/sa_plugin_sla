@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 续中央列 1683,8989,48639（D(5,5)，D(6,6)，D(7,7)；中央序列复算）。
// 意对标 620_delannoy_central（低位中央版互补；765 做三向收束）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{},{}", delan(5, 5), delan(6, 6), delan(7, 7));
    return 0;
}

@test "basic 762 delan central7"() {
    if delan(5, 5) != 1683 { panic(76201); };
    if delan(6, 6) != 8989 { panic(76202); };
    if delan(7, 7) != 48639 { panic(76203); };
    if delan(4, 4) != 321 { panic(76204); };
}
