@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类列对峙：建表 vs 幂公式（(8,2)：127 对 127；(9,2)：255 对 255）。
// 意对标 701_stir2_col2 × 幂公式源（列源与公式源合流）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn p2m1(n: int) -> int {
    let p = 1;
    let i = 1;
    while i <= n - 1 {
        p = p * 2;
        i = i + 1;
    }
    return p - 1;
}

fn main() -> i32 {
    println("{},{},{},{}", svt(8, 2), p2m1(8), svt(9, 2), p2m1(9));
    return 0;
}

@test "basic 702 duel col2"() {
    if svt(8, 2) != 127 { panic(70201); };
    if p2m1(8) != 127 { panic(70202); };
    if svt(9, 2) != 255 { panic(70203); };
    if p2m1(9) != 255 { panic(70204); };
}
