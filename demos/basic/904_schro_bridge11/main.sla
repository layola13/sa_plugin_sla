@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大小 Schröder 续桥恒等 S(n)=2s(n)：S(11)=5293446，S(12)=27297738（桥续大端双锁）。
// 意对标 794_schro_bridge9（n=9/10 桥互补；桥恒等续高位复算）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn dsch(n: int) -> int {
    return 2 * ssho(n);
}

fn main() -> i32 {
    println("{},{},{},{}", sch(11), 2 * ssho(11), sch(12), 2 * ssho(12));
    return 0;
}

@test "basic 904 schro bridge11"() {
    if sch(11) != 5293446 { panic(90401); };
    if 2 * ssho(11) != 5293446 { panic(90402); };
    if sch(12) != 27297738 { panic(90403); };
    if 2 * ssho(12) != 27297738 { panic(90404); };
}
