@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大小 Schröder 三向：短递推 × 半大数 × 半递归（n=6：903 三锁）。
// 意对标 768_sschro_high（高位源互补；609 三向体例收束大小族）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rsch(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 2; };
    let s = rsch(n - 1);
    let k = 0;
    while k < n {
        s = s + rsch(k) * rsch(n - 1 - k);
        k = k + 1;
    }
    return s;
}

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn shalf(n: int) -> int {
    return sch(n) / 2;
}

fn rhalf(n: int) -> int {
    return rsch(n) / 2;
}

fn main() -> i32 {
    println("{},{},{}", ssho(6), shalf(6), rhalf(6));
    return 0;
}

@test "basic 775 tri sschro"() {
    if ssho(6) != 903 { panic(77501); };
    if shalf(6) != 903 { panic(77502); };
    if rhalf(6) != 903 { panic(77503); };
    if ssho(5) != 197 { panic(77504); };
}
