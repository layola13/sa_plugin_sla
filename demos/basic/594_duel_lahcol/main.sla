@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Lah 首列对峙：L(n,1) == fact(n)（n=4：24 对 24；n=5：120 对 120；n=6：720 对 720）。
// 意对标 592 lah_col（单实现见源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn lah(n: int, k: int) -> int {
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn main() -> i32 {
    println("{},{},{},{},{},{}", lah(4, 1), fact(4), lah(5, 1), fact(5), lah(6, 1), fact(6));
    return 0;
}

@test "basic 594 duel lahcol"() {
    if lah(4, 1) != 24 { panic(59401); };
    if fact(4) != 24 { panic(59402); };
    if lah(5, 1) != 120 { panic(59403); };
    if fact(5) != 120 { panic(59404); };
    if lah(6, 1) != 720 { panic(59405); };
    if fact(6) != 720 { panic(59406); };
}
