// expect: MacroConditionalConsume
// neg: macro consumes a parameter only inside one if branch (consuming callee param + move marker)
fn sink(^v: Vec<i32>) -> i64 {
    return v.len();
}
macro maybe_sink(flag: bool, v: Vec<i32>, out: i64) {
    if flag {
        out = sink(^v);
    };
}
fn main() -> i64 {
    let out: i64 = 0;
    let v: Vec<i32> = Vec::new();
    maybe_sink(true, v, out);
    return out;
}
