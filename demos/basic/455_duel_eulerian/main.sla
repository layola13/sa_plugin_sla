@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Eulerian 双实现对峙（递推 vs 容斥和：A(4,1)=11 双边）。
// 意对标 454 Bell 对峙的排列版（452 互补）。

fn eulerian_rec(n: int, m: int) -> int {
    if n == 0 { return 0; };
    if m < 0 { return 0; };
    if m == 0 { return 1; };
    if m >= n { return 0; };
    return (n - m) * eulerian_rec(n - 1, m - 1) + (m + 1) * eulerian_rec(n - 1, m);
}

fn pow_int(base: int, exp: int) -> int {
    let r = 1;
    let i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}

fn binom(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn eulerian_sum(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m + 1 {
        let term = binom(n + 1, k) * pow_int(m + 1 - k, n);
        if k % 2 == 0 { s = s + term; };
        if k % 2 == 1 { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", eulerian_rec(4, 1), eulerian_sum(4, 1));
    return 0;
}

@test "basic 455 duel eulerian"() {
    if eulerian_rec(4, 1) != 11 { panic(45501); };
    if eulerian_sum(4, 1) != 11 { panic(45502); };
    if eulerian_rec(4, 1) != eulerian_sum(4, 1) { panic(45503); };
    if eulerian_sum(3, 1) != 4 { panic(45504); };
}
