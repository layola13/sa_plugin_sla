@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 续高位对峙二：建表 vs 直和（(7,5)：7183 对 7183；(7,6)：19825 对 19825）。
// 意对标 758_delan_high7 × 759_duel_delan7（高位源与对峙体例合流）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ddel(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        if k <= n {
            let p = 1;
            let j = 0;
            while j < k {
                p = p * 2;
                j = j + 1;
            }
            s = s + binom_mul(m, k) * binom_mul(n, k) * p;
        };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", delan(7, 5), ddel(7, 5), delan(7, 6), ddel(7, 6));
    return 0;
}

@test "basic 760 duel delan76"() {
    if delan(7, 5) != 7183 { panic(76001); };
    if ddel(7, 5) != 7183 { panic(76002); };
    if delan(7, 6) != 19825 { panic(76003); };
    if ddel(7, 6) != 19825 { panic(76004); };
}
