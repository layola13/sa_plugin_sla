@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Lah 行：n=4 行 `24,36,12,1`（和 73）；n=5 行首尾 `120,…,1`。
// 意对标 586 lah（单格版互补；532 行和体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn lah(n: int, k: int) -> int {
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn main() -> i32 {
    println("{},{},{},{},{}", lah(4, 1), lah(4, 2), lah(4, 3), lah(4, 4), lah(4, 1) + lah(4, 2) + lah(4, 3) + lah(4, 4));
    return 0;
}

@test "basic 587 lahrow"() {
    if lah(4, 1) != 24 { panic(58701); };
    if lah(4, 2) != 36 { panic(58702); };
    if lah(4, 3) != 12 { panic(58703); };
    if lah(4, 4) != 1 { panic(58704); };
    if lah(5, 5) != 1 { panic(58705); };
}
