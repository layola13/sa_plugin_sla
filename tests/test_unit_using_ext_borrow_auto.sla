// DEF-E0 regression: extension whose first parameter is declared with
// a borrow TYPE (&Vec<i32>), called directly on an owned Vec value —
// the receiver is auto-borrowed at the call site and must still be
// alive afterwards.
mod borrow_ext {
    pub fn peek_len(v: &Vec<i32>) -> i32 {
        return v.len() + 50;
    }
}

using borrow_ext;

@test "using ext: borrow receiver auto-borrow"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    if v.peek_len() != 53 { panic(35000); };
    // receiver must still be alive afterwards if it was only borrowed
    if v.len() != 3 { panic(35001); };
}
