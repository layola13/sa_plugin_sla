@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 高位对峙：行和 vs Catalan 商式（n=7：429 对 429；n=8：1430 对 1430）。
// 意对标 718_nar8 × 719_duel_nar7（高位源与对峙体例合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{},{}", nsum(7), catd(7), nsum(8), catd(8));
    return 0;
}

@test "basic 720 duel nar8"() {
    if nsum(7) != 429 { panic(72001); };
    if catd(7) != 429 { panic(72002); };
    if nsum(8) != 1430 { panic(72003); };
    if catd(8) != 1430 { panic(72004); };
}
