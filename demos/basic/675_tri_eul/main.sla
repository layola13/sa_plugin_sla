@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 三向：建表行和 × 交错和行和 × 阶乘（n=5：120 三锁）。
// 意对标 668_eul_high（高位源互补；605 三向体例收束 Eulerian 族）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pwr(b: int, e: int) -> int {
    let r = 1;
    let i = 0;
    while i < e {
        r = r * b;
        i = i + 1;
    }
    return r;
}

fn ealt(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m + 1 {
        let term = binom_mul(n + 1, k) * pwr(m + 1 - k, n);
        if k % 2 == 0 { s = s + term; } else { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn easum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + ealt(n, k);
        k = k + 1;
    }
    return s;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", esum(5), easum(5), fact(5));
    return 0;
}

@test "basic 675 tri eul"() {
    if esum(5) != 120 { panic(67501); };
    if easum(5) != 120 { panic(67502); };
    if fact(5) != 120 { panic(67503); };
    if esum(4) != 24 { panic(67504); };
}
