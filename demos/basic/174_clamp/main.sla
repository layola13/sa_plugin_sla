@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1263_clamp：钳制（5,0,10）。
// 与 134 的 max/min 双函数互补：此处为三参数单函数夹逼。

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo; };
    if v > hi { return hi; };
    return v;
}

fn main() -> i32 {
    println("{},{},{}", clamp(5, 0, 10), clamp(-5, 0, 10), clamp(50, 0, 10));
    return 0;
}

@test "basic 174 clamp"() {
    if clamp(5, 0, 10) != 5 { panic(17401); };
    if clamp(-5, 0, 10) != 0 { panic(17402); };
    if clamp(50, 0, 10) != 10 { panic(17403); };
    if clamp(0, 0, 10) != 0 { panic(17404); };
}
