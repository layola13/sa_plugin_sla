@import "sa_std/url.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

// Registry shard 4 coverage: small url helpers from
// sa_std/url.sla (SAB registry class=declared, never probed,
// zero corpus references at census 2026-11-06).
// Entries: url_bytes_eq, url_range_eq, url_ranges_eq,
// url_find_byte, url_rfind_byte, url_hex_val, url_hex_upper,
// url_is_alpha, url_is_digit, url_is_sub_delim,
// url_is_unreserved, url_default_port, url_dec_len,
// url_dec_digits, url_dup_string, url_dup_range, url_lower_dup.

fn s4_eq(a: String, b: String) -> bool {
    let pa: ptr = STR_PTR(a);
    let pb: ptr = STR_PTR(b);
    if len(a) != len(b) { return false; };
    let i: u64 = 0;
    while i < len(a) {
        if PTR_BYTE_AT(pa, i) != PTR_BYTE_AT(pb, i) { return false; };
        i = i + 1;
    }
    return true;
}

@test "reg4 url bytes eq"() {
    let a = format("abc");
    let b = format("abc");
    let c = format("abd");
    let d = format("abcd");
    if url_bytes_eq(STR_PTR(a), len(a), STR_PTR(b), len(b)) != true { panic(43201); };
    if url_bytes_eq(STR_PTR(a), len(a), STR_PTR(c), len(c)) != false { panic(43202); };
    if url_bytes_eq(STR_PTR(a), len(a), STR_PTR(d), len(d)) != false { panic(43203); };
}

@test "reg4 url range eq"() {
    let s = format("xxhelloyy");
    if url_range_eq(STR_PTR(s), 2, 7, format("hello")) != true { panic(43211); };
    if url_range_eq(STR_PTR(s), 2, 6, format("hell")) != true { panic(43212); };
    if url_range_eq(STR_PTR(s), 0, 2, format("xx")) != true { panic(43213); };
    if url_range_eq(STR_PTR(s), 2, 7, format("hellx")) != false { panic(43214); };
    if url_range_eq(STR_PTR(s), 2, 7, format("hell")) != false { panic(43215); };
}

@test "reg4 url ranges eq"() {
    let a = format("xxhello");
    let b = format("hello");
    if url_ranges_eq(STR_PTR(a), 2, 5, STR_PTR(b), 0, 5) != true { panic(43221); };
    if url_ranges_eq(STR_PTR(a), 2, 4, STR_PTR(b), 0, 5) != false { panic(43222); };
    if url_ranges_eq(STR_PTR(a), 0, 5, STR_PTR(b), 0, 5) != false { panic(43223); };
}

@test "reg4 url find byte"() {
    let s = format("a/b/c");
    let p: ptr = STR_PTR(s);
    if url_find_byte(p, 0, 5, 47) != 1 { panic(43231); };
    if url_find_byte(p, 2, 5, 47) != 3 { panic(43232); };
    if url_find_byte(p, 0, 5, 122) != -1 { panic(43233); };
    if url_find_byte(p, 2, 2, 47) != -1 { panic(43234); };
    if url_find_byte(p, 0, 5, 97) != 0 { panic(43235); };
}

@test "reg4 url rfind byte"() {
    let s = format("a/b/c");
    let p: ptr = STR_PTR(s);
    if url_rfind_byte(p, 0, 5, 47) != 3 { panic(43241); };
    if url_rfind_byte(p, 0, 3, 47) != 1 { panic(43242); };
    if url_rfind_byte(p, 0, 5, 122) != -1 { panic(43243); };
    if url_rfind_byte(p, 4, 5, 47) != -1 { panic(43244); };
}

@test "reg4 url hex val"() {
    if url_hex_val(48) != 0 { panic(43251); };
    if url_hex_val(57) != 9 { panic(43252); };
    if url_hex_val(97) != 10 { panic(43253); };
    if url_hex_val(102) != 15 { panic(43254); };
    if url_hex_val(65) != 10 { panic(43255); };
    if url_hex_val(70) != 15 { panic(43256); };
    if url_hex_val(103) != -1 { panic(43257); };
    if url_hex_val(47) != -1 { panic(43258); };
}

@test "reg4 url hex upper"() {
    if url_hex_upper(0) != 48 { panic(43261); };
    if url_hex_upper(9) != 57 { panic(43262); };
    if url_hex_upper(10) != 65 { panic(43263); };
    if url_hex_upper(15) != 70 { panic(43264); };
}

@test "reg4 url byte classes"() {
    if url_is_alpha(65) != true { panic(43271); };
    if url_is_alpha(90) != true { panic(43272); };
    if url_is_alpha(97) != true { panic(43273); };
    if url_is_alpha(122) != true { panic(43274); };
    if url_is_alpha(91) != false { panic(43275); };
    if url_is_alpha(48) != false { panic(43276); };
    if url_is_digit(48) != true { panic(43277); };
    if url_is_digit(57) != true { panic(43278); };
    if url_is_digit(58) != false { panic(43279); };
}

@test "reg4 url sub delim and unreserved classes"() {
    if url_is_sub_delim(33) != true { panic(43281); };
    if url_is_sub_delim(36) != true { panic(43282); };
    if url_is_sub_delim(38) != true { panic(43283); };
    if url_is_sub_delim(39) != true { panic(43284); };
    if url_is_sub_delim(40) != true { panic(43285); };
    if url_is_sub_delim(41) != true { panic(43286); };
    if url_is_sub_delim(42) != true { panic(43287); };
    if url_is_sub_delim(43) != true { panic(43288); };
    if url_is_sub_delim(44) != true { panic(43289); };
    if url_is_sub_delim(59) != true { panic(43290); };
    if url_is_sub_delim(61) != true { panic(43291); };
    if url_is_sub_delim(47) != false { panic(43292); };
    if url_is_sub_delim(58) != false { panic(43293); };
    if url_is_unreserved(65) != true { panic(43294); };
    if url_is_unreserved(48) != true { panic(43295); };
    if url_is_unreserved(45) != true { panic(43296); };
    if url_is_unreserved(46) != true { panic(43297); };
    if url_is_unreserved(95) != true { panic(43298); };
    if url_is_unreserved(126) != true { panic(43299); };
    if url_is_unreserved(47) != false { panic(43300); };
    if url_is_unreserved(37) != false { panic(43301); };
}

@test "reg4 url default port"() {
    if url_default_port(format("http")) != 80 { panic(43311); };
    if url_default_port(format("https")) != 443 { panic(43312); };
    if url_default_port(format("ws")) != 80 { panic(43313); };
    if url_default_port(format("wss")) != 443 { panic(43314); };
    if url_default_port(format("ftp")) != 21 { panic(43315); };
    if url_default_port(format("gopher")) != 0 { panic(43316); };
    if url_default_port(format("")) != 0 { panic(43317); };
}

@test "reg4 url dec len within five digits"() {
    if url_dec_len(0) != 1 { panic(43321); };
    if url_dec_len(9) != 1 { panic(43322); };
    if url_dec_len(10) != 2 { panic(43323); };
    if url_dec_len(99) != 2 { panic(43324); };
    if url_dec_len(100) != 3 { panic(43325); };
    if url_dec_len(9999) != 4 { panic(43326); };
    if url_dec_len(10000) != 5 { panic(43327); };
    if url_dec_len(65535) != 5 { panic(43328); };
}

@test "reg4 url dec len six digit value"() {
    // url_dec_digits(100000) writes six digits; the length
    // helper must agree with it. Isolated: if the helper
    // saturates at 5 this is the defect-candidate test.
    if url_dec_len(100000) != 6 { panic(43331); };
}

@test "reg4 url dec digits"() {
    let d0 = url_dec_digits(0);
    if d0[0] != 48 { panic(43341); };
    if d0[1] != 0 { panic(43342); };
    let d7 = url_dec_digits(7);
    if d7[0] != 55 { panic(43343); };
    let d123 = url_dec_digits(123);
    if d123[0] != 49 { panic(43344); };
    if d123[1] != 50 { panic(43345); };
    if d123[2] != 51 { panic(43346); };
    if d123[3] != 0 { panic(43347); };
    let dmax = url_dec_digits(65535);
    if dmax[0] != 54 { panic(43348); };
    if dmax[1] != 53 { panic(43349); };
    if dmax[2] != 53 { panic(43350); };
    if dmax[3] != 51 { panic(43351); };
    if dmax[4] != 53 { panic(43352); };
    if dmax[5] != 0 { panic(43353); };
}

@test "reg4 url dup and lower helpers"() {
    if !s4_eq(url_dup_string(format("copy me")), format("copy me")) { panic(43361); };
    let s = format("hello world");
    if !s4_eq(url_dup_range(STR_PTR(s), 0, 5), format("hello")) { panic(43362); };
    if !s4_eq(url_dup_range(STR_PTR(s), 6, 11), format("world")) { panic(43363); };
    if !s4_eq(url_dup_range(STR_PTR(s), 3, 3), format("")) { panic(43364); };
    if !s4_eq(url_lower_dup(format("AbC-XYz")), format("abc-xyz")) { panic(43365); };
    if !s4_eq(url_lower_dup(format("already")), format("already")) { panic(43366); };
}
