@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 完全数计数（<=30 有 6/28 共 2 个）。
// 意对标 373 素数计数的完全版（373/389 互补）。

fn sigma(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        if n % i == 0 { s = s + i; };
        i = i + 1;
    }
    return s;
}

fn is_perfect(n: int) -> int {
    if n < 2 { return 0; };
    if sigma(n) == 2 * n { return 1; };
    return 0;
}

fn perfect_count(limit: int) -> int {
    let c = 0;
    let k = 2;
    while k <= limit {
        if is_perfect(k) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", perfect_count(30), perfect_count(6), is_perfect(28));
    return 0;
}

@test "basic 523 perfect count"() {
    if perfect_count(30) != 2 { panic(52301); };
    if perfect_count(6) != 1 { panic(52302); };
    if is_perfect(28) != 1 { panic(52303); };
}
