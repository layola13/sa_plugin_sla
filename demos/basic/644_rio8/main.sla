@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 高位三 R(8)=91（R(7)=36 对 36；短递推一步 `7·117/9`）。
// 意对标 641_rio7（高位版互补；645 做三向收束）。

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", rio(7), rio(8));
    return 0;
}

@test "basic 644 rio8"() {
    if rio(8) != 91 { panic(64401); };
    if rio(7) != 36 { panic(64402); };
    if rio(6) != 15 { panic(64403); };
}
