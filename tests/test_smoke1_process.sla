@test "smoke1 sa_std_pidfd_wait"() {
    let h = s1_spawn_pidfd(STR_PTR("/bin/true"), STR_LEN("/bin/true"), STR_PTR(""), 0, 57140);
    let fd = [0u64; 4];
    sla_std_process_pidfd(h, &fd[0]);
