@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana 商式B N(n,k)=C(n-1,k)·C(n+1,k+1)/(n+1)（596 商式A的移位变体）。
// N(5,2)=20，N(6,2)=50，N(6,3)=50（605 做三向收束）。
// 意对标 596 narayana（商式A版互补；除数 `n+1` 移位）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana_b(n: int, k: int) -> int {
    return binom_mul(n - 1, k) * binom_mul(n + 1, k + 1) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{}", narayana_b(5, 2), narayana_b(6, 2), narayana_b(6, 3));
    return 0;
}

@test "basic 604 narayana alt"() {
    if narayana_b(5, 2) != 20 { panic(60401); };
    if narayana_b(6, 2) != 50 { panic(60402); };
    if narayana_b(6, 3) != 50 { panic(60403); };
    if narayana_b(4, 1) != 6 { panic(60404); };
}
