    return FmtBuffer { raw: sa_fmt_i64(value, base) };
}

fn sla_fmt_buffer_data(buffer: &FmtBuffer) -> &[u8][buffer] {
    return __slice_view(sa_fmt_buffer_data(buffer.raw), sa_fmt_buffer_len(buffer.raw));
}

fn sla_fmt_buffer_free(^buffer: FmtBuffer) -> i32 {
    return sa_fmt_buffer_free(buffer.raw);
}

fn view_eq(view: &[u8], expected: ptr, expected_len: u64) -> bool {
    if view.len() != expected_len {
        return false;
    };
    let i: u64 = 0;
    while i < expected_len {
        if view[i] != PTR_READ_U8(PTR_BYTE_ADD(expected, i)) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

@test "e_res fs read buffer view is stable and frees after last use"() {
    let path = "e_res_rb_tmp.txt";
    let data = "borrowed bytes";
    if sa_fs_write_file(STR_PTR(path), STR_LEN(path), STR_PTR(data), STR_LEN(data)) != 0 {
        panic(47101);
    };
    let r = sla_fs_read_file(STR_PTR(path), STR_LEN(path), 4096);
    let owner: FsReadBuffer = FsReadBuffer { raw: 0 };
    match r {
        Ok(h) => {
            owner = h;
        },
        Err(e) => {
            panic(47102);
        },
    };
    if sla_fs_read_buffer_len(&owner) != STR_LEN(data) {
        panic(47103);
    };
    let view = sla_fs_read_buffer_data(&owner);
    if !view_eq(&view, STR_PTR(data), STR_LEN(data)) {
        panic(47104);
    };
    let again = sla_fs_read_buffer_data(&owner);
    if !view_eq(&again, STR_PTR(data), STR_LEN(data)) {
        panic(47105);
    };
    if sla_fs_read_buffer_free(^owner) != 0 {
        panic(47106);
    };
}

@test "e_res fs dir entries and entry name views"() {
    let dir = ".";
    let r = sla_fs_read_dir_entries(STR_PTR(dir), STR_LEN(dir), 512);
    let entries: FsDirEntries = FsDirEntries { raw: 0 };
    match r {
        Ok(h) => {
            entries = h;
        },
        Err(e) => {
            panic(47111);
        },
    };
    if sla_fs_dir_entries_len(&entries) == 0 {
        panic(47112);
    };
    let jr = sla_fs_read_dir_json(STR_PTR(dir), STR_LEN(dir), 512);
    let jbuf: FsDirBuffer = FsDirBuffer { raw: 0 };
    match jr {
        Ok(h) => {
            jbuf = h;
        },
        Err(e) => {
            panic(47113);
        },
    };
    let blob = sla_fs_dir_buffer_data(&jbuf);
    if blob.len() == 0 {
        panic(47120);
    };
    if blob[0] != 91 && blob[0] != 123 {
        panic(47121);
    };
    if sla_fs_dir_buffer_free(^jbuf) != 0 {
        panic(47122);
    };
    let cell: u64 = 0;
    if sa_std_fs_dir_entries_get(entries.raw, 0, &cell) != 0 {
        panic(47114);
    };
    if cell == 0 {
        panic(47115);
    };
    let entry = FsDirEntry { raw: cell };
    let name = sla_fs_dir_entry_name_ptr(&entry);
    if name.len() == 0 {
        panic(47116);
    };
    let fname = sla_fs_dir_entry_file_name_ptr(&entry);
    if fname.len() == 0 {
        panic(47117);
    };
    if sla_fs_dir_entry_free(^entry) != 0 {
        panic(47118);
    };
    if sla_fs_dir_entries_free(^entries) != 0 {
        panic(47119);
    };
}

@test "e_res json node string view"() {
    let doc = "{\"s\":\"abc\",\"n\":7}";
    let root = sla_json_parse(STR_PTR(doc), STR_LEN(doc));
    if root.raw == 0 {
        panic(47121);
    };
    let child_cell: u64 = 0;
    let key = "s";
    if sa_json_object_get(root.raw, STR_PTR(key), STR_LEN(key), &child_cell) != 0 {
        panic(47122);
    };
    if child_cell == 0 {
        panic(47123);
    };
    let child = JsonNode { raw: child_cell };
    let view = sla_json_string_ptr(&child);
    let expected = "abc";
    if !view_eq(&view, STR_PTR(expected), STR_LEN(expected)) {
        panic(47124);
    };
    let fr = sla_json_free(^root);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47125);
            };
        },
        Err(e) => {
            panic(47126);
        },
    };
}

@test "e_res json buffer view from writer"() {
    let writer_cell: u64 = 0;
    if sa_json_writer_new(0, 0, 0, 0, 0, &writer_cell) != 0 {
        panic(47131);
    };
    if writer_cell == 0 {
        panic(47132);
    };
    if sa_json_writer_begin_object(writer_cell) != 0 {
        panic(47133);
    };
    let k = "k";
    let v = "vv";
    if sa_json_writer_field_string(writer_cell, STR_PTR(k), STR_LEN(k), STR_PTR(v), STR_LEN(v)) != 0 {
        panic(47134);
    };
    if sa_json_writer_end_object(writer_cell) != 0 {
        panic(47135);
    };
    let buf_cell = sa_json_writer_finish_buffer(writer_cell);
    if buf_cell == 0 {
        panic(47137);
    };
    let buffer = JsonBuffer { raw: buf_cell };
    let view = sla_json_buffer_data(&buffer);
    if view.len() == 0 {
        panic(47138);
    };
    if view[0] != 123 {
        panic(47139);
    };
    let fr = sla_json_buffer_free(^buffer);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47140);
            };
        },
        Err(e) => {
            panic(47141);
        },
    };
}

@test "e_res json stream slice view"() {
    let doc = "[1, 22]";
    let stream = sla_json_stream_new(STR_PTR(doc), STR_LEN(doc));
    if stream.raw == 0 {
        panic(47151);
    };
    let saw_slice = false;
    let steps: u64 = 0;
    while steps < 16 {
        let tok = sa_json_stream_next(stream.raw);
        if tok == 0 {
            break;
        };
        let view = sla_json_stream_get_slice_ptr(&stream);
        if view.len() > 0 {
            saw_slice = true;
        };
        steps = steps + 1;
    }
    if !saw_slice {
        panic(47152);
    };
    let fr = sla_json_stream_free(^stream);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47153);
            };
        },
        Err(e) => {
            panic(47154);
        },
    };
}

@test "e_res net addr host view from listener"() {
    let host = "127.0.0.1";
    let rb = sa_net_tcp_listener_bind(STR_PTR(host), STR_LEN(host), 0);
    let listener: u64 = 0;
    match rb {
        Ok(h) => {
            listener = h;
        },
        Err(e) => {
            panic(47161);
        },
    };
    let ra = sla_net_tcp_listener_local_addr(listener);
    let addr: NetAddr = NetAddr { raw: 0 };
    match ra {
        Ok(h) => {
            addr = h;
        },
        Err(e) => {
            panic(47162);
        },
    };
    let view = sla_net_addr_host(&addr);
    if !view_eq(&view, STR_PTR(host), STR_LEN(host)) {
        panic(47163);
    };
    if sla_net_addr_port(&addr) == 0 {
        panic(47164);
    };
    let fr = sla_net_addr_free(^addr);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47165);
            };
        },
        Err(e) => {
            panic(47166);
        },
    };
    let lc = sa_net_tcp_listener_close(listener);
    match lc {
        Ok(p) => {
            if p != 0 {
                panic(47167);
            };
        },
        Err(e) => {
            panic(47168);
        },
    };
}

