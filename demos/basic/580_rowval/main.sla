@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 第一类 Stirling 行值 Σ_k c(n,k) = n!（row3=6，row4=24，row5=120；581 做阶乘对峙）。
// 意对标 576 stirling1（单格版互补；532/570 行和体例）。

fn stirling1(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn s1_row(n: int) -> int {
    let s = 0;
    let k = 1;
    while k <= n {
        s = s + stirling1(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", s1_row(3), s1_row(4), s1_row(5));
    return 0;
}

@test "basic 580 rowval"() {
    if s1_row(3) != 6 { panic(58001); };
    if s1_row(4) != 24 { panic(58002); };
    if s1_row(5) != 120 { panic(58003); };
}
