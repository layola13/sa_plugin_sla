// 对标 tsgosa 17_bool_logic：&& || !。

fn bool_and(a: bool, b: bool) -> bool {
    return a && b;
}

fn bool_or(a: bool, b: bool) -> bool {
    return a || b;
}

fn main() -> i32 {
    let a: i32 = 5;
    let b: i32 = 0;
    println("{}", a > 3 && b == 0);
    println("{}", !(a == 5));
    println("{}", a != b);
    return 0;
}

@test "basic 14 bool logic"() {
    if bool_and(true, true) != true { panic(1401); };
    if bool_and(true, false) { panic(1402); };
    if bool_or(false, true) != true { panic(1403); };
    if bool_or(false, false) { panic(1404); };
    if !(5 > 3 && 0 == 0) { panic(1405); };
}
