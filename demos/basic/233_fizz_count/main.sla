@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 24_fizzbuzz 的计数版（1–100 含 15 倍数 6 个；24 为逐行打印）。
// 字符串分支改计数（字符串区暂不碰），区间 + 取余（45 口径）组合。

fn main() -> i32 {
    let fizz = 0;
    for i in 1..101 {
        if i % 15 == 0 { fizz = fizz + 1; };
    }
    println("{}", fizz);
    return 0;
}

@test "basic 233 fizz count"() {
    let fizz = 0;
    for i in 1..101 {
        if i % 15 == 0 { fizz = fizz + 1; };
    }
    if fizz != 6 { panic(23301); };
}
