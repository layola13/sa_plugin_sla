@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 12_for_of：遍历字符串求长（1, 2）。
// `for-of` 用直列改写（`for in` 迭代器协议见 Phase 6，暂不碰；写法见 68）。

fn main() -> i32 {
    let s0 = "x";
    let s1 = "yy";
    println("{},{}", len(s0), len(s1));
    return 0;
}

@test "basic 96 forof len"() {
    let s0 = "x";
    let s1 = "yy";
    if len(s0) != 1 { panic(9601); };
    if len(s1) != 2 { panic(9602); };
}
