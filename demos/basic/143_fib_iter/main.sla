@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 173_fib_loop：迭代 fib（55）。
// 与 120 的递归 fib 互补：此处为双变量滚动（O(1) 空间）；

fn main() -> i32 {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < 10 {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    println("{}", a);
    return 0;
}

@test "basic 143 fib iter"() {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < 10 {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    if a != 55 { panic(14301); };
    if b != 89 { panic(14302); };
}
