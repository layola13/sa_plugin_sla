    sla_http_client_resp_free((rs[0] as ptr));
    if sla_http_client_req_free((rq[0] as ptr)) != 0 { panic(65386); };
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

@test "smoke2 sa_http_client_free"() {
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65400); };
    if sla_http_client_free((cl[0] as ptr)) != 0 { panic(65401); };
}

