@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 547_swap 的 Vec 版（127 为定长数组版：首尾换位 3,1）。
// 临时变量三步换（与 173 的 `^` 换异曲同工，此处为通用写法）。

fn main() -> i32 {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    let t = v[0];
    v[0] = v[2];
    v[2] = t;
    println("{},{},{}", v[0], v[1], v[2]);
    return 0;
}

@test "basic 249 vec swap"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    let t = v[0];
    v[0] = v[2];
    v[2] = t;
    if v[0] != 3 { panic(24901); };
    if v[1] != 2 { panic(24902); };
    if v[2] != 1 { panic(24903); };
}
