@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin-Riordan 桥序 R(n)=M(n-1)-R(n-1)（R(4)=3，R(5)=6，R(6)=15）。
// 意对标 636_riordan × 626_motzkin（两族桥接；645 做三向收束）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return moz(n - 1) - rbr(n - 1);
}

fn main() -> i32 {
    println("{},{},{}", rbr(4), rbr(5), rbr(6));
    return 0;
}

@test "basic 643 rio bridge"() {
    if rbr(4) != 3 { panic(64301); };
    if rbr(5) != 6 { panic(64302); };
    if rbr(6) != 15 { panic(64303); };
    if rbr(7) != 36 { panic(64304); };
}
