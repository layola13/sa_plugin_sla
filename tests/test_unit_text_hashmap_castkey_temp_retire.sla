@import "sa_std/vec.sa"
@import "sa_std/hashmap.sa"
@import "sa_std/core/option.sa"

// DEF-TEXT-VECINDEX-FIELDASSIGN-TEMP-RETIRE (audit, HashMap index
// arm): a HashMap index read whose key is a materializing cast
// (`m[k as i32]`) inside a value-returning function leaves the cast
// result register Active at the return point. The index arm retired
// the key register only under callArgNeedsRelease, which excludes
// cast results, so the host traps MemoryLeak 1012. Fails on the
// base head, passes after the fix (predicate aligned to
// indexResultNeedsRelease; non-materializing casts still retire
// nothing, via castResultMaterializesTemp).

fn get_val(m: &HashMap<i32, i32>, k: i64) -> i32 {
    return m[k as i32];
}

@test "hashmap cast key temp retire"() {
    let m: HashMap<i32, i32> = HashMap::new();
    m.insert(7, 70);
    m.insert(8, 80);
    if get_val(&m, 8) != 80 { panic(4781); };
}
