// E_res corpus: borrow-return views over move-only handle newtypes.
//
// The wrapper functions below are written in exactly the form
// gen_wrap.py emits for the E_res handle families (owner retyped to a
// move-only newtype, borrow externs become `-> &[u8][owner]` views
// produced by the __slice_view intrinsic), so this file doubles as the
// form proof for the generated wrap batch.  Positive verdicts: the
// view's length/content agree with the len sibling, repeated views
// are stable while the owner is untouched, and the owner can still be
// freed after the last view use.
@import "sa_std/env.sai"
@import "sa_std/fmt.sai"
@import "sa_std/fs.sai"
@import "sa_std/io.sai"
@import "sa_std/net.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/text/regex.sai"

struct FsReadBuffer {
    raw: u64,
}

fn sla_fs_read_file(path: ptr, path_len: u64, max_bytes: u64) -> FsReadBuffer! {
    let r = sa_fs_read_file(path, path_len, max_bytes);
    match r {
        Ok(h) => {
            return Ok(FsReadBuffer { raw: h });
        },
        Err(e) => {
            return Err(e);
        },
    };
}

fn sla_fs_read_buffer_data(buffer: &FsReadBuffer) -> &[u8][buffer] {
    return __slice_view(sa_fs_read_buffer_data(buffer.raw), sa_fs_read_buffer_len(buffer.raw));
}

fn sla_fs_read_buffer_len(buffer: &FsReadBuffer) -> u64 {
    return sa_fs_read_buffer_len(buffer.raw);
}

fn sla_fs_read_buffer_free(^buffer: FsReadBuffer) -> i32 {
    return sa_fs_read_buffer_free(buffer.raw);
}

