@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/btree_map.sa"
@import "sa_std/core/option.sa"

// #14 follow-up: `BTreeMap.get` / `len` SAB lowering (output verified via
// build-exe: `10,2,0,2`).
fn main() -> i32 {
    let m = BTreeMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 10);
    let ga = m.get("a").copied().unwrap_or_default();
    let gb = m.get("b").copied().unwrap_or_default();
    let gc = m.get("zzz").copied().unwrap_or_default();
    println("{},{},{},{}", ga, gb, gc, len(m));
    return 0;
}

@test "unit btree get chain"() {
    let m = BTreeMap::new();
    if m.get("nope").copied().unwrap_or_default() != 0 {
        panic(15001);
    };
    if len(m) != 0 {
        panic(15002);
    };
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 10);
    if m.get("a").copied().unwrap_or_default() != 10 {
        panic(15003);
    };
    if m.get("b").copied().unwrap_or_default() != 2 {
        panic(15004);
    };
    if m.get("zzz").copied().unwrap_or_default() != 0 {
        panic(15005);
    };
    if len(m) != 2 {
        panic(15006);
    };
}
