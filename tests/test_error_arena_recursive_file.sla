// expect: ArenaUnsafe
// F2-A C1 corpus: design 2.4 counterexample. The recursive
// edge Vec<Node> must NOT be cut the way drop plans cut cycles:
// the greatest-fixpoint closure still reaches File through
// Node.f, so Node is not arena-safe.
struct Node { f: File, next: Vec<Node> }

fn id_node(x: Node) -> Node { return x; }

fn neg_recursive_file(p: Node) -> i32 {
    arena {
        let n = id_node(p);
    }
    return 0;
}
