@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// sigma 乘性（gcd(m,n)=1 时 σ(mn)=σ(m)σ(n)：σ(12)=σ(4)σ(3)=28）。
// 意对标 377 除数和的乘性版（399-phi 乘性互补）。

fn sigma(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        if n % i == 0 { s = s + i; };
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", sigma(12), sigma(4) * sigma(3), sigma(6));
    return 0;
}

@test "basic 400 sigma mult"() {
    if sigma(12) != 28 { panic(40001); };
    if sigma(4) * sigma(3) != 28 { panic(40002); };
    if sigma(12) != sigma(4) * sigma(3) { panic(40003); };
    if sigma(6) != 12 { panic(40004); };
}
