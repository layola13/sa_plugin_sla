    let q: u64 = 0;
    let eoff: u64 = 0;
    let ekind: u64 = 0;
    if sla_ts_query_new(STR_PTR("typescript"), STR_LEN("typescript"), STR_PTR("(function_declaration name: (identifier) @fname)"), STR_LEN("(function_declaration name: (identifier) @fname)"), &q, &eoff, &ekind) != 0 { panic(93576); };
    let cursor: u64 = 0;
    if sla_ts_query_cursor_new(&cursor) != 0 { panic(93577); };
    if sla_ts_query_exec(cursor, q, root) != 0 { panic(93578); };
    let has: u64 = 0;
    let pat: u64 = 0;
    let caps: u64 = 0;
    if sla_ts_query_next_match(cursor, &has, &pat, &caps) != 0 { panic(93579); };
    if has != 1 { panic(93580); };
    let node: u64 = 0;
    let cap: u64 = 0;
    if sla_ts_query_match_capture(cursor, 0, &node, &cap) != 0 { panic(93581); };
    if node == 0 { panic(93582); };
    if cap != 0 { panic(93583); };
    let buf = [0u8; 64];
    let bp: ptr = SLA_PTR_ADD(&buf[0], 0);
    let tlen: u64 = 0;
    if sla_ts_node_text(node, &buf[0], 64, &tlen) != 0 { panic(93584); };
    if ts_buf_eq(bp, tlen, STR_PTR("alpha"), STR_LEN("alpha")) != 1 { panic(93585); };
    sla_ts_node_free(^node);
    if sla_ts_query_next_match(cursor, &has, &pat, &caps) != 0 { panic(93586); };
    if has != 1 { panic(93587); };
