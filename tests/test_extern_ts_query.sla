@test "extern ts sa_ts_query_exec"() {
    if sla_ts_available() != 1 { panic(93531); };
    let parser: u64 = 0;
    if sla_ts_parser_new(&parser) != 0 { panic(93532); };
    if sla_ts_parser_set_language(parser, STR_PTR("typescript"), STR_LEN("typescript")) != 0 { panic(93533); };
    let tree: u64 = 0;
    if sla_ts_parse(parser, STR_PTR("function alpha() {} function beta() {}"), STR_LEN("function alpha() {} function beta() {}"), &tree) != 0 { panic(93534); };
    let root: u64 = 0;
    if sla_ts_tree_root(tree, &root) != 0 { panic(93535); };
    let q: u64 = 0;
    let eoff: u64 = 0;
    let ekind: u64 = 0;
    if sla_ts_query_new(STR_PTR("typescript"), STR_LEN("typescript"), STR_PTR("(function_declaration name: (identifier) @fname)"), STR_LEN("(function_declaration name: (identifier) @fname)"), &q, &eoff, &ekind) != 0 { panic(93536); };
    let cursor: u64 = 0;
    if sla_ts_query_cursor_new(&cursor) != 0 { panic(93537); };
    if sla_ts_query_exec(cursor, q, root) != 0 { panic(93538); };
    let has: u64 = 0;
    let pat: u64 = 0;
    let caps: u64 = 0;
    if sla_ts_query_next_match(cursor, &has, &pat, &caps) != 0 { panic(93539); };
    if has != 1 { panic(93540); };
    sla_ts_query_cursor_free(^cursor);
    sla_ts_query_free(^q);
    sla_ts_node_free(^root);
    sla_ts_tree_free(^tree);
    sla_ts_parser_free(^parser);
}

