@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 高位三 M(8)=323（M(7)=127 对 127；卷积和 196）。
// 意对标 631_motz7（高位版互补；635 做三向收束）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", moz(7), moz(8));
    return 0;
}

@test "basic 634 motz8"() {
    if moz(8) != 323 { panic(63401); };
    if moz(7) != 127 { panic(63402); };
    if moz(6) != 51 { panic(63403); };
}
