// extern FINAL batch -- sa_pthread_join, isolated in its own file.
// thread.sai documents the pre-F1 hazard: SA programs were once bound
// to glibc's pthread_join, which dereferences the i32 registry slot
// as a pthread descriptor (SIGSEGV). The sa_pthread_join entry is the
// runtime's own registry join; its out cell must be a real writable
// cell (the impl writes the task result through it and rejects a
// null out with an invalid-argument error). This carrier is the
// fresh verdict on sci 79a2aafd x sla 0998efbf: spawn a counter
// worker through the raw extern (fn values materialize only at raw
// extern ptr boundaries), join it through sa_pthread_join, and
// require the counter to be exactly 1 after the join returns
// (join = completion barrier).
@import "sla_std/wrap/thread.sla"
@import "sa_std/thread.sai"
@import "sa_std/globals.sai"
@import "sa_std/string.sa"

fn fin_tj_worker(arg: ptr) {
    let out: u64 = 0;
    let rc: i32 = sa_global_u64_add(STR_PTR("fin.tj.a"), STR_LEN("fin.tj.a"), 1, &out);
}

@test "extern final sa_pthread_join"() {
    let h: i32 = pthread_spawn(fin_tj_worker, 0);
    if h <= 0 { panic(950201); };
    let oc = [0u8; 8];
    let rc: i32 = sa_pthread_join(h, &oc[0]);
    if rc != 0 { panic(950202); };
    let v: u64 = 0;
    let rc2: i32 = sa_global_u64_get(STR_PTR("fin.tj.a"), STR_LEN("fin.tj.a"), &v);
    if rc2 != 0 { panic(950203); };
    if v != 1 { panic(950204); };
}
