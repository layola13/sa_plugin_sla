@test "smoke2 sa_http_client_sse_read"() {
    let h = go s2_sse_srv(24813 + 66060 * 16777216);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24813, STR_PTR("/sse"), STR_LEN("/sse"), ubp);
    sla_time_sleep_ms(100);
    let hh = [0u64; 4];
    if sla_http_client_sse_post(ubp, ulen, STR_PTR("{}"), STR_LEN("{}"), STR_PTR(""), 0, &hh[0]) != 0 { panic(66070); };
    let handle = (hh[0] as ptr);
    let acc = [0u8; 2048];
    let ap: ptr = PTR_BYTE_ADD(&acc, 0);
    let total: u64 = 0;
    let done = [0u64; 4];
    let spins: u64 = 0;
    while spins < 300 {
        let big = [0u64; 256];
        let ol = [0u64; 4];
        if sla_http_client_sse_read(handle, &big[0], 2048, &ol[0]) != 0 { panic(66071); };
        if ol[0] > 0 {
            let srcp: ptr = PTR_BYTE_ADD(&big, 0);
            let i: u64 = 0;
            while i < ol[0] {
                let s: ptr = PTR_BYTE_ADD(srcp, i);
                let d: ptr = PTR_BYTE_ADD(ap, total + i);
                PTR_WRITE_U8(d, PTR_READ_U8(s));
                i = i + 1;
            }
            total = total + ol[0];
        };
        if sla_http_client_sse_poll(handle, &done[0]) != 0 { panic(66072); };
        if done[0] == 2 { panic(66073); };
        if done[0] == 1 && ol[0] == 0 { break; };
        sla_time_sleep_ms(20);
        spins = spins + 1;
    }
    if done[0] != 1 { panic(66074); };
    if !s2_contains(ap, total, STR_PTR("tick-1"), STR_LEN("tick-1")) { panic(66075); };
    if !s2_contains(ap, total, STR_PTR("tick-2"), STR_LEN("tick-2")) { panic(66076); };
    sla_http_client_sse_free(handle);
    sa_task_join(h);
}

