@import "sa_std/vec.sa"

// (xviii) root B: `&&` must short-circuit. The generic binary
// combine used to evaluate both operands and merge them with a
// plain `and`, so a guarded read on the right executed even when
// the left side had already decided the result -- with i == len
// that read traps with the Vec OOB panic code=32 (the (xlix)
// root-B failure behind __psa_fmt_parse). Every test in this file
// traps with code=32 on the pre-fix compiler.

@test "and guard in if condition never reads past len"() {
    let v: Vec<i32> = Vec::new();
    v.push(46);
    v.push(7);
    let i = len(v);
    if i < len(v) && v[i] == 46 {
        panic(88401);
    };
}

@test "and guard in let value position never reads past len"() {
    let v: Vec<i32> = Vec::new();
    v.push(46);
    v.push(7);
    let i = len(v);
    let ok = i < len(v) && v[i] == 46;
    if ok {
        panic(88402);
    };
}

@test "and guard in while condition stops at len"() {
    let v: Vec<i32> = Vec::new();
    v.push(46);
    v.push(46);
    v.push(46);
    let i = 0;
    let hits = 0;
    while i < len(v) && v[i] == 46 {
        hits = hits + 1;
        i = i + 1;
    }
    if hits != 3 {
        panic(88403);
    };
    if i != 3 {
        panic(88404);
    };
}

@test "and chained guard skips the tail reads"() {
    let v: Vec<i32> = Vec::new();
    v.push(46);
    v.push(7);
    let i = len(v);
    let ok = i < len(v) && v[i] == 46 && v[i + 1] == 7;
    if ok {
        panic(88405);
    };
}

@test "and evaluates right side when left is true"() {
    let v: Vec<i32> = Vec::new();
    v.push(46);
    v.push(7);
    let i = 0;
    if !(i < len(v) && v[i] == 46) {
        panic(88406);
    };
    let j = 1;
    if j < len(v) && v[j] == 46 {
        panic(88407);
    };
}
