@import "sa_std/hashmap.sa"
@import "sa_std/core/option.sa"

// P1 coverage: HashMap.contains_key(...) — SAB audit registry entry
// HashMap.contains_key was checkfail on both backends
// (check:Undefined call) at registry stamp ee7b41c3 and no unit
// corpus file references it. The SA-level sa_map_contains_key
// export exists in sa_std/hashmap.sa.

@test "p1 hashmap contains_key"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    if !m.contains_key("a") { panic(205); };
    if !m.contains_key("b") { panic(210); };
    if m.contains_key("zzz") { panic(211); };
}

@test "p1 hashmap contains_key empty and int keys"() {
    let m: HashMap<i32, i32> = HashMap::new();
    if m.contains_key(7) { panic(212); };
    m.insert(7, 70);
    if !m.contains_key(7) { panic(213); };
}
