@import "sa_std/vec.sa"
@import "sa_std/thread.sa"
@import "sa_std/core/result.sa"

fn merge_direct_chunk() -> Vec<i32> {
    let chunk: Vec<i32> = Vec::new();
    chunk.push(7);
    chunk.push(11);
    return chunk;
}

fn merge_direct_batch(chunk: Vec<i32>) -> i32 {
    return len(chunk) as i32;
}

// Branch merge must consume `chunk` on both arms:
// - thread-spawn capture move (non-copy payload)
// - plain call move
// Capture a fn-ptr too so SA uses the known-good inline-join thread path
// (fn-ptr + noncopy payload), matching test_unit_fn_ptr_thread_pair_direct.
fn merge_direct_spawn_or_call(use_threads: bool, batch: fn(Vec<i32>) -> i32) -> i32 {
    let chunk = merge_direct_chunk();
    if use_threads {
        let handle = thread::spawn(^|| batch(chunk));
        return handle.join().unwrap();
    } else {
        return batch(chunk);
    };
}

@test "thread closure and direct call both consume branch chunk"() {
    if merge_direct_spawn_or_call(false, merge_direct_batch) != 2 { panic(51380); };
    if merge_direct_spawn_or_call(true, merge_direct_batch) != 2 { panic(51381); };
}
