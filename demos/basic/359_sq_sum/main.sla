@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 平方和循环版（1²+...+10²=385）。
// 意对标 27 平方和的循环版（288 公式对峙版互补；365 做三向）。

fn sq_sum(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i * i;
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", sq_sum(10), sq_sum(4));
    return 0;
}

@test "basic 359 sq sum"() {
    if sq_sum(10) != 385 { panic(35901); };
    if sq_sum(4) != 30 { panic(35902); };
    if sq_sum(1) != 1 { panic(35903); };
}
