// extern FINAL batch -- quic/http3 group (17 names):
// sa_std_quic_conn_poll, sa_std_quic_conn_handshake_completed,
// sa_std_quic_conn_close, sa_std_quic_stream_open,
// sa_std_quic_stream_write, sa_std_quic_stream_read,
// sa_std_quic_buffer_data, sa_std_quic_buffer_len,
// sa_std_quic_buffer_free, sa_std_http3_session_bind,
// sa_std_http3_session_destroy, sa_std_http3_submit_request,
// sa_std_http3_server_next_request, sa_std_http3_request_field,
// sa_std_http3_submit_response, sa_std_http3_response_status,
// sa_std_http3_stream_read.
// Client and server endpoints live in the same process on UDP
// loopback; both state machines are driven by interleaved poll
// calls from the test body (no threads). Certificates are the
// batch fixtures in /tmp/fincert (self-signed CN=localhost,
// generated by the batch setup script; the client passes the same
// PEM as its CA file).
@import "sla_std/wrap/quic.sla"
@import "sa_std/string.sa"
@import "sa_std/time.sai"
@import "sa_std/globals.sai"
@import "tests/import_fixtures/pkgjson/ptr_helpers.sa"

fn fin_q_server(port: u32) -> u64 {
    let ep: u64 = 0;
    if sla_std_quic_endpoint_create(&ep) != 0 { panic(954010); };
    if ep == 0 { panic(954011); };
    if sla_std_quic_server_listen(ep, port, STR_PTR("/tmp/fincert/cert.pem"), STR_LEN("/tmp/fincert/cert.pem"), STR_PTR("/tmp/fincert/key.pem"), STR_LEN("/tmp/fincert/key.pem")) != 0 { panic(954012); };
    return ep;
}

fn fin_q_client(port: u32, alpn: ptr, alpn_len: u64) -> u64 {
    // Returns the client connection; the client endpoint handle is
    // stashed in a global for the destroy call.
    let ep: u64 = 0;
    if sla_std_quic_endpoint_create(&ep) != 0 { panic(954020); };
    let conn: u64 = 0;
    let rc: i32 = sla_std_quic_client_connect(ep, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), port, STR_PTR("localhost"), STR_LEN("localhost"), STR_PTR("/tmp/fincert/cert.pem"), STR_LEN("/tmp/fincert/cert.pem"), alpn, alpn_len, &conn);
    if rc != 0 { panic(954021); };
    if conn == 0 { panic(954022); };
    let dummy: u64 = 0;
    if sa_global_u64_add(STR_PTR("fin.q.cep"), STR_LEN("fin.q.cep"), ep, &dummy) != 0 { panic(954023); };
    return conn;
}

fn fin_q_client_ep() -> u64 {
    let v: u64 = 0;
    let rc: i32 = sa_global_u64_get(STR_PTR("fin.q.cep"), STR_LEN("fin.q.cep"), &v);
    if rc != 0 { return 0; };
    return v;
}

// Drive both endpoints until both handshakes complete; returns the
// server-side connection handle.
fn fin_q_handshake(sep: u64, cep: u64, cconn: u64) -> u64 {
    let sconn: u64 = 0;
    let i: i32 = 0;
    while i < 600 {
        if sla_std_quic_server_poll(sep, 5) != 0 { panic(954030); };
        if sconn == 0 {
            let ac: u64 = 0;
            let arc: i32 = sla_std_quic_server_accept(sep, &ac);
            if arc == 0 { sconn = ac; };
        };
        if sla_std_quic_conn_poll(cconn, 5) != 0 { panic(954031); };
        if sconn != 0 {
            if sla_std_quic_conn_poll(sconn, 5) != 0 { panic(954032); };
        };
        let cd: u64 = 0;
        if sla_std_quic_conn_handshake_completed(cconn, &cd) != 0 { panic(954033); };
        if cd == 1 {
            if sconn != 0 {
                let sd: u64 = 0;
                if sla_std_quic_conn_handshake_completed(sconn, &sd) != 0 { panic(954034); };
                if sd == 1 { return sconn; };
            };
        };
        i = i + 1;
    }
    panic(954035);
    return 0;
}

fn fin_q_pump(sep: u64, a: u64, b: u64, rounds: i32) {
    let i: i32 = 0;
    while i < rounds {
        if sla_std_quic_server_poll(sep, 2) != 0 { panic(954040); };
        if sla_std_quic_conn_poll(a, 2) != 0 { panic(954041); };
        if sla_std_quic_conn_poll(b, 2) != 0 { panic(954042); };
        i = i + 1;
    }
}

@test "extern final quic stream echo"() {
    let sep: u64 = fin_q_server(61480);
    let cconn: u64 = fin_q_client(61480, STR_PTR("h3"), STR_LEN("h3"));
    let cep: u64 = fin_q_client_ep();
    let sconn: u64 = fin_q_handshake(sep, cep, cconn);
    if sconn == 0 { panic(954102); };
    // Client opens a stream and writes a fin-terminated message.
    let sid: u64 = 0;
    if sla_std_quic_stream_open(cconn, &sid) != 0 { panic(954103); };
    let written: u64 = 0;
    if sla_std_quic_stream_write(cconn, sid as i64, STR_PTR("fin-quic"), STR_LEN("fin-quic"), 1, &written) != 0 { panic(954104); };
    if written != 8 { panic(954105); };
    // Server reads it (pumping both endpoints until it arrives).
    let buf = [0u8; 64];
    let got: u64 = 0;
    let gfin: u64 = 0;
    let i: i32 = 0;
    while i < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let n: u64 = 0;
        let f: u64 = 0;
        let rc: i32 = sla_std_quic_stream_read(sconn, sid as i64, &buf[0], 64, &n, &f);
        if rc == 0 {
            if n > 0 { got = n; gfin = f; break; };
        };
        i = i + 1;
    }
    if got != 8 { panic(954106); };
    if gfin != 1 { panic(954107); };
    if SLA_BYTE_AT(&buf[0], 0) != 102 { panic(954108); };
    if SLA_BYTE_AT(&buf[0], 7) != 99 { panic(954109); };
    // Server writes the reply on the same stream; client reads it.
    let w2: u64 = 0;
    if sla_std_quic_stream_write(sconn, sid as i64, STR_PTR("quic-fin"), STR_LEN("quic-fin"), 1, &w2) != 0 { panic(954110); };
    if w2 != 8 { panic(954111); };
    let buf2 = [0u8; 64];
    let got2: u64 = 0;
    let j: i32 = 0;
    while j < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let n: u64 = 0;
        let f: u64 = 0;
        let rc: i32 = sla_std_quic_stream_read(cconn, sid as i64, &buf2[0], 64, &n, &f);
        if rc == 0 {
            if n > 0 { got2 = n; break; };
        };
        j = j + 1;
    }
    if got2 != 8 { panic(954112); };
    if SLA_BYTE_AT(&buf2[0], 0) != 113 { panic(954113); };
    if SLA_BYTE_AT(&buf2[0], 7) != 110 { panic(954114); };
    if sla_std_quic_conn_close(cconn) != 0 { panic(954115); };
    if sla_std_quic_conn_close(sconn) != 0 { panic(954116); };
    if sla_std_quic_endpoint_destroy(cep) != 0 { panic(954117); };
    if sla_std_quic_endpoint_destroy(sep) != 0 { panic(954118); };
}

@test "extern final http3 request response"() {
    let sep: u64 = fin_q_server(61481);
    let cconn: u64 = fin_q_client(61481, STR_PTR("h3"), STR_LEN("h3"));
    let cep: u64 = fin_q_client_ep();
    let sconn: u64 = fin_q_handshake(sep, cep, cconn);
    // Client session: bind and submit a request with a body.
    let cs: u64 = 0;
    if sla_std_http3_session_create(&cs) != 0 { panic(954122); };
    if sla_std_http3_session_bind(cs, cconn) != 0 { panic(954123); };
    let ss: u64 = 0;
    if sla_std_http3_session_create(&ss) != 0 { panic(954124); };
    if sla_std_http3_session_bind(ss, sconn) != 0 { panic(954125); };
    let rsid: u64 = 0;
    if sla_std_http3_submit_request(cs, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("localhost"), STR_LEN("localhost"), STR_PTR("/fin"), STR_LEN("/fin"), STR_PTR("ping"), STR_LEN("ping"), &rsid) != 0 { panic(954126); };
    // Server: next_request must surface the same stream, the :path
    // field must read back, and the body must stream through.
    let ssid: u64 = 0;
    let i: i32 = 0;
    while i < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let t: u64 = 0;
        let rc: i32 = sla_std_http3_server_next_request(ss, &t);
        if rc == 0 {
            if t as i64 != -1 { ssid = t; break; };
        };
        i = i + 1;
    }
    if ssid != rsid { panic(954127); };
    let fbuf = [0u8; 64];
    let flen: u64 = 0;
    if sla_std_http3_request_field(ss, ssid as i64, STR_PTR(":path"), STR_LEN(":path"), &fbuf[0], 64, &flen) != 0 { panic(954128); };
    if flen != 4 { panic(954129); };
    if SLA_BYTE_AT(&fbuf[0], 0) != 47 { panic(954130); };
    if SLA_BYTE_AT(&fbuf[0], 1) != 102 { panic(954131); };
    let bbuf = [0u8; 64];
    let blen: u64 = 0;
    let bfin: u64 = 0;
    let j: i32 = 0;
    while j < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let n: u64 = 0;
        let f: u64 = 0;
        let rc: i32 = sla_std_http3_stream_read(ss, ssid as i64, &bbuf[0], 64, &n, &f);
        if rc == 0 {
            if n > 0 { blen = n; bfin = f; break; };
        };
        j = j + 1;
    }
    if blen != 4 { panic(954132); };
    if SLA_BYTE_AT(&bbuf[0], 0) != 112 { panic(954133); };
    // Server responds 200 with a body; client reads status + body.
    if sla_std_http3_submit_response(ss, ssid as i64, 200, STR_PTR("pong"), STR_LEN("pong")) != 0 { panic(954134); };
    let status: u64 = 0;
    let k: i32 = 0;
    while k < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let st: u64 = 0;
        let rc: i32 = sla_std_http3_response_status(cs, rsid as i64, &st);
        if rc == 0 {
            if st != 0 { status = st; break; };
        };
        k = k + 1;
    }
    if status != 200 { panic(954135); };
    let rbuf = [0u8; 64];
    let rlen: u64 = 0;
    let m: i32 = 0;
    while m < 300 {
        fin_q_pump(sep, cconn, sconn, 1);
        let n: u64 = 0;
        let f: u64 = 0;
        let rc: i32 = sla_std_http3_stream_read(cs, rsid as i64, &rbuf[0], 64, &n, &f);
        if rc == 0 {
            if n > 0 { rlen = n; break; };
        };
        m = m + 1;
    }
    if rlen != 4 { panic(954136); };
    if SLA_BYTE_AT(&rbuf[0], 0) != 112 { panic(954137); };
    if SLA_BYTE_AT(&rbuf[0], 3) != 103 { panic(954138); };
    if sla_std_http3_session_destroy(cs) != 0 { panic(954139); };
    if sla_std_http3_session_destroy(ss) != 0 { panic(954140); };
    if sla_std_quic_conn_close(cconn) != 0 { panic(954141); };
    if sla_std_quic_conn_close(sconn) != 0 { panic(954142); };
    if sla_std_quic_endpoint_destroy(cep) != 0 { panic(954143); };
    if sla_std_quic_endpoint_destroy(sep) != 0 { panic(954144); };
}

@test "extern final quic buffer trio"() {
    let h: u64 = 0;
    if sla_std_quic_capabilities_json(&h) != 0 { panic(954151); };
    if h == 0 { panic(954152); };
    let n: u64 = sla_std_quic_buffer_len(h);
    if n == 0 { panic(954153); };
    let qb = QuicBuffer { raw: h };
    let view = sla_std_quic_buffer_data(&qb);
    if view.len() != n { panic(954154); };
    if view[0] != 123 { panic(954155); };
    if sla_std_quic_buffer_free(^h) != 0 { panic(954156); };
    let h2: u64 = 0;
    if sla_std_quic_constants_json(&h2) != 0 { panic(954157); };
    let n2: u64 = sla_std_quic_buffer_len(h2);
    if n2 == 0 { panic(954158); };
    if sla_std_quic_buffer_free(^h2) != 0 { panic(954159); };
}
