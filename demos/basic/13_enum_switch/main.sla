@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 15_enum_switch：switch over i32（数字分支）。

fn classify(c: i32) -> i32 {
    let r: i32 = 0;
    switch c {
        0 => {
            r = 10;
        },
        1 => {
            r = 20;
        },
        default => {
            r = 30;
        },
    };
    return r;
}

fn main() -> i32 {
    println("{}", classify(1));
    println("{}", classify(0) + classify(2));
    return 0;
}

@test "basic 13 switch classify"() {
    if classify(1) != 20 { panic(1301); };
    if classify(0) + classify(2) != 40 { panic(1302); };
}
