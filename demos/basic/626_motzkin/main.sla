@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 数递推 M(n)=M(n-1)+sum M(k)M(n-2-k)（迭代建表，546 范式）。
// M(3)=4，M(4)=9，M(5)=21（629 做迭代/递归对峙）。
// 意对标 606_schroder（同为格路计数族；此处为含平步格路）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", moz(3), moz(4), moz(5));
    return 0;
}

@test "basic 626 motzkin"() {
    if moz(3) != 4 { panic(62601); };
    if moz(4) != 9 { panic(62602); };
    if moz(5) != 21 { panic(62603); };
    if moz(2) != 2 { panic(62604); };
}
