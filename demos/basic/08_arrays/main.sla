@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 08_arrays：定长数组读写（SLA 用 [int; N]，区别于 Vec）。
// 注意：字面量 [3, 1, 4, 1, 5] 推导为 [int; 5]；若形参写 [i32; 5] 则出现
// i64(8B stride) vs i32(4B stride) 的布局错位（check 能过但运行值错，
// 已记入 POTENTIAL_ISSUES.md #1），此处演示统一用 int。

fn array_sum(values: [int; 5]) -> int {
    return values[0] + values[1] + values[2] + values[3] + values[4];
}

fn main() -> i32 {
    let a = [3, 1, 4, 1, 5];
    println("{}", len(a));
    println("{}", a[0] + a[4]);
    a[1] = 9;
    println("{}", a[1]);
    return 0;
}

@test "basic 08 fixed array"() {
    let a = [3, 1, 4, 1, 5];
    if len(a) != 5 { panic(801); };
    if a[0] + a[4] != 8 { panic(802); };
    a[1] = 9;
    if a[1] != 9 { panic(803); };
    if array_sum(a) != 3 + 9 + 4 + 1 + 5 { panic(804); };
}
