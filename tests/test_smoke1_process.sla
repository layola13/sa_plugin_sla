@test "smoke1 sa_std_process_read_stdout"() {
    // read_stdout belongs to capture mode: run() the echo, then drain
    // the captured stdout from the process handle. (In stream mode the
    // pipes are separate io handles; read_stdout after wait fails --
    // probe evidence, WAVE1_REPORT.)
    let rec = [0u64; 4];
    let x: u64 = 0;
    PTR_ADDR(x, STR_PTR("/bin/echo"));
    rec[0] = x;
    rec[1] = STR_LEN("/bin/echo");
    let y: u64 = 0;
    PTR_ADDR(y, STR_PTR("hi"));
    rec[2] = y;
    rec[3] = STR_LEN("hi");
    let proc = [0u64; 4];
    let s1bp7: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_run(s1bp7, 2, &proc[0]);
    if rc != 0 { panic(57180); };
    let wcode = [0u64; 4];
    let wrc = sla_std_process_wait(proc[0], &wcode[0]);
    if wrc != 0 { panic(57186); };
    if wcode[0] != 0 { panic(57187); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc2 = sla_std_process_read_stdout(proc[0], &buf[0], 64, &rd[0]);
    if rc2 != 0 { panic(57182); };
    if rd[0] != 3 { panic(57183); };
    if buf[0] != 104 { panic(57184); };
    if buf[2] != 10 { panic(57185); };
    sla_std_process_close(proc[0]);
}

@test "smoke1 sa_std_process_read_stderr"() {
    // run = capture mode: the handle carries the captured streams.
    let rec = [0u64; 6];
    let x: u64 = 0;
    PTR_ADDR(x, STR_PTR("/bin/sh"));
    rec[0] = x;
    rec[1] = STR_LEN("/bin/sh");
    let y: u64 = 0;
    PTR_ADDR(y, STR_PTR("-c"));
    rec[2] = y;
    rec[3] = STR_LEN("-c");
    let z: u64 = 0;
    PTR_ADDR(z, STR_PTR("echo err 1>&2"));
    rec[4] = z;
    rec[5] = STR_LEN("echo err 1>&2");
    let cell = [0u64; 4];
    let s1bp8: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_run(s1bp8, 3, &cell[0]);
    if rc != 0 { panic(57192); };
    let wcode = [0u64; 4];
    let wrc = sla_std_process_wait(cell[0], &wcode[0]);
    if wrc != 0 { panic(57197); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc2 = sla_std_process_read_stderr(cell[0], &buf[0], 64, &rd[0]);
    if rc2 != 0 { panic(57193); };
    if rd[0] != 4 { panic(57194); };
    if buf[0] != 101 { panic(57195); };
    if buf[3] != 10 { panic(57196); };
    sla_std_process_close(cell[0]);
}

@test "smoke1 sa_std_process_close"() {
    let h = s1_spawn1(STR_PTR("/bin/true"), STR_LEN("/bin/true"), 57200);
    s1_wait_code(h, 57201);
    let rc = sla_std_process_close(h);
    if rc != 0 { panic(57202); };
    let rc2 = sla_std_process_close(h);
    if rc2 == 0 { panic(57203); };
}
