@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// !6=265 三向收束：双项递推 == 容斥和式 == 单项递推 !n=n·!(n-1)+(-1)^n
//（265 对 265 对 265；三算法互锁，316 系三向体例）。
// 意对标 566 derange × 567 derange_sum（两源见各源；单项式为第三源）。

fn derange(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let a = 1;
    let b = 0;
    let i = 2;
    let cur = 0;
    while i <= n {
        cur = (i - 1) * (b + a);
        a = b;
        b = cur;
        i = i + 1;
    }
    return cur;
}

fn derange_sum(n: int) -> int {
    let acc = 0;
    let k = 0;
    while k <= n {
        let f = 1;
        let j = 0;
        while j < n - k {
            f = f * (n - j);
            j = j + 1;
        }
        let sgn = 0 - 1;
        if k % 2 == 0 { sgn = 1; };
        acc = acc + sgn * f;
        k = k + 1;
    }
    return acc;
}

fn derange1(n: int) -> int {
    let a = 1;
    let i = 1;
    let cur = 1;
    while i <= n {
        let sgn = 0 - 1;
        if i % 2 == 0 { sgn = 1; };
        cur = i * a + sgn;
        a = cur;
        i = i + 1;
    }
    return cur;
}

fn main() -> i32 {
    println("{},{},{}", derange(6), derange_sum(6), derange1(6));
    return 0;
}

@test "basic 575 tri derange"() {
    if derange(6) != 265 { panic(57501); };
    if derange_sum(6) != 265 { panic(57502); };
    if derange1(6) != 265 { panic(57503); };
    if derange1(5) != 44 { panic(57504); };
}
