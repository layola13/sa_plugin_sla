@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 行和对峙：行和 == Catalan 卷积（n=4：14 对 14；n=5：42 对 42）。
// 意对标 597 narayana_row × 556 cat_conv（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nar_row(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + narayana(n, k);
        k = k + 1;
    }
    return s;
}

fn cat_conv(n: int) -> int {
    let c: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        c.push(0);
        i = i + 1;
    }
    c[0] = 1;
    let m = 1;
    while m <= n {
        let acc = 0;
        let j = 0;
        while j < m {
            acc = acc + c[j] * c[m - 1 - j];
            j = j + 1;
        }
        c[m] = acc;
        m = m + 1;
    }
    return c[n];
}

fn main() -> i32 {
    println("{},{},{},{}", nar_row(4), cat_conv(4), nar_row(5), cat_conv(5));
    return 0;
}

@test "basic 599 duel narrow"() {
    if nar_row(4) != 14 { panic(59901); };
    if cat_conv(4) != 14 { panic(59902); };
    if nar_row(5) != 42 { panic(59903); };
    if cat_conv(5) != 42 { panic(59904); };
    if nar_row(5) != cat_conv(5) { panic(59905); };
}
