@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 高位二 D(6,6)=8989（D(6,5)=3653 对 3653；D(6,4)=1289 中继）。
// 意对标 617_delannoy_high（高位版互补；625 做三向收束）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{}", delan(6, 5), delan(6, 6));
    return 0;
}

@test "basic 624 delannoy6"() {
    if delan(6, 6) != 8989 { panic(62401); };
    if delan(6, 5) != 3653 { panic(62402); };
    if delan(6, 4) != 1289 { panic(62403); };
}
