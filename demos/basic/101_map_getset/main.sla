@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/hashmap.sa"
@import "sa_std/core/option.sa"

// 对标 tsgosa 35_map_getset：存取求和（3）+ 缺键（0）+ 表长（2）。
// `has(c)` 用缺键取零表达（`get().copied().unwrap_or_default()`，见 #14）；
// `getSize()` 用 `len(m)` 表达（SAB `MAP_LEN` 直降）。

fn main() -> i32 {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ga = m.get("a").copied().unwrap_or_default();
    let gb = m.get("b").copied().unwrap_or_default();
    let gc = m.get("c").copied().unwrap_or_default();
    println("{},{},{}", ga + gb, gc, len(m));
    return 0;
}

@test "basic 101 map getset"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let ga = m.get("a").copied().unwrap_or_default();
    let gb = m.get("b").copied().unwrap_or_default();
    let gc = m.get("c").copied().unwrap_or_default();
    if ga + gb != 3 { panic(10101); };
    if gc != 0 { panic(10102); };
    if len(m) != 2 { panic(10103); };
}
