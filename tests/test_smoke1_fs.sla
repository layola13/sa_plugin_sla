}

@test "smoke1 sa_std_fs_file_read_exact_at"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/stdexactat.txt"), STR_LEN("smoke1_fs/stdexactat.txt"), STR_PTR("abcdef"), STR_LEN("abcdef"));
