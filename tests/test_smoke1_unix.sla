// Smoke wave 1: register-2 externs in sa_std/net.sai (unix families).
// Sockets live under smoke1_unix/ in the run cwd. Stream I/O on unix
// stream handles goes through the tcp stream wrappers (same handle
// family). Panic codes 61xxx.
@import "sla_std/wrap/net.sla"
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/process.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s1_mkdir() {
    sla_fs_mkdir_p(STR_PTR("smoke1_unix"), STR_LEN("smoke1_unix"));
}

fn s1_unix_listen(path: ptr, path_len: u64, code: i32) -> u64 {
    let lh = [0u64; 4];
    let rc = sla_std_net_unix_listen(path, path_len, &lh[0]);
    if rc != 0 { panic(code); };
    if lh[0] == 0 { panic(code + 1); };
    return lh[0];
}

@test "smoke1 sa_std_net_unix_accept"() {
    s1_mkdir();
    let lh = s1_unix_listen(STR_PTR("smoke1_unix/a.sock"), STR_LEN("smoke1_unix/a.sock"), 61010);
    let cli = [0u64; 4];
    let rc = sla_std_net_unix_connect(STR_PTR("smoke1_unix/a.sock"), STR_LEN("smoke1_unix/a.sock"), &cli[0]);
    if rc != 0 { panic(61011); };
    let srv = [0u64; 4];
    let rc2 = sla_std_net_unix_accept(lh, &srv[0]);
    if rc2 != 0 { panic(61012); };
    if srv[0] == 0 { panic(61013); };
    let wr = [0u64; 4];
    sla_std_net_tcp_stream_write(cli[0], STR_PTR("ux"), STR_LEN("ux"), &wr[0]);
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rd[0] != 2 { panic(61014); };
    if buf[0] != 117 { panic(61015); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_unix_accept_addr"() {
    s1_mkdir();
    let lh = s1_unix_listen(STR_PTR("smoke1_unix/b.sock"), STR_LEN("smoke1_unix/b.sock"), 61020);
    let cli = [0u64; 4];
    sla_std_net_unix_connect(STR_PTR("smoke1_unix/b.sock"), STR_LEN("smoke1_unix/b.sock"), &cli[0]);
    let srv = [0u64; 4];
    let addr = [0u64; 4];
    let rc = sla_std_net_unix_accept_addr(lh, &srv[0], &addr[0]);
    if rc != 0 { panic(61021); };
    if srv[0] == 0 { panic(61022); };
    if addr[0] == 0 { panic(61023); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_unix_listener_local_addr"() {
    s1_mkdir();
    let lh = s1_unix_listen(STR_PTR("smoke1_unix/c.sock"), STR_LEN("smoke1_unix/c.sock"), 61030);
    let addr = [0u64; 4];
    let rc = sla_std_net_unix_listener_local_addr(lh, &addr[0]);
    if rc != 0 { panic(61031); };
    if sla_net_unix_addr_path_len(addr[0]) != STR_LEN("smoke1_unix/c.sock") { panic(61032); };
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_unix_listener_try_clone"() {
    s1_mkdir();
    let lh = s1_unix_listen(STR_PTR("smoke1_unix/d.sock"), STR_LEN("smoke1_unix/d.sock"), 61040);
    let clone = [0u64; 4];
    let rc = sla_std_net_unix_listener_try_clone(lh, &clone[0]);
    if rc != 0 { panic(61041); };
    if clone[0] == 0 { panic(61042); };
    let cli = [0u64; 4];
    sla_std_net_unix_connect(STR_PTR("smoke1_unix/d.sock"), STR_LEN("smoke1_unix/d.sock"), &cli[0]);
    let srv = [0u64; 4];
    let rc2 = sla_std_net_unix_accept(clone[0], &srv[0]);
    if rc2 != 0 { panic(61043); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(clone[0]);
    sla_std_close(lh);
}

