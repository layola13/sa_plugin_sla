@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 步数 vs 链长-1 collatz 对峙（49×236：6→8=8）。
// 双实现一致性锁定（单实现见 49/236）。

fn collatz_steps(n: int) -> int {
    let x = n;
    let s = 0;
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2;
        } else {
            x = x * 3 + 1;
        };
        s = s + 1;
    }
    return s;
}

fn main() -> i32 {
    let chain: Vec<i32> = Vec::new();
    let m = 6;
    while m != 1 {
        chain.push(m);
        if m % 2 == 0 {
            m = m / 2;
        } else {
            m = m * 3 + 1;
        };
    }
    chain.push(1);
    println("{},{}", len(chain) - 1, collatz_steps(6));
    return 0;
}

@test "basic 294 duel collatz"() {
    let chain: Vec<i32> = Vec::new();
    let m = 6;
    while m != 1 {
        chain.push(m);
        if m % 2 == 0 {
            m = m / 2;
        } else {
            m = m * 3 + 1;
        };
    }
    chain.push(1);
    if len(chain) - 1 != collatz_steps(6) { panic(29401); };
    if collatz_steps(6) != 8 { panic(29402); };
}
