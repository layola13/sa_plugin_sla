// Bend2 P1-6 parity corpus: Map group (base.bend @faeb02e, 51 clauses).
// Bend Map is a persistent Patricia trie keyed by String. Our anchors:
// HashMap (primary) and BTreeMap. SLA method surface is new/insert/get/
// clear/len; keys are reachable through the imported MAP_KEYS macro,
// removal through BTREE_MAP_REMOVE on BTreeMap. The parity table
// records the form per def (Bend-internal trie helpers have no surface
// counterpart by design).
@import "sa_std/vec.sa"
@import "sa_std/hashmap.sa"
@import "sa_std/btree_map.sa"
@import "sa_std/core/option.sa"

@test "bend2 map new put set get has size"() {
    let m = HashMap::new();
    if len(m) != 0 { panic(73001); };
    // Map.put == Map.set value semantics: insert-or-replace
    m.insert("a", 1);
    m.insert("b", 2);
    m.insert("a", 10);
    if len(m) != 2 { panic(73002); };
    // Note: Option::unwrap_or_default() currently misgenerates
    // (!0 UnknownRegister, frontend bug registered by P1-6); the
    // corpus uses unwrap_or(0), which is verified working.
    let ga = m.get("a");
    if ga.copied().unwrap_or(0) != 10 { panic(73003); };
    let gb = m.get("b");
    if gb.copied().unwrap_or(0) != 2 { panic(73004); };
    // Map.has via get().is_some()
    if !m.get("a").is_some() { panic(73005); };
    if m.get("zzz").is_some() { panic(73006); };
    // Map.get on a missing key is None in Bend; ours agrees
    let gz = m.get("zzz");
    if gz.copied().unwrap_or(0) != 0 { panic(73007); };
}

@test "bend2 map keys values to_list"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    // Map.keys via the imported MAP_KEYS macro (no method surface):
    // reachable on the text backend (len == 2 asserted there; probe
    // evidence probes/probe_mf2.sla + split history in the P1-6
    // report). Two gaps keep it out of this dual-backend corpus: the
    // SAB macro bridge fails MAP_KEYS (UnknownRegister), and the
    // returned Vec<String>'s elements are not indexable in codegen,
    // so key *content* cannot be read back on either backend today.
    // Map.values / Map.to_list: the value multiset, read back through
    // get over the known key set (data-driven iteration over keys
    // awaits the keys-element gap above).
    let va = m.get("a");
    let vb = m.get("b");
    let total = va.copied().unwrap_or(0) + vb.copied().unwrap_or(0);
    if total != 3 { panic(73009); };
}

@test "bend2 map from_list union"() {
    // Map.from_list by composition (insert fold over pairs)
    let m = HashMap::new();
    m.insert("x", 1);
    m.insert("y", 2);
    if len(m) != 2 { panic(73010); };
    // Map.union(m, n): entries of n folded into m, n wins on conflict.
    // Driven here over n's known keys; a data-driven fold over
    // MAP_KEYS(n) awaits the keys-element readability gap (see above).
    let n = HashMap::new();
    n.insert("y", 20);
    n.insert("z", 30);
    let vy = n.get("y");
    m.insert("y", vy.copied().unwrap_or(0));
    let vz = n.get("z");
    m.insert("z", vz.copied().unwrap_or(0));
    if len(m) != 3 { panic(73011); };
    let gy = m.get("y");
    if gy.copied().unwrap_or(0) != 20 { panic(73012); };
    let gx = m.get("x");
    if gx.copied().unwrap_or(0) != 1 { panic(73013); };
    let gz2 = m.get("z");
    if gz2.copied().unwrap_or(0) != 30 { panic(73014); };
}

@test "bend2 map pop del btree"() {
    // Map.pop / Map.del: HashMap has no SLA removal entry (the MAP_DEL
    // macro bridge traps at runtime on the text backend). BTreeMap
    // removal via the BTREE_MAP_REMOVE macro works on the text
    // backend — old value 1 returned, len drops, key gone (probe
    // evidence probes/probe_w_btree_remove.sla) — but the SAB macro
    // bridge fails it (UnknownRegister), so the removal assertions
    // live in the probe evidence, not this dual-backend corpus.
    let b = BTreeMap::new();
    b.insert("a", 1);
    b.insert("b", 2);
    if len(b) != 2 { panic(73015); };
    let ba = b.get("a");
    if ba.copied().unwrap_or(0) != 1 { panic(73016); };
    let bb = b.get("b");
    if bb.copied().unwrap_or(0) != 2 { panic(73018); };
}

@test "bend2 map clear"() {
    let m = HashMap::new();
    m.insert("a", 1);
    m.clear();
    if len(m) != 0 { panic(73019); };
    if m.get("a").is_some() { panic(73020); };
}
