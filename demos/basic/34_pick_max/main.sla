@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 112_pick_max：早返回式 max（与 03_if_else 的表达式式互补）。

fn pick(a: i32, b: i32) -> i32 {
    if a > b {
        return a;
    };
    return b;
}

fn main() -> i32 {
    println("{},{}", pick(7, 12), pick(9, 3));
    return 0;
}

@test "basic 34 pick max early return"() {
    if pick(7, 12) != 12 { panic(3401); };
    if pick(9, 3) != 9 { panic(3402); };
}
