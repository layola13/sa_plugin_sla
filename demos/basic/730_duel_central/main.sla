@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 中央二项对峙：商式直算 vs Pascal 建表（(10,5)：252 对 252；(12,6)：924 对 924）。
// 意对标 729_central_binom × 546_pascal（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pbin(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{},{}", binom_mul(10, 5), pbin(10, 5), binom_mul(12, 6), pbin(12, 6));
    return 0;
}

@test "basic 730 duel central"() {
    if binom_mul(10, 5) != 252 { panic(73001); };
    if pbin(10, 5) != 252 { panic(73002); };
    if binom_mul(12, 6) != 924 { panic(73003); };
    if pbin(12, 6) != 924 { panic(73004); };
}
