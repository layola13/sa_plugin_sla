@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 347_math_sqrt 的判定版（117 为取值版：1,0,1）。
// 试乘回代相等（117 口径之判定版）。

fn is_square(n: int) -> int {
    let r = 0;
    while (r + 1) * (r + 1) <= n {
        r = r + 1;
    }
    return if r * r == n { 1 } else { 0 };
}

fn main() -> i32 {
    println("{},{},{}", is_square(16), is_square(15), is_square(100));
    return 0;
}

@test "basic 321 is square"() {
    if is_square(16) != 1 { panic(32101); };
    if is_square(15) != 0 { panic(32102); };
    if is_square(100) != 1 { panic(32103); };
    if is_square(1) != 1 { panic(32104); };
}
