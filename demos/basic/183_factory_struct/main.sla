@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 482_factory_arg：工厂返回结构体（42）。
// 函数返回结构体值语义正常（与 #17 的数组返回缺口对照：
// 结构体返回可用，数组返回不可用）；参数侧见 111。

struct Pint { x: i32 }

fn mk() -> Pint {
    return Pint { x: 41 };
}

fn use(p: Pint) -> i32 {
    return p.x + 1;
}

fn main() -> i32 {
    println("{}", use(mk()));
    return 0;
}

@test "basic 183 factory struct"() {
    if use(mk()) != 42 { panic(18301); };
    if mk().x != 41 { panic(18302); };
}
