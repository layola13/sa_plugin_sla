@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 8 行 1,28,196,490,490,196,28,1（行和 1430=Catalan(8)；循环求和）。
// 意对标 717_nar_row7（低位行互补；同式高位行复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", nar(8, 1), nar(8, 2), nsum(8));
    return 0;
}

@test "basic 724 nar row8"() {
    if nar(8, 1) != 28 { panic(72401); };
    if nar(8, 2) != 196 { panic(72402); };
    if nsum(8) != 1430 { panic(72403); };
    if nar(8, 0) != 1 { panic(72404); };
}
