@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 9 行右部 N(9,5)=1176，N(9,6)=336，N(9,7)=36（左部 846 互补，全行覆盖）。
// 意对标 846_nar9（左部版互补；855 做三向）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(9, 5), nar(9, 6), nar(9, 7));
    return 0;
}

@test "basic 854 nar9 right"() {
    if nar(9, 5) != 1176 { panic(85401); };
    if nar(9, 6) != 336 { panic(85402); };
    if nar(9, 7) != 36 { panic(85403); };
    if nar(8, 6) != 28 { panic(85404); };
}
