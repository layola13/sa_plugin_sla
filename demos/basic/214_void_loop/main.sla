@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 676_void_loop：循环内 void 调用（两次 7，主流程打印 1）。

fn f() {
    println("{}", 7);
}

fn main() -> i32 {
    for i in 0..2 {
        f();
    }
    println("{}", 1);
    return 0;
}

@test "basic 214 void loop"() {
    for i in 0..2 {
        f();
    }
}
