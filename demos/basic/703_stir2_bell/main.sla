@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类 Bell 桥 bell(n+1)=sum C(n,k)bell(k)（bell(6)=203，bell(7)=877，bell(8)=4140）。
// 意对标 697_stir2_row7 × Bell 族（两族桥接；705 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", bell(6), bell(7), bell(8));
    return 0;
}

@test "basic 703 stir2 bell"() {
    if bell(6) != 203 { panic(70301); };
    if bell(7) != 877 { panic(70302); };
    if bell(8) != 4140 { panic(70303); };
    if bell(5) != 52 { panic(70304); };
}
