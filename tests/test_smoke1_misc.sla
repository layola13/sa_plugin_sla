@test "smoke1 sa_io_read_exact"() {
    let rec = [0u64; 4];
    let a0: u64 = 0;
    PTR_ADDR(a0, STR_PTR("/bin/echo"));
    rec[0] = a0;
    rec[1] = STR_LEN("/bin/echo");
    let a1: u64 = 0;
    PTR_ADDR(a1, STR_PTR("hi"));
    rec[2] = a1;
    rec[3] = STR_LEN("hi");
    let proc = [0u64; 4];
    let sout = [0u64; 4];
    let serr = [0u64; 4];
    let s1bp10: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_spawn_stream(s1bp10, 2, &proc[0], &sout[0], &serr[0]);
    if rc != 0 { panic(56220); };
    let buf = [0u8; 64];
    let s1bp11: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc2 = sla_io_read_exact(sout[0], s1bp11, 3);
    if rc2 != 0 { panic(56221); };
    if buf[0] != 104 { panic(56222); };
    if buf[2] != 10 { panic(56223); };
    // A second exact read must fail: the stream is at EOF.
    let s1bp12: ptr = PTR_BYTE_ADD(&buf, 0);
    let rc3 = sla_io_read_exact(sout[0], s1bp12, 1);
    if rc3 == 0 { panic(56224); };
    let code = [0u64; 4];
    sla_std_process_wait(proc[0], &code[0]);
    sla_std_process_close(proc[0]);
}

@test "smoke1 sa_io_read_line"() {
    // PARTIAL (W1-DEF-IO-BUFFER-API): read_line itself works (rc 0,
    // nonzero handle), but the handle it returns is a registry id
    // while sa_io_buffer_len expects a raw SaIoBuffer struct pointer,
    // so the line's content/length cannot be verified through the
    // documented API. The full chain lives in the defect minim
    // (test_smoke1_defect_io_buffer.sla) and stays red; this entry
    // does NOT clear this wave.
    let rec = [0u64; 4];
    let a0: u64 = 0;
    PTR_ADDR(a0, STR_PTR("/bin/echo"));
    rec[0] = a0;
    rec[1] = STR_LEN("/bin/echo");
    let a1: u64 = 0;
    PTR_ADDR(a1, STR_PTR("line1"));
    rec[2] = a1;
    rec[3] = STR_LEN("line1");
    let proc = [0u64; 4];
    let sout = [0u64; 4];
    let serr = [0u64; 4];
    let rbp: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_spawn_stream(rbp, 2, &proc[0], &sout[0], &serr[0]);
    if rc != 0 { panic(56230); };
    let bufh = [0u64; 4];
    let rc2 = sla_io_read_line(sout[0], 1024, &bufh[0]);
    if rc2 != 0 { panic(56231); };
    if bufh[0] == 0 { panic(56232); };
    let code = [0u64; 4];
    sla_std_process_wait(proc[0], &code[0]);
    sla_std_process_close(proc[0]);
}



@test "smoke1 sa_io_flush"() {
    let h = sla_io_stderr();
    let rc = sla_io_flush(h);
    if rc != 0 { panic(56260); };
}

@test "smoke1 sa_io_close"() {
    let rec = [0u64; 2];
    let a0: u64 = 0;
    PTR_ADDR(a0, STR_PTR("/bin/cat"));
    rec[0] = a0;
    rec[1] = STR_LEN("/bin/cat");
    let proc = [0u64; 4];
    let sin = [0u64; 4];
    let sout = [0u64; 4];
    let serr = [0u64; 4];
    let s1bp16: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_spawn_bidi(s1bp16, 1, &proc[0], &sin[0], &sout[0], &serr[0]);
    if rc != 0 { panic(56270); };
    sla_io_write_all(sin[0], STR_PTR("q"), STR_LEN("q"));
    let rc2 = sla_io_close(sin[0]);
    if rc2 != 0 { panic(56271); };
    // After closing stdin, cat exits; stdout reaches EOF.
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc3 = sla_io_read(sout[0], &buf[0], 64, &rd[0]);
    if rc3 != 0 { panic(56272); };
    if rd[0] != 1 { panic(56273); };
    if buf[0] != 113 { panic(56274); };
    let code = [0u64; 4];
    sla_std_process_wait(proc[0], &code[0]);
    if code[0] != 0 { panic(56275); };
    sla_std_process_close(proc[0]);
}
