@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 尺子函数（v₂(n)：ruler(8)=3，ruler(12)=2）。
// 意对标 392 阶乘素指数的单值版（392 互补）。

fn ruler(n: int) -> int {
    if n <= 0 { return 0; };
    let c = 0;
    let m = n;
    while m % 2 == 0 {
        m = m / 2;
        c = c + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", ruler(8), ruler(12), ruler(7));
    return 0;
}

@test "basic 517 ruler"() {
    if ruler(8) != 3 { panic(51701); };
    if ruler(12) != 2 { panic(51702); };
    if ruler(7) != 0 { panic(51703); };
}
