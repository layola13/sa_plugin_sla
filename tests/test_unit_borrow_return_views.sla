@test "e_res regex split views"() {
    let pat = ",";
    let regex = sa_regex_compile(STR_PTR(pat), STR_LEN(pat), 0);
    if regex == 0 {
        panic(47201);
    };
    let text = "a,b,c";
    let list_raw = sa_regex_split(regex, STR_PTR(text), STR_LEN(text), 0);
    if list_raw == 0 {
        panic(47202);
    };
    let list = RegexSplitList { raw: list_raw };
    if sa_regex_split_count(list.raw) != 3 {
        panic(47203);
    };
    let first = sla_regex_split_ptr(&list, 0);
    let ea = "a";
    if !view_eq(&first, STR_PTR(ea), STR_LEN(ea)) {
        panic(47204);
    };
    let third = sla_regex_split_ptr(&list, 2);
    let ec = "c";
    if !view_eq(&third, STR_PTR(ec), STR_LEN(ec)) {
        panic(47205);
    };
    let fr = sla_regex_split_free(^list);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47206);
            };
        },
        Err(e) => {
            panic(47207);
        },
    };
    let rf = sa_regex_free(regex);
    match rf {
        Ok(p) => {
            if p != 0 {
                panic(47208);
            };
        },
        Err(e) => {
            panic(47209);
        },
    };
}

