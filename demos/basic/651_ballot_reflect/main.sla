@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Ballot 反射差式 B(n,k)=C(n+k,k)-C(n+k,k-1)（B(4,2)=9，B(5,3)=28，B(5,5)=42）。
// 意对标 646_ballot（建表版互补；655 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bref(n: int, k: int) -> int {
    if k == 0 { return 1; };
    return binom_mul(n + k, k) - binom_mul(n + k, k - 1);
}

fn main() -> i32 {
    println("{},{},{}", bref(4, 2), bref(5, 3), bref(5, 5));
    return 0;
}

@test "basic 651 ballot reflect"() {
    if bref(4, 2) != 9 { panic(65101); };
    if bref(5, 3) != 28 { panic(65102); };
    if bref(5, 5) != 42 { panic(65103); };
    if bref(3, 2) != 5 { panic(65104); };
}
