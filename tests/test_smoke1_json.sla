    let doc = s1_doc();
    let n = s1_get(doc, STR_PTR("n"), STR_LEN("n"), 52100);
    let v = [0u64; 4];
    let rc = sla_json_as_i64(n, &v[0]);
    if rc != 0 { panic(52101); };
    if v[0] != 42 { panic(52102); };
}

@test "smoke1 sa_json_as_bool"() {
    let t = sla_json_parse(STR_PTR("true"), STR_LEN("true"));
    let v = [0u64; 4];
    let rc = sla_json_as_bool(t, &v[0]);
    if rc != 0 { panic(52110); };
    if v[0] != 1 { panic(52111); };
    let f = sla_json_parse(STR_PTR("false"), STR_LEN("false"));
    let rc2 = sla_json_as_bool(f, &v[0]);
    if rc2 != 0 { panic(52112); };
    if v[0] != 0 { panic(52113); };
}

@test "smoke1 sa_json_object_set_string"() {
    let obj = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let rc = sla_json_object_set_string(obj, STR_PTR("k"), STR_LEN("k"), STR_PTR("v"), STR_LEN("v"));
    if rc != 0 { panic(52120); };
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc2 = sla_json_object_get_string(obj, STR_PTR("k"), STR_LEN("k"), &p[0], &l[0]);
    if rc2 != 0 { panic(52121); };
    let sp: ptr = (p[0] as ptr);
    if s1_streq(sp, l[0], STR_PTR("v"), STR_LEN("v")) == false { panic(52122); };
}

