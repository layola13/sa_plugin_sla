@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 九九乘法表求和（1..9 双重累计，和 2025=45*45）。
// 与 146（嵌套计数）互补，此处为嵌套算术；打印版（星号表）涉字符串，略去。

fn main() -> i32 {
    let tab = 0;
    let x = 1;
    while x <= 9 {
        let y = 1;
        while y <= 9 {
            tab = tab + x * y;
            y = y + 1;
        }
        x = x + 1;
    }
    println("{}", tab);
    return 0;
}

@test "basic 264 mult table"() {
    let tab = 0;
    let x = 1;
    while x <= 9 {
        let y = 1;
        while y <= 9 {
            tab = tab + x * y;
            y = y + 1;
        }
        x = x + 1;
    }
    if tab != 2025 { panic(26401); };
}
