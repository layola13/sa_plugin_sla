@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 数短递推 F(n)=[2(2n-1)(2F(n-1)+F(n-2))-F(n-1)(n+1)]/[2(n+1)]（精确整除）。
// F(3)=2，F(4)=6，F(5)=18（659 做短递推/桥序对峙）。
// 意对标 351_catalan（C(n)=2F(n)+F(n-1)；Catalan 姐妹序列）。

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", fsho(3), fsho(4), fsho(5));
    return 0;
}

@test "basic 656 fine"() {
    if fsho(3) != 2 { panic(65601); };
    if fsho(4) != 6 { panic(65602); };
    if fsho(5) != 18 { panic(65603); };
    if fsho(2) != 1 { panic(65604); };
}
