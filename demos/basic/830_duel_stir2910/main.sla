@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类续高位二对峙：建表 vs 递归（(10,4)：34105 对 34105；(9,4)：7770 对 7770）。
// 意对标 826_stir29 × 829_duel_stir29（内格源与对峙体例合流）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rss(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rss(n - 1, k - 1) + k * rss(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", sst(10, 4), rss(10, 4), sst(9, 4), rss(9, 4));
    return 0;
}

@test "basic 830 duel stir2910"() {
    if sst(10, 4) != 34105 { panic(83001); };
    if rss(10, 4) != 34105 { panic(83002); };
    if sst(9, 4) != 7770 { panic(83003); };
    if rss(9, 4) != 7770 { panic(83004); };
}
