@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类列纵深 S(7,2)=63，S(8,2)=127，S(9,2)=255（2^(n-1)-1 上行链）。
// 意对标 826_stir29（单格版互补；833 做列对峙）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", sst(7, 2), sst(8, 2), sst(9, 2));
    return 0;
}

@test "basic 832 stir2 col210"() {
    if sst(7, 2) != 63 { panic(83201); };
    if sst(8, 2) != 127 { panic(83202); };
    if sst(9, 2) != 255 { panic(83203); };
    if sst(10, 2) != 511 { panic(83204); };
}
