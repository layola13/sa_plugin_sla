    let uid = [0u64; 4];
    let gid = [0u64; 4];
    let rc = sla_std_net_unix_stream_peer_cred(r[0], &pid[0], &uid[0], &gid[0]);
    if rc != 0 { panic(61110); };
    if pid[0] != sla_std_process_id() { panic(61111); };
    if uid[0] != sla_std_process_user_id() { panic(61112); };
