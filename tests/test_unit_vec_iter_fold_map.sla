@import "sa_std/vec.sa"

// Regression: text backend had no Vec-source lowering for
// iter().fold(init, closure) (only arrays) and no materializing
// iter().map(closure) -> Vec lowering (only the fused map+sum form).
// Both threw error.CodegenError on the text backend while the SAB
// backend compiled them. Fixed by genVecIterFold /
// genVecIterMapCollect in codegen.zig (audit probes vec_fold /
// vec_map shapes).

@test "vec iter fold i32"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    if v.iter().fold(0, |acc, x| acc + x) != 6 { panic(9301); };
}

@test "vec iter fold i64 let bound"() {
    let v: Vec<i64> = Vec::new();
    v.push(10);
    v.push(20);
    let s = v.iter().fold(0, |acc, x| acc + x);
    if s != 30 { panic(9302); };
}

@test "vec iter fold product"() {
    let v: Vec<i32> = Vec::new();
    v.push(2);
    v.push(3);
    v.push(4);
    if v.iter().fold(1, |acc, x| acc * x) != 24 { panic(9303); };
}

@test "vec iter map materialize"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    let mapped = v.iter().map(|x| x + 1);
    if mapped.len() != 3 { panic(9311); };
    if mapped[0] != 2 { panic(9312); };
    if mapped[2] != 4 { panic(9313); };
}

@test "vec iter map empty"() {
    let v: Vec<i32> = Vec::new();
    let mapped = v.iter().map(|x| x + 1);
    if mapped.len() != 0 { panic(9314); };
}
