@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// L(5,3)=120 三向收束：商式A C(n-1,k-1)·n!/k! == 商式B C(n,k)·(n-1)!/(k-1)! == 递推
//（120 对 120 对 120；三算法互锁，316 系三向体例）。
// 意对标 586 lah × 589 lah_rec（两源见各源；商式B为第三源）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn lah_a(n: int, k: int) -> int {
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn lah_b(n: int, k: int) -> int {
    return binom_mul(n, k) * fact(n - 1) / fact(k - 1);
}

fn lah_rec(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn + kk - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", lah_a(5, 3), lah_b(5, 3), lah_rec(5, 3));
    return 0;
}

@test "basic 595 tri lah"() {
    if lah_a(5, 3) != 120 { panic(59501); };
    if lah_b(5, 3) != 120 { panic(59502); };
    if lah_rec(5, 3) != 120 { panic(59503); };
    if lah_a(4, 2) != 36 { panic(59504); };
    if lah_b(4, 2) != 36 { panic(59505); };
}
