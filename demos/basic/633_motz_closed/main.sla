@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 二项直和 M(n)=sum C(n,2k)Catalan(k)（M(5)=21，M(6)=51，M(7)=127）。
// 意对标 626_motzkin（递推版互补；635 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cmot(n: int) -> int {
    let s = 0;
    let k = 0;
    while 2 * k <= n {
        s = s + binom_mul(n, 2 * k) * binom_mul(2 * k, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", cmot(5), cmot(6), cmot(7));
    return 0;
}

@test "basic 633 motz closed"() {
    if cmot(5) != 21 { panic(63301); };
    if cmot(6) != 51 { panic(63302); };
    if cmot(7) != 127 { panic(63303); };
    if cmot(4) != 9 { panic(63304); };
}
