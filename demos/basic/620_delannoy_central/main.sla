@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 中央列 1,3,13,63,321,1683（D(3,3)=63，D(4,4)=321，D(5,5)=1683）。
// 意对标 617_delannoy_high（高位版互补；中央序列复算）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{},{}", delan(3, 3), delan(4, 4), delan(5, 5));
    return 0;
}

@test "basic 620 delannoy central"() {
    if delan(3, 3) != 63 { panic(62001); };
    if delan(4, 4) != 321 { panic(62002); };
    if delan(5, 5) != 1683 { panic(62003); };
    if delan(1, 1) != 3 { panic(62004); };
}
