@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 续高位四 B(12)=4213597（二项递推，同式再上一位）。
// 意对标 906_bell11（n=11 版互补；910 做高位对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", bell(12), bell(11));
    return 0;
}

@test "basic 909 bell12"() {
    if bell(12) != 4213597 { panic(90901); };
    if bell(11) != 678570 { panic(90902); };
    if bell(10) != 115975 { panic(90903); };
    if bell(12) - bell(11) != 3535027 { panic(90904); };
}
