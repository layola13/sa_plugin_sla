@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 试乘 vs 牛顿开方对峙（117×257：15→3=3，另断言 16/100）。
// 双实现一致性锁定（单实现见 117/257）。

fn isqrt_try(n: int) -> int {
    let r = 0;
    while (r + 1) * (r + 1) <= n {
        r = r + 1;
    }
    return r;
}

fn isqrt_newton(n: int) -> int {
    if n <= 1 { return n; };
    let x = n;
    let y = (x + n / x) / 2;
    while y < x {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}

fn main() -> i32 {
    println("{},{}", isqrt_try(15), isqrt_newton(15));
    return 0;
}

@test "basic 287 duel isqrt"() {
    if isqrt_try(15) != isqrt_newton(15) { panic(28701); };
    if isqrt_newton(15) != 3 { panic(28702); };
    if isqrt_try(16) != isqrt_newton(16) { panic(28703); };
    if isqrt_try(100) != isqrt_newton(100) { panic(28704); };
}
