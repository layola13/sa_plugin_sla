@test "fallible direct json frees ok and err"() {
    let doc = "{\"a\":1}";
    let root = sa_json_parse(STR_PTR(doc), STR_LEN(doc));
    if root == 0 {
        panic(45140);
    };
    let f1 = sa_json_free(root);
    match f1 {
        Ok(p) => {
            if p != 0 {
                panic(45141);
            };
        },
        Err(e) => {
            panic(45142);
        },
    };
    let f2 = sa_json_free(0);
    match f2 {
        Ok(p) => {
            panic(45143);
        },
        Err(e) => {
            if e == 0 {
                panic(45144);
            };
        },
    };
    let root2 = sa_json_parse(STR_PTR(doc), STR_LEN(doc));
    if root2 == 0 {
        panic(45145);
    };
    let buf: u64 = 0;
    if sa_json_stringify(root2, &buf) != 0 {
        panic(45146);
    };
    if buf == 0 {
        panic(45147);
    };
    let f3 = sa_json_buffer_free(buf);
    match f3 {
        Ok(p) => {
            if p != 0 {
                panic(45148);
            };
        },
        Err(e) => {
            panic(45149);
        },
    };
    let f4 = sa_json_free(root2);
    match f4 {
        Ok(p) => {
            if p != 0 {
                panic(45150);
            };
        },
        Err(e) => {
            panic(45151);
        },
    };
    let f5 = sa_json_buffer_free(0);
    match f5 {
        Ok(p) => {
            panic(45152);
        },
        Err(e) => {
            if e == 0 {
                panic(45153);
            };
        },
    };
    let stream = sa_json_stream_new(STR_PTR(doc), STR_LEN(doc));
    if stream == 0 {
        panic(45154);
    };
    let f6 = sa_json_stream_free(stream);
    match f6 {
        Ok(p) => {
            if p != 0 {
                panic(45155);
            };
        },
        Err(e) => {
            panic(45156);
        },
    };
    let f7 = sa_json_stream_free(0);
    match f7 {
        Ok(p) => {
            panic(45157);
        },
        Err(e) => {
            if e == 0 {
                panic(45158);
            };
        },
    };
}

@test "fallible direct regex frees ok and err"() {
    let re = sa_regex_compile(STR_PTR("1"), STR_LEN("1"), 0);
    if re == 0 {
        panic(45160);
    };
    let m = sa_regex_match(re, STR_PTR("123abc"), STR_LEN("123abc"));
    if m == 0 {
        panic(45161);
    };
    let f1 = sa_regex_match_free(m);
    match f1 {
        Ok(p) => {
            if p != 0 {
                panic(45162);
            };
        },
        Err(e) => {
            panic(45163);
        },
    };
    let list = sa_regex_match_all(re, STR_PTR("a1b22"), STR_LEN("a1b22"));
    if list == 0 {
        panic(45164);
    };
    let f2 = sa_regex_match_list_free(list);
    match f2 {
        Ok(p) => {
            if p != 0 {
                panic(45165);
            };
        },
        Err(e) => {
            panic(45166);
        },
    };
    let buf = sa_regex_replace(re, STR_PTR("a1"), 2, STR_PTR("X"), 1);
    if buf == 0 {
        panic(45167);
    };
    let f3 = sa_regex_buffer_free(buf);
    match f3 {
        Ok(p) => {
            if p != 0 {
                panic(45168);
            };
        },
        Err(e) => {
            panic(45169);
        },
    };
    let parts = sa_regex_split(re, STR_PTR("a1b2"), 4, 0);
    if parts == 0 {
        panic(45170);
    };
    let f4 = sa_regex_split_free(parts);
    match f4 {
        Ok(p) => {
            if p != 0 {
                panic(45171);
            };
        },
        Err(e) => {
            panic(45172);
        },
    };
    let f5 = sa_regex_free(re);
    match f5 {
        Ok(p) => {
            if p != 0 {
                panic(45173);
            };
        },
        Err(e) => {
            panic(45174);
        },
    };
    let f6 = sa_regex_free(0);
    match f6 {
        Ok(p) => {
            panic(45175);
        },
        Err(e) => {
            if e == 0 {
                panic(45176);
            };
        },
    };
}

@test "fallible direct tcp ok path"() {
    let listener: u64 = 0;
    let b1 = sa_net_tcp_listener_bind(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0);
    match b1 {
        Ok(l) => {
            listener = l;
        },
        Err(e) => {
            panic(45180);
        },
    };
    if listener == 0 {
        panic(45181);
    };
    let addr: u64 = 0;
    let a1 = sa_net_tcp_listener_local_addr(listener);
    match a1 {
        Ok(a) => {
            addr = a;
        },
        Err(e) => {
            panic(45184);
        },
    };
    let port = sa_net_addr_port(addr) as u16;
    let f1 = sa_net_addr_free(addr);
    match f1 {
        Ok(p) => {
            if p != 0 {
                panic(45182);
            };
        },
        Err(e) => {
            panic(45183);
        },
    };
    if port == 0 {
        panic(45185);
    };
    let stream: u64 = 0;
    let c1 = sa_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), port);
    match c1 {
        Ok(s) => {
            stream = s;
        },
        Err(e) => {
            panic(45186);
        },
    };
    if stream == 0 {
        panic(45187);
    };
    let w1 = sa_net_tcp_stream_write_all(stream, STR_PTR("hi"), 2);
    match w1 {
        Ok(p) => {
            if p != 0 {
                panic(45188);
            };
        },
        Err(e) => {
            panic(45189);
        },
    };
    let z1 = sa_net_tcp_stream_close(stream);
    match z1 {
        Ok(p) => {
            if p != 0 {
                panic(45198);
            };
        },
        Err(e) => {
            panic(45199);
        },
    };
    let z3 = sa_net_tcp_listener_close(listener);
    match z3 {
        Ok(p) => {
            if p != 0 {
                panic(45202);
            };
        },
        Err(e) => {
            panic(45203);
        },
    };
}

@test "fallible direct tcp err constructions"() {
    let scratch = "........";
    let x1 = sa_net_tcp_stream_read(0, STR_PTR(scratch), 8);
    match x1 {
        Ok(n) => {
            panic(45190);
        },
        Err(e) => {
            if e == 0 {
                panic(45191);
            };
        },
    };
    let x2 = sa_net_tcp_stream_read_exact(0, STR_PTR(scratch), 8);
    match x2 {
        Ok(p) => {
            panic(45192);
        },
        Err(e) => {
            if e == 0 {
                panic(45193);
            };
        },
    };
    let x3 = sa_net_tcp_stream_write_all(0, STR_PTR("hi"), 2);
    match x3 {
        Ok(p) => {
            panic(45194);
        },
        Err(e) => {
            if e == 0 {
                panic(45195);
            };
        },
    };
    let c2 = sa_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 1);
    match c2 {
        Ok(s) => {
            panic(45196);
        },
        Err(e) => {
            if e == 0 {
                panic(45197);
            };
        },
    };
    let z2 = sa_net_tcp_stream_close(0);
    match z2 {
        Ok(p) => {
            panic(45200);
        },
        Err(e) => {
            if e == 0 {
                panic(45201);
            };
        },
    };
    let listener: u64 = 0;
    let b1 = sa_net_tcp_listener_bind(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0);
    match b1 {
        Ok(l) => {
            listener = l;
        },
        Err(e) => {
            panic(45208);
        },
    };
    let z3 = sa_net_tcp_listener_close(listener);
    match z3 {
        Ok(p) => {},
        Err(e) => {
            panic(45209);
        },
    };
    let z4 = sa_net_tcp_listener_accept(0);
    match z4 {
        Ok(s) => {
            panic(45204);
        },
        Err(e) => {
            if e == 0 {
                panic(45205);
            };
        },
    };
    let z5 = sa_net_addr_free(0);
    match z5 {
        Ok(p) => {
            panic(45206);
        },
        Err(e) => {
            if e == 0 {
                panic(45207);
            };
        },
    };
}

@test "fallible direct unix addr free ok and err"() {
    let uaddr: u64 = 0;
    if sa_std_net_unix_addr_from_pathname(STR_PTR("/tmp/x.sock"), STR_LEN("/tmp/x.sock"), &uaddr) != 0 {
        panic(45210);
    };
    if uaddr == 0 {
        panic(45211);
    };
    let f1 = sa_net_unix_addr_free(uaddr);
    match f1 {
        Ok(p) => {
            if p != 0 {
                panic(45212);
            };
        },
        Err(e) => {
            panic(45213);
        },
    };
    let f2 = sa_net_unix_addr_free(0);
    match f2 {
        Ok(p) => {
            panic(45214);
        },
        Err(e) => {
            if e == 0 {
                panic(45215);
            };
        },
    };
}
