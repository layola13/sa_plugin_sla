@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1237_mul_overflow：64 位不回绕（2147483648,2147483648,
// 1073741824,2147483649）。
// SLA 整数 64 位：`INT_MAX + 1` 与 `(1 << 31) + 1` 均不回绕为负
//（TS 32 位得 2147483648,2147483648,1073741824,-2147483647；
// 末项分歧，此处按 SLA 实际语义断言，见 128/168 同主题）。

fn main() -> i32 {
    println("{},{},{},{}", 2 * 1073741824, 2147483647 + 1, 1 << 30, (1 << 31) + 1);
    return 0;
}

@test "basic 171 overflow 64"() {
    if 2 * 1073741824 != 2147483648 { panic(17101); };
    if 2147483647 + 1 != 2147483648 { panic(17102); };
    if 1 << 30 != 1073741824 { panic(17103); };
    if (1 << 31) + 1 != 2147483649 { panic(17104); };
}
