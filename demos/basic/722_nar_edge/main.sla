@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 边恒等 N(n,1)=C(n,2)：N(7,1)=21，N(8,1)=28（边值恒等单锁）。
// 意对标 716_nar7（内格版互补；725 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(7, 1), nar(8, 1), binom_mul(8, 2));
    return 0;
}

@test "basic 722 nar edge"() {
    if nar(7, 1) != 21 { panic(72201); };
    if nar(8, 1) != 28 { panic(72202); };
    if binom_mul(8, 2) != 28 { panic(72203); };
    if binom_mul(7, 2) != 21 { panic(72204); };
}
