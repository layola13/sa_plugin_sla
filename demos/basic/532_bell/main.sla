@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 数 B(n) = Σ_k S(n,k)（B(4)=15，B(5)=52；Stirling 行求和）。
// 意对标 531 stirling2（行版互补）与 453 bell（集合版互补，此处走行和式）。

fn bell(n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = kk * t[(nn - 1) * w + kk] + t[(nn - 1) * w + kk - 1];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    let s = 0;
    let kk = 0;
    while kk <= n {
        s = s + t[n * w + kk];
        kk = kk + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", bell(4), bell(5));
    return 0;
}

@test "basic 532 bell"() {
    if bell(3) != 5 { panic(53201); };
    if bell(4) != 15 { panic(53202); };
    if bell(5) != 52 { panic(53203); };
}
