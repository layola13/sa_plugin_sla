@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类高位对峙：建表 vs 递归（(8,2)：13068 对 13068；(8,3)：13132 对 13132）。
// 意对标 688_stir18 × 689_duel_stir17（高位源与对峙体例合流）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rcs(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rcs(n - 1, k - 1) + (n - 1) * rcs(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", cst(8, 2), rcs(8, 2), cst(8, 3), rcs(8, 3));
    return 0;
}

@test "basic 690 duel stir18"() {
    if cst(8, 2) != 13068 { panic(69001); };
    if rcs(8, 2) != 13068 { panic(69002); };
    if cst(8, 3) != 13132 { panic(69003); };
    if rcs(8, 3) != 13132 { panic(69004); };
}
