@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 高位二对峙：短递推 vs 卷积（n=6：57 对 57；n=7：186 对 186）。
// 卷积 F(n)=sum C(k-1)F(n-k)（n=7：18+12+10+14+0+132=186）。
// 意对标 661_fine7 × 卷积版（高位源与卷积体例合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cat(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn fconv(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let s = 0;
    let k = 2;
    while k <= n {
        s = s + cat(k - 1) * fconv(n - k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", fsho(6), fconv(6), fsho(7), fconv(7));
    return 0;
}

@test "basic 662 duel fine7"() {
    if fsho(6) != 57 { panic(66201); };
    if fconv(6) != 57 { panic(66202); };
    if fsho(7) != 186 { panic(66203); };
    if fconv(7) != 186 { panic(66204); };
}
