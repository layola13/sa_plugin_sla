// smoke-wave2: http_client websocket chains (v1 + v2 + unix is in probe F
// disposition) and the SSE family. Peers are SLA websocket echo servers
// (goroutines, unique ports); the SSE peer is a v2 streaming response.
@import "sla_std/wrap/http_server.sla"
@import "sla_std/wrap/http_client.sla"
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/time.sla"
@import "sa_std/task.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s2_mem_eq(p: ptr, n: u64, q: ptr, m: u64) -> bool {
    if n != m { return false; };
    let i: u64 = 0;
    while i < n {
        let a: ptr = PTR_BYTE_ADD(p, i);
        let b: ptr = PTR_BYTE_ADD(q, i);
        if PTR_READ_U8(a) != PTR_READ_U8(b) { return false; };
        i = i + 1;
    }
    return true;
}

fn s2_contains(p: ptr, n: u64, q: ptr, m: u64) -> bool {
    if m == 0 { return true; };
    if n < m { return false; };
    let i: u64 = 0;
    while i + m <= n {
        let base: ptr = PTR_BYTE_ADD(p, i);
        if s2_mem_eq(base, m, q, m) { return true; };
        i = i + 1;
    }
    return false;
}

// v1 ws echo peer (single packed arg: port | code<<24).
fn s2_ws_echo1(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_server_websocket_upgrade(req, &wc[0]) != 0 { panic(code + 3); };
    let ws = (wc[0] as ptr);
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_websocket_read(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(code + 4); };
    if sla_http_server_websocket_write(ws, (op[0] as u8), (dp[0] as ptr), dl[0]) != 0 { panic(code + 5); };
    sla_http_server_websocket_free(ws);
    sla_http_server_free(srv);
}

// v2 ws echo peer (single packed arg: port | code<<24).
fn s2_ws_echo2(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new_v2(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_server_websocket_upgrade_v2(req, &wc[0]) != 0 { panic(code + 3); };
    let ws = (wc[0] as ptr);
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_websocket_read_v2(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(code + 4); };
    let wr = [0u64; 4];
    if sla_http_server_websocket_write_v2(ws, (op[0] as u8), (dp[0] as ptr), dl[0], &wr[0]) != 0 { panic(code + 5); };
    let rc2 = sla_http_server_websocket_read_v2(ws, 4096, &op[0], &dp[0], &dl[0]);
    sla_http_server_websocket_free_v2(ws);
    sla_http_server_free_v2(srv);
}

// v1 ws echo peer that stays for the client's close frame.
fn s2_ws_echo1_stay(arg: u64) -> void {
    let port: u64 = arg & 65535;
    let code: i32 = (arg >> 24) as i32;
    let sc = [0u64; 4];
    if sla_http_server_new(&sc[0]) != 0 { panic(code); };
    let srv = (sc[0] as ptr);
    if sla_http_server_start(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u16)) != 0 { panic(code + 1); };
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 2); };
    let req = (aq[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_server_websocket_upgrade(req, &wc[0]) != 0 { panic(code + 3); };
    let ws = (wc[0] as ptr);
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_server_websocket_read(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(code + 4); };
    if sla_http_server_websocket_write(ws, (op[0] as u8), (dp[0] as ptr), dl[0]) != 0 { panic(code + 5); };
    let rc2 = sla_http_server_websocket_read(ws, 4096, &op[0], &dp[0], &dl[0]);
    sla_http_server_websocket_free(ws);
    sla_http_server_free(srv);
}

fn s2_ws_url(port: u64, ob: ptr) -> u64 {
    let pre = "ws://127.0.0.1:";
    let pp: ptr = STR_PTR(pre);
    let pl: u64 = STR_LEN(pre);
    let n: u64 = 0;
    let i: u64 = 0;
    while i < pl {
        let s: ptr = PTR_BYTE_ADD(pp, i);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
        i = i + 1;
    }
    let digits = [0u8; 8];
    let dp0: ptr = PTR_BYTE_ADD(&digits, 0);
    let v: u64 = port;
    let nd: u64 = 0;
    while v > 0 {
        let d: ptr = PTR_BYTE_ADD(dp0, nd);
        PTR_WRITE_U8(d, (48 + ((v % 10) as u8)));
        nd = nd + 1;
        v = v / 10;
    }
    let k: u64 = nd;
    while k > 0 {
        k = k - 1;
        let s: ptr = PTR_BYTE_ADD(dp0, k);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
    }
    let suf = "/ws";
    let sp: ptr = STR_PTR(suf);
    let sl: u64 = STR_LEN(suf);
    let j: u64 = 0;
    while j < sl {
        let s: ptr = PTR_BYTE_ADD(sp, j);
        let d: ptr = PTR_BYTE_ADD(ob, n);
        PTR_WRITE_U8(d, PTR_READ_U8(s));
        n = n + 1;
        j = j + 1;
    }
    return n;
}

// ---------------- v1 client websocket ----------------
// REMOVED from this green file: sa_http_client_websocket_connect,
// sa_http_websocket_read, sa_http_websocket_write and
// sa_http_websocket_free are blocked by W2-DEF-WS-V1-CLIENT-DEAD
// (connect succeeds but the v1 handle transmits nothing and reads
// error out; wire-level evidence in probes I/I2, see WAVE2_REPORT).

// ---------------- v2 client websocket ----------------

@test "smoke2 sa_http_client_websocket_connect_v2"() {
    let h = go s2_ws_echo1(24803 + 65860 * 16777216);
    let ub = [0u8; 64];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_ws_url(24803, ubp);
    sla_time_sleep_ms(100);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65870); };
    let client = (cl[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_client_websocket_connect_v2(client, ubp, ulen, 10000, &wc[0]) != 0 { panic(65871); };
    if wc[0] == 0 { panic(65872); };
    let ws = (wc[0] as ptr);
    let wr = [0u64; 4];
    if sla_http_websocket_write_v2(ws, 1, STR_PTR("v2-ws"), STR_LEN("v2-ws"), &wr[0]) != 0 { panic(65873); };
    let ev = [0u64; 4];
    if sla_http_websocket_poll_v2(ws, 1, 5000, &ev[0]) != 0 { panic(65874); };
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_websocket_read_v2(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(65875); };
    if !s2_mem_eq((dp[0] as ptr), dl[0], STR_PTR("v2-ws"), STR_LEN("v2-ws")) { panic(65876); };
    sla_http_websocket_close_v2(ws, 1000, STR_PTR(""), 0);
    sla_http_websocket_free_v2(ws);
    sla_http_client_free(client);
    sa_task_join(h);
}

