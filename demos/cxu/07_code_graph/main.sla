// D7: code graph kernel — the CXU saVmTreeSitter usage distilled.
// sa_ts_* (sa_std, tree_sitter.sai): parse TypeScript, walk the root's
// named children, and collect top-level function declarations with
// their names (the seed of a code graph).
@import "sa_std/tree_sitter.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/io/print.sai"
@import "byteseq.sa"
@import "append.sa"

struct NameAcc {
    bytes: [u8; 512],
    len: u64,
}

fn type_is(node: u64, lit: ptr, lit_len: u64) -> bool {
    let buf = [0u8; 64];
    let len: u64 = 0;
    if sa_ts_node_type(node, &buf, 64, &len) != 0 {
        return false;
    };
    let slot = [0u64; 1];
    BYTES_EQ(&slot, &buf, len, lit, lit_len);
    return slot[0] == 1;
}

fn acc_is(acc: &NameAcc, lit: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, &acc.bytes, acc.len, lit, lit_len);
    return slot[0] == 1;
}

fn harvest_decl(decl: u64, acc: &NameAcc) -> u64 {
    let name_node: u64 = 0;
    if sa_ts_node_child_by_field(decl, STR_PTR("name"), STR_LEN("name"), &name_node) == 0 && name_node != 0 {
        let tbuf = [0u8; 128];
        let tlen: u64 = 0;
        let ok: u64 = 0;
        if sa_ts_node_text(name_node, &tbuf, 128, &tlen) == 0 {
            APPEND_BYTES(&acc.bytes, acc.len, &tbuf, tlen);
            acc.len = acc.len + tlen;
            acc.bytes[acc.len] = 10;
            acc.len = acc.len + 1;
            ok = 1;
        };
        sa_ts_node_free(name_node);
        return ok;
    };
    return 0;
}

// Returns 1 when the child (or its export_statement unwrap) is a
// function_declaration whose name was appended to acc.
fn harvest(child: u64, acc: &NameAcc) -> u64 {
    if type_is(child, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
        return harvest_decl(child, acc);
    };
    if type_is(child, STR_PTR("export_statement"), STR_LEN("export_statement")) {
        let inner: u64 = 0;
        if sa_ts_node_child(child, 0, 1, &inner) == 0 && inner != 0 {
            let r: u64 = 0;
            if type_is(inner, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
                r = harvest_decl(inner, acc);
            };
            sa_ts_node_free(inner);
            return r;
        };
    };
    return 0;
}

fn collect_functions(root: u64, acc: &NameAcc) -> u64 {
    let found: u64 = 0;
    let total: u32 = 0;
    if sa_ts_node_named_child_count(root, &total) != 0 {
        return 0;
    };
    let i: u32 = 0;
    while i < total {
        i = i + 1;
        let child: u64 = 0;
        if sa_ts_node_child(root, i - 1, 1, &child) == 0 && child != 0 {
            found = found + harvest(child, acc);
            sa_ts_node_free(child);
        };
    }
    return found;
}

fn main() -> i32 {
    if sa_ts_available() != 1 {
        return 2;
    };
    // Read sample.ts through the std fs surface.
    let total: u64 = 0;
    if sa_std_fs_len(STR_PTR("sample.ts"), STR_LEN("sample.ts"), &total) != 0 {
        return 3;
    };
    let fh: u64 = 0;
    if sa_std_fs_open_read(STR_PTR("sample.ts"), STR_LEN("sample.ts"), &fh) != 0 {
        return 4;
    };
    let src = [0u8; 8192];
    let read_n: u64 = 0;
    if sa_std_fs_file_read(fh, &src, 8192, &read_n) != 0 {
        return 5;
    };
    sa_fs_file_close(fh);
    if read_n != total {
        return 6;
    };

    let parser: u64 = 0;
    if sa_ts_parser_new(&parser) != 0 {
        return 7;
    };
    if sa_ts_parser_set_language(parser, STR_PTR("typescript"), STR_LEN("typescript")) != 0 {
        return 8;
    };
    let tree: u64 = 0;
    if sa_ts_parse(parser, &src, read_n, &tree) != 0 {
        return 9;
    };
    let sbuf = [0u8; 8192];
    let slen: u64 = 0;
    if sa_ts_tree_sexp(tree, &sbuf, 8192, &slen) != 0 {
        return 10;
    };
    let root: u64 = 0;
    if sa_ts_tree_root(tree, &root) != 0 {
        return 11;
    };
    if type_is(root, STR_PTR("program"), STR_LEN("program")) == false {
        return 12;
    };
    let acc = NameAcc { bytes: [0u8; 512], len: 0 };
    let found = collect_functions(root, &acc);
    if found != 2 {
        return 13;
    };
    if acc_is(&acc, STR_PTR("add\ngreet\n"), STR_LEN("add\ngreet\n")) == false {
        return 14;
    };
    sa_ts_node_free(root);
    sa_ts_tree_free(tree);
    sa_ts_parser_free(parser);
    println("d7 code graph ok");
    return 0;
}
