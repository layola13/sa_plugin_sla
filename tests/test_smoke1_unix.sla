    let rc = sla_std_net_unix_datagram_shutdown(a[0], 1);
    if rc != 0 { panic(61260); };
    let wr = [0u64; 4];
    let rc2 = sla_std_net_unix_datagram_send_to(a[0], STR_PTR("no"), STR_LEN("no"), STR_PTR("smoke1_unix/dz.sock"), STR_LEN("smoke1_unix/dz.sock"), &wr[0]);
    if rc2 == 0 { panic(61261); };
