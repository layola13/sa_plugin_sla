@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大小 Schröder 对峙：短递推 vs 半大数（n=4：45 对 45；n=5：197 对 197）。
// 半大数 shalf(n)=S(n)/2（S(5)/2=394/2=197 精确整除）。
// 意对标 766_sschro × 606_schroder（两源单实现见各源；286 系对峙体例）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn shalf(n: int) -> int {
    return sch(n) / 2;
}

fn main() -> i32 {
    println("{},{},{},{}", ssho(4), shalf(4), ssho(5), shalf(5));
    return 0;
}

@test "basic 769 duel sschro"() {
    if ssho(4) != 45 { panic(76901); };
    if shalf(4) != 45 { panic(76902); };
    if ssho(5) != 197 { panic(76903); };
    if shalf(5) != 197 { panic(76904); };
}
