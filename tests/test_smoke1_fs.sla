@test "smoke1 sa_fs_metadata_ino"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/ino_a.txt"), STR_LEN("smoke1_fs/ino_a.txt"), STR_PTR("i"), STR_LEN("i"));
    sla_fs_remove_file(STR_PTR("smoke1_fs/ino_b.txt"), STR_LEN("smoke1_fs/ino_b.txt"));
    let rc = sla_fs_hard_link(STR_PTR("smoke1_fs/ino_a.txt"), STR_LEN("smoke1_fs/ino_a.txt"), STR_PTR("smoke1_fs/ino_b.txt"), STR_LEN("smoke1_fs/ino_b.txt"));
    if rc != 0 { panic(51400); };
    let ma = s1_meta(STR_PTR("smoke1_fs/ino_a.txt"), STR_LEN("smoke1_fs/ino_a.txt"), 51401);
    let mb = s1_meta(STR_PTR("smoke1_fs/ino_b.txt"), STR_LEN("smoke1_fs/ino_b.txt"), 51402);
    if sla_fs_metadata_ino(ma) == 0 { panic(51403); };
    if sla_fs_metadata_ino(ma) != sla_fs_metadata_ino(mb) { panic(51404); };
    sla_std_fs_metadata_free(ma);
    sla_std_fs_metadata_free(mb);
}

