@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schroder 数递推 S(n)=S(n-1)+sum S(k)S(n-1-k)（迭代建表，546 范式）。
// S(2)=6，S(3)=22，S(4)=90（609 做迭代/递归对峙）。
// 意对标 351_catalan（同为格路计数族；此处为含对角步格路）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", sch(2), sch(3), sch(4));
    return 0;
}

@test "basic 606 schroder"() {
    if sch(2) != 6 { panic(60601); };
    if sch(3) != 22 { panic(60602); };
    if sch(4) != 90 { panic(60603); };
    if sch(1) != 2 { panic(60604); };
}
