@test "smoke1 sa_json_array_push_node"() {
    let arr = sla_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let child = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let rc = sla_json_array_push_node(arr, child);
    if rc != 0 { panic(52240); };
    let cell = [0u64; 4];
    sla_json_array_get(arr, 0, &cell[0]);
    if sla_json_kind(cell[0]) != 7 { panic(52241); };
