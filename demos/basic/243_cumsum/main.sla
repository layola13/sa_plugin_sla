@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 141_sum_sq 的累计版（27 为总额版：运行平方和表尾 52，次项 10）。
// 运行累加（232 的计数累加口径）+ 入表组合。

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(3);
    a.push(1);
    a.push(4);
    a.push(1);
    a.push(5);
    let cum: Vec<i32> = Vec::new();
    let run = 0;
    for i in 0..len(a) {
        run = run + a[i] * a[i];
        cum.push(run);
    }
    println("{},{}", cum[4], cum[1]);
    return 0;
}

@test "basic 243 cumsum"() {
    let a: Vec<i32> = Vec::new();
    a.push(3);
    a.push(1);
    a.push(4);
    a.push(1);
    a.push(5);
    let cum: Vec<i32> = Vec::new();
    let run = 0;
    for i in 0..len(a) {
        run = run + a[i] * a[i];
        cum.push(run);
    }
    if len(cum) != 5 { panic(24301); };
    if cum[4] != 52 { panic(24302); };
    if cum[1] != 10 { panic(24303); };
}
