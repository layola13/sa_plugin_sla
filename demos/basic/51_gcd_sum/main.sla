@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 159_gcd_sum：while 版辗转相除 + gcd(i, 12)（i=1..10）累加得 27。
// 与 17/21 的递归/三值 gcd 互补，此处用循环版（SLA 风格见 04_while_sum）。

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn main() -> i32 {
    let t = 0;
    for i in 1..11 {
        t = t + gcd(i, 12);
    }
    println("{}", t);
    return 0;
}

@test "basic 51 gcd sum"() {
    if gcd(48, 18) != 6 { panic(5101); };
    if gcd(12, 8) != 4 { panic(5102); };
    let t = 0;
    for i in 1..11 {
        t = t + gcd(i, 12);
    }
    if t != 27 { panic(5103); };
}
