@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 表版高位 F(9)=7087261（742 体例续高位，同式再上一位）。
// 意对标 744_fubp8（n=8 版互补；875 做三向收束）。

fn pbin(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fubp(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + pbin(n, k) * fubp(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", fubp(9), fubp(8));
    return 0;
}

@test "basic 872 fubp9"() {
    if fubp(9) != 7087261 { panic(87201); };
    if fubp(8) != 545835 { panic(87202); };
    if fubp(7) != 47293 { panic(87203); };
    if pbin(9, 4) != 126 { panic(87204); };
}
