@import "sa_std/vec.sa"

// By-value Vec params must remain usable across a loop that repeatedly passes
// them to another by-value Vec callee. SA/SAB ABI still uses ^ ownership at the
// call site, so the compiler clones when the source must stay live.

fn signature_equals(left: Vec<i32>, right: Vec<i32>) -> bool {
    if len(left) != len(right) {
        return false;
    };
    let i: i64 = 0;
    let cnt = len(left) as i64;
    while i < cnt {
        if left[i] != right[i] {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn find_arch(component_ids: Vec<i32>, candidates: Vec<Vec<i32>>) -> i64 {
    let i: i64 = 0;
    let cnt = len(candidates) as i64;
    while i < cnt {
        if signature_equals(candidates[i], component_ids) {
            return i;
        };
        i = i + 1;
    }
    return -1;
}

@test "param vec not consumed across loop equals"() {
    let ids: Vec<i32> = Vec::new();
    ids.push(1);
    ids.push(2);
    let cands: Vec<Vec<i32>> = Vec::new();
    let a: Vec<i32> = Vec::new();
    a.push(9);
    cands.push(a);
    let b: Vec<i32> = Vec::new();
    b.push(1);
    b.push(2);
    cands.push(b);
    let slot = find_arch(ids, cands);
    if slot != 1 {
        panic(92001);
    };
}
