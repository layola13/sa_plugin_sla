@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 中心二项式对峙：Pascal 查表 == 乘法式（n=4：70 对 70；n=5：252 对 252）。
// 意对标 546 pascal × 557 central（两源单实现见各源；286 系对峙体例）。

fn binom_table(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn central(n: int) -> int {
    let r = 1;
    let i = 0;
    while i < n {
        r = r * (2 * n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{}", binom_table(8, 4), central(4), binom_table(10, 5), central(5));
    return 0;
}

@test "basic 563 duel central"() {
    if binom_table(8, 4) != 70 { panic(56301); };
    if central(4) != 70 { panic(56302); };
    if binom_table(10, 5) != 252 { panic(56303); };
    if central(5) != 252 { panic(56304); };
    if binom_table(10, 5) != central(5) { panic(56305); };
}
