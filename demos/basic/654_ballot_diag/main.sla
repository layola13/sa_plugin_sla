@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Ballot 对角线即 Catalan：B(3,3)=5，B(4,4)=14，B(5,5)=42（对角恒等单锁）。
// 意对标 351_catalan（Catalan 单值版互补；对角线复算）。

fn btab(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn] + t[mm * w + nn - 1];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", btab(3, 3), btab(4, 4), btab(5, 5));
    return 0;
}

@test "basic 654 ballot diag"() {
    if btab(3, 3) != 5 { panic(65401); };
    if btab(4, 4) != 14 { panic(65402); };
    if btab(5, 5) != 42 { panic(65403); };
    if btab(2, 2) != 2 { panic(65404); };
}
