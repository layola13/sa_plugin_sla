@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// gcd 表和（sum_{i=1..6} gcd(i,12)=17）。
// 意对标 125 表版的 gcd 版（173-表系互补）。

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn gcd_table_sum(m: int, n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + gcd(i, m);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", gcd_table_sum(12, 6), gcd_table_sum(6, 4));
    return 0;
}

@test "basic 363 gcd table sum"() {
    if gcd_table_sum(12, 6) != 17 { panic(36301); };
    if gcd_table_sum(6, 4) != 8 { panic(36302); };
}
