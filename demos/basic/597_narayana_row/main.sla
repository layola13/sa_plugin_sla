@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana 行：n=4 行 `1,6,6,1`（和 14=C(4)）；N(5,0)=1 左端点。
// 意对标 596 narayana（单格版互补；532 行和体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{},{},{}", narayana(4, 0), narayana(4, 1), narayana(4, 2), narayana(4, 3), narayana(4, 0) + narayana(4, 1) + narayana(4, 2) + narayana(4, 3));
    return 0;
}

@test "basic 597 narrow"() {
    if narayana(4, 0) != 1 { panic(59701); };
    if narayana(4, 1) != 6 { panic(59702); };
    if narayana(4, 2) != 6 { panic(59703); };
    if narayana(4, 3) != 1 { panic(59704); };
    if narayana(5, 0) != 1 { panic(59705); };
}
