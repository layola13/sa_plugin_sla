@import "sa_std/growvec.sa"
@import "sa_std/growvec.sai"

// F1 core promise: element addresses NEVER move. The data pointer is
// sampled before growth and after 200,000 pushes (1.6 MB, hundreds of
// freshly committed pages) and must be bit-identical; every element
// value is then verified in place. A Vec under the same load would
// have reallocated (and moved) many times.
@test "growvec element addresses never move"() {
    let g: GrowVec<u64> = GrowVec::new();
    g.push(111);
    let p0 = sa_growvec_data_ptr(&g);
    let i: u64 = 1;
    while i < 200000 {
        g.push(i * 7 + 1);
        i = i + 1;
    }
    let p1 = sa_growvec_data_ptr(&g);
    if p0 != p1 { panic(1); };
    if len(g) != 200000 { panic(2); };
    if g[0] != 111 { panic(3); };
    if g[1] != 8 { panic(4); };
    if g[199999] != 1399994 { panic(5); };
    let sum: u64 = 0;
    let j: u64 = 0;
    while j < len(g) {
        sum = sum + g[j];
        j = j + 1;
    }
    if sum != 139999500110 { panic(6); };
    println("GROWVEC_ADDR_STABLE_OK");
}
