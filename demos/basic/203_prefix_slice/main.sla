@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 1423_slice_0_2：手写前缀切片拷贝（长 2，次元 2）。
// SLA 无 `slice` 方法（见 83/89），用 `for in` 区间逐元 `push`
//（与 89 的尾段版互补，此处为闭区间前缀版）。

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    let b: Vec<i32> = Vec::new();
    for i in 0..2 {
        b.push(a[i]);
    }
    println("{},{}", len(b), b[1]);
    return 0;
}

@test "basic 203 prefix slice"() {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    let b: Vec<i32> = Vec::new();
    for i in 0..2 {
        b.push(a[i]);
    }
    if len(b) != 2 { panic(20301); };
    if b[1] != 2 { panic(20302); };
    if a[2] != 3 { panic(20303); };
}
