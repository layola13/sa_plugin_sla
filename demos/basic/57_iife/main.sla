@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 170_iife：立即调用函数表达式 `(() => 42)()`。
// SLA 不支持对闭包字面量直接调用（`(|x| ...)()` 报 `error.InvalidCallTarget`，
// 探针见 /tmp/piife.sla）；此处先绑定再调用，块作用域限定绑定可见性，
// 语义与 IIFE 等价（参考 20_closures 的闭包写法）。

fn main() -> i32 {
    let v = 0;
    {
        let f = || 42;
        v = f();
    }
    println("{}", v);
    return 0;
}

@test "basic 57 iife"() {
    let f = || 42;
    if f() != 42 { panic(5701); };
}
