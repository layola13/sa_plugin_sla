@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 452_shift_bigcount：大计数位移（0,8589934592,-1）。
// SLA 位移为 64 位无掩码语义（`8 >> 33 = 0`，`1 << 33 = 2^33`），
// 与 TS 的 mod-32 语义（4,2,-4）不同，此处按实际语义断言；
// `>>>` / `>>=` / `<<=` 均无词法 token（见 119）。

fn main() -> i32 {
    println("{},{},{}", 8 >> 33, 1 << 33, -8 >> 33);
    return 0;
}

@test "basic 128 shift big"() {
    if 8 >> 33 != 0 { panic(12801); };
    if 1 << 33 != 8589934592 { panic(12802); };
    if -8 >> 33 != -1 { panic(12803); };
    if 8 >> 1 != 4 { panic(12804); };
}
