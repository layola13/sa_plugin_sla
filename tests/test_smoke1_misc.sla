@test "smoke1 sa_io_read"() {
    let rec = [0u64; 4];
    let a0: u64 = 0;
    PTR_ADDR(a0, STR_PTR("/bin/echo"));
    rec[0] = a0;
    rec[1] = STR_LEN("/bin/echo");
    let a1: u64 = 0;
    PTR_ADDR(a1, STR_PTR("hi"));
    rec[2] = a1;
    rec[3] = STR_LEN("hi");
