    let fd = [0u64; 4];
    sla_std_process_pidfd(h, &fd[0]);
    let ready = [0u64; 4];
    let code = [0u64; 4];
    let tries: u64 = 0;
    while ready[0] == 0 {
        let rc = sla_std_pidfd_try_wait(fd[0], &ready[0], &code[0]);
        if rc != 0 { panic(57161); };
