// Smoke wave 1: register-2 externs in sa_std/encoding/json.sai.
// Node handles come from sla_json_parse (real documents), writer handles
// from sla_json_writer_new. Panic codes 52xxx.
// Kind codes (sci sa_std.zig): null 0, bool 1, integer 2, float 3,
// number_string 4, string 5, array 6, object 7.
@import "sla_std/wrap/encoding/json.sla"
@import "sla_std/wrap/fs.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s1_doc() -> u64 {
    let n = sla_json_parse(STR_PTR("{\"name\":\"sla\",\"n\":42,\"f\":2.5,\"b\":true,\"z\":null,\"arr\":[1,2,3],\"obj\":{\"k\":\"v\"}}"), STR_LEN("{\"name\":\"sla\",\"n\":42,\"f\":2.5,\"b\":true,\"z\":null,\"arr\":[1,2,3],\"obj\":{\"k\":\"v\"}}"));
    if n == 0 { panic(52001); };
    return n;
}

fn s1_streq(p: ptr, l: u64, lit: ptr, litl: u64) -> bool {
    if l != litl { return false; };
    let i: u64 = 0;
    while i < l {
        if PTR_BYTE_AT(p, i) != PTR_BYTE_AT(lit, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn s1_get(node: u64, key: ptr, key_len: u64, code: i32) -> u64 {
    let cell = [0u64; 4];
    let rc = sla_json_object_get(node, key, key_len, &cell[0]);
    if rc != 0 { panic(code); };
    if cell[0] == 0 { panic(code + 1); };
    return cell[0];
}

@test "smoke1 sa_json_kind"() {
    let doc = s1_doc();
    if sla_json_kind(doc) != 7 { panic(52010); };
    let arr = sla_json_parse(STR_PTR("[1]"), STR_LEN("[1]"));
    if sla_json_kind(arr) != 6 { panic(52011); };
    let s = sla_json_parse(STR_PTR("\"x\""), STR_LEN("\"x\""));
    if sla_json_kind(s) != 5 { panic(52012); };
    let i = sla_json_parse(STR_PTR("42"), STR_LEN("42"));
    if sla_json_kind(i) != 2 { panic(52013); };
}

@test "smoke1 sa_json_object_get"() {
    let doc = s1_doc();
    let arr = s1_get(doc, STR_PTR("arr"), STR_LEN("arr"), 52020);
    if sla_json_kind(arr) != 6 { panic(52022); };
}

@test "smoke1 sa_json_array_get"() {
    let doc = s1_doc();
    let arr = s1_get(doc, STR_PTR("arr"), STR_LEN("arr"), 52030);
    let cell = [0u64; 4];
    let rc = sla_json_array_get(arr, 1, &cell[0]);
    if rc != 0 { panic(52032); };
    let v = [0u64; 4];
    let rc2 = sla_json_as_i64(cell[0], &v[0]);
    if rc2 != 0 { panic(52033); };
    if v[0] != 2 { panic(52034); };
}

@test "smoke1 sa_json_object_key_at"() {
    let obj = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if obj == 0 { panic(52040); };
    sla_json_object_set_string(obj, STR_PTR("alpha"), STR_LEN("alpha"), STR_PTR("1"), STR_LEN("1"));
    sla_json_object_set_string(obj, STR_PTR("beta"), STR_LEN("beta"), STR_PTR("2"), STR_LEN("2"));
    let p0 = [0u64; 4];
    let l0 = [0u64; 4];
    let rc = sla_json_object_key_at(obj, 0, &p0[0], &l0[0]);
    if rc != 0 { panic(52041); };
    let p1 = [0u64; 4];
    let l1 = [0u64; 4];
    let rc2 = sla_json_object_key_at(obj, 1, &p1[0], &l1[0]);
    if rc2 != 0 { panic(52042); };
    let ptr0: ptr = (p0[0] as ptr);
    let ptr1: ptr = (p1[0] as ptr);
    let ab = s1_streq(ptr0, l0[0], STR_PTR("alpha"), STR_LEN("alpha")) && s1_streq(ptr1, l1[0], STR_PTR("beta"), STR_LEN("beta"));
    let ba = s1_streq(ptr0, l0[0], STR_PTR("beta"), STR_LEN("beta")) && s1_streq(ptr1, l1[0], STR_PTR("alpha"), STR_LEN("alpha"));
    if ab == false {
        if ba == false { panic(52043); };
    };
}

@test "smoke1 sa_json_object_get_string"() {
    let doc = s1_doc();
    let p = [0u64; 4];
    let l = [0u64; 4];
    let rc = sla_json_object_get_string(doc, STR_PTR("name"), STR_LEN("name"), &p[0], &l[0]);
    if rc != 0 { panic(52050); };
    let sp: ptr = (p[0] as ptr);
    if s1_streq(sp, l[0], STR_PTR("sla"), STR_LEN("sla")) == false { panic(52051); };
}

