@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Markov 三向（判定/计数/Vieta 上行：(1,2,5)→29）。
// 意对标 489 双角版的三向版（489 互补）。

fn is_markov(a: int, b: int, c: int) -> int {
    if a * a + b * b + c * c == 3 * a * b * c { return 1; };
    return 0;
}

fn markov_count(limit: int) -> int {
    let n = 0;
    let a = 1;
    while a <= limit {
        let b = a;
        while b <= limit {
            let c = b;
            while c <= limit {
                if is_markov(a, b, c) == 1 { n = n + 1; };
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return n;
}

fn markov_up(a: int, b: int, c: int) -> int {
    return 3 * b * c - a;
}

fn main() -> i32 {
    println("{},{},{}", is_markov(2, 5, 29), markov_count(30), markov_up(1, 2, 5));
    return 0;
}

@test "basic 492 tri markov"() {
    if is_markov(2, 5, 29) != 1 { panic(49201); };
    if markov_count(30) != 5 { panic(49202); };
    if markov_up(1, 2, 5) != 29 { panic(49203); };
    if is_markov(2, 5, markov_up(1, 2, 5)) != 1 { panic(49204); };
}
