@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 8 行高位 E(8,1)=247，E(8,2)=4293，E(8,3)=15619（同式再上一位）。
// 意对标 796_eul7（n=7 版互补；800 做高位对峙）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{}", eul(8, 1), eul(8, 2), eul(8, 3));
    return 0;
}

@test "basic 798 eul8"() {
    if eul(8, 1) != 247 { panic(79801); };
    if eul(8, 2) != 4293 { panic(79802); };
    if eul(8, 3) != 15619 { panic(79803); };
    if eul(8, 4) != 15619 { panic(79804); };
}
