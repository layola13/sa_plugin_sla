fn sum_of(values: [int; 4]) -> int {
    return values.iter().sum();
}

@test "vec adapters"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    if v.iter().sum() != 6 { panic(21); };
    if v.iter().count() != 3 { panic(22); };
    if v.len() != 3 { panic(23); };
    if sum_of([1, 2, 3, 4]) != 10 { panic(24); };
}
