@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 三向：二项递推 × Aitken 三角 × 二类行和（n=9：21147 三锁）。
// 意对标 776_bell9（递推源互补；605 三向体例收束 Bell 续高位族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn bt(n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = t[(mm - 1) * w + mm - 1];
        let nn = 1;
        while nn <= mm {
            t[mm * w + nn] = t[mm * w + nn - 1] + t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w];
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn bsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", bell(9), bt(9), bsum(9));
    return 0;
}

@test "basic 785 tri bell"() {
    if bell(9) != 21147 { panic(78501); };
    if bt(9) != 21147 { panic(78502); };
    if bsum(9) != 21147 { panic(78503); };
    if bell(8) != 4140 { panic(78504); };
}
