@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Fubini 高位 F(6)=4683（行和式直算：1+62+540+1560+1800+720）。
// 意对标 588 fubini（低位版互补；同式高位复算，大值单锁）。

fn stirling2(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = kk * t[(nn - 1) * w + kk] + t[(nn - 1) * w + kk - 1];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn fubini(n: int) -> int {
    let s = 0;
    let k = 1;
    while k <= n {
        s = s + fact(k) * stirling2(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{}", fubini(6));
    return 0;
}

@test "basic 593 fubini6"() {
    if fubini(6) != 4683 { panic(59301); };
    if fubini(5) != 541 { panic(59302); };
}
