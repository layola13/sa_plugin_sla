@test "smoke1 sa_net_udp_join_multicast_v4"() {
    let a = s1_np_udp(63170);
    let rc = sla_net_udp_join_multicast_v4(a, STR_PTR("233.1.1.3"), STR_LEN("233.1.1.3"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc != 0 { panic(63171); };
    let rc2 = sla_net_udp_leave_multicast_v4(a, STR_PTR("233.1.1.3"), STR_LEN("233.1.1.3"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc2 != 0 { panic(63172); };
    sla_net_udp_close(a);
}

@test "smoke1 sa_net_udp_leave_multicast_v4"() {
    let a = s1_np_udp(63180);
    sla_net_udp_join_multicast_v4(a, STR_PTR("233.1.1.4"), STR_LEN("233.1.1.4"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    let rc = sla_net_udp_leave_multicast_v4(a, STR_PTR("233.1.1.4"), STR_LEN("233.1.1.4"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    if rc != 0 { panic(63181); };
    sla_net_udp_close(a);
}

@test "smoke1 sa_net_udp_join_multicast_v6"() {
    let h = sla_net_udp_bind(STR_PTR("::1"), STR_LEN("::1"), 0);
    if h <= 0 { panic(63190); };
    let rc = sla_net_udp_join_multicast_v6((h as u64), STR_PTR("ff02::3"), STR_LEN("ff02::3"), 1);
    if rc != 0 { panic(63191); };
    let rc2 = sla_net_udp_leave_multicast_v6((h as u64), STR_PTR("ff02::3"), STR_LEN("ff02::3"), 1);
    if rc2 != 0 { panic(63192); };
    sla_net_udp_close((h as u64));
}

@test "smoke1 sa_net_udp_leave_multicast_v6"() {
    let h = sla_net_udp_bind(STR_PTR("::1"), STR_LEN("::1"), 0);
    if h <= 0 { panic(63200); };
    sla_net_udp_join_multicast_v6((h as u64), STR_PTR("ff02::4"), STR_LEN("ff02::4"), 1);
    let rc = sla_net_udp_leave_multicast_v6((h as u64), STR_PTR("ff02::4"), STR_LEN("ff02::4"), 1);
    if rc != 0 { panic(63201); };
    sla_net_udp_close((h as u64));
}

@test "smoke1 sa_net_udp_close"() {
    let a = s1_np_udp(63210);
    let rc = sla_net_udp_close(a);
    if rc != 0 { panic(63211); };
    let rc2 = sla_net_udp_close(a);
    if rc2 == 0 { panic(63212); };
}

@test "smoke1 sa_net_tcp_stream_write"() {
    let srv = s1_np_pair_srv(63220);
    let lh = [0u64; 4];
    // The pair helper leaks its listener/client by design of this
    // helper; write is judged on the server stream via a fresh pair:
    let n = sla_net_tcp_stream_write(srv, STR_PTR("hi"), STR_LEN("hi"));
    if n != 2 { panic(63223); };
    sla_std_close(srv);
}

@test "smoke1 sa_net_tcp_stream_peek"() {
    let lh = [0u64; 4];
    let port = [0u64; 4];
    sla_std_net_tcp_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0, &lh[0], &port[0]);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port[0] as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh[0], &srv[0]);
    let wr = [0u64; 4];
    sla_std_net_tcp_stream_write(cli[0], STR_PTR("peek"), STR_LEN("peek"), &wr[0]);
    let buf = [0u8; 64];
    let n = sla_net_tcp_stream_peek(srv[0], &buf[0], 64);
    if n != 4 { panic(63230); };
    if buf[0] != 112 { panic(63231); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh[0]);
}

@test "smoke1 sa_net_tcp_stream_peer_addr"() {
    let lh = [0u64; 4];
    let port = [0u64; 4];
    sla_std_net_tcp_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0, &lh[0], &port[0]);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port[0] as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh[0], &srv[0]);
    let a = sla_net_tcp_stream_peer_addr(srv[0]);
    if a <= 0 { panic(63240); };
    let laddr = [0u64; 4];
    sla_std_net_tcp_stream_local_addr(cli[0], &laddr[0]);
    if sla_net_addr_port((a as u64)) != sla_net_addr_port(laddr[0]) { panic(63241); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh[0]);
}

