@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 数 A(n,d)（0 起降序数）：A(n,d)=(n-d)·A(n-1,d-1)+(d+1)·A(n-1,d)
//（A(4,1)=11，A(4,2)=11，A(5,2)=66，A(5,3)=26；拍扁表，570 做行和）。
// 意对标 531 stirling2（同为拍扁加权三角；此处双权和式）。

fn euler(n: int, d: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let dd = 0;
        while dd <= nn - 1 {
            let a = 0;
            if dd > 0 { a = (nn - dd) * t[(nn - 1) * w + dd - 1]; };
            let b = (dd + 1) * t[(nn - 1) * w + dd];
            t[nn * w + dd] = a + b;
            dd = dd + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + d];
}

fn main() -> i32 {
    println("{},{},{},{}", euler(4, 1), euler(4, 2), euler(5, 2), euler(5, 3));
    return 0;
}

@test "basic 569 euler"() {
    if euler(4, 1) != 11 { panic(56901); };
    if euler(4, 2) != 11 { panic(56902); };
    if euler(5, 2) != 66 { panic(56903); };
    if euler(5, 3) != 26 { panic(56904); };
}
