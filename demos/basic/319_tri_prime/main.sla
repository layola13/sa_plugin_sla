@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 试除×轮式×标记三向素数对峙（46×261×241：10=10=10）。
// 双向已见 290，此处加标记版收束三向。

fn prime_trial(n: int) -> int {
    if n < 2 { return 0; };
    for i in 2..n {
        if i * i > n { break; };
        if n % i == 0 { return 0; };
    }
    return 1;
}

fn prime_wheel(n: int) -> int {
    if n < 2 { return 0; };
    if n == 2 || n == 3 { return 1; };
    if n % 2 == 0 || n % 3 == 0 { return 0; };
    let i = 5;
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return 0; };
        i = i + 6;
    }
    return 1;
}

fn main() -> i32 {
    let marks: Vec<i32> = Vec::new();
    let m = 0;
    while m <= 30 {
        marks.push(1);
        m = m + 1;
    }
    let p = 2;
    while p * p <= 30 {
        if marks[p] == 1 {
            let q = p * p;
            while q <= 30 {
                marks[q] = 0;
                q = q + p;
            }
        };
        p = p + 1;
    }
    let mc = 0;
    let j = 2;
    while j <= 30 {
        if marks[j] == 1 { mc = mc + 1; };
        j = j + 1;
    }
    let tc = 0;
    let wc = 0;
    let c = 2;
    while c <= 30 {
        if prime_trial(c) == 1 { tc = tc + 1; };
        if prime_wheel(c) == 1 { wc = wc + 1; };
        c = c + 1;
    }
    println("{},{},{}", tc, wc, mc);
    return 0;
}

@test "basic 319 tri prime"() {
    let tc = 0;
    let wc = 0;
    let c = 2;
    while c <= 30 {
        if prime_trial(c) == 1 { tc = tc + 1; };
        if prime_wheel(c) == 1 { wc = wc + 1; };
        c = c + 1;
    }
    if tc != wc { panic(31901); };
    if tc != 10 { panic(31902); };
}
