@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 1441_toReversed 的手写版（SLA 无 `toReversed` 方法）。
// 逆序下标拷贝（首 4 末 1）；与 89（尾段版）互补，此处为全表逆序。

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    a.push(4);
    let r: Vec<i32> = Vec::new();
    for i in 0..len(a) {
        r.push(a[len(a) - 1 - i]);
    }
    println("{},{},{}", r[0], r[3], len(r));
    return 0;
}

@test "basic 246 vec reverse"() {
    let a: Vec<i32> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    a.push(4);
    let r: Vec<i32> = Vec::new();
    for i in 0..len(a) {
        r.push(a[len(a) - 1 - i]);
    }
    if r[0] != 4 { panic(24601); };
    if r[3] != 1 { panic(24602); };
    if len(r) != 4 { panic(24603); };
}
