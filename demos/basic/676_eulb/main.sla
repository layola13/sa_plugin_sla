@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 型建表 B(n,m)=(2m+1)B(n-1,m)+(2n-2m+1)B(n-1,m-1)（546 范式）。
// B(3,1)=23，B(4,1)=76，B(4,2)=230（679 做建表/交错和对峙）。
// 意对标 666_eulerian（A 型姐妹；此处为符号置换计数，行和 2^n·n!）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{}", eub(3, 1), eub(4, 1), eub(4, 2));
    return 0;
}

@test "basic 676 eulb"() {
    if eub(3, 1) != 23 { panic(67601); };
    if eub(4, 1) != 76 { panic(67602); };
    if eub(4, 2) != 230 { panic(67603); };
    if eub(2, 1) != 6 { panic(67604); };
}
