@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Euclid 公式生成（(m,n)=(2,1)→(3,4,5)，(3,2)→(5,12,13)）。
// 意对标 339 生成版的公式版（339 互补）。

fn euclid_pack(m: int, n: int) -> int {
    let a = m * m - n * n;
    let b = 2 * m * n;
    let c = m * m + n * n;
    return a * 10000 + b * 100 + c;
}

fn main() -> i32 {
    println("{},{}", euclid_pack(2, 1), euclid_pack(3, 2));
    return 0;
}

@test "basic 427 euclid gen"() {
    if euclid_pack(2, 1) != 30405 { panic(42701); };
    if euclid_pack(3, 2) != 51213 { panic(42702); };
}
