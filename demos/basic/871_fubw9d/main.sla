@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 加权分项 7!S(9,7)=2328480，8!S(9,8)=1451520，9!S(9,9)=362880（尾三项锁定）。
// 意对标 867_fubw9（总量版互补；分项直打）。

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fubw(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + fact(k) * svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", fact(7) * svt(9, 7), fact(8) * svt(9, 8), fact(9) * svt(9, 9));
    return 0;
}

@test "basic 871 fubw9d"() {
    if fact(7) * svt(9, 7) != 2328480 { panic(87101); };
    if fact(8) * svt(9, 8) != 1451520 { panic(87102); };
    if fact(9) * svt(9, 9) != 362880 { panic(87103); };
    if fubw(9) != 7087261 { panic(87104); };
}
