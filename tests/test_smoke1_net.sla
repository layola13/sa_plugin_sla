@test "smoke1 sa_std_net_tcp_stream_set_deferaccept"() {
    let lh = s1_listen(59200);
    let port = s1_port_of_listener(lh, 59201);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let rc = sla_std_net_tcp_stream_set_deferaccept(srv[0], 5);
    if rc != 0 { panic(59202); };
    let out = [0u64; 4];
    sla_std_net_tcp_stream_deferaccept(srv[0], &out[0]);
    // TCP_DEFER_ACCEPT readback is kernel-quantized (seconds are
    // converted to retransmission units); engaged means nonzero.
    if out[0] == 0 { panic(59203); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

