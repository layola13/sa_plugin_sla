@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 3 的幂和（1+3+9+27=40）。
// 意对标 352 等比版的 3 进制版（352 互补）。

fn pow3_sum(n: int) -> int {
    let s = 0;
    let t = 1;
    let i = 0;
    while i < n {
        s = s + t;
        t = t * 3;
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", pow3_sum(4), pow3_sum(3), pow3_sum(1));
    return 0;
}

@test "basic 372 pow3 sum"() {
    if pow3_sum(4) != 40 { panic(37201); };
    if pow3_sum(3) != 13 { panic(37202); };
    if pow3_sum(1) != 1 { panic(37203); };
}
