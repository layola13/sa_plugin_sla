@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana-商式对峙：行和 == B(n)/(n+1)（n=5：42 对 42；n=6：132 对 132）。
// 意对标 598 narayana6 × 351 catalan（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nar_row(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + narayana(n, k);
        k = k + 1;
    }
    return s;
}

fn cat_div(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{},{},{}", nar_row(5), cat_div(5), nar_row(6), cat_div(6));
    return 0;
}

@test "basic 600 duel narcat"() {
    if nar_row(5) != 42 { panic(60001); };
    if cat_div(5) != 42 { panic(60002); };
    if nar_row(6) != 132 { panic(60003); };
    if cat_div(6) != 132 { panic(60004); };
    if nar_row(6) != cat_div(6) { panic(60005); };
}
