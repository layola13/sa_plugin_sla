@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 不同素因子计数 ω（ω(12)=2，ω(30)=3）。
// 意对标 376 半素数（计重数）的去重版（376 互补）。

fn omega(n: int) -> int {
    if n < 2 { return 0; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        if m % d == 0 {
            c = c + 1;
            while m % d == 0 { m = m / d; }
        };
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    return c;
}

fn main() -> i32 {
    println("{},{},{}", omega(12), omega(30), omega(8));
    return 0;
}

@test "basic 386 omega"() {
    if omega(12) != 2 { panic(38601); };
    if omega(30) != 3 { panic(38602); };
    if omega(8) != 1 { panic(38603); };
}
