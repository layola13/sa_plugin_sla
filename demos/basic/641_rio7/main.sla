@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 高位二 R(7)=36（R(6)=15 对 15；短递推一步 `6·48/8`）。
// 意对标 638_rio_high（高位版互补；642 做高位二对峙）。

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", rio(6), rio(7));
    return 0;
}

@test "basic 641 rio7"() {
    if rio(7) != 36 { panic(64101); };
    if rio(6) != 15 { panic(64102); };
    if rio(5) != 6 { panic(64103); };
}
