@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 7 行 1,120,1191,2416,1191,120,1（行和 5040=7!；行和循环求和）。
// 意对标 796_eul7（单格版互补；同式行复算）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eul(7, 1), eul(7, 2), esum(7));
    return 0;
}

@test "basic 797 eul row7"() {
    if eul(7, 1) != 120 { panic(79701); };
    if eul(7, 2) != 1191 { panic(79702); };
    if esum(7) != 5040 { panic(79703); };
    if eul(7, 0) != 1 { panic(79704); };
}
