// SQLite facade declarations for the D3 demo.
//
// The implementations are the node plugin's sa_node_plugin_sqlite_*
// externs (installed plugin `node`, node_extra.sai). They are declared
// locally because the SLA compiler's import expansion does not resolve
// plugin/<name>/... paths for .sla sources yet (recorded as a D3 finding
// in demos/cxu/README.md); the SA-level resolver accepts the qualified
// form, the SLA frontend does not.

@extern sa_node_plugin_sqlite_open(path_ptr: ptr, path_len: u64, &out_db: ptr) -> u64
@extern sa_node_plugin_sqlite_close(db_ptr: ptr) -> u64
@extern sa_node_plugin_sqlite_exec(db_ptr: ptr, sql_ptr: ptr, sql_len: u64) -> u64
@extern sa_node_plugin_sqlite_query_json(db_ptr: ptr, sql_ptr: ptr, sql_len: u64, &out_ptr: ptr, &out_len: u64) -> u64
