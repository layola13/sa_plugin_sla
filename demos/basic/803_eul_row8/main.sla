@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 8 行 1,247,4293,15619,15619,4293,247,1（行和 40320=8!；循环求和）。
// 意对标 797_eul_row7（低位行互补；同式高位行复算）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eul(8, 1), eul(8, 2), esum(8));
    return 0;
}

@test "basic 803 eul row8"() {
    if eul(8, 1) != 247 { panic(80301); };
    if eul(8, 2) != 4293 { panic(80302); };
    if esum(8) != 40320 { panic(80303); };
    if eul(8, 0) != 1 { panic(80304); };
}
