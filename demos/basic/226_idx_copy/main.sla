@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 79_copy_loop：下标逐元拷贝（和 18）。
// 与 84/89/98/203（`push` 式拷贝）互补，此处为定长目标下标写。

fn main() -> i32 {
    let a = [5, 6, 7];
    let c = [0, 0, 0];
    for i in 0..3 {
        c[i] = a[i];
    }
    println("{}", c[0] + c[1] + c[2]);
    return 0;
}

@test "basic 226 idx copy"() {
    let a = [5, 6, 7];
    let c = [0, 0, 0];
    for i in 0..3 {
        c[i] = a[i];
    }
    if c[0] + c[1] + c[2] != 18 { panic(22601); };
    if c[1] != 6 { panic(22602); };
}
