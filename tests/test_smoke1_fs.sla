@test "smoke1 sa_std_fs_file_write_at"() {
    s1_mkdir();
    sla_fs_write_file(STR_PTR("smoke1_fs/stdwriteat.txt"), STR_LEN("smoke1_fs/stdwriteat.txt"), STR_PTR("......"), STR_LEN("......"));
    let cell = [0u64; 4];
    let rc = sla_std_fs_open_write(STR_PTR("smoke1_fs/stdwriteat.txt"), STR_LEN("smoke1_fs/stdwriteat.txt"), 0, &cell[0]);
    if rc != 0 { panic(51160); };
    let wr = [0u64; 4];
    let rc2 = sla_std_fs_file_write_at(cell[0], STR_PTR("AB"), STR_LEN("AB"), 2, &wr[0]);
    if rc2 != 0 { panic(51161); };
    if wr[0] != 2 { panic(51162); };
    sla_std_close(cell[0]);
    let rc3 = sla_std_fs_open_read(STR_PTR("smoke1_fs/stdwriteat.txt"), STR_LEN("smoke1_fs/stdwriteat.txt"), &cell[0]);
    if rc3 != 0 { panic(51163); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    sla_std_fs_file_read(cell[0], &buf[0], 64, &rd[0]);
    if buf[0] != 46 { panic(51164); };
    if buf[2] != 65 { panic(51165); };
    if buf[3] != 66 { panic(51166); };
    if buf[5] != 46 { panic(51167); };
    sla_std_close(cell[0]);
}

