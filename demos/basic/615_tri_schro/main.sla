@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Schroder 三向：迭代建表 × 递归 × 二项商式直和（n=4：90 三锁）。
// 商式 S(n)=sum C(n,k)C(n+k,k)/(k+1)（逐项精确整除：1,10,30,35,14）。
// 意对标 608_schro_high（高位源互补；605 三向体例）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rsch(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 2; };
    let s = rsch(n - 1);
    let k = 0;
    while k < n {
        s = s + rsch(k) * rsch(n - 1 - k);
        k = k + 1;
    }
    return s;
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn ssch(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom_mul(n, k) * binom_mul(n + k, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", sch(4), rsch(4), ssch(4));
    return 0;
}

@test "basic 615 tri schro"() {
    if sch(4) != 90 { panic(61501); };
    if rsch(4) != 90 { panic(61502); };
    if ssch(4) != 90 { panic(61503); };
    if ssch(2) != 6 { panic(61504); };
}
