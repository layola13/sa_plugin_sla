@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 第二类 Stirling 数 S(n,k)：S(n,k)=k*S(n-1,k)+S(n-1,k-1)
//（S(5,2)=15，S(5,3)=25，S(6,3)=90；拍扁二维表，避嵌套数组 #20）。
// 意对标 351 catalan（同为组合三角递推；351 走卷积，此处走加权递推）。

fn stirling2(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = kk * t[(nn - 1) * w + kk] + t[(nn - 1) * w + kk - 1];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", stirling2(5, 2), stirling2(5, 3), stirling2(6, 3));
    return 0;
}

@test "basic 531 stirling2"() {
    if stirling2(5, 2) != 15 { panic(53101); };
    if stirling2(5, 3) != 25 { panic(53102); };
    if stirling2(6, 3) != 90 { panic(53103); };
    if stirling2(4, 2) != 7 { panic(53104); };
}
