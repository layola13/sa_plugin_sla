@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 续三向：商式 × 卷积 × 比值递推（n=9：4862 三锁）。
// 意对标 856_cat9（商源互补；735 三向体例收束 Catalan 续三行族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn catf(n: int) -> int {
    return binom_mul(2 * n, n) - binom_mul(2 * n, n + 1);
}

fn rat(n: int) -> int {
    let r = 1;
    let i = 0;
    while i < n {
        r = r * 2 * (2 * i + 1) / (i + 2);
        i = i + 1;
    }
    return r;
}

fn catc(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let i = 0;
    while i < n {
        s = s + catc(i) * catc(n - 1 - i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", catd(9), catc(9), rat(9));
    return 0;
}

@test "basic 865 tri cat9"() {
    if catd(9) != 4862 { panic(86501); };
    if catc(9) != 4862 { panic(86502); };
    if rat(9) != 4862 { panic(86503); };
    if catd(10) != 16796 { panic(86504); };
}
