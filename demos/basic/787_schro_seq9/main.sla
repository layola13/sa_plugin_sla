@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 序列前 10 项和 258563（S(8)=41586，S(9)=206098；前缀和循环求和）。
// 意对标 786_schro9（单值版互补；同式序列复算）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn schseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + sch(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", sch(8), sch(9), schseq(9));
    return 0;
}

@test "basic 787 schro seq9"() {
    if schseq(9) != 258563 { panic(78701); };
    if sch(8) != 41586 { panic(78702); };
    if sch(9) != 206098 { panic(78703); };
    if schseq(6) != 2321 { panic(78704); };
}
