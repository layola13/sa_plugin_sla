@test "smoke1 sa_std_net_tcp_stream_set_nonblocking"() {
    let lh = s1_listen(59130);
    let port = s1_port_of_listener(lh, 59131);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let rc = sla_std_net_tcp_stream_set_nonblocking(srv[0], 1);
    if rc != 0 { panic(59132); };
    // Nonblocking read with no data pending must fail, not hang.
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc2 = sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rc2 == 0 { panic(59133); };
    let rc3 = sla_std_net_tcp_stream_set_nonblocking(srv[0], 0);
    if rc3 != 0 { panic(59134); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_stream_set_linger"() {
    let lh = s1_listen(59140);
    let port = s1_port_of_listener(lh, 59141);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let rc = sla_std_net_tcp_stream_set_linger(srv[0], 1, 2000000000);
    if rc != 0 { panic(59142); };
    let en = [0u64; 4];
    let to = [0u64; 4];
    sla_std_net_tcp_stream_linger(srv[0], &en[0], &to[0]);
    if en[0] != 1 { panic(59143); };
    if to[0] == 0 { panic(59144); };
    if to[0] > 2000000000 { panic(59145); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

