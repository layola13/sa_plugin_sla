@import "sa_std/dns.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/status.sla"

// reg-shard1 coverage: SAB registry declared entries from
// sa_std/dns.sla, pure codec half A (checker-clean subgraph):
// dns_empty_record / dns_empty_message / dns_slice_len /
// dns_get_u8 / dns_get_u16 / dns_get_u32 / dns_put_u16 /
// dns_put_u32 / dns_put_bytes / dns_put_dec / dns_encode_name /
// dns_build_query / dns_records_of_type / dns_is_space /
// dns_resolv_conf_server / dns_token_eq / dns_parse_port /
// dns_services_scan / dns_reverse_name_v4. Wire fixtures are
// hand-built per RFC 1035; expected values are the protocol
// values, not re-derivations from the implementation. The wire
// READER entries live in test_unit_reg1_dns_codec_b.sla: they
// are checker-rejected on this head (see RESULT.md, defect
// candidate REG1-DNS-LOOP).

fn reg1_bytes(s: String) -> Vec<u8> {
    let out: Vec<u8> = Vec::new();
    let p: ptr = STR_PTR(s);
    let n: u64 = len(s) as u64;
    let i: u64 = 0;
    while i < n {
        out.push(PTR_BYTE_AT(p, i));
        i = i + 1;
    }
    return out;
}

fn reg1_veq(v: &Vec<u8>, s: String) -> bool {
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    let nv: u64 = 0;
    SLICE_GET_LEN(nv, sl);
    let ns: u64 = len(s) as u64;
    if nv != ns { return false; };
    let p: ptr = STR_PTR(s);
    let i: u64 = 0;
    while i < ns {
        let b: u8 = 0;
        SLICE_GET(b, sl, i);
        if b != PTR_BYTE_AT(p, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn reg1_example_wire() -> Vec<u8> {
    let w: Vec<u8> = Vec::new();
    w.push(7);
    w.push(101);
    w.push(120);
    w.push(97);
    w.push(109);
    w.push(112);
    w.push(108);
    w.push(101);
    w.push(3);
    w.push(99);
    w.push(111);
    w.push(109);
    w.push(0);
    return w;
}

@test "reg1 dns empty record and message"() {
    let r = dns_empty_record();
    if len(r.name) != 0 { panic(61901); };
    if r.record_type != 0 { panic(61902); };
    if r.record_class != 0 { panic(61903); };
    if r.ttl != 0 { panic(61904); };
    if r.addr_v4 != 0 { panic(61905); };
    if len(r.addr_v6) != 0 { panic(61906); };
    if len(r.target) != 0 { panic(61907); };
    if r.preference != 0 { panic(61908); };
    if r.priority != 0 { panic(61909); };
    if r.weight != 0 { panic(61910); };
    if r.port != 0 { panic(61911); };
    if len(r.text) != 0 { panic(61912); };
    if len(r.raw) != 0 { panic(61913); };
    let m = dns_empty_message();
    if m.id != 0 { panic(61914); };
    if m.rcode != 0 { panic(61915); };
    if m.opcode != 0 { panic(61916); };
    if m.is_response { panic(61917); };
    if m.authoritative_answer { panic(61918); };
    if m.truncation { panic(61919); };
    if m.recursion_desired { panic(61920); };
    if m.recursion_available { panic(61921); };
    if len(m.questions) != 0 { panic(61922); };
    if len(m.answers) != 0 { panic(61923); };
    if len(m.authorities) != 0 { panic(61924); };
    if len(m.additionals) != 0 { panic(61925); };
}

@test "reg1 dns slice len and get scalars"() {
    let v: Vec<u8> = Vec::new();
    v.push(18);
    v.push(52);
    v.push(86);
    v.push(120);
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    if dns_slice_len(&sl) != 4 { panic(61931); };
    if dns_get_u8(&sl, 0) != 18 { panic(61932); };
    if dns_get_u8(&sl, 3) != 120 { panic(61933); };
    if dns_get_u16(&sl, 0) != 4660 { panic(61934); };
    if dns_get_u16(&sl, 2) != 22136 { panic(61935); };
    if dns_get_u32(&sl, 0) != 305419896 { panic(61936); };
    let empty: Vec<u8> = Vec::new();
    let esl: Slice<u8> = VEC_AS_SLICE(empty);
    if dns_slice_len(&esl) != 0 { panic(61937); };
}

@test "reg1 dns put scalars and bytes"() {
    let out: Vec<u8> = Vec::new();
    dns_put_u16(&out, 4660);
    if len(out) != 2 { panic(61941); };
    if out[0] != 18 { panic(61942); };
    if out[1] != 52 { panic(61943); };
    dns_put_u16(&out, 0);
    if len(out) != 4 { panic(61944); };
    if out[3] != 0 { panic(61945); };
    let out2: Vec<u8> = Vec::new();
    dns_put_u32(&out2, 305419896);
    if len(out2) != 4 { panic(61946); };
    if out2[0] != 18 { panic(61947); };
    if out2[1] != 52 { panic(61948); };
    if out2[2] != 86 { panic(61949); };
    if out2[3] != 120 { panic(61950); };
    dns_put_u32(&out2, 4294967295);
    if out2[7] != 255 { panic(61951); };
    let src: Vec<u8> = Vec::new();
    src.push(10);
    src.push(20);
    src.push(30);
    src.push(40);
    src.push(50);
    let ssl: Slice<u8> = VEC_AS_SLICE(src);
    let base: Vec<u8> = Vec::new();
    base.push(99);
    let joined = dns_put_bytes(base, &ssl, 1, 3);
    if len(joined) != 4 { panic(61952); };
    if joined[0] != 99 { panic(61953); };
    if joined[1] != 20 { panic(61954); };
    if joined[3] != 40 { panic(61955); };
    let base2: Vec<u8> = Vec::new();
    base2.push(7);
    let same = dns_put_bytes(base2, &ssl, 0, 0);
    if len(same) != 1 { panic(61956); };
    if same[0] != 7 { panic(61957); };
}

@test "reg1 dns put_dec"() {
    let a: Vec<u8> = Vec::new();
    dns_put_dec(&a, 0);
    if !reg1_veq(&a, "0") { panic(61961); };
    let b: Vec<u8> = Vec::new();
    dns_put_dec(&b, 7);
    if !reg1_veq(&b, "7") { panic(61962); };
    let c: Vec<u8> = Vec::new();
    dns_put_dec(&c, 42);
    if !reg1_veq(&c, "42") { panic(61963); };
    let d: Vec<u8> = Vec::new();
    dns_put_dec(&d, 255);
    if !reg1_veq(&d, "255") { panic(61964); };
    let e: Vec<u8> = Vec::new();
    dns_put_dec(&e, 100);
    if !reg1_veq(&e, "100") { panic(61965); };
    let f: Vec<u8> = Vec::new();
    dns_put_dec(&f, 1);
    dns_put_dec(&f, 23);
    if !reg1_veq(&f, "123") { panic(61966); };
}

@test "reg1 dns encode name"() {
    let nm = reg1_bytes("example.com");
    let nsl: Slice<u8> = VEC_AS_SLICE(nm);
    let r = dns_encode_name(&nsl);
    match r {
        Ok(enc) => {
            if len(enc) != 13 { panic(61971); };
            if enc[0] != 7 { panic(61972); };
            if enc[1] != 101 { panic(61973); };
            if enc[8] != 3 { panic(61974); };
            if enc[9] != 99 { panic(61975); };
            if enc[12] != 0 { panic(61976); };
        },
        Err(e) => { panic(61970); },
    };
    let root: Vec<u8> = Vec::new();
    let rsl: Slice<u8> = VEC_AS_SLICE(root);
    let r2 = dns_encode_name(&rsl);
    match r2 {
        Ok(enc) => {
            if len(enc) != 1 { panic(61977); };
            if enc[0] != 0 { panic(61978); };
        },
        Err(e) => { panic(61979); },
    };
    let ab = reg1_bytes("a.b");
    let asl: Slice<u8> = VEC_AS_SLICE(ab);
    let r3 = dns_encode_name(&asl);
    match r3 {
        Ok(enc) => {
            if len(enc) != 5 { panic(61980); };
            if enc[0] != 1 { panic(61981); };
            if enc[2] != 1 { panic(61982); };
            if enc[4] != 0 { panic(61983); };
        },
        Err(e) => { panic(61984); },
    };
    let bad1 = reg1_bytes("a..b");
    let b1sl: Slice<u8> = VEC_AS_SLICE(bad1);
    let r4 = dns_encode_name(&b1sl);
    match r4 {
        Ok(enc) => { panic(61985); },
        Err(e) => { if e != SA_STD_ERR_INVALID_ARGUMENT { panic(61986); }; },
    };
    let bad2 = reg1_bytes("a.");
    let b2sl: Slice<u8> = VEC_AS_SLICE(bad2);
    let r5 = dns_encode_name(&b2sl);
    match r5 {
        Ok(enc) => { panic(61987); },
        Err(e) => { if e != SA_STD_ERR_INVALID_ARGUMENT { panic(61988); }; },
    };
    let bad3: Vec<u8> = Vec::new();
    let i: u64 = 0;
    while i < 64 {
        bad3.push(97);
        i = i + 1;
    }
    let b3sl: Slice<u8> = VEC_AS_SLICE(bad3);
    let r6 = dns_encode_name(&b3sl);
    match r6 {
        Ok(enc) => { panic(61989); },
        Err(e) => { if e != SA_STD_ERR_INVALID_ARGUMENT { panic(61990); }; },
    };
}

@test "reg1 dns build query wire"() {
    let nm = reg1_bytes("example.com");
    let r = dns_build_query(4660, nm, 1, 1, true);
    match r {
        Ok(w) => {
            if len(w) != 29 { panic(62051); };
            if w[0] != 18 { panic(62052); };
            if w[1] != 52 { panic(62053); };
            if w[2] != 1 { panic(62054); };
            if w[3] != 0 { panic(62055); };
            if w[5] != 1 { panic(62056); };
            if w[7] != 0 { panic(62057); };
            if w[12] != 7 { panic(62058); };
            if w[13] != 101 { panic(62059); };
            if w[20] != 3 { panic(62060); };
            if w[24] != 0 { panic(62061); };
            if w[25] != 0 { panic(62062); };
            if w[26] != 1 { panic(62063); };
            if w[27] != 0 { panic(62064); };
            if w[28] != 1 { panic(62065); };
        },
        Err(e) => { panic(62050); },
    };
    let nm2 = reg1_bytes("example.com");
    let r2 = dns_build_query(4660, nm2, 1, 1, false);
    match r2 {
        Ok(w) => {
            if w[2] != 0 { panic(62066); };
            if w[3] != 0 { panic(62067); };
        },
        Err(e) => { panic(62068); },
    };
    let bad = reg1_bytes("a..b");
    let r3 = dns_build_query(4660, bad, 1, 1, true);
    match r3 {
        Ok(w) => { panic(62069); },
        Err(e) => { if e != SA_STD_ERR_INVALID_ARGUMENT { panic(62070); }; },
    };
}

@test "reg1 dns records of type"() {
    let msg = dns_empty_message();
    let r1 = dns_empty_record();
    r1.record_type = 1;
    r1.addr_v4 = 16909060;
    msg.answers.push(r1);
    let r2 = dns_empty_record();
    r2.record_type = 28;
    msg.answers.push(r2);
    let r3 = dns_empty_record();
    r3.record_type = 1;
    r3.addr_v4 = 84281096;
    msg.answers.push(r3);
    let a1 = dns_records_of_type(msg, 0, 1);
    if len(a1) != 2 { panic(62101); };
    let asl: Slice<DnsRecord> = VEC_AS_SLICE(a1);
    let f0 = dns_empty_record();
    SLICE_GET(f0, asl, 0);
    if f0.addr_v4 != 16909060 { panic(62102); };
    let f1 = dns_empty_record();
    SLICE_GET(f1, asl, 1);
    if f1.addr_v4 != 84281096 { panic(62103); };
    let msg2 = dns_empty_message();
    let s1 = dns_empty_record();
    s1.record_type = 28;
    msg2.answers.push(s1);
    let s2 = dns_empty_record();
    s2.record_type = 2;
    msg2.authorities.push(s2);
    let a2 = dns_records_of_type(msg2, 0, 28);
    if len(a2) != 1 { panic(62104); };
    let msg3 = dns_empty_message();
    let t2 = dns_empty_record();
    t2.record_type = 2;
    msg3.authorities.push(t2);
    let a3 = dns_records_of_type(msg3, 1, 2);
    if len(a3) != 1 { panic(62105); };
    let msg4 = dns_empty_message();
    let a4 = dns_records_of_type(msg4, 2, 1);
    if len(a4) != 0 { panic(62106); };
}

@test "reg1 dns is space token eq parse port"() {
    if !dns_is_space(32) { panic(62111); };
    if !dns_is_space(9) { panic(62112); };
    if !dns_is_space(13) { panic(62113); };
    if !dns_is_space(10) { panic(62114); };
    if dns_is_space(65) { panic(62115); };
    if dns_is_space(0) { panic(62116); };
    let content = reg1_bytes("xxhello yy");
    let csl: Slice<u8> = VEC_AS_SLICE(content);
    let want = reg1_bytes("hello");
    let wsl: Slice<u8> = VEC_AS_SLICE(want);
    if !dns_token_eq(&csl, 2, 5, &wsl) { panic(62117); };
    if dns_token_eq(&csl, 2, 4, &wsl) { panic(62118); };
    if dns_token_eq(&csl, 3, 5, &wsl) { panic(62119); };
    let want2 = reg1_bytes("world");
    let w2sl: Slice<u8> = VEC_AS_SLICE(want2);
    if dns_token_eq(&csl, 2, 5, &w2sl) { panic(62120); };
    let pc = reg1_bytes("http 80/tcp 65535 8a");
    let psl: Slice<u8> = VEC_AS_SLICE(pc);
    if dns_parse_port(&psl, 5, 2) != 80 { panic(62121); };
    if dns_parse_port(&psl, 12, 5) != 65535 { panic(62122); };
    if dns_parse_port(&psl, 18, 2) != 65536 { panic(62123); };
    if dns_parse_port(&psl, 0, 0) != 0 { panic(62124); };
}

@test "reg1 dns resolv conf server"() {
    let c1 = reg1_bytes("nameserver 8.8.8.8\n");
    let s1: Slice<u8> = VEC_AS_SLICE(c1);
    let r1 = dns_resolv_conf_server(&s1);
    match r1 {
        Ok(v) => { if !reg1_veq(&v, "8.8.8.8") { panic(62131); }; },
        Err(e) => { panic(62132); },
    };
    let c2 = reg1_bytes("# comment\nsearch example.com\nnameserver 1.1.1.1 # primary\n");
    let s2: Slice<u8> = VEC_AS_SLICE(c2);
    let r2 = dns_resolv_conf_server(&s2);
    match r2 {
        Ok(v) => { if !reg1_veq(&v, "1.1.1.1") { panic(62133); }; },
        Err(e) => { panic(62134); },
    };
    let c3 = reg1_bytes("  nameserver 9.9.9.9\n");
    let s3: Slice<u8> = VEC_AS_SLICE(c3);
    let r3 = dns_resolv_conf_server(&s3);
    match r3 {
        Ok(v) => { if !reg1_veq(&v, "9.9.9.9") { panic(62135); }; },
        Err(e) => { panic(62136); },
    };
    let c4 = reg1_bytes("search example.com\noptions ndots:2\n");
    let s4: Slice<u8> = VEC_AS_SLICE(c4);
    let r4 = dns_resolv_conf_server(&s4);
    match r4 {
        Ok(v) => { panic(62137); },
        Err(e) => { if e != SA_STD_ERR_NOT_FOUND { panic(62138); }; },
    };
    let c5 = reg1_bytes("nameserver 8.8.8.8\nnameserver 1.1.1.1\n");
    let s5: Slice<u8> = VEC_AS_SLICE(c5);
    let r5 = dns_resolv_conf_server(&s5);
    match r5 {
        Ok(v) => { if !reg1_veq(&v, "8.8.8.8") { panic(62139); }; },
        Err(e) => { panic(62140); },
    };
}

@test "reg1 dns services scan"() {
    let content = reg1_bytes("#http 9999/tcp\nhttp 80/tcp www\nhttps 443/tcp www-http\nssh 22/tcp\n");
    let csl: Slice<u8> = VEC_AS_SLICE(content);
    let n_http = reg1_bytes("http");
    let nh: Slice<u8> = VEC_AS_SLICE(n_http);
    let n_www = reg1_bytes("www");
    let nw: Slice<u8> = VEC_AS_SLICE(n_www);
    let n_https = reg1_bytes("https");
    let nhs: Slice<u8> = VEC_AS_SLICE(n_https);
    let n_ssh = reg1_bytes("ssh");
    let ns: Slice<u8> = VEC_AS_SLICE(n_ssh);
    let p_tcp = reg1_bytes("tcp");
    let pt: Slice<u8> = VEC_AS_SLICE(p_tcp);
    let p_udp = reg1_bytes("udp");
    let pu: Slice<u8> = VEC_AS_SLICE(p_udp);
    let p_any: Vec<u8> = Vec::new();
    let pa: Slice<u8> = VEC_AS_SLICE(p_any);
    let h1 = dns_services_scan(&csl, &nh, &pt, 0, 0);
    if h1.status != SA_STD_OK { panic(62151); };
    if h1.port != 80 { panic(62152); };
    let h2 = dns_services_scan(&csl, &nw, &pt, 0, 0);
    if h2.status != SA_STD_OK { panic(62153); };
    if h2.port != 80 { panic(62154); };
    let h3 = dns_services_scan(&csl, &nhs, &pu, 0, 0);
    if h3.status != SA_STD_ERR_NOT_FOUND { panic(62155); };
    let h4 = dns_services_scan(&csl, &ns, &pa, 0, 0);
    if h4.status != SA_STD_OK { panic(62156); };
    if h4.port != 22 { panic(62157); };
    let h5 = dns_services_scan(&csl, &pa, &pt, 443, 1);
    if h5.status != SA_STD_OK { panic(62158); };
    if !reg1_veq(&h5.name, "https") { panic(62159); };
    if h5.port != 443 { panic(62160); };
    let h6 = dns_services_scan(&csl, &pa, &pt, 9999, 1);
    if h6.status != SA_STD_ERR_NOT_FOUND { panic(62161); };
    if h6.port != 0 { panic(62162); };
    if len(h6.name) != 0 { panic(62163); };
}

@test "reg1 dns reverse name v4"() {
    let r1 = dns_reverse_name_v4(16909060);
    if !reg1_veq(&r1, "4.3.2.1.in-addr.arpa") { panic(62171); };
    let r2 = dns_reverse_name_v4(3232235777);
    if !reg1_veq(&r2, "1.1.168.192.in-addr.arpa") { panic(62172); };
    let r3 = dns_reverse_name_v4(0);
    if !reg1_veq(&r3, "0.0.0.0.in-addr.arpa") { panic(62173); };
    let r4 = dns_reverse_name_v4(4294967295);
    if !reg1_veq(&r4, "255.255.255.255.in-addr.arpa") { panic(62174); };
}

