@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 9 行左部 N(9,1)=36，N(9,2)=336，N(9,3)=1176（商式，同式再上一位）。
// 意对标 718_nar8（n=8 版互补；849 做商表对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(9, 1), nar(9, 2), nar(9, 3));
    return 0;
}

@test "basic 846 nar9"() {
    if nar(9, 1) != 36 { panic(84601); };
    if nar(9, 2) != 336 { panic(84602); };
    if nar(9, 3) != 1176 { panic(84603); };
    if nar(8, 2) != 196 { panic(84604); };
}
