@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 换零钱计数：硬币 {1,2,5} 凑出 n 的方案数（amount 6→5 种，10→10 种）。
// 意对标 527 oddpart（同为完全背包 DP；此处硬币为有限面值集）。

fn coin_ways(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    let s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    k = 2;
    s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    k = 5;
    s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    return dp[n];
}

fn main() -> i32 {
    println("{},{}", coin_ways(6), coin_ways(10));
    return 0;
}

@test "basic 529 coinchange"() {
    if coin_ways(6) != 5 { panic(52901); };
    if coin_ways(10) != 10 { panic(52902); };
    if coin_ways(1) != 1 { panic(52903); };
}
