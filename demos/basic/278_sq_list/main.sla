@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 141_sum_sq 的表版（27 为总额版：1–5 平方表，末项 25）。
// 逐项平方入表（237 的滚动口径之平方版）。

fn main() -> i32 {
    let sqs: Vec<i32> = Vec::new();
    let q = 1;
    while q <= 5 {
        sqs.push(q * q);
        q = q + 1;
    }
    println("{},{}", len(sqs), sqs[4]);
    return 0;
}

@test "basic 278 sq list"() {
    let sqs: Vec<i32> = Vec::new();
    let q = 1;
    while q <= 5 {
        sqs.push(q * q);
        q = q + 1;
    }
    if len(sqs) != 5 { panic(27801); };
    if sqs[4] != 25 { panic(27802); };
    if sqs[0] != 1 { panic(27803); };
}
