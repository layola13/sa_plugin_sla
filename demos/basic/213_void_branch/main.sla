@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 675_void_branch：分支内 void 调用（真分支打印 7，主流程打印 1）。

fn f() {
    println("{}", 7);
}

fn main() -> i32 {
    let b = true;
    if b {
        f();
    };
    println("{}", 1);
    return 0;
}

@test "basic 213 void branch"() {
    let b = true;
    if b {
        f();
    };
}
