@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Delannoy 三向对峙（格路递推 vs 二项和 vs 中央递推：D(3,3)=63）。
// 意对标 464 双边版的三向版（461 互补）。

fn del_rec(m: int, n: int) -> int {
    if m == 0 { return 1; };
    if n == 0 { return 1; };
    return del_rec(m - 1, n) + del_rec(m - 1, n - 1) + del_rec(m, n - 1);
}

fn pow_int(base: int, exp: int) -> int {
    let r = 1;
    let i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}

fn binom(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn del_sum(m: int, n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        if k <= n {
            s = s + binom(m, k) * binom(n, k) * pow_int(2, k);
        };
        k = k + 1;
    }
    return s;
}

fn del_central(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 3; };
    return (3 * (2 * n - 1) * del_central(n - 1) - (n - 1) * del_central(n - 2)) / n;
}

fn main() -> i32 {
    println("{},{},{}", del_rec(3, 3), del_sum(3, 3), del_central(3));
    return 0;
}

@test "basic 465 tri delannoy"() {
    if del_rec(3, 3) != 63 { panic(46501); };
    if del_sum(3, 3) != 63 { panic(46502); };
    if del_central(3) != 63 { panic(46503); };
    if del_central(2) != 13 { panic(46504); };
    if del_rec(3, 3) != del_central(3) { panic(46505); };
}
