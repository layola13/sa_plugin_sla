@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类三向：建表行和 × 递归行和 × 阶乘（n=7：5040 三锁）。
// 意对标 687_stir1_row7（行源互补；605 三向体例收束一类续高位族）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rcs(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rcs(n - 1, k - 1) + (n - 1) * rcs(n - 1, k);
}

fn csum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + cst(n, k);
        k = k + 1;
    }
    return s;
}

fn rsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + rcs(n, k);
        k = k + 1;
    }
    return s;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", csum(7), rsum(7), fact(7));
    return 0;
}

@test "basic 695 tri stir1"() {
    if csum(7) != 5040 { panic(69501); };
    if rsum(7) != 5040 { panic(69502); };
    if fact(7) != 5040 { panic(69503); };
    if csum(6) != 720 { panic(69504); };
}
