@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 983_math_aux 的 log10 部（2）。
// SLA 尚无 `Math.log10`（`sqrt` 见 117 同类），用循环除数表达；
// `sign` 部见 118，此处只取 log10。

fn ilog10(n: i32) -> i32 {
    let c = 0;
    let x = n;
    while x >= 10 {
        x = x / 10;
        c = c + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", ilog10(100), ilog10(9), ilog10(1000));
    return 0;
}

@test "basic 157 ilog10"() {
    if ilog10(100) != 2 { panic(15701); };
    if ilog10(9) != 0 { panic(15702); };
    if ilog10(1000) != 3 { panic(15703); };
    if ilog10(1) != 0 { panic(15704); };
}
