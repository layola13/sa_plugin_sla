@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类第 7 行 1,63,301,350,140,21,1（行和 877=Bell(7)；行和循环求和）。
// 意对标 696_stir27（单格版互补；同式行复算）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn bsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", svt(7, 2), svt(7, 3), bsum(7));
    return 0;
}

@test "basic 697 stir2 row7"() {
    if svt(7, 2) != 63 { panic(69701); };
    if svt(7, 3) != 301 { panic(69702); };
    if bsum(7) != 877 { panic(69703); };
    if svt(7, 7) != 1 { panic(69704); };
}
