@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Vec 扫描最大（134 为标量函数版：9）。
// 首元播种 + 动态界扫描（215 口径）组合。

fn main() -> i32 {
    let w: Vec<i32> = Vec::new();
    w.push(5);
    w.push(1);
    w.push(9);
    w.push(3);
    let m = w[0];
    for i in 1..len(w) {
        if w[i] > m { m = w[i]; };
    }
    println("{}", m);
    return 0;
}

@test "basic 250 vec max"() {
    let w: Vec<i32> = Vec::new();
    w.push(5);
    w.push(1);
    w.push(9);
    w.push(3);
    let m = w[0];
    for i in 1..len(w) {
        if w[i] > m { m = w[i]; };
    }
    if m != 9 { panic(25001); };
}
