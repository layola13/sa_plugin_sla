@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Harshad 数（n % dsum(n)==0；<=20 有 13 个）。
// 意对标 406 数位和的整除版（406 互补；415 做对峙）。

fn dsum(n: int) -> int {
    let s = 0;
    let m = n;
    while m > 0 {
        s = s + m % 10;
        m = m / 10;
    }
    return s;
}

fn is_harshad(n: int) -> int {
    if n < 1 { return 0; };
    if n % dsum(n) == 0 { return 1; };
    return 0;
}

fn harshad_count(limit: int) -> int {
    let c = 0;
    let k = 1;
    while k <= limit {
        if is_harshad(k) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn main() -> i32 {
    println("{},{},{}", is_harshad(18), is_harshad(19), harshad_count(20));
    return 0;
}

@test "basic 410 harshad"() {
    if is_harshad(18) != 1 { panic(41001); };
    if is_harshad(19) != 0 { panic(41002); };
    if harshad_count(20) != 13 { panic(41003); };
}
