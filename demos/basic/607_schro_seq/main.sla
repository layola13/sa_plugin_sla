@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Schroder 序列前 5 项 1,2,6,22,90（和 121；前缀和循环求和）。
// 意对标 606_schroder（单值版互补；同式序列复算）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn schseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + sch(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", sch(0), sch(1), schseq(4));
    return 0;
}

@test "basic 607 schro seq"() {
    if schseq(4) != 121 { panic(60701); };
    if sch(0) != 1 { panic(60702); };
    if sch(1) != 2 { panic(60703); };
    if schseq(2) != 9 { panic(60704); };
}
