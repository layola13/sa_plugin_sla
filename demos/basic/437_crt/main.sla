@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 互素模 CRT（x≡2 mod 3，x≡3 mod 5 → x=8）。
// 意对标 344 模逆元的应用版（344 互补）。

fn modinv(a: int, m: int) -> int {
    let t = 0;
    let newt = 1;
    let r = m;
    let newr = a % m;
    while newr != 0 {
        let q = r / newr;
        let tt = t;
        t = newt;
        newt = tt - q * newt;
        let rr = r;
        r = newr;
        newr = rr - q * newr;
    }
    if r > 1 { return 0; };
    if t < 0 { t = t + m; };
    return t;
}

fn crt(a: int, m: int, b: int, n: int) -> int {
    let inv = modinv(m % n, n);
    let t = (b - a) * inv % n;
    return a + m * t;
}

fn main() -> i32 {
    println("{},{},{}", crt(2, 3, 3, 5), crt(1, 4, 2, 7), crt(0, 5, 1, 7));
    return 0;
}

@test "basic 437 crt"() {
    if crt(2, 3, 3, 5) != 8 { panic(43701); };
    if crt(1, 4, 2, 7) != 9 { panic(43702); };
    if crt(0, 5, 1, 7) != 15 { panic(43703); };
    if crt(2, 3, 3, 5) % 3 != 2 { panic(43704); };
}
