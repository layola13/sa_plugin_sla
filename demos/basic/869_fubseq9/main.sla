@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 序列前缀和 F(0)+…+F(9)=7685706（737 体例续高位）。
// 意对标 866_fub9（单值版互补；同式序列复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn fseq(n: int) -> int {
    let s = 0;
    let i = 0;
    while i <= n {
        s = s + fub(i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", fseq(9), fseq(8));
    return 0;
}

@test "basic 869 fubseq9"() {
    if fseq(9) != 7685706 { panic(86901); };
    if fseq(8) != 598445 { panic(86902); };
    if fseq(7) != 52610 { panic(86903); };
    if fub(9) != 7087261 { panic(86904); };
}
