    let cell = [0u64; 4];
    let rc = sla_std_fs_read_dir_json(STR_PTR("smoke1_fs/dbuf"), STR_LEN("smoke1_fs/dbuf"), 16, &cell[0]);
    if rc != 0 { panic(51640); };
    if cell[0] == 0 { panic(51641); };
    if sla_fs_dir_buffer_len(cell[0]) == 0 { panic(51642); };
    sla_fs_dir_buffer_free(^cell[0]);
}

@test "smoke1 sa_fs_dir_buffer_free"() {
