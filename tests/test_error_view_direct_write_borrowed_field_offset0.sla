// View-types stage 1: borrow the offset-0 field, then write THE SAME
// field directly while the borrow is live and used afterwards. The
// checker must reject the direct write with a BorrowConflict
// diagnostic. (The nonzero-offset sibling case is
// test_error_view_direct_write_borrowed_field.sla.) Before stage 1
// only the SAB backend rejected this, as a side effect of locking
// the whole root allocation for offset-0 borrows; the text backend
// accepted it silently.
struct Pair { a: i64, b: i64 }

fn bad_direct_write_borrowed_offset0() {
    let s = Pair { a: 1, b: 2 };
    let x = &s.a;
    s.a = 30;
    *x = 10;
}

fn main() -> i32 {
    bad_direct_write_borrowed_offset0();
    return 0;
}
