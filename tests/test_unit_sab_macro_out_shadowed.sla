@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/vec.sa"
@import "sa_std/alloc/vec.sa"
@import "sa_std/status.sla"

// Regression (DEF-PROXY-TUNNEL): on the SAB backend, an imported
// macro's assigned output (SLICE_GET) into a local whose name was
// already bound earlier in the same function silently lost its
// store: genImportedMacroLeadingOutputArg resolved the destination
// through bindingReg, which invents a fresh temporary for a
// multiply-bound name, so the slot check missed and the value went
// to the rebind path while every read of the binding goes through
// its stack slot. The first test is the proxy_read_head shape
// (byte loop binding `b`, then a parse loop whose SLICE_GET target
// is also named `b`); it failed on SAB before the fix (every
// read-back byte stale) and passed on the text backend. The second
// test is the same collision across two plain scopes. Panic codes
// 815xx.

@test "sab macro out shadowed read head shape"() {
    let s: String = format("HTTP/1.1 200 Connection Established\r\n\r\n");
    let sp: ptr = STR_PTR(s);
    let n: u64 = len(s) as u64;
    let head: Vec<u8> = Vec::new();
    let matched: u64 = 0;
    let idx: u64 = 0;
    while matched < 4 {
        if idx >= n { panic(81501); };
        let b: u8 = PTR_BYTE_AT(sp, idx);
        idx = idx + 1;
        head.push(b);
        if matched == 0 {
            if b == 13 { matched = 1; };
        } else {
            if matched == 1 {
                if b == 10 {
                    matched = 2;
                } else {
                    if b != 13 { matched = 0; };
                };
            } else {
                if matched == 2 {
                    if b == 13 {
                        matched = 3;
                    } else {
                        matched = 0;
                    };
                } else {
                    if b == 10 {
                        matched = 4;
                    } else {
                        if b == 13 {
                            matched = 1;
                        } else {
                            matched = 0;
                        };
                    };
                };
            };
        };
    }
    if len(head) != 39 { panic(81502); };
    let sl: Slice<u8> = VEC_AS_SLICE(head);
    let j: u64 = 0;
    while j < n {
        let b: u8 = 0;
        SLICE_GET(b, sl, j);
        if b != PTR_BYTE_AT(sp, j) { panic(81600 + (j as i32)); };
        j = j + 1;
    }
}

@test "sab macro out shadowed two scopes"() {
    let v: Vec<u8> = Vec::new();
    let i: u64 = 0;
    while i < 4 {
        let b: u8 = (i as u8) + 30;
        v.push(b);
        i = i + 1;
    }
    let sl: Slice<u8> = VEC_AS_SLICE(v);
    let b: u8 = 0;
    SLICE_GET(b, sl, 2);
    if b != 32 { panic(81511); };
    let j: u64 = 0;
    while j < 4 {
        let b: u8 = 0;
        SLICE_GET(b, sl, j);
        if b != ((j as u8) + 30) { panic(81700 + (j as i32)); };
        j = j + 1;
    }
}
