@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 循环×公式×递归三向三角数对峙（71×245×rec：10→55=55=55）。
// 双向已见 295，此处加递归版收束三向。

fn tri_loop(n: int) -> int {
    let t = 0;
    for i in 1..(n + 1) {
        t = t + i;
    }
    return t;
}

fn tri_form(n: int) -> int {
    return n * (n + 1) / 2;
}

fn tri_rec(n: int) -> int {
    if n <= 0 { return 0; };
    return n + tri_rec(n - 1);
}

fn main() -> i32 {
    println("{},{},{}", tri_loop(10), tri_form(10), tri_rec(10));
    return 0;
}

@test "basic 311 tri tri"() {
    if tri_loop(10) != tri_form(10) { panic(31101); };
    if tri_form(10) != tri_rec(10) { panic(31102); };
    if tri_rec(10) != 55 { panic(31103); };
}
