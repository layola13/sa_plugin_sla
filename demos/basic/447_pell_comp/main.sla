@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Pell 伴随数（Q(5)=82，Q(3)=14）。
// 意对标 443 Pell 的伴随版（443 互补）。

fn pell_q(n: int) -> int {
    if n == 0 { return 2; };
    if n == 1 { return 2; };
    let a = 2;
    let b = 2;
    let i = 1;
    while i < n {
        let t = 2 * b + a;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}

fn main() -> i32 {
    println("{},{},{}", pell_q(5), pell_q(3), pell_q(0));
    return 0;
}

@test "basic 447 pell comp"() {
    if pell_q(5) != 82 { panic(44701); };
    if pell_q(3) != 14 { panic(44702); };
    if pell_q(0) != 2 { panic(44703); };
}
