@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/vec.sa"

// F-perf-2 runtime guard: owned String/Vec values dropped in loops must
// be freed deeply (buffer + struct) on every path exercised here --
// by-value params that are only viewed, per-iteration locals, and
// reassignment predecessors. A shallow or missing drop leaks the heap
// buffer on every iteration; a misplaced deep drop double-frees and the
// referee traps. The emission-level regressions live in plugin_tests.zig
// ("frees owned String and Vec params deeply" / "frees owned String
// values deeply"); this file keeps the runtime behaviour pinned.

fn view_only(text: String) -> u64 {
    let n: u64 = len(text);
    return n;
}

fn accumulate(p: ptr, n: u64) -> String {
    let out: String = format("");
    let i: u64 = 0;
    while i < n {
        let one: [u8; 1] = [PTR_BYTE_AT(p, i)];
        let s: String = one.iter().collect<String>();
        out = format("{}{}", out, s);
        i = i + 1;
    }
    return out;
}

fn sumv(v: Vec<i32>) -> i64 {
    let total: i64 = 0;
    let i: i64 = 0;
    let cnt = len(v) as i64;
    while i < cnt {
        total = total + (v[i] as i64);
        i = i + 1;
    }
    return total;
}

@test "string and vec drops in a loop stay sound"() {
    let p: ptr = STR_PTR("127.0.0.1");
    let k: i32 = 0;
    while k < 20000 {
        let built: String = accumulate(p, 9);
        if view_only(built) != 9 { panic(25031); };
        let values: Vec<i32> = Vec::new();
        values.push(4);
        values.push(5);
        values.push(6);
        if sumv(values) != 15 { panic(25032); };
        k = k + 1;
    }
}
