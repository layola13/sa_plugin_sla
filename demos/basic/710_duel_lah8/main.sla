@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 高位对峙：建表 vs 商式（(8,3)：141120 对 141120；(8,4)：58800 对 58800）。
// 意对标 708_lah8 × 709_duel_lah7（高位源与对峙体例合流）。

fn ltb(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm + nn - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn lahq(n: int, k: int) -> int {
    if k == 0 { return 0; };
    return binom_mul(n - 1, k - 1) * fact(n) / fact(k);
}

fn main() -> i32 {
    println("{},{},{},{}", ltb(8, 3), lahq(8, 3), ltb(8, 4), lahq(8, 4));
    return 0;
}

@test "basic 710 duel lah8"() {
    if ltb(8, 3) != 141120 { panic(71001); };
    if lahq(8, 3) != 141120 { panic(71002); };
    if ltb(8, 4) != 58800 { panic(71003); };
    if lahq(8, 4) != 58800 { panic(71004); };
}
