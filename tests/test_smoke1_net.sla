@test "smoke1 sa_std_net_udp_send_to"() {
    let a = s1_udp(59520);
    let b = s1_udp(59521);
    let bport = s1_udp_port(b, 59522);
    let wr = [0u64; 4];
    let rc = sla_std_net_udp_send_to(a, STR_PTR("to"), STR_LEN("to"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (bport as u32), &wr[0]);
    if rc != 0 { panic(59523); };
    if wr[0] != 2 { panic(59524); };
    let buf = [0u8; 64];
