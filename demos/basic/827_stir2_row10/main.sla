@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类第 10 行 1,511,9330,34105,42525,22827,5880,750,45,1（行和 115975=Bell(10)）。
// 意对标 826_stir29（单格版互补；同式行复算）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn srow(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + sst(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", sst(10, 5), sst(10, 6), srow(10));
    return 0;
}

@test "basic 827 stir2 row10"() {
    if sst(10, 5) != 42525 { panic(82701); };
    if sst(10, 6) != 22827 { panic(82702); };
    if srow(10) != 115975 { panic(82703); };
    if sst(9, 5) != 6951 { panic(82704); };
}
