@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sa"

// 对标 tsgosa 10_strings / 16_template：格式化输出 + 字符串相等。
// 已修复（POTENTIAL_ISSUES #3/#5）：无注解 `let s = "hello"` 绑定既可
// `str_eq` 断言（SAB 走 Slice 直通）又可 `println` 打印；显式 `: ptr`
// 绑定持有真正的 C 字符串，两条消费路径同样全绿，不再需要双绑定绕行。

fn main() -> i32 {
    let s = "hello";
    println("{}", s);
    println("{} world", s);
    println("hi {}, n={}!", "sa", 3);
    return 0;
}

@test "basic 10 strings format eq"() {
    let s = "hello";
    if !str_eq(s, "hello") { panic(1001); };
    if str_eq(s, "world") { panic(1002); };
    println("{}", s);
    println("{} world", s);
    let name = "sa";
    let n = 3;
    println("hi {}, n={}!", name, n);
    // 显式 : ptr 绑定同样双绿（持有 NUL 结尾 C 字符串）。
    let a: ptr = "hello";
    if !str_eq(a, "hello") { panic(1003); };
    println("{}", a);
}
