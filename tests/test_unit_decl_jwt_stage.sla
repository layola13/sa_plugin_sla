@import "sa_std/jwt.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/status.sla"

// DEF-DECL-REST carrier: SAB registry declared entry jwt_stage
// from sa_std/jwt.sla (stages a byte vector into a raw buffer in
// 256-byte chunks; the buffer-staging step every jwt verify path
// starts from). Asserted byte-exact over a 600-byte pattern that
// crosses two chunk boundaries, with the byte past the staged
// region checked untouched. The sibling entries jwt_split /
// jwt_verify_hs256 / jwt_verify_rs256 are WITHHELD: jwt_split
// segfaults on both backends at the pinned head for any
// well-formed token (measured in this line's probes; the verify
// entries call jwt_split first), registered as a defect in the
// line's RESULT. Panic codes 686xx.

@test "decl jwt stage roundtrip"() {
    let v: Vec<u8> = Vec::new();
    let i: u64 = 0;
    while i < 600 {
        v.push((i % 251) as u8);
        i = i + 1;
    }
    let buf = [0u8; 1024];
    jwt_stage(PTR_BYTE_ADD(&buf, 0), &v);
    let j: u64 = 0;
    while j < 600 {
        if PTR_BYTE_AT(&buf, j) != ((j % 251) as u8) { panic(68601); };
        j = j + 1;
    }
    if PTR_BYTE_AT(&buf, 600) != 0 { panic(68602); };
    // empty input stages nothing
    let empty: Vec<u8> = Vec::new();
    let buf2 = [7u8; 16];
    jwt_stage(PTR_BYTE_ADD(&buf2, 0), &empty);
    if PTR_BYTE_AT(&buf2, 0) != 7 { panic(68603); };
}
