@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 续对称性：D(8,2)=D(2,8)=145，D(8,5)=D(5,8)=13073（镜像双算一致）。
// 意对标 886_delan8（单格版互补；行列镜像互锁，761 体例续高位）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn main() -> i32 {
    println("{},{},{},{}", delan(8, 2), delan(2, 8), delan(8, 5), delan(5, 8));
    return 0;
}

@test "basic 891 delan sym8"() {
    if delan(8, 2) != 145 { panic(89101); };
    if delan(2, 8) != 145 { panic(89102); };
    if delan(8, 5) != 13073 { panic(89103); };
    if delan(5, 8) != 13073 { panic(89104); };
}
