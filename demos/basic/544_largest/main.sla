@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 最大部恰为 k 的分拆数 P(n,k)：P(n,k)=P(n-1,k-1)+P(n-k,k)
//（P(10,3)=8，P(8,2)=4，P(7,3)=4；拍扁二维表，545 做行和三向）。
// 意对标 531 stirling2（同为拍扁加权递推；此处权为 0/1 选择）。

fn largest_exact(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - kk) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", largest_exact(10, 3), largest_exact(8, 2), largest_exact(7, 3));
    return 0;
}

@test "basic 544 largest"() {
    if largest_exact(10, 3) != 8 { panic(54401); };
    if largest_exact(8, 2) != 4 { panic(54402); };
    if largest_exact(7, 3) != 4 { panic(54403); };
    if largest_exact(5, 5) != 1 { panic(54404); };
}
