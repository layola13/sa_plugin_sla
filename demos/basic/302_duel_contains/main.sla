@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 谓词包含 vs 下标查找对峙（39×116：命中 1=1，未中 0=0）。
// 双实现一致性锁定（单实现见 39/116）。

fn vec_contains(values: Vec<i32>, target: i32) -> bool {
    let i: i32 = 0;
    while i < len(values) as i32 {
        if values[i] == target {
            return true;
        };
        i = i + 1;
    }
    return false;
}

fn index_of(a: [int; 4], v: int) -> int {
    let i = 0;
    while i < 4 {
        if a[i] == v { return i; };
        i = i + 1;
    }
    return -1;
}

fn main() -> i32 {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    let c = if vec_contains(v, 2) { 1 } else { 0 };
    let d = if index_of([1, 2, 3, 4], 2) != -1 { 1 } else { 0 };
    println("{},{}", c, d);
    return 0;
}

@test "basic 302 duel contains"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    if vec_contains(v, 2) != (index_of([1, 2, 3, 4], 2) != -1) { panic(30201); };
    if vec_contains(v, 9) != (index_of([1, 2, 3, 4], 9) != -1) { panic(30202); };
}
