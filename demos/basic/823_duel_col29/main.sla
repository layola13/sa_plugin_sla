@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 2 列对峙：建表 vs 递归（(8,2)：13068 对 13068；(9,2)：109584 对 109584）。
// 意对标 822_stir1_col29 × 819_duel_stir19（列源与对峙体例合流）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rcs(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rcs(n - 1, k - 1) + (n - 1) * rcs(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", cst(8, 2), rcs(8, 2), cst(9, 2), rcs(9, 2));
    return 0;
}

@test "basic 823 duel col29"() {
    if cst(8, 2) != 13068 { panic(82301); };
    if rcs(8, 2) != 13068 { panic(82302); };
    if cst(9, 2) != 109584 { panic(82303); };
    if rcs(9, 2) != 109584 { panic(82304); };
}
