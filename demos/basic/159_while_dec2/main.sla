@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1050_while_dec：步长 2 倒数求和（9）。
// 与 158 互补（初值/步长不同：5+3+1；158 为 10+7+4+1）。

fn main() -> i32 {
    let i = 5;
    let t = 0;
    while i > 0 {
        t = t + i;
        i = i - 2;
    }
    println("{}", t);
    return 0;
}

@test "basic 159 while dec2"() {
    let i = 5;
    let t = 0;
    while i > 0 {
        t = t + i;
        i = i - 2;
    }
    if t != 9 { panic(15901); };
    if i != -1 { panic(15902); };
}
