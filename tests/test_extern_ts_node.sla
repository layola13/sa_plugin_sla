    if col != 10 { panic(93448); };
    let decl: u64 = 0;
    if sla_ts_node_child(root, 0, 1, &decl) != 0 { panic(93449); };
    if sla_ts_node_end_point(decl, &row, &col) != 0 { panic(93450); };
    if row != 0 { panic(93451); };
    if col != 10 { panic(93452); };
    sla_ts_node_free(^decl);
    sla_ts_node_free(^root);
    sla_ts_tree_free(^tree);
    sla_ts_parser_free(^parser);
}

@test "extern ts sa_ts_node_free"() {
    if sla_ts_available() != 1 { panic(93461); };
    let parser: u64 = 0;
    if sla_ts_parser_new(&parser) != 0 { panic(93462); };
    if sla_ts_parser_set_language(parser, STR_PTR("typescript"), STR_LEN("typescript")) != 0 { panic(93463); };
    let tree: u64 = 0;
    if sla_ts_parse(parser, STR_PTR("let x = 1;"), STR_LEN("let x = 1;"), &tree) != 0 { panic(93464); };
    let root: u64 = 0;
    if sla_ts_tree_root(tree, &root) != 0 { panic(93465); };
    let decl: u64 = 0;
    if sla_ts_node_child(root, 0, 1, &decl) != 0 { panic(93466); };
    let rc: i32 = sla_ts_node_free(^decl);
    if rc != 0 { panic(93467); };
    let rc2: i32 = sla_ts_node_free(^root);
    if rc2 != 0 { panic(93468); };
    sla_ts_tree_free(^tree);
    sla_ts_parser_free(^parser);
}
