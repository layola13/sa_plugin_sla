@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 序列前 10 项和 1374（M(8)=323，M(9)=835；前缀和循环求和）。
// 意对标 746_motz9（单值版互补；同式序列复算）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn mozseq(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + moz(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", moz(8), moz(9), mozseq(9));
    return 0;
}

@test "basic 747 motz seq9"() {
    if mozseq(9) != 1374 { panic(74701); };
    if moz(8) != 323 { panic(74702); };
    if moz(9) != 835 { panic(74703); };
    if mozseq(5) != 38 { panic(74704); };
}
