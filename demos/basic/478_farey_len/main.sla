@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Farey 序列长度（|F(5)|=11，|F(8)|=23）。
// 意对标 373 素数计数的互素版（373 互补；482 做对峙）。

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn phi(n: int) -> int {
    if n <= 1 { return 1; };
    let c = 0;
    let k = 1;
    while k < n {
        if gcd(k, n) == 1 { c = c + 1; };
        k = k + 1;
    }
    return c;
}

fn farey_len(n: int) -> int {
    let s = 1;
    let m = 1;
    while m <= n {
        s = s + phi(m);
        m = m + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", farey_len(5), farey_len(8), farey_len(1));
    return 0;
}

@test "basic 478 farey len"() {
    if farey_len(5) != 11 { panic(47801); };
    if farey_len(8) != 23 { panic(47802); };
    if farey_len(1) != 2 { panic(47803); };
}
