@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 双实现对峙：建表 vs 交错和（(4,2)：230 对 230；(5,2)：1682 对 1682）。
// 交错和 B(n,m)=sum (-1)^k C(n+1,k)(2(m-k)+1)^n（(5,2)：3125-1458+15=1682）。
// 意对标 676_eulb × 交错和版（两源单实现见各源；286 系对峙体例）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn pwr(b: int, e: int) -> int {
    let r = 1;
    let i = 0;
    while i < e {
        r = r * b;
        i = i + 1;
    }
    return r;
}

fn eba(n: int, m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= m {
        let term = binom_mul(n + 1, k) * pwr(2 * (m - k) + 1, n);
        if k % 2 == 0 { s = s + term; } else { s = s - term; };
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", eub(4, 2), eba(4, 2), eub(5, 2), eba(5, 2));
    return 0;
}

@test "basic 679 duel eulb"() {
    if eub(4, 2) != 230 { panic(67901); };
    if eba(4, 2) != 230 { panic(67902); };
    if eub(5, 2) != 1682 { panic(67903); };
    if eba(5, 2) != 1682 { panic(67904); };
}
