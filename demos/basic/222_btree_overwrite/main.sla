@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/btree_map.sa"
@import "sa_std/core/option.sa"

// 对标 tsgosa 132_map_count 的 BTree 版（102 为 HashMap 版）：
// 取-加-存覆写（11）+ 表长不变（2）。
// 键须为字符串（int 键已转 loud 门，见 #30）。

fn main() -> i32 {
    let m = BTreeMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let cur = m.get("a").copied().unwrap_or_default();
    m.insert("a", cur + 10);
    println("{},{},{}", m.get("a").copied().unwrap_or_default(), m.get("b").copied().unwrap_or_default(), len(m));
    return 0;
}

@test "basic 222 btree overwrite"() {
    let m = BTreeMap::new();
    m.insert("a", 1);
    m.insert("b", 2);
    let cur = m.get("a").copied().unwrap_or_default();
    m.insert("a", cur + 10);
    if m.get("a").copied().unwrap_or_default() != 11 { panic(22201); };
    if m.get("b").copied().unwrap_or_default() != 2 { panic(22202); };
    if len(m) != 2 { panic(22203); };
}
