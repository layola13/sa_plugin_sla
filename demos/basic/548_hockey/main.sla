@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// hockey-stick 恒等式 Σ_{i=k}^{n} C(i,k) = C(n+1,k+1)
//（k=1,n=5→15；k=2,n=6→35；k=3,n=7→70；551 做查表对峙）。
// 意对标 547 rowsum（横向求和版互补；此处为对角求和）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn hockey(k: int, n: int) -> int {
    let s = 0;
    let i = k;
    while i <= n {
        s = s + binom(i, k);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", hockey(1, 5), hockey(2, 6), hockey(3, 7));
    return 0;
}

@test "basic 548 hockey"() {
    if hockey(1, 5) != 15 { panic(54801); };
    if hockey(2, 6) != 35 { panic(54802); };
    if hockey(3, 7) != 70 { panic(54803); };
}
