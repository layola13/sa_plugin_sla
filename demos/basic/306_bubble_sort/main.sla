@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 73_bubble_sort：冒泡排序（首 1 末 5，中 3）。
// 第三种手排（16 插入/262 选择/98 拷贝；`sort` 方法暂无）。

fn main() -> i32 {
    let s = [3, 1, 4, 1, 5];
    let i = 0;
    while i < 4 {
        let j = 0;
        while j < 4 - i {
            if s[j] > s[j + 1] {
                let t = s[j];
                s[j] = s[j + 1];
                s[j + 1] = t;
            };
            j = j + 1;
        }
        i = i + 1;
    }
    println("{},{},{}", s[0], s[2], s[4]);
    return 0;
}

@test "basic 306 bubble sort"() {
    let s = [3, 1, 4, 1, 5];
    let i = 0;
    while i < 4 {
        let j = 0;
        while j < 4 - i {
            if s[j] > s[j + 1] {
                let t = s[j];
                s[j] = s[j + 1];
                s[j + 1] = t;
            };
            j = j + 1;
        }
        i = i + 1;
    }
    if s[0] != 1 { panic(30601); };
    if s[2] != 3 { panic(30602); };
    if s[4] != 5 { panic(30603); };
}
