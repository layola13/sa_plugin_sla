@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 对称性：N(7,2)=N(7,4)=105，N(8,1)=N(8,6)=28（镜像双算一致）。
// 意对标 716_nar7（单格版互补；行列镜像互锁，601 体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{},{}", nar(7, 2), nar(7, 4), nar(8, 1), nar(8, 6));
    return 0;
}

@test "basic 721 nar sym"() {
    if nar(7, 2) != 105 { panic(72101); };
    if nar(7, 4) != 105 { panic(72102); };
    if nar(8, 1) != 28 { panic(72103); };
    if nar(8, 6) != 28 { panic(72104); };
}
