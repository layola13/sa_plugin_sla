@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 奇部数分拆 p_odd(n)：只用奇数部（{1,3,5} 完全背包式 DP）。
// 意对标 526 distinct（互异版互补；Euler 定理断言 q(n)==p_odd(n)，见 534 对峙）。

fn odd_part(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    while k <= n {
        let s = k;
        while s <= n {
            dp[s] = dp[s] + dp[s - k];
            s = s + 1;
        }
        k = k + 2;
    }
    return dp[n];
}

fn main() -> i32 {
    println("{},{},{}", odd_part(5), odd_part(6), odd_part(7));
    return 0;
}

@test "basic 527 oddpart"() {
    if odd_part(5) != 3 { panic(52701); };
    if odd_part(6) != 4 { panic(52702); };
    if odd_part(7) != 5 { panic(52703); };
}
