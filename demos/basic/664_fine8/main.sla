@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 高位三 F(8)=622（F(7)=186 对 186；短递推一步 `[30·234-1674]/18`）。
// 意对标 661_fine7（高位版互补；665 做三向收束）。

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", fsho(7), fsho(8));
    return 0;
}

@test "basic 664 fine8"() {
    if fsho(8) != 622 { panic(66401); };
    if fsho(7) != 186 { panic(66402); };
    if fsho(6) != 57 { panic(66403); };
}
