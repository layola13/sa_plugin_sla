@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 双实现对峙：二项递推 vs Aitken 三角（n=8：4140 对 4140；n=9：21147 对 21147）。
// 意对标 776_bell9 × 三角版（两源单实现见各源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn bt(n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = t[(mm - 1) * w + mm - 1];
        let nn = 1;
        while nn <= mm {
            t[mm * w + nn] = t[mm * w + nn - 1] + t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w];
}

fn main() -> i32 {
    println("{},{},{},{}", bell(8), bt(8), bell(9), bt(9));
    return 0;
}

@test "basic 779 duel bell9"() {
    if bell(8) != 4140 { panic(77901); };
    if bt(8) != 4140 { panic(77902); };
    if bell(9) != 21147 { panic(77903); };
    if bt(9) != 21147 { panic(77904); };
}
