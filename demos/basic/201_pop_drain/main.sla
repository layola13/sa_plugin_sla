@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 1416_pop_cond：`len` 驱动排空求和（5）。
// `pop()` 返回 Option，空表即停（与 141 的 `unwrap` 口径一致）。

fn main() -> i32 {
    let v: Vec<i32> = Vec::new();
    v.push(5);
    let s = 0;
    while len(v) > 0 {
        s = s + v.pop().unwrap();
    }
    println("{}", s);
    return 0;
}

@test "basic 201 pop drain"() {
    let v: Vec<i32> = Vec::new();
    v.push(5);
    let s = 0;
    while len(v) > 0 {
        s = s + v.pop().unwrap();
    }
    if s != 5 { panic(20101); };
    if len(v) != 0 { panic(20102); };
}
