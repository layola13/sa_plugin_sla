@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 楔形数（三不同素数之积：30=2·3·5 是，60=2²·3·5 否）。
// 意对标 386 去重计数的等三版（386 互补）。

fn omega(n: int) -> int {
    if n < 2 { return 0; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        if m % d == 0 {
            c = c + 1;
            while m % d == 0 { m = m / d; }
        };
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    return c;
}

fn is_squarefree(n: int) -> int {
    if n < 1 { return 0; };
    let d = 2;
    while d * d <= n {
        if n % (d * d) == 0 { return 0; };
        d = d + 1;
    }
    return 1;
}

fn is_sphenic(n: int) -> int {
    if omega(n) != 3 { return 0; };
    if is_squarefree(n) != 1 { return 0; };
    return 1;
}

fn main() -> i32 {
    println("{},{},{},{}", is_sphenic(30), is_sphenic(42), is_sphenic(60), is_sphenic(66));
    return 0;
}

@test "basic 416 sphenic"() {
    if is_sphenic(30) != 1 { panic(41601); };
    if is_sphenic(42) != 1 { panic(41602); };
    if is_sphenic(60) != 0 { panic(41603); };
    if is_sphenic(66) != 1 { panic(41604); };
}
