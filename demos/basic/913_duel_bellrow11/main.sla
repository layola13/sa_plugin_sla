@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 行和二对峙：二项递推 vs 二类行和（n=11：678570 对 678570；n=12：4213597 对 4213597）。
// 意对标 912_bell_rowsum11 × 906_bell11（行源与递推源合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn bsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + svt(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", bell(11), bsum(11), bell(12), bsum(12));
    return 0;
}

@test "basic 913 duel bellrow11"() {
    if bell(11) != 678570 { panic(91301); };
    if bsum(11) != 678570 { panic(91302); };
    if bell(12) != 4213597 { panic(91303); };
    if bsum(12) != 4213597 { panic(91304); };
}
