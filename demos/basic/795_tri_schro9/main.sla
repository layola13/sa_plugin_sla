@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 续三向：迭代 × 商式 × 倍小（n=9：206098 三锁）。
// 意对标 786_schro9（单格源互补；775 三向体例收束大续族）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn qsch(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + binom_mul(n + k, k) * binom_mul(n, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn ssho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        t[ii] = ((6 * ii - 3) * t[ii - 1] - (ii - 2) * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn dsch(n: int) -> int {
    return 2 * ssho(n);
}

fn main() -> i32 {
    println("{},{},{}", sch(9), qsch(9), dsch(9));
    return 0;
}

@test "basic 795 tri schro9"() {
    if sch(9) != 206098 { panic(79501); };
    if qsch(9) != 206098 { panic(79502); };
    if dsch(9) != 206098 { panic(79503); };
    if sch(8) != 41586 { panic(79504); };
}
