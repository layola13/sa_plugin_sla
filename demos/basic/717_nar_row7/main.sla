@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 第 7 行 1,21,105,175,105,21,1（行和 429=Catalan(7)；行和循环求和）。
// 意对标 716_nar7（单格版互补；同式行复算）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn nsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k < n {
        s = s + nar(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", nar(7, 1), nar(7, 2), nsum(7));
    return 0;
}

@test "basic 717 nar row7"() {
    if nar(7, 1) != 21 { panic(71701); };
    if nar(7, 2) != 105 { panic(71702); };
    if nsum(7) != 429 { panic(71703); };
    if nar(7, 0) != 1 { panic(71704); };
}
