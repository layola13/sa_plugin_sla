// Smoke wave 1: register-2 externs in sa_std/net.sai (std_ families).
// All chains are loopback-only: 127.0.0.1 listeners with ephemeral
// ports, unix sockets under smoke1_net/. Panic codes 59xxx.
@import "sla_std/wrap/net.sla"
@import "sla_std/wrap/fs.sla"
@import "sla_std/wrap/process.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn s1_listen(code: i32) -> u64 {
    let lh = [0u64; 4];
    let port = [0u64; 4];
    let rc = sla_std_net_tcp_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0, &lh[0], &port[0]);
    if rc != 0 { panic(code); };
    if lh[0] == 0 { panic(code + 1); };
    if port[0] == 0 { panic(code + 2); };
    return lh[0];
}

fn s1_port_of_listener(lh: u64, code: i32) -> u64 {
    let addr = [0u64; 4];
    let rc = sla_std_net_tcp_listener_local_addr(lh, &addr[0]);
    if rc != 0 { panic(code); };
    return (sla_net_addr_port(addr[0]) as u64);
}

// Each test below builds its pair inline: listen on 127.0.0.1:0,
// connect a client, accept on the listener. The three handles live in
// the test's own cells.

@test "smoke1 sa_std_net_tcp_accept"() {
    let lh = s1_listen(59010);
    let port = s1_port_of_listener(lh, 59011);
    let cli = [0u64; 4];
    let rc = sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    if rc != 0 { panic(59012); };
    let srv = [0u64; 4];
    let rc2 = sla_std_net_tcp_accept(lh, &srv[0]);
    if rc2 != 0 { panic(59013); };
    if srv[0] == 0 { panic(59014); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_accept_addr"() {
    let lh = s1_listen(59020);
    let port = s1_port_of_listener(lh, 59021);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    let addr = [0u64; 4];
    let rc = sla_std_net_tcp_accept_addr(lh, &srv[0], &addr[0]);
    if rc != 0 { panic(59022); };
    if srv[0] == 0 { panic(59023); };
    // Accepted addr port == client local port.
    let laddr = [0u64; 4];
    sla_std_net_tcp_stream_local_addr(cli[0], &laddr[0]);
    if (sla_net_addr_port(addr[0]) as u64) != (sla_net_addr_port(laddr[0]) as u64) { panic(59024); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_listener_local_addr"() {
    let lh = [0u64; 4];
    let port = [0u64; 4];
    let rc = sla_std_net_tcp_listen(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0, &lh[0], &port[0]);
    if rc != 0 { panic(59030); };
    let addr = [0u64; 4];
    let rc2 = sla_std_net_tcp_listener_local_addr(lh[0], &addr[0]);
    if rc2 != 0 { panic(59031); };
    if (sla_net_addr_port(addr[0]) as u64) != port[0] { panic(59032); };
    sla_std_close(lh[0]);
}

@test "smoke1 sa_std_net_tcp_stream_write"() {
    let lh = s1_listen(59040);
    let port = s1_port_of_listener(lh, 59041);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let wr = [0u64; 4];
    let rc = sla_std_net_tcp_stream_write(cli[0], STR_PTR("hello"), STR_LEN("hello"), &wr[0]);
    if rc != 0 { panic(59042); };
    if wr[0] != 5 { panic(59043); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rd[0] != 5 { panic(59044); };
    if buf[0] != 104 { panic(59045); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_stream_read"() {
    let lh = s1_listen(59050);
    let port = s1_port_of_listener(lh, 59051);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let wr = [0u64; 4];
    sla_std_net_tcp_stream_write(cli[0], STR_PTR("ping"), STR_LEN("ping"), &wr[0]);
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc = sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rc != 0 { panic(59052); };
    if rd[0] != 4 { panic(59053); };
    if buf[0] != 112 { panic(59054); };
    if buf[3] != 103 { panic(59055); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_stream_peek"() {
    let lh = s1_listen(59060);
    let port = s1_port_of_listener(lh, 59061);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let wr = [0u64; 4];
    sla_std_net_tcp_stream_write(cli[0], STR_PTR("ping"), STR_LEN("ping"), &wr[0]);
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let rc = sla_std_net_tcp_stream_peek(srv[0], &buf[0], 64, &rd[0]);
    if rc != 0 { panic(59062); };
    if rd[0] != 4 { panic(59063); };
    if buf[0] != 112 { panic(59064); };
    // Peek must not consume: a following read returns the same bytes.
    let rc2 = sla_std_net_tcp_stream_read(srv[0], &buf[0], 64, &rd[0]);
    if rc2 != 0 { panic(59065); };
    if rd[0] != 4 { panic(59066); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

@test "smoke1 sa_std_net_tcp_stream_read_vectored"() {
    let lh = s1_listen(59070);
    let port = s1_port_of_listener(lh, 59071);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let wr = [0u64; 4];
    sla_std_net_tcp_stream_write(cli[0], STR_PTR("ping"), STR_LEN("ping"), &wr[0]);
    let b1 = [0u8; 2];
    let b2 = [0u8; 2];
    let iovs = [0u64; 4];
    let p1: u64 = 0;
    let s1bp1: ptr = PTR_BYTE_ADD(&b1, 0);
    PTR_ADDR(p1, s1bp1);
    iovs[0] = p1;
    iovs[1] = 2;
    let p2: u64 = 0;
    let s1bp2: ptr = PTR_BYTE_ADD(&b2, 0);
    PTR_ADDR(p2, s1bp2);
    iovs[2] = p2;
    iovs[3] = 2;
    let rd = [0u64; 4];
    let rc = sla_std_net_tcp_stream_read_vectored(srv[0], &iovs[0], 2, &rd[0]);
    if rc != 0 { panic(59072); };
    if rd[0] != 4 { panic(59073); };
    if b1[0] != 112 { panic(59074); };
    if b2[1] != 103 { panic(59075); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

