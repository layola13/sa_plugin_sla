@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin 续三向：迭代 × 直和 × 桥序和（n=9：835 三锁）。
// 意对标 746_motz9（单格源互补；635 三向体例收束 Motzkin 续高位族）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn cmot(n: int) -> int {
    let s = 0;
    let k = 0;
    while 2 * k <= n {
        s = s + binom_mul(n, 2 * k) * binom_mul(2 * k, k) / (k + 1);
        k = k + 1;
    }
    return s;
}

fn rbr(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    return moz(n - 1) - rbr(n - 1);
}

fn mbri(n: int) -> int {
    return rbr(n) + rbr(n + 1);
}

fn main() -> i32 {
    println("{},{},{}", moz(9), cmot(9), mbri(9));
    return 0;
}

@test "basic 755 tri motz9"() {
    if moz(9) != 835 { panic(75501); };
    if cmot(9) != 835 { panic(75502); };
    if mbri(9) != 835 { panic(75503); };
    if moz(8) != 323 { panic(75504); };
}
