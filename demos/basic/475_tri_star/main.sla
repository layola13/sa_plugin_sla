@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 星形数三向对峙（闭式 vs 三角累加 vs 逆序累加：S(4)=73）。
// 意对标 474 双边版的三向版（472 互补）。

fn star_form(n: int) -> int {
    return 6 * n * (n - 1) + 1;
}

fn tri(n: int) -> int {
    return n * (n + 1) / 2;
}

fn star_acc(n: int) -> int {
    if n <= 1 { return 1; };
    return 1 + 12 * tri(n - 1);
}

fn tri_rev(n: int) -> int {
    let s = 0;
    let k = n;
    while k >= 1 {
        s = s + k;
        k = k - 1;
    }
    return s;
}

fn star_rev(n: int) -> int {
    if n <= 1 { return 1; };
    return 1 + 12 * tri_rev(n - 1);
}

fn main() -> i32 {
    println("{},{},{}", star_form(4), star_acc(4), star_rev(4));
    return 0;
}

@test "basic 475 tri star"() {
    if star_form(4) != 73 { panic(47501); };
    if star_acc(4) != 73 { panic(47502); };
    if star_rev(4) != 73 { panic(47503); };
    if star_form(4) != star_rev(4) { panic(47504); };
}
