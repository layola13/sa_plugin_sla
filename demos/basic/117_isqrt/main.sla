@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 347_math_sqrt：整数开方下取整（4,3,1,10）。
// SLA 尚无 `Math.sqrt`，用循环试乘表达（与 49/52/113 的整数数学主题互补）。

fn isqrt(n: i32) -> i32 {
    let r = 0;
    while (r + 1) * (r + 1) <= n {
        r = r + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{}", isqrt(16), isqrt(15), isqrt(1), isqrt(100));
    return 0;
}

@test "basic 117 isqrt"() {
    if isqrt(16) != 4 { panic(11701); };
    if isqrt(15) != 3 { panic(11702); };
    if isqrt(1) != 1 { panic(11703); };
    if isqrt(100) != 10 { panic(11704); };
    if isqrt(0) != 0 { panic(11705); };
}
