@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 列纵深 N(7,2)=105，N(8,2)=196，N(9,2)=336（第二列上行链）。
// 意对标 846_nar9（单格版互补；853 做列对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", nar(7, 2), nar(8, 2), nar(9, 2));
    return 0;
}

@test "basic 852 nar col29"() {
    if nar(7, 2) != 105 { panic(85201); };
    if nar(8, 2) != 196 { panic(85202); };
    if nar(9, 2) != 336 { panic(85203); };
    if nar(8, 3) != 490 { panic(85204); };
}
