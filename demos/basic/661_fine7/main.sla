@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 高位二 F(7)=186（F(6)=57 对 57；短递推一步 `[26·132-456]/16`）。
// 意对标 658_fine_high（高位版互补；662 做高位二对峙）。

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", fsho(6), fsho(7));
    return 0;
}

@test "basic 661 fine7"() {
    if fsho(7) != 186 { panic(66101); };
    if fsho(6) != 57 { panic(66102); };
    if fsho(5) != 18 { panic(66103); };
}
