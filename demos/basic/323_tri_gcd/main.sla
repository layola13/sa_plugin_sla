@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 取模×减法×Stein 三向 gcd 对峙（17×256×310：25=25=25）。
// 双向已见 286，此处加 Stein 版收束三向（310 的函数复用）。

fn gcd_mod(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn gcd_sub(a: int, b: int) -> int {
    let x = a;
    let y = b;
    while x != y {
        if x > y {
            x = x - y;
        } else {
            y = y - x;
        };
    }
    return x;
}

fn gcd_stein(a: int, b: int) -> int {
    let x = a;
    let y = b;
    let shift = 0;
    while x % 2 == 0 && y % 2 == 0 {
        x = x / 2;
        y = y / 2;
        shift = shift + 1;
    }
    while x != y {
        if x % 2 == 0 {
            x = x / 2;
        } else if y % 2 == 0 {
            y = y / 2;
        } else if x > y {
            x = (x - y) / 2;
        } else {
            y = (y - x) / 2;
        };
    }
    let r = x;
    let i = 0;
    while i < shift {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", gcd_mod(100, 75), gcd_sub(100, 75), gcd_stein(100, 75));
    return 0;
}

@test "basic 323 tri gcd"() {
    if gcd_mod(100, 75) != gcd_sub(100, 75) { panic(32301); };
    if gcd_sub(100, 75) != gcd_stein(100, 75) { panic(32302); };
    if gcd_stein(100, 75) != 25 { panic(32303); };
}
