@test "smoke2 sa_http_websocket_poll_v2"() {
    let h = go s2_ws_echo1(24805 + 65900 * 16777216);
    let ub = [0u8; 64];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_ws_url(24805, ubp);
    sla_time_sleep_ms(100);
    let cl = [0u64; 4];
    if sla_http_client_new_v2(0, PTR_NULL(), 0, &cl[0]) != 0 { panic(65910); };
    let client = (cl[0] as ptr);
    let wc = [0u64; 4];
    if sla_http_client_websocket_connect_v2(client, ubp, ulen, 10000, &wc[0]) != 0 { panic(65911); };
    let ws = (wc[0] as ptr);
    // Idle: per the std contract (sa_http_client.zig websocketPoll),
    // a poll that times out with no events returns a non-ok timeout
    // status, not ok+0. Pin both facts.
    let ev = [0u64; 4];
    if sla_http_websocket_poll_v2(ws, 1, 300, &ev[0]) == 0 { panic(65912); };
    if ev[0] != 0 { panic(65913); };
    let wr = [0u64; 4];
    if sla_http_websocket_write_v2(ws, 1, STR_PTR("poll-ws"), STR_LEN("poll-ws"), &wr[0]) != 0 { panic(65914); };
    if sla_http_websocket_poll_v2(ws, 1, 5000, &ev[0]) != 0 { panic(65915); };
    if ev[0] == 0 { panic(65916); };
    let op = [0u64; 4];
    let dp = [0u64; 4];
    let dl = [0u64; 4];
    if sla_http_websocket_read_v2(ws, 4096, &op[0], &dp[0], &dl[0]) != 0 { panic(65917); };
    sla_http_websocket_close_v2(ws, 1000, STR_PTR(""), 0);
    sla_http_websocket_free_v2(ws);
    sla_http_client_free(client);
    sa_task_join(h);
}

