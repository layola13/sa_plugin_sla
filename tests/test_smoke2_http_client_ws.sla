    let ws = (wc[0] as ptr);
    let wr = [0u64; 4];
    if sla_http_websocket_write_v2(ws, 1, STR_PTR("c2"), STR_LEN("c2"), &wr[0]) != 0 { panic(65952); };
    let ev = [0u64; 4];
