@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 9 行右部 c(9,5)=22449，c(9,6)=4536，c(9,7)=546（右半行复算）。
// 意对标 816_stir19（左部版互补；825 做三向收束）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(9, 5), cst(9, 6), cst(9, 7));
    return 0;
}

@test "basic 824 stir19 right"() {
    if cst(9, 5) != 22449 { panic(82401); };
    if cst(9, 6) != 4536 { panic(82402); };
    if cst(9, 7) != 546 { panic(82403); };
    if cst(9, 8) != 36 { panic(82404); };
}
