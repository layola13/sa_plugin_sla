@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 197_and_or：与/或/非（假，真，真）。
// TS 用整数真值，SLA 中 `&&/||/!` 只接受布尔，故用比较式改写（`&&` 口径见 14）。

fn main() -> i32 {
    let a = 1;
    let b = 0;
    println("{},{},{}", a != 0 && b != 0, a != 0 || b != 0, !(b != 0));
    return 0;
}

@test "basic 92 and or"() {
    let a = 1;
    let b = 0;
    if (a != 0 && b != 0) != false { panic(9201); };
    if (a != 0 || b != 0) != true { panic(9202); };
    if !(b != 0) != true { panic(9203); };
}
