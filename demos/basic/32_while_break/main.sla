@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 110_while_break：while(true) + break/continue，奇数求和 1+3=4。

fn odd_sum_break() -> i32 {
    let i: i32 = 0;
    let t: i32 = 0;
    while true {
        if i >= 5 {
            break;
        };
        if i % 2 == 0 {
            i = i + 1;
            continue;
        };
        t = t + i;
        i = i + 1;
    }
    return t;
}

fn main() -> i32 {
    println("{}", odd_sum_break());
    return 0;
}

@test "basic 32 while break continue"() {
    if odd_sum_break() != 4 { panic(3201); };
}
