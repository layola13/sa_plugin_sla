@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 有序 Bell 续三向：商版递推 × 加权和 × 表版递推（n=9：7087261 三锁）。
// 意对标 866_fub9（商源互补；745 三向体例收束 Fubini 续三行族）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fub(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n, k) * fub(k);
        k = k + 1;
    }
    return s;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fubw(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + fact(k) * svt(n, k);
        k = k + 1;
    }
    return s;
}

fn pbin(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fubp(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + pbin(n, k) * fubp(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", fub(9), fubw(9), fubp(9));
    return 0;
}

@test "basic 875 tri fub9"() {
    if fub(9) != 7087261 { panic(87501); };
    if fubw(9) != 7087261 { panic(87502); };
    if fubp(9) != 7087261 { panic(87503); };
    if fub(8) != 545835 { panic(87504); };
}
