@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 边值 L(9,9)=1，L(9,8)=72=9·8，L(9,7)=2016（对角边恒等 L(n,n-1)=n(n-1)）。
// 意对标 713_lah_edge（低位边值互补；845 做三向收束）。

fn lah(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm + nn - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", lah(9, 9), lah(9, 8), lah(9, 7));
    return 0;
}

@test "basic 841 lah edge9"() {
    if lah(9, 9) != 1 { panic(84101); };
    if lah(9, 8) != 72 { panic(84102); };
    if lah(9, 7) != 2016 { panic(84103); };
    if lah(8, 7) != 56 { panic(84104); };
}
