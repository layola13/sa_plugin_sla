@test "smoke1 sa_std_net_socket_setsockopt_int"() {
    let a = s1_udp(59910);
    let rc = sla_std_net_socket_setsockopt_int(a, 1, 8, 65536);
    if rc != 0 { panic(59911); };
    let out = [0u64; 4];
    sla_std_net_socket_getsockopt_int(a, 1, 8, &out[0]);
    if out[0] < 65536 { panic(59912); };
    sla_std_close(a);
}

