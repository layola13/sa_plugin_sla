@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类续高位对峙：建表 vs 递归（(9,2)：109584 对 109584；(9,3)：118124 对 118124）。
// 意对标 816_stir19 × 递归版（两源单实现见各源；689 体例续高位）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rcs(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rcs(n - 1, k - 1) + (n - 1) * rcs(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", cst(9, 2), rcs(9, 2), cst(9, 3), rcs(9, 3));
    return 0;
}

@test "basic 819 duel stir19"() {
    if cst(9, 2) != 109584 { panic(81901); };
    if rcs(9, 2) != 109584 { panic(81902); };
    if cst(9, 3) != 118124 { panic(81903); };
    if rcs(9, 3) != 118124 { panic(81904); };
}
