}

@test "smoke1 sa_std_net_tcp_stream_set_read_timeout"() {
    let lh = s1_listen(59090);
    let port = s1_port_of_listener(lh, 59091);
    let cli = [0u64; 4];
    sla_std_net_tcp_connect(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (port as u32), &cli[0]);
    let srv = [0u64; 4];
    sla_std_net_tcp_accept(lh, &srv[0]);
    let rc = sla_std_net_tcp_stream_set_read_timeout(srv[0], 2000000000);
    if rc != 0 { panic(59092); };
    let out = [0u64; 4];
    sla_std_net_tcp_stream_read_timeout(srv[0], &out[0]);
    if out[0] == 0 { panic(59093); };
    if out[0] > 2000000000 { panic(59094); };
    sla_std_close(srv[0]);
    sla_std_close(cli[0]);
    sla_std_close(lh);
}

