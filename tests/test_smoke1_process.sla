@test "smoke1 sa_std_pidfd_wait_raw"() {
    let rec = [0u64; 6];
    let x: u64 = 0;
    PTR_ADDR(x, STR_PTR("/bin/sh"));
    rec[0] = x;
    rec[1] = STR_LEN("/bin/sh");
    let y: u64 = 0;
    PTR_ADDR(y, STR_PTR("-c"));
    rec[2] = y;
    rec[3] = STR_LEN("-c");
    let z: u64 = 0;
    PTR_ADDR(z, STR_PTR("exit 3"));
    rec[4] = z;
    rec[5] = STR_LEN("exit 3");
    let cell = [0u64; 4];
    let s1bp6: ptr = PTR_BYTE_ADD(&rec, 0);
    let rc = sla_std_process_spawn_command_ext_pidfd(s1bp6, 3, STR_PTR(""), 0, 0, STR_PTR(""), 0, 0, 0, 0, 0, 1, &cell[0]);
    if rc != 0 { panic(57150); };
    let fd = [0u64; 4];
    sla_std_process_pidfd(cell[0], &fd[0]);
    let raw = [0u64; 4];
    let rc2 = sla_std_pidfd_wait_raw(fd[0], &raw[0]);
    if rc2 != 0 { panic(57151); };
    if raw[0] != 768 { panic(57152); };
    sla_std_process_close(cell[0]);
}

@test "smoke1 sa_std_pidfd_try_wait"() {
