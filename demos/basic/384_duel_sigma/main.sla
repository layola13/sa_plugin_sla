@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 除数和双实现对峙（全量循环 vs 半程+n：σ(12)=28 双边）。
// 意对标 374 素数计数对峙的除数和版（379 三向版互补）。

fn sigma_full(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        if n % i == 0 { s = s + i; };
        i = i + 1;
    }
    return s;
}

fn sigma_half(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n / 2 {
        if n % i == 0 { s = s + i; };
        i = i + 1;
    }
    return s + n;
}

fn main() -> i32 {
    println("{},{}", sigma_full(12), sigma_half(12));
    return 0;
}

@test "basic 384 duel sigma"() {
    if sigma_full(12) != 28 { panic(38401); };
    if sigma_half(12) != 28 { panic(38402); };
    if sigma_full(12) != sigma_half(12) { panic(38403); };
    if sigma_full(6) != 12 { panic(38404); };
}
