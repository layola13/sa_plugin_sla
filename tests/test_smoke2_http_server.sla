@test "smoke2 sa_http_server_accept_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv2(24432, pp, 64660);
    // With no connection queued, a short-timeout accept must fail.
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 200, &aq[0]) == 0 { panic(64663); };
    let cli = s2_raw_conn(pc[0], 64664);
    let req_lit = "GET /a2 HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64665);
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(64666); };
    if aq[0] == 0 { panic(64667); };
    sla_http_server_req_free_v2((aq[0] as ptr));
    sla_std_close(cli);
    sla_http_server_free_v2(srv);
}

fn s2_hist_total(srv: ptr) -> u64 {
    let total: u64 = 0;
    let seg: u32 = 0;
    while seg < 8 {
        let bucket: u32 = 0;
        while bucket < 32 {
            total = total + sla_http_server_hist_v2(srv, seg, bucket);
            bucket = bucket + 1;
        }
        seg = seg + 1;
    }
    return total;
}

fn s2_serve_one_v2(srv: ptr, cli: u64, code: i32) -> void {
    let req_lit = "GET /hist HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v2(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), code);
    let rp = [0u64; 4];
    if sla_http_server_resp_new_v2(req, 200, &rp[0]) != 0 { panic(code + 2); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_send_v2(resp, STR_PTR("h"), STR_LEN("h"), 5000) != 0 { panic(code + 3); };
    sla_http_server_resp_free_v2(resp);
    sla_http_server_req_free_v2(req);
    let buf = [0u8; 256];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_raw_read_all(cli, bp, 256);
}

@test "smoke2 sa_http_server_hist_v2"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
