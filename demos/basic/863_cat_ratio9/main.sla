@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 比值递推高位 C(9)=4862，C(10)=16796，C(11)=58786（逐轮精确整除）。
// 意对标 733_cat_ratio（低位比值版互补；865 做三向收束）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn catf(n: int) -> int {
    return binom_mul(2 * n, n) - binom_mul(2 * n, n + 1);
}

fn rat(n: int) -> int {
    let r = 1;
    let i = 0;
    while i < n {
        r = r * 2 * (2 * i + 1) / (i + 2);
        i = i + 1;
    }
    return r;
}

fn catc(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let i = 0;
    while i < n {
        s = s + catc(i) * catc(n - 1 - i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", rat(9), rat(10), rat(11));
    return 0;
}

@test "basic 863 cat ratio9"() {
    if rat(9) != 4862 { panic(86301); };
    if rat(10) != 16796 { panic(86302); };
    if rat(11) != 58786 { panic(86303); };
    if rat(8) != 1430 { panic(86304); };
}
