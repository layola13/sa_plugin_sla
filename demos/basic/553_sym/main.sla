@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对称性对峙 C(n,k) == C(n,n-k)（C(10,3)=120 对 C(10,7)=120；C(9,2)=36 对 C(9,7)=36）。
// 意对标 546 pascal（单实现见源；表内对称天然成立，双下标互查锁定）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{},{}", binom(10, 3), binom(10, 7), binom(9, 2), binom(9, 7));
    return 0;
}

@test "basic 553 sym"() {
    if binom(10, 3) != 120 { panic(55301); };
    if binom(10, 7) != 120 { panic(55302); };
    if binom(9, 2) != 36 { panic(55303); };
    if binom(9, 7) != 36 { panic(55304); };
    if binom(10, 3) != binom(10, 7) { panic(55305); };
}
