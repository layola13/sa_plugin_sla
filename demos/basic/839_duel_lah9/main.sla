@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 续高位对峙：建表 vs 商式（(9,2)：1451520 对 1451520；(9,3)：1693440 对 1693440）。
// 意对标 836_lah9 × 商式版（两源单实现见各源；709 体例续高位）。

fn lah(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm + nn - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn ccomb(n: int, k: int) -> int {
    if k > n { return 0; };
    if k == 0 { return 1; };
    if k == n { return 1; };
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = 1;
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn qlah(n: int, k: int) -> int {
    return ccomb(n - 1, k - 1) * fact(n) / fact(k);
}

fn main() -> i32 {
    println("{},{},{},{}", lah(9, 2), qlah(9, 2), lah(9, 3), qlah(9, 3));
    return 0;
}

@test "basic 839 duel lah9"() {
    if lah(9, 2) != 1451520 { panic(83901); };
    if qlah(9, 2) != 1451520 { panic(83902); };
    if lah(9, 3) != 1693440 { panic(83903); };
    if qlah(9, 3) != 1693440 { panic(83904); };
}
