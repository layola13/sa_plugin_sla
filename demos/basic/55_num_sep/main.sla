@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 164_num_sep：数字分隔符字面量 `1_000_000`。
// 缺口 #11 已修复：词法保留数字间 `_`，parser 转换点去分隔符
// （十进制/十六进制/浮点/后缀/定长/判别式全覆盖），此处直写分隔符形式。

fn main() -> i32 {
    let x = 1_000_000;
    println("{}", x / 1_000);
    return 0;
}

@test "basic 55 num sep"() {
    let x = 1_000_000;
    if x / 1_000 != 1000 { panic(5501); };
    if 0xFF_FF != 65535 { panic(5502); };
}
