@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fine 高位 F(6)=57（F(5)=18 对 18；短递推一步 `[22·42-126]/14`）。
// 意对标 656_fine（低位版互补；660 做高位对峙）。

fn fsho(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (2 * (2 * ii - 1) * (2 * t[ii - 1] + t[ii - 2]) - t[ii - 1] * (ii + 1)) / (2 * (ii + 1));
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", fsho(5), fsho(6));
    return 0;
}

@test "basic 658 fine high"() {
    if fsho(6) != 57 { panic(65801); };
    if fsho(5) != 18 { panic(65802); };
    if fsho(4) != 6 { panic(65803); };
}
