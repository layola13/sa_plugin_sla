@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Ballot 三向：拍扁建表 × 商式 × 反射差式（(4,2)：9 三锁）。
// 意对标 648_ballot_high（高位源互补；605 三向体例收束 Ballot 族）。

fn btab(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn] + t[mm * w + nn - 1];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bclo(n: int, k: int) -> int {
    return (n - k + 1) * binom_mul(n + k, k) / (n + 1);
}

fn bref(n: int, k: int) -> int {
    if k == 0 { return 1; };
    return binom_mul(n + k, k) - binom_mul(n + k, k - 1);
}

fn main() -> i32 {
    println("{},{},{}", btab(4, 2), bclo(4, 2), bref(4, 2));
    return 0;
}

@test "basic 655 tri ballot"() {
    if btab(4, 2) != 9 { panic(65501); };
    if bclo(4, 2) != 9 { panic(65502); };
    if bref(4, 2) != 9 { panic(65503); };
    if bref(5, 3) != 28 { panic(65504); };
}
