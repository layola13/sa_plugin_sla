@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 续对称性：E(9,1)=E(9,7)=502，E(9,2)=E(9,6)=14608（镜像双算一致）。
// 意对标 916_eul9（单格版互补；行列镜像互锁，801 体例续高位）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{},{}", eul(9, 1), eul(9, 7), eul(9, 2), eul(9, 6));
    return 0;
}

@test "basic 919 eul sym9"() {
    if eul(9, 1) != 502 { panic(91901); };
    if eul(9, 7) != 502 { panic(91902); };
    if eul(9, 2) != 14608 { panic(91903); };
    if eul(9, 6) != 14608 { panic(91904); };
}
