@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1397_loop_var_after：循环外带出末轮值（k=2）。
// 覆盖“循环变量域外不可见时以外层变量带出”写法（与 163 的调用界互补）。

fn main() -> i32 {
    let k = 0;
    for i in 0..3 {
        k = i;
    }
    println("{}", k);
    return 0;
}

@test "basic 200 loop carry"() {
    let k = 0;
    for i in 0..3 {
        k = i;
    }
    if k != 2 { panic(20001); };
}
