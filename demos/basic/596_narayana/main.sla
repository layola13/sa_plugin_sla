@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Narayana 数商式 N(n,k)=C(n,k)·C(n,k+1)/n（先乘后除精确整除）。
// N(4,1)=6，N(4,2)=6，N(5,2)=20（599 做行和对峙）。
// 意对标 586 lah（同为商式族；此处为双二项商式，Catalan 细化）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn narayana(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{}", narayana(4, 1), narayana(4, 2), narayana(5, 2));
    return 0;
}

@test "basic 596 narayana"() {
    if narayana(4, 1) != 6 { panic(59601); };
    if narayana(4, 2) != 6 { panic(59602); };
    if narayana(5, 2) != 20 { panic(59603); };
    if narayana(3, 1) != 3 { panic(59604); };
}
