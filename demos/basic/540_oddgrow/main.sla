@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 奇部数分拆增长段（p_odd(8..10)=6,8,10；527 的高位延续，541 做 Euler 对峙）。
// 意对标 539 qgrow（互异版互补；Euler 定理逐点相等）。

fn odd_part(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    while k <= n {
        let s = k;
        while s <= n {
            dp[s] = dp[s] + dp[s - k];
            s = s + 1;
        }
        k = k + 2;
    }
    return dp[n];
}

fn main() -> i32 {
    println("{},{},{}", odd_part(8), odd_part(9), odd_part(10));
    return 0;
}

@test "basic 540 oddgrow"() {
    if odd_part(8) != 6 { panic(54001); };
    if odd_part(9) != 8 { panic(54002); };
    if odd_part(10) != 10 { panic(54003); };
}
