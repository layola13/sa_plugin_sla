@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 179_div_mod 的减法版（45 为算子版：商 3 余 2）。
// 连减求商余（与 256 的减法口径一致）。

fn main() -> i32 {
    let n = 17;
    let d = 5;
    let q = 0;
    let m = n;
    while m >= d {
        m = m - d;
        q = q + 1;
    }
    println("{},{}", q, m);
    return 0;
}

@test "basic 259 divmod sub"() {
    let n = 17;
    let d = 5;
    let q = 0;
    let m = n;
    while m >= d {
        m = m - d;
        q = q + 1;
    }
    if q != 3 { panic(25901); };
    if m != 2 { panic(25902); };
}
