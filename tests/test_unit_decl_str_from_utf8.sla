@import "sa_std/string.sai"
@import "sa_std/str.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/ptr.sa"

// DEF-STR-UTF8-VALIDATE regression carrier for the declared
// str_from_utf8 surface (sa_std/str.sla).
//
// Layered truth this file pins:
//  * The sa_str_utf8_validate extern itself is correct on its
//    contract input -- a packed byte buffer (ptr, len). The
//    "utf8 validate" matrix below feeds it packed stack arrays
//    and pins the verdict for every boundary class: lead ranges,
//    continuation edges, overlong forms, surrogate halves,
//    truncation, and position discriminators.
//  * str_from_utf8 took a std byte slice (element-addressed; a
//    Vec-backed slice's raw buffer is word-slot strided per the
//    sa_std/vec_packed.sla contract) and handed that raw buffer
//    both to the packed extern (STR_IS_UTF8) and to a raw
//    mem_copy (STRING_BUF_FROM_UTF8_UNCHECKED). Valid multi-byte
//    text was rejected, ASCII-led invalid text was accepted, and
//    an accepted String carried the slots' padding bytes. The
//    "str from utf8" tests below build their slices from Vec<u8>
//    pushes -- the blocked producer -- and pin Ok/Err plus the
//    exact returned bytes.

fn valid_packed(p: ptr, n: u64) -> bool {
    let st: i32 = sa_str_utf8_validate(p, n);
    return st == 0;
}

@test "utf8 validate empty"() {
    let a: [u8; 1] = [0];
    let p: ptr = PTR_BYTE_ADD(&a, 0);
    if valid_packed(p, 0) != true { panic(67401); };
}

@test "utf8 validate ascii_a"() {
    let a: [u8; 1] = [97];
    let p: ptr = PTR_BYTE_ADD(&a, 0);
    if valid_packed(p, 1) != true { panic(67402); };
}

