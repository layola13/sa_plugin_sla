// D9: VM tool surface — the CXU agent code tools distilled.
// Two tools over std surfaces: find_definition (tree-sitter, D7) and
// read_file (fs). Both touch files only through policy-gated opens
// (16_policy): run.sh drives three scenarios — allow-list (tools
// work), deny (first tool call surfaces status 10 and the program
// exits 42), and ask + one-time tokens via SA_POLICY_TOKENS_JSON
// (each file opens exactly once; the deliberate second read of
// lib.ts is denied because its token was consumed).
@import "sa_std/tree_sitter.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/io/print.sai"
@import "byteseq.sa"

struct FileBuf {
    bytes: [u8; 8192],
    len: u64,
}

// One open per file: fs_len is a stat (not an acquisition), the open
// is the policy-gated step, reads ride the open handle.
fn read_once(path: ptr, path_len: u64, buf: &FileBuf) -> i32 {
    let total: u64 = 0;
    let st = sa_std_fs_len(path, path_len, &total);
    if st != 0 {
        return st;
    };
    let fh: u64 = 0;
    let ost = sa_std_fs_open_read(path, path_len, &fh);
    if ost != 0 {
        return ost;
    };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &buf.bytes, 8192, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 {
        return rst;
    };
    buf.len = read_n;
    return 0;
}

fn type_is(node: u64, lit: ptr, lit_len: u64) -> bool {
    let buf = [0u8; 64];
    let len: u64 = 0;
    if sa_ts_node_type(node, &buf, 64, &len) != 0 {
        return false;
    };
    let slot = [0u64; 1];
    BYTES_EQ(&slot, &buf, len, lit, lit_len);
    return slot[0] == 1;
}

fn name_is(node: u64, want: ptr, want_len: u64) -> bool {
    let buf = [0u8; 128];
    let len: u64 = 0;
    if sa_ts_node_text(node, &buf, 128, &len) != 0 {
        return false;
    };
    let slot = [0u64; 1];
    BYTES_EQ(&slot, &buf, len, want, want_len);
    return slot[0] == 1;
}

// Finds a function declaration by name under an export unwrap;
// returns its byte length (end - start), or 0 when absent.
fn decl_span(decl: u64, want: ptr, want_len: u64) -> u64 {
    let name_node: u64 = 0;
    let span: u64 = 0;
    if sa_ts_node_child_by_field(decl, STR_PTR("name"), STR_LEN("name"), &name_node) == 0 && name_node != 0 {
        if name_is(name_node, want, want_len) {
            let s: u32 = 0;
            let e: u32 = 0;
            if sa_ts_node_byte_range(decl, &s, &e) == 0 && e > s {
                span = (e - s) as u64;
            };
        };
        sa_ts_node_free(name_node);
    };
    return span;
}

fn find_in_child(child: u64, want: ptr, want_len: u64) -> u64 {
    if type_is(child, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
        return decl_span(child, want, want_len);
    };
    if type_is(child, STR_PTR("export_statement"), STR_LEN("export_statement")) {
        let inner: u64 = 0;
        let span: u64 = 0;
        if sa_ts_node_child(child, 0, 1, &inner) == 0 && inner != 0 {
            if type_is(inner, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
                span = decl_span(inner, want, want_len);
            };
            sa_ts_node_free(inner);
        };
        return span;
    };
    return 0;
}

fn find_definition(root: u64, want: ptr, want_len: u64) -> u64 {
    let total: u32 = 0;
    if sa_ts_node_named_child_count(root, &total) != 0 {
        return 0;
    };
    let i: u32 = 0;
    let found: u64 = 0;
    while i < total {
        i = i + 1;
        let child: u64 = 0;
        if sa_ts_node_child(root, i - 1, 1, &child) == 0 && child != 0 {
            let span = find_in_child(child, want, want_len);
            if span != 0 {
                found = span;
            };
            sa_ts_node_free(child);
        };
    }
    return found;
}

fn buf_is(buf: &FileBuf, lit: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, &buf.bytes, buf.len, lit, lit_len);
    return slot[0] == 1;
}

fn main() -> i32 {
    let libbuf = FileBuf { bytes: [0u8; 8192], len: 0 };
    let st = read_once(STR_PTR("lib.ts"), STR_LEN("lib.ts"), &libbuf);
    if st == 10 {
        println("tool denied at first read (10)");
        return 42;
    };
    if st != 0 {
        return 2;
    };
    if sa_ts_available() != 1 {
        return 3;
    };
    let parser: u64 = 0;
    if sa_ts_parser_new(&parser) != 0 {
        return 4;
    };
    if sa_ts_parser_set_language(parser, STR_PTR("typescript"), STR_LEN("typescript")) != 0 {
        return 5;
    };
    let tree: u64 = 0;
    if sa_ts_parse(parser, &libbuf.bytes, libbuf.len, &tree) != 0 {
        return 6;
    };
    let root: u64 = 0;
    if sa_ts_tree_root(tree, &root) != 0 {
        return 7;
    };
    let span = find_definition(root, STR_PTR("computeTotal"), STR_LEN("computeTotal"));
    if span == 0 {
        return 8;
    };
    println("find_definition ok");
    sa_ts_node_free(root);
    sa_ts_tree_free(tree);
    sa_ts_parser_free(parser);

    let notebuf = FileBuf { bytes: [0u8; 8192], len: 0 };
    let st2 = read_once(STR_PTR("notes.txt"), STR_LEN("notes.txt"), &notebuf);
    if st2 == 10 {
        println("tool denied at notes read (10)");
        return 43;
    };
    if st2 != 0 {
        return 9;
    };
    if buf_is(&notebuf, STR_PTR("vm tools note\n"), STR_LEN("vm tools note\n")) == false {
        return 11;
    };
    println("read_file ok");

    // Deliberate second read of lib.ts: allowed under the allow-list
    // scenario, denied under one-time tokens (already consumed).
    let again = FileBuf { bytes: [0u8; 8192], len: 0 };
    let st3 = read_once(STR_PTR("lib.ts"), STR_LEN("lib.ts"), &again);
    if st3 == 10 {
        println("second read denied");
    };
    if st3 == 0 {
        println("second read allowed");
    };
    if st3 != 0 && st3 != 10 {
        return 12;
    };
    println("d9 vm tools ok");
    return 0;
}
