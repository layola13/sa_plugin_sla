}

@test "smoke1 sa_std_net_unix_datagram_send_to"() {
    s1_mkdir();
    let a = [0u64; 4];
    sla_std_net_unix_datagram_bind(STR_PTR("smoke1_unix/da.sock"), STR_LEN("smoke1_unix/da.sock"), &a[0]);
    let b = [0u64; 4];
    let brc = sla_std_net_unix_datagram_bind(STR_PTR("smoke1_unix/db.sock"), STR_LEN("smoke1_unix/db.sock"), &b[0]);
    if brc != 0 { panic(61120); };
    let wr = [0u64; 4];
    let rc = sla_std_net_unix_datagram_send_to(a[0], STR_PTR("dg"), STR_LEN("dg"), STR_PTR("smoke1_unix/db.sock"), STR_LEN("smoke1_unix/db.sock"), &wr[0]);
    if rc != 0 { panic(61121); };
    if wr[0] != 2 { panic(61122); };
    let buf = [0u8; 64];
    let rd = [0u64; 4];
    let from = [0u64; 4];
    sla_std_net_unix_datagram_recv_from(b[0], &buf[0], 64, &rd[0], &from[0]);
    if rd[0] != 2 { panic(61123); };
    if buf[0] != 100 { panic(61124); };
    sla_std_close(a[0]);
    sla_std_close(b[0]);
}

