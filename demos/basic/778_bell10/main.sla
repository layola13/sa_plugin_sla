@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Bell 续高位二 B(10)=115975（B(9)=21147 对 21147；十项和 `94828+21147`）。
// 意对标 776_bell9（n=9 版互补；780 做高位对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn bell(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let k = 0;
    while k <= n - 1 {
        s = s + binom_mul(n - 1, k) * bell(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", bell(9), bell(10));
    return 0;
}

@test "basic 778 bell10"() {
    if bell(10) != 115975 { panic(77801); };
    if bell(9) != 21147 { panic(77802); };
    if bell(8) != 4140 { panic(77803); };
}
