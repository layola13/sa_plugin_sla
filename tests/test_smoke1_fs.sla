    let rc2 = sla_fs_dir_buffer_free(^cell[0]);
    if rc2 != 0 { panic(51652); };
}

fn s1_watch(code: i32) -> u64 {
    let cell = [0u64; 4];
    let rc = sla_fs_watch_create(&cell[0]);
    if rc != 0 { panic(code); };
    if cell[0] == 0 { panic(code + 1); };
    return cell[0];
}

@test "smoke1 sa_fs_watch_add"() {
    s1_mkdir();
    let w = s1_watch(51660);
    let wd = [0u64; 4];
    let rc = sla_fs_watch_add(w, STR_PTR("smoke1_fs"), STR_LEN("smoke1_fs"), 4095, &wd[0]);
    if rc != 0 { panic(51662); };
    sla_fs_watch_close(^w);
}

@test "smoke1 sa_fs_watch_poll"() {
    s1_mkdir();
    sla_fs_remove_dir_all(STR_PTR("smoke1_fs/watchd"), STR_LEN("smoke1_fs/watchd"));
    sla_fs_mkdir_p(STR_PTR("smoke1_fs/watchd"), STR_LEN("smoke1_fs/watchd"));
    let w = s1_watch(51670);
    let wd = [0u64; 4];
    let rc = sla_fs_watch_add(w, STR_PTR("smoke1_fs/watchd"), STR_LEN("smoke1_fs/watchd"), 4095, &wd[0]);
    if rc != 0 { panic(51672); };
    sla_fs_write_file(STR_PTR("smoke1_fs/watchd/ev1.txt"), STR_LEN("smoke1_fs/watchd/ev1.txt"), STR_PTR("e"), STR_LEN("e"));
    let pending = [0u64; 4];
    let rc2 = sla_fs_watch_poll(w, 2000, &pending[0]);
    if rc2 != 0 { panic(51673); };
    if pending[0] == 0 { panic(51674); };
    sla_fs_watch_close(^w);
}

@test "smoke1 sa_fs_watch_next"() {
    s1_mkdir();
    sla_fs_remove_dir_all(STR_PTR("smoke1_fs/watchd2"), STR_LEN("smoke1_fs/watchd2"));
    sla_fs_mkdir_p(STR_PTR("smoke1_fs/watchd2"), STR_LEN("smoke1_fs/watchd2"));
    let w = s1_watch(51680);
    let wd = [0u64; 4];
    let rc = sla_fs_watch_add(w, STR_PTR("smoke1_fs/watchd2"), STR_LEN("smoke1_fs/watchd2"), 4095, &wd[0]);
    if rc != 0 { panic(51682); };
    sla_fs_write_file(STR_PTR("smoke1_fs/watchd2/ev2.txt"), STR_LEN("smoke1_fs/watchd2/ev2.txt"), STR_PTR("e"), STR_LEN("e"));
    let pending = [0u64; 4];
    sla_fs_watch_poll(w, 2000, &pending[0]);
    if pending[0] == 0 { panic(51683); };
    let ready = [0u64; 4];
    let owd = [0u64; 4];
    let omask = [0u64; 4];
    let ocookie = [0u64; 4];
    let namebuf = [0u64; 32];
    let nlen = [0u64; 4];
    let rc2 = sla_fs_watch_next(w, &ready[0], &owd[0], &omask[0], &ocookie[0], &namebuf[0], 256, &nlen[0]);
    if rc2 != 0 { panic(51684); };
    if ready[0] != 1 { panic(51685); };
    if owd[0] != wd[0] { panic(51686); };
    if omask[0] == 0 { panic(51687); };
    if nlen[0] != 7 { panic(51688); };
    let np = PTR_BYTE_ADD(&namebuf, 0);
    if PTR_BYTE_AT(np, 0) != 101 { panic(51689); };
    if PTR_BYTE_AT(np, 6) != 116 { panic(51690); };
    sla_fs_watch_close(^w);
}

@test "smoke1 sa_fs_watch_remove"() {
    s1_mkdir();
    let w = s1_watch(51700);
    let wd = [0u64; 4];
