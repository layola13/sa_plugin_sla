@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Vec 连乘（230 为区间版：2*3*4=24）。
// 累乘（230 口径）+ 动态界（215 口径）组合。

fn main() -> i32 {
    let p: Vec<i32> = Vec::new();
    p.push(2);
    p.push(3);
    p.push(4);
    let prod = 1;
    for i in 0..len(p) {
        prod = prod * p[i];
    }
    println("{}", prod);
    return 0;
}

@test "basic 252 vec prod"() {
    let p: Vec<i32> = Vec::new();
    p.push(2);
    p.push(3);
    p.push(4);
    let prod = 1;
    for i in 0..len(p) {
        prod = prod * p[i];
    }
    if prod != 24 { panic(25201); };
}
