// D10: static + artifact serving — the CXU static surface distilled.
// Serves a fixed whitelist of files from www/ over the v2
// http_server API (D2): content type per file, cache-control split
// (HTML no-cache, assets one hour), 404 for anything not whitelisted
// — including traversal attempts, which never reach the fs because
// only literal whitelisted paths are ever opened. Files are read per
// request through the std fs surface. Exactly six requests, then the
// server prints "d10 static ok" and exits; run.sh verifies status
// codes, headers and bodies with curl.
@import "sa_std/http_server.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/io/print.sai"
@import "byteseq.sa"

struct FileBuf {
    bytes: [u8; 8192],
    len: u64,
}

fn path_is(p_ptr: ptr, p_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, p_ptr, p_len, lit_ptr, lit_len);
    return slot[0] == 1;
}

fn read_once(path: ptr, path_len: u64, buf: &FileBuf) -> i32 {
    let total: u64 = 0;
    let st = sa_std_fs_len(path, path_len, &total);
    if st != 0 {
        return st;
    };
    let fh: u64 = 0;
    let ost = sa_std_fs_open_read(path, path_len, &fh);
    if ost != 0 {
        return ost;
    };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &buf.bytes, 8192, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 {
        return rst;
    };
    buf.len = read_n;
    return 0;
}

// Serves one whitelisted file; returns 0 or a demo error code.
fn serve_file(req: ptr, file: ptr, file_len: u64, ctype: ptr, ctype_len: u64, cache: ptr, cache_len: u64) -> i32 {
    let buf = FileBuf { bytes: [0u8; 8192], len: 0 };
    if read_once(file, file_len, &buf) != 0 {
        return 20;
    };
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, 200, &resp) != 0 {
        return 21;
    };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), ctype, ctype_len);
    sa_http_server_resp_add_header_v2(resp, STR_PTR("cache-control"), STR_LEN("cache-control"), cache, cache_len);
    if sa_http_server_resp_send_v2(resp, &buf.bytes, buf.len, 5000) != 0 {
        return 22;
    };
    sa_http_server_resp_free_v2(resp);
    return 0;
}

fn serve_404(req: ptr) -> i32 {
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, 404, &resp) != 0 {
        return 23;
    };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("text/plain"), STR_LEN("text/plain"));
    let body = "not found";
    if sa_http_server_resp_send_v2(resp, STR_PTR(body), STR_LEN(body), 5000) != 0 {
        return 24;
    };
    sa_http_server_resp_free_v2(resp);
    return 0;
}

fn main() -> i32 {
    let srv: ptr = PTR_NULL();
    if sa_http_server_new_v2(&srv) != 0 {
        return 2;
    };
    if sa_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 18083) != 0 {
        return 3;
    };
    let handled: u64 = 0;
    while handled < 6 {
        let req: ptr = PTR_NULL();
        if sa_http_server_accept_v2(srv, 30000, &req) != 0 {
            return 4;
        };
        let p_ptr: ptr = PTR_NULL();
        let p_len: u64 = 0;
        if sa_http_server_req_get_path(req, &p_ptr, &p_len) != 0 {
            return 5;
        };
        let rc: i32 = 0;
        if path_is(p_ptr, p_len, STR_PTR("/"), STR_LEN("/")) || path_is(p_ptr, p_len, STR_PTR("/index.html"), STR_LEN("/index.html")) {
            rc = serve_file(req, STR_PTR("www/index.html"), STR_LEN("www/index.html"), STR_PTR("text/html"), STR_LEN("text/html"), STR_PTR("no-cache"), STR_LEN("no-cache"));
        } else if path_is(p_ptr, p_len, STR_PTR("/app.js"), STR_LEN("/app.js")) {
            rc = serve_file(req, STR_PTR("www/app.js"), STR_LEN("www/app.js"), STR_PTR("text/javascript"), STR_LEN("text/javascript"), STR_PTR("public, max-age=3600"), STR_LEN("public, max-age=3600"));
        } else if path_is(p_ptr, p_len, STR_PTR("/style.css"), STR_LEN("/style.css")) {
            rc = serve_file(req, STR_PTR("www/style.css"), STR_LEN("www/style.css"), STR_PTR("text/css"), STR_LEN("text/css"), STR_PTR("public, max-age=3600"), STR_LEN("public, max-age=3600"));
        } else {
            rc = serve_404(req);
        };
        sa_http_server_req_free_v2(req);
        if rc != 0 {
            return rc;
        };
        handled = handled + 1;
    }
    sa_http_server_free_v2(srv);
    println("d10 static ok");
    return 0;
}
