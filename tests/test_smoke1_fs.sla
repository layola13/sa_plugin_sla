@test "smoke1 sa_fs_metadata_mode"() {
    let m = s1_meta_file();
    let mode = sla_fs_metadata_mode(m);
    // Regular-file type bits: mode in [0o100000, 0o100000 + 0o10000).
    if mode < 32768 { panic(51370); };
    if mode > 36863 { panic(51371); };
    sla_std_fs_metadata_free(m);
}

