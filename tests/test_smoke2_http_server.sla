@test "smoke2 sa_http_server_resp_new"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24407, pp, 64470);
    let cli = s2_raw_conn(pc[0], 64472);
    let req_lit = "GET /n HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64473);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64474); };
    let req = (aq[0] as ptr);
    let rp = [0u64; 4];
    if sla_http_server_resp_new(req, 201, &rp[0]) != 0 { panic(64475); };
    if rp[0] == 0 { panic(64476); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_send(resp, STR_PTR("created"), STR_LEN("created")) != 0 { panic(64477); };
    sla_http_server_resp_free(resp);
    sla_http_server_req_free(req);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_raw_read_all(cli, bp, 1024);
    if !s2_contains(bp, total, STR_PTR("201"), STR_LEN("201")) { panic(64478); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_resp_set_content_type"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24408, pp, 64480);
    let cli = s2_raw_conn(pc[0], 64482);
    let req_lit = "GET /ct HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64483);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64484); };
    let req = (aq[0] as ptr);
    let rp = [0u64; 4];
    if sla_http_server_resp_new(req, 200, &rp[0]) != 0 { panic(64485); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_set_content_type(resp, STR_PTR("text/x-w2"), STR_LEN("text/x-w2")) != 0 { panic(64486); };
    if sla_http_server_resp_send(resp, STR_PTR("ct-body"), STR_LEN("ct-body")) != 0 { panic(64487); };
    sla_http_server_resp_free(resp);
    sla_http_server_req_free(req);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_raw_read_all(cli, bp, 1024);
    if !s2_contains(bp, total, STR_PTR("text/x-w2"), STR_LEN("text/x-w2")) { panic(64488); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_resp_send"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24409, pp, 64490);
    let cli = s2_raw_conn(pc[0], 64492);
    let req_lit = "GET /s HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    s2_raw_write(cli, STR_PTR(req_lit), STR_LEN(req_lit), 64493);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(64494); };
    let req = (aq[0] as ptr);
    let rp = [0u64; 4];
    if sla_http_server_resp_new(req, 200, &rp[0]) != 0 { panic(64495); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_send(resp, STR_PTR("v1-resp-body"), STR_LEN("v1-resp-body")) != 0 { panic(64496); };
    sla_http_server_resp_free(resp);
    sla_http_server_req_free(req);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_raw_read_all(cli, bp, 1024);
    if total < 12 { panic(64497); };
    if !s2_mem_eq(bp, 12, STR_PTR("HTTP/1.1 200"), STR_LEN("HTTP/1.1 200")) { panic(64498); };
    if !s2_contains(bp, total, STR_PTR("v1-resp-body"), STR_LEN("v1-resp-body")) { panic(64499); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

// ---------------- v1 stream tests ----------------

fn s2_accept_v1(srv: ptr, cli: u64, req_lit: ptr, req_len: u64, code: i32) -> ptr {
    s2_raw_write(cli, req_lit, req_len, code);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) != 0 { panic(code + 1); };
    return (aq[0] as ptr);
}

@test "smoke2 sa_http_server_resp_stream_new"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24410, pp, 64500);
    let cli = s2_raw_conn(pc[0], 64502);
    let req_lit = "GET /st HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v1(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64503);
    let rp = [0u64; 4];
    if sla_http_server_resp_stream_new(req, 200, &rp[0]) != 0 { panic(64505); };
    if rp[0] == 0 { panic(64506); };
    let sresp = (rp[0] as ptr);
    if sla_http_server_resp_stream_end(sresp) != 0 { panic(64507); };
    sla_http_server_resp_stream_free(sresp);
    sla_http_server_req_free(req);
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_resp_stream_write"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24411, pp, 64510);
    let cli = s2_raw_conn(pc[0], 64512);
    let req_lit = "GET /st HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v1(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64513);
    let rp = [0u64; 4];
    if sla_http_server_resp_stream_new(req, 200, &rp[0]) != 0 { panic(64515); };
    let sresp = (rp[0] as ptr);
    if sla_http_server_resp_stream_write(sresp, STR_PTR("chunk-A"), STR_LEN("chunk-A")) != 0 { panic(64516); };
    if sla_http_server_resp_stream_end(sresp) != 0 { panic(64517); };
    sla_http_server_resp_stream_free(sresp);
    sla_http_server_req_free(req);
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_raw_read_all(cli, bp, 1024);
    if !s2_contains(bp, total, STR_PTR("chunk-A"), STR_LEN("chunk-A")) { panic(64518); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_resp_stream_flush"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24412, pp, 64520);
    let cli = s2_raw_conn(pc[0], 64522);
    let req_lit = "GET /st HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v1(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64523);
    let rp = [0u64; 4];
    if sla_http_server_resp_stream_new(req, 200, &rp[0]) != 0 { panic(64525); };
    let sresp = (rp[0] as ptr);
    if sla_http_server_resp_stream_write(sresp, STR_PTR("flush-me"), STR_LEN("flush-me")) != 0 { panic(64526); };
    if sla_http_server_resp_stream_flush(sresp) != 0 { panic(64527); };
    // After flush the chunk must be readable before end is called.
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    s2_read_exact(cli, bp, 8, 64528);
    if sla_http_server_resp_stream_end(sresp) != 0 { panic(64529); };
    sla_http_server_resp_stream_free(sresp);
    sla_http_server_req_free(req);
    let total = s2_raw_read_all(cli, bp, 1024);
    if !s2_contains(bp, total, STR_PTR("flush-me"), STR_LEN("flush-me")) { panic(64530); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

@test "smoke2 sa_http_server_resp_stream_end"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24413, pp, 64540);
    let cli = s2_raw_conn(pc[0], 64542);
    let req_lit = "GET /st HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
    let req = s2_accept_v1(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64543);
    let rp = [0u64; 4];
    if sla_http_server_resp_stream_new(req, 200, &rp[0]) != 0 { panic(64545); };
    let sresp = (rp[0] as ptr);
    if sla_http_server_resp_stream_write(sresp, STR_PTR("end-chunk"), STR_LEN("end-chunk")) != 0 { panic(64546); };
    if sla_http_server_resp_stream_end(sresp) != 0 { panic(64547); };
    sla_http_server_resp_stream_free(sresp);
    sla_http_server_req_free(req);
    // End must terminate the body: read_all ends at EOF with the chunk in it.
    let buf = [0u8; 1024];
    let bp: ptr = PTR_BYTE_ADD(&buf, 0);
    let total = s2_raw_read_all(cli, bp, 1024);
    if !s2_contains(bp, total, STR_PTR("end-chunk"), STR_LEN("end-chunk")) { panic(64548); };
    sla_std_close(cli);
    sla_http_server_free(srv);
}

