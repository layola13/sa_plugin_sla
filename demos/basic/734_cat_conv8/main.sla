@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 卷积高位 C(7)=429，C(8)=1430（同式再上两位；556 体例高位）。
// 意对标 726_cat_conv6（低位卷积版互补；735 做三向收束）。

fn catc(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let i = 0;
    while i < n {
        s = s + catc(i) * catc(n - 1 - i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", catc(7), catc(8));
    return 0;
}

@test "basic 734 cat conv8"() {
    if catc(7) != 429 { panic(73401); };
    if catc(8) != 1430 { panic(73402); };
    if catc(6) != 132 { panic(73403); };
}
