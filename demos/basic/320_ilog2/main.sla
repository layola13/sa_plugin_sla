@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 983_math_aux 的 log2 部（157 为 log10 部：3,3,4）。
// 倍增计数（113 的累乘口径之对数版）。

fn ilog2(n: int) -> int {
    let r = 0;
    let p = 1;
    while p * 2 <= n {
        p = p * 2;
        r = r + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{}", ilog2(8), ilog2(9), ilog2(16));
    return 0;
}

@test "basic 320 ilog2"() {
    if ilog2(8) != 3 { panic(32001); };
    if ilog2(9) != 3 { panic(32002); };
    if ilog2(16) != 4 { panic(32003); };
    if ilog2(1) != 0 { panic(32004); };
}
