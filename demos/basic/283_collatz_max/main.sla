@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 155_collatz 的最值版（236 为序列版：链(6)峰值 16）。
// 变换（236 口径）+ 运行最大（244 口径）组合。

fn main() -> i32 {
    let n = 6;
    let cmax = 6;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        };
        if n > cmax { cmax = n; };
    }
    println("{}", cmax);
    return 0;
}

@test "basic 283 collatz max"() {
    let n = 6;
    let cmax = 6;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        };
        if n > cmax { cmax = n; };
    }
    if cmax != 16 { panic(28301); };
}
