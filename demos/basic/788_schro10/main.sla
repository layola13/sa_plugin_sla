@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 续高位二 S(10)=1037718（S(9)=206098 对 206098；卷积和 831620）。
// 意对标 786_schro9（n=9 版互补；790 做高位对峙）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", sch(9), sch(10));
    return 0;
}

@test "basic 788 schro10"() {
    if sch(10) != 1037718 { panic(78801); };
    if sch(9) != 206098 { panic(78802); };
    if sch(8) != 41586 { panic(78803); };
}
