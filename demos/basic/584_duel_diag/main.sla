@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 次对角对峙：c(n,n-1) == n·(n-1)/2（n=4：6 对 6；n=5：10 对 10；n=6：15 对 15）。
// 意对标 576 stirling1（单实现见源；对换计数解释：单个对换选二元）。

fn stirling1(n: int, k: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= nn {
            t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + (nn - 1) * t[(nn - 1) * w + kk];
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn diag(n: int) -> int {
    return n * (n - 1) / 2;
}

fn main() -> i32 {
    println("{},{},{},{},{},{}", stirling1(4, 3), diag(4), stirling1(5, 4), diag(5), stirling1(6, 5), diag(6));
    return 0;
}

@test "basic 584 duel diag"() {
    if stirling1(4, 3) != 6 { panic(58401); };
    if diag(4) != 6 { panic(58402); };
    if stirling1(5, 4) != 10 { panic(58403); };
    if diag(5) != 10 { panic(58404); };
    if stirling1(6, 5) != 15 { panic(58405); };
    if diag(6) != 15 { panic(58406); };
}
