@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类第 2 列即 Mersenne：S(7,2)=63，S(8,2)=127，S(9,2)=255（2^(n-1)-1）。
// 意对标 696_stir27（内格版互补；702 做列对峙）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", svt(7, 2), svt(8, 2), svt(9, 2));
    return 0;
}

@test "basic 701 stir2 col2"() {
    if svt(7, 2) != 63 { panic(70101); };
    if svt(8, 2) != 127 { panic(70102); };
    if svt(9, 2) != 255 { panic(70103); };
    if svt(6, 2) != 31 { panic(70104); };
}
