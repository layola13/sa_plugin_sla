@test "e_res regex match group view"() {
    let pat = "123";
    let regex = sa_regex_compile(STR_PTR(pat), STR_LEN(pat), 0);
    if regex == 0 {
        panic(47181);
    };
    let text = "123abc";
    let m_raw = sa_regex_match(regex, STR_PTR(text), STR_LEN(text));
    if m_raw == 0 {
        panic(47182);
    };
    let m = RegexMatch { raw: m_raw };
    let view = sla_regex_group_ptr(&m, 0);
    let expected = "123";
    if !view_eq(&view, STR_PTR(expected), STR_LEN(expected)) {
        panic(47183);
    };
    let fr = sla_regex_match_free(^m);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(47184);
            };
        },
        Err(e) => {
            panic(47185);
        },
    };
    let rf = sa_regex_free(regex);
    match rf {
        Ok(p) => {
            if p != 0 {
                panic(47186);
            };
        },
        Err(e) => {
            panic(47187);
        },
    };
}

