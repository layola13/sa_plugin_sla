@test "smoke1 sa_json_object_set_null"() {
    let obj = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let rc = sla_json_object_set_null(obj, STR_PTR("z"), STR_LEN("z"));
    if rc != 0 { panic(52160); };
    let child = s1_get(obj, STR_PTR("z"), STR_LEN("z"), 52161);
    if sla_json_kind(child) != 0 { panic(52162); };
}

@test "smoke1 sa_json_object_set_node"() {
    let obj = sla_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let child = sla_json_parse(STR_PTR("[1]"), STR_LEN("[1]"));
    let rc = sla_json_object_set_node(obj, STR_PTR("arr"), STR_LEN("arr"), child);
    if rc != 0 { panic(52170); };
    let got = s1_get(obj, STR_PTR("arr"), STR_LEN("arr"), 52171);
    if sla_json_kind(got) != 6 { panic(52172); };
}

@test "smoke1 sa_json_object_remove"() {
    let obj = sla_json_parse(STR_PTR("{\"a\":1,\"b\":2}"), STR_LEN("{\"a\":1,\"b\":2}"));
    let rc = sla_json_object_remove(obj, STR_PTR("a"), STR_LEN("a"));
    if rc != 0 { panic(52180); };
    let cell = [0u64; 4];
    let rc2 = sla_json_object_get(obj, STR_PTR("a"), STR_LEN("a"), &cell[0]);
    if rc2 == 0 { panic(52181); };
    let cnt = [0u64; 4];
    sla_json_value_count(obj, &cnt[0]);
    if cnt[0] != 1 { panic(52182); };
}

@test "smoke1 sa_json_array_push_string"() {
    let arr = sla_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let rc = sla_json_array_push_string(arr, STR_PTR("x"), STR_LEN("x"));
    if rc != 0 { panic(52190); };
    let cell = [0u64; 4];
    sla_json_array_get(arr, 0, &cell[0]);
    if sla_json_kind(cell[0]) != 5 { panic(52191); };
    if sla_json_string_len(cell[0]) != 1 { panic(52192); };
}

@test "smoke1 sa_json_array_push_i64"() {
    let arr = sla_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    sla_json_array_push_i64(arr, 5);
    let rc = sla_json_array_push_i64(arr, 6);
    if rc != 0 { panic(52200); };
    let cnt = [0u64; 4];
    sla_json_value_count(arr, &cnt[0]);
    if cnt[0] != 2 { panic(52201); };
    let cell = [0u64; 4];
    sla_json_array_get(arr, 1, &cell[0]);
    let v = [0u64; 4];
    sla_json_as_i64(cell[0], &v[0]);
    if v[0] != 6 { panic(52202); };
}

