@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 第 7 行 1,15,113,575,2241,7183,19825,48639（行和 78592；循环求和）。
// 意对标 756_delan7（单格版互补；同式行复算）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn drow7() -> int {
    let s = 0;
    let k = 0;
    while k <= 7 {
        s = s + delan(7, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", delan(7, 1), delan(7, 2), drow7());
    return 0;
}

@test "basic 757 delan row7"() {
    if delan(7, 1) != 15 { panic(75701); };
    if delan(7, 2) != 113 { panic(75702); };
    if drow7() != 78592 { panic(75703); };
    if delan(7, 0) != 1 { panic(75704); };
}
