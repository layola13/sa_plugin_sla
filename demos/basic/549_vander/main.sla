@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Vandermonde 恒等式 Σ_k C(r,k)·C(s,n-k) = C(r+s,n)
//（r=s=4,n=4→70；r=3,s=5,n=4→70；552 做查表对峙）。
// 意对标 548 hockey（单表对角版互补；此处为双表卷积）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn vander(r: int, s: int, n: int) -> int {
    let acc = 0;
    let k = 0;
    while k <= n {
        if k <= r {
            let j = n - k;
            if j >= 0 {
                if j <= s {
                    acc = acc + binom(r, k) * binom(s, j);
                };
            };
        };
        k = k + 1;
    }
    return acc;
}

fn main() -> i32 {
    println("{},{}", vander(4, 4, 4), vander(3, 5, 4));
    return 0;
}

@test "basic 549 vander"() {
    if vander(4, 4, 4) != 70 { panic(54901); };
    if vander(3, 5, 4) != 70 { panic(54902); };
    if vander(2, 2, 2) != 6 { panic(54903); };
}
