}

@test "smoke2 sa_http_server_set_max_body_bytes"() {
    let pc = [0u64; 4];
    let pp: ptr = PTR_BYTE_ADD(&pc, 0);
    let srv = s2_srv1(24421, pp, 64630);
    if sla_http_server_set_max_body_bytes(srv, 1048576) != 0 { panic(64632); };
    // Normal request still served under a generous limit.
    let cli = s2_raw_conn(pc[0], 64633);
    let req_lit = "POST /mb HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 4\r\nConnection: close\r\n\r\nBODY";
    let req = s2_accept_v1(srv, cli, STR_PTR(req_lit), STR_LEN(req_lit), 64634);
    let rp = [0u64; 4];
    if sla_http_server_resp_new(req, 200, &rp[0]) != 0 { panic(64636); };
    let resp = (rp[0] as ptr);
    if sla_http_server_resp_send(resp, STR_PTR("ok"), STR_LEN("ok")) != 0 { panic(64637); };
    sla_http_server_resp_free(resp);
    sla_http_server_req_free(req);
    sla_std_close(cli);
    // Tighten to 4 bytes: an 10-byte body must now be rejected at accept.
    if sla_http_server_set_max_body_bytes(srv, 4) != 0 { panic(64638); };
    let cli2 = s2_raw_conn(pc[0], 64639);
    let big_lit = "POST /mb HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 10\r\nConnection: close\r\n\r\n0123456789";
    s2_raw_write(cli2, STR_PTR(big_lit), STR_LEN(big_lit), 64640);
    let aq = [0u64; 4];
    if sla_http_server_accept(srv, &aq[0]) == 0 { panic(64641); };
    sla_std_close(cli2);
    sla_http_server_free(srv);
}

// ---------------- v2 tests ----------------

fn s2_accept_v2(srv: ptr, cli: u64, req_lit: ptr, req_len: u64, code: i32) -> ptr {
    s2_raw_write(cli, req_lit, req_len, code);
    let aq = [0u64; 4];
    if sla_http_server_accept_v2(srv, 30000, &aq[0]) != 0 { panic(code + 1); };
    return (aq[0] as ptr);
}

fn s2_head_len(bp: ptr, total: u64) -> u64 {
    if total < 4 { return 0; };
    let i: u64 = 0;
    while i + 4 <= total {
        let a: ptr = PTR_BYTE_ADD(bp, i);
        let b: ptr = PTR_BYTE_ADD(bp, i + 1);
        let c: ptr = PTR_BYTE_ADD(bp, i + 2);
        let d: ptr = PTR_BYTE_ADD(bp, i + 3);
        if PTR_READ_U8(a) == 13 && PTR_READ_U8(b) == 10 && PTR_READ_U8(c) == 13 && PTR_READ_U8(d) == 10 {
            return i + 4;
        };
        i = i + 1;
    }
    return 0;
}

