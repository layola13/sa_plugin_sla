@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fuss 对峙：商式 C(3n,n)/(2n+1) == 三元卷积 T(n)=Σ_{i+j+k=n-1}T(i)T(j)T(k)
//（n=2：3 对 3；n=3：12 对 12）。
// 意对标 560 fuss（单实现见源；286 系对峙体例）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fuss_div(n: int) -> int {
    return binom_mul(3 * n, n) / (2 * n + 1);
}

fn fuss_conv(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let m = 1;
    while m <= n {
        let acc = 0;
        let a = 0;
        while a < m {
            let b = 0;
            while b < m - a {
                let c = m - 1 - a - b;
                acc = acc + t[a] * t[b] * t[c];
                b = b + 1;
            }
            a = a + 1;
        }
        t[m] = acc;
        m = m + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{},{}", fuss_div(2), fuss_conv(2), fuss_div(3), fuss_conv(3));
    return 0;
}

@test "basic 564 duel fuss"() {
    if fuss_div(2) != 3 { panic(56401); };
    if fuss_conv(2) != 3 { panic(56402); };
    if fuss_div(3) != 12 { panic(56403); };
    if fuss_conv(3) != 12 { panic(56404); };
    if fuss_div(3) != fuss_conv(3) { panic(56405); };
}
