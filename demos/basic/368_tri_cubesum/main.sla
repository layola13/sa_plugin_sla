@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 立方和三向对峙（循环 vs 公式 (n(n+1)/2)² vs 逆序累加：5 → 225）。
// 意对标 365 平方三向的立方版（360 互补）。

fn cube_loop(n: int) -> int {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i * i * i;
        i = i + 1;
    }
    return s;
}

fn cube_form(n: int) -> int {
    let t = n * (n + 1) / 2;
    return t * t;
}

fn cube_acc(n: int) -> int {
    let s = 0;
    let i = n;
    while i >= 1 {
        s = s + i * i * i;
        i = i - 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", cube_loop(5), cube_form(5), cube_acc(5));
    return 0;
}

@test "basic 368 tri cubesum"() {
    if cube_loop(5) != 225 { panic(36801); };
    if cube_form(5) != 225 { panic(36802); };
    if cube_acc(5) != 225 { panic(36803); };
    if cube_loop(5) != cube_form(5) { panic(36804); };
    if cube_form(5) != cube_acc(5) { panic(36805); };
}
