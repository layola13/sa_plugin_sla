+/// SABAUDIT-FIX-MEASURE-ONLY: measurement builds ONLY (audit registry
+/// regen). When SLA_SAB_AUDIT_MEASURE=1, audit findings are computed
+/// and printable but never block the compile, so registry probes
+/// measure the backends themselves instead of being intercepted by
+/// the checked-in registry (DEF-SAB-AUDIT-REGEN-SELF-BLOCK). This
+/// helper set is applied by tools/sab_audit/make_meas.sh to a scratch
+/// copy of the tree; it must never be committed to the shipped
+/// plugin sources.
+fn sabAuditMeasureOnly() bool {
+    const raw = std.c.getenv("SLA_SAB_AUDIT_MEASURE") orelse return false;
+    const s = std.mem.span(raw);
+    return s.len != 0 and !std.mem.eql(u8, s, "0") and !std.mem.eql(u8, s, "false") and !std.mem.eql(u8, s, "no");
+}
