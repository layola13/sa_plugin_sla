@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 递归×迭代×表三向阶乘对峙（120×230×277：5→120=120=120）。
// 双向已见 292，此处加表版收束三向。

fn fact_rec(n: int) -> int {
    if n <= 1 { return 1; };
    return n * fact_rec(n - 1);
}

fn fact_iter(n: int) -> int {
    let p = 1;
    let i = 1;
    while i <= n {
        p = p * i;
        i = i + 1;
    }
    return p;
}

fn main() -> i32 {
    let facts: Vec<i32> = Vec::new();
    let k = 0;
    while k <= 5 {
        facts.push(fact_iter(k));
        k = k + 1;
    }
    println("{},{},{}", fact_rec(5), fact_iter(5), facts[5]);
    return 0;
}

@test "basic 307 tri fact"() {
    if fact_rec(5) != fact_iter(5) { panic(30701); };
    let facts: Vec<i32> = Vec::new();
    let k = 0;
    while k <= 5 {
        facts.push(fact_iter(k));
        k = k + 1;
    }
    if facts[5] != fact_rec(5) { panic(30702); };
    if facts[5] != 120 { panic(30703); };
}
