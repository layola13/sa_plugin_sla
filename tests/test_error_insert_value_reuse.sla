@import "sa_std/hashmap.sa"
@import "sa_std/vec.sa"

// DEF insert-consume (value side): the same owned Vec value inserted
// under two keys. Before the fix the checker accepted it; both slots
// aliased the one Vec handle while the source binding still owned it,
// so the source's scope-exit drop freed the buffer under the map
// (reading an entry back segfaults). The checker must reject the
// second insert with a language-level UseAfterMove naming the
// variable and `insert`.

fn bad_insert_value_reuse(v: Vec<i32>) -> HashMap<i32, Vec<i32>> {
    let m: HashMap<i32, Vec<i32>> = HashMap::new();
    m.insert(1, v);
    m.insert(2, v);
    return m;
}

fn main() -> i32 {
    let xs: Vec<i32> = Vec::new();
    xs.push(1);
    let r = bad_insert_value_reuse(xs);
    return len(r) as i32;
}
