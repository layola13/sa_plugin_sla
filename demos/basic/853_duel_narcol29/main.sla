@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Narayana 列对峙：乘式商式 vs 表式商式（(8,2)：196 对 196；(9,2)：336 对 336）。
// 意对标 852_nar_col29（列源互补；848 边对峙体例合流）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn nar(n: int, k: int) -> int {
    return binom_mul(n, k) * binom_mul(n, k + 1) / n;
}

fn ccomb(n: int, k: int) -> int {
    if k > n { return 0; };
    if k == 0 { return 1; };
    if k == n { return 1; };
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        t[mm * w] = 1;
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn qnar(n: int, k: int) -> int {
    return ccomb(n, k) * ccomb(n, k + 1) / n;
}

fn main() -> i32 {
    println("{},{},{},{}", nar(8, 2), qnar(8, 2), nar(9, 2), qnar(9, 2));
    return 0;
}

@test "basic 853 duel narcol29"() {
    if nar(8, 2) != 196 { panic(85301); };
    if qnar(8, 2) != 196 { panic(85302); };
    if nar(9, 2) != 336 { panic(85303); };
    if qnar(9, 2) != 336 { panic(85304); };
}
