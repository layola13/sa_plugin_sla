@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Delannoy 第 8 行 1,17,145,833,3649,13073,40081,108545,265729（行和 432073；循环求和）。
// 意对标 886_delan8（单格版互补；同式行复算）。

fn delan(m: int, n: int) -> int {
    let w = n + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= m * w + n {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= m {
        t[a * w] = 1;
        a = a + 1;
    }
    let b = 0;
    while b <= n {
        t[b] = 1;
        b = b + 1;
    }
    let mm = 1;
    while mm <= m {
        let nn = 1;
        while nn <= n {
            t[mm * w + nn] = t[(mm - 1) * w + nn] + t[(mm - 1) * w + nn - 1] + t[mm * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[m * w + n];
}

fn drow(m: int) -> int {
    let s = 0;
    let k = 0;
    while k <= 8 {
        s = s + delan(m, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", delan(8, 5), delan(8, 6), drow(8));
    return 0;
}

@test "basic 887 delan row8"() {
    if delan(8, 5) != 13073 { panic(88701); };
    if delan(8, 6) != 40081 { panic(88702); };
    if drow(8) != 432073 { panic(88703); };
    if delan(7, 5) != 7183 { panic(88704); };
}
