// DEF-TEXT31-EXECUTOR-VEC-TEMP regression: the future-object temp
// produced for task::new (FUTURE_NEW wrapper around the state) is
// moved into the task by TASK_NEW and must be retired visibly
// (move-consume forget) right after the store -- the SAB backend's
// task::new arm already did this, the TEXT arm did not, so the
// wrapper temp stayed Active at function exit (MemoryLeak 1012,
// first leaking register tmp_9 @ executor_vec_ready_count_all in
// test_unit_async_executor_vec_runtime).

@import "sa_std/future.sa"
@import "sa_std/core/task.sa"
@import "sa_std/vec.sa"

fn task_new_future_obj_ready_count() -> u64 {
    let first_future = future::ready(1);
    let second_future = future::ready(2);
    let first = task::new(first_future);
    let second = task::new(second_future);
    let tasks: Vec<Task<i32>> = Vec::new();
    tasks.push(first);
    tasks.push(second);
    let executor = executor::new(tasks);
    let count = executor::poll_ready_count(executor);
    return count;
}

fn task_new_future_obj_poll_one() -> bool {
    let future = future::ready(7);
    let task = task::new(future);
    let tasks: Vec<Task<i32>> = Vec::new();
    tasks.push(task);
    let executor = executor::new(tasks);
    let ready = executor::poll_one(executor, 0);
    return ready;
}

@test "text task new future object temp retires"() {
    if task_new_future_obj_ready_count() != 2 {
        panic(32041);
    };
}

@test "text task new future object poll one"() {
    if task_new_future_obj_poll_one() != true {
        panic(32042);
    };
}
