// DEF-batch2 card 10a: a cross-type cast bound by a `let` leaked its
// fresh result temp on the SA text backend — the let path retired the
// value temp with callArgNeedsRelease, which is false for every cast,
// so the temp stayed Active to function exit and the verifier trapped
// error[MemoryLeak] (1012). The SAB backend and the direct (non-let)
// spellings were unaffected. Pre-fix the SA backend fails every test
// below with MemoryLeak on the cast temp; post-fix both backends pass.

@test "let bound widening cast u32 to i64"() {
    let x: u32 = 41;
    let y: i64 = x as i64;
    if y != 41 { panic(37101); };
}

@test "let bound widening cast i32 to i64"() {
    let x: i32 = -5;
    let y: i64 = x as i64;
    if y != -5 { panic(37102); };
}

@test "let bound narrowing cast i64 to i32"() {
    let x: i64 = 123456;
    let y: i32 = x as i32;
    if y != 123456 { panic(37103); };
}

@test "let bound float to int cast"() {
    let x: f64 = 7.0;
    let y: i64 = x as i64;
    if y != 7 { panic(37104); };
}

@test "let bound cast result and source both reused"() {
    let x: u32 = 41;
    let y: i64 = x as i64;
    if x != 41 { panic(37105); };
    if y + 1 != 42 { panic(37106); };
}
