// D12 (server) — token-stream backend for the frontend miniature.
// One WebSocket connection at /stream: reads the prompt frame, then
// streams three token frames ("Hel", "lo", "!") and a final "done"
// frame, then closes. The SAX page (page.sax) is the intended client
// UI; its airlock has no WebSocket bridge yet (recorded gap), so
// client.sla stands in for the page's stream consumer.
@import "sa_std/http_server.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/io/print.sai"
@import "byteseq.sa"

fn path_is(p_ptr: ptr, p_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, p_ptr, p_len, lit_ptr, lit_len);
    return slot[0] == 1;
}

fn send_frame(ws: ptr, text: ptr, text_len: u64) -> i32 {
    let written: u64 = 0;
    if sa_http_server_websocket_write_v2(ws, 1, text, text_len, &written) != 0 {
        return 1;
    };
    return 0;
}

fn main() -> i32 {
    let srv: ptr = PTR_NULL();
    if sa_http_server_new_v2(&srv) != 0 {
        return 2;
    };
    if sa_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 18085) != 0 {
        return 3;
    };
    let req: ptr = PTR_NULL();
    if sa_http_server_accept_v2(srv, 30000, &req) != 0 {
        return 4;
    };
    let p_ptr: ptr = PTR_NULL();
    let p_len: u64 = 0;
    if sa_http_server_req_get_path(req, &p_ptr, &p_len) != 0 {
        return 5;
    };
    if path_is(p_ptr, p_len, STR_PTR("/stream"), STR_LEN("/stream")) == false {
        return 6;
    };
    let ws: ptr = PTR_NULL();
    if sa_http_server_websocket_upgrade_v2(req, &ws) != 0 {
        return 7;
    };
    // Read the prompt frame (v2 sockets are non-blocking: poll first).
    let got = false;
    let attempts: u64 = 0;
    while got != true {
        let events: u32 = 0;
        if sa_http_server_websocket_poll_v2(ws, 1, 10000, &events) != 0 {
            return 8;
        };
        let opcode: u8 = 0;
        let d_ptr: ptr = PTR_NULL();
        let d_len: u64 = 0;
        let rst = sa_http_server_websocket_read_v2(ws, 4096, &opcode, &d_ptr, &d_len);
        if rst == 0 {
            got = true;
        } else if rst == 1 {
            attempts = attempts + 1;
            if attempts > 100 {
                return 9;
            };
        } else {
            return 10;
        };
    }
    if send_frame(ws, STR_PTR("Hel"), STR_LEN("Hel")) != 0 {
        return 11;
    };
    if send_frame(ws, STR_PTR("lo"), STR_LEN("lo")) != 0 {
        return 12;
    };
    if send_frame(ws, STR_PTR("!"), STR_LEN("!")) != 0 {
        return 13;
    };
    if send_frame(ws, STR_PTR("done"), STR_LEN("done")) != 0 {
        return 14;
    };
    sa_http_server_websocket_close_v2(ws, 1000, STR_PTR(""), 0);
    sa_http_server_websocket_free_v2(ws);
    sa_http_server_free_v2(srv);
    println("d12 server ok");
    return 0;
}
