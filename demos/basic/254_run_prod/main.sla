@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 运行乘积（243 为运行平方和版：表尾 60，次项 3）。
// 运行累积（243 口径）换乘法。

fn main() -> i32 {
    let a: Vec<i32> = Vec::new();
    a.push(3);
    a.push(1);
    a.push(4);
    a.push(1);
    a.push(5);
    let rp: Vec<i32> = Vec::new();
    let run = 1;
    for i in 0..len(a) {
        run = run * a[i];
        rp.push(run);
    }
    println("{},{}", rp[4], rp[1]);
    return 0;
}

@test "basic 254 run prod"() {
    let a: Vec<i32> = Vec::new();
    a.push(3);
    a.push(1);
    a.push(4);
    a.push(1);
    a.push(5);
    let rp: Vec<i32> = Vec::new();
    let run = 1;
    for i in 0..len(a) {
        run = run * a[i];
        rp.push(run);
    }
    if len(rp) != 5 { panic(25401); };
    if rp[4] != 60 { panic(25402); };
    if rp[1] != 3 { panic(25403); };
}
