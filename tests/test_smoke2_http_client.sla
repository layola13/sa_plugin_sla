@test "smoke2 sa_http_client_resp_get_header"() {
    let h = go s2_echo2(24611 + 1 * 65536 + 65220 * 16777216);
    sla_time_sleep_ms(120);
    let ub = [0u8; 128];
    let ubp: ptr = PTR_BYTE_ADD(&ub, 0);
    let ulen = s2_url(24611, STR_PTR("/gh"), STR_LEN("/gh"), ubp);
    let cl = [0u64; 4];
    if sla_http_client_new(0, &cl[0]) != 0 { panic(65223); };
    let rq = [0u64; 4];
    if sla_http_client_req_new((cl[0] as ptr), 1, ubp, ulen, &rq[0]) != 0 { panic(65224); };
    let rs = [0u64; 4];
    if sla_http_client_req_send((rq[0] as ptr), &rs[0]) != 0 { panic(65225); };
    let resp = (rs[0] as ptr);
    let vp = [0u64; 4];
    let vl = [0u64; 4];
    if sla_http_client_resp_get_header(resp, STR_PTR("X-Echo"), STR_LEN("X-Echo"), &vp[0], &vl[0]) != 0 { panic(65226); };
    if !s2_mem_eq((vp[0] as ptr), vl[0], STR_PTR("wave2"), STR_LEN("wave2")) { panic(65227); };
    // An absent header must report an error, not an empty value.
    if sla_http_client_resp_get_header(resp, STR_PTR("X-Absent"), STR_LEN("X-Absent"), &vp[0], &vl[0]) == 0 { panic(65228); };
    sla_http_client_resp_free(resp);
    sla_http_client_req_free((rq[0] as ptr));
    sla_http_client_free((cl[0] as ptr));
    sa_task_join(h);
}

