@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 9 行 40320,109584,118124,67284,22449,4536,546,36,1（行和 362880=9!）。
// 意对标 816_stir19（单格版互补；同式行复算）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn csum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + cst(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", cst(9, 1), cst(9, 2), csum(9));
    return 0;
}

@test "basic 817 stir1 row9"() {
    if cst(9, 1) != 40320 { panic(81701); };
    if cst(9, 2) != 109584 { panic(81702); };
    if csum(9) != 362880 { panic(81703); };
    if cst(9, 9) != 1 { panic(81704); };
}
