@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 序列前 12 项和 6589727（S(11)=5293446；前缀和循环求和）。
// 意对标 896_schro11（单值版互补；同式序列复算）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn sseq(n: int) -> int {
    let s = 0;
    let i = 0;
    while i <= n {
        s = s + sch(i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", sseq(11), sseq(10));
    return 0;
}

@test "basic 897 schro seq11"() {
    if sseq(11) != 6589727 { panic(89701); };
    if sseq(10) != 1296281 { panic(89702); };
    if sseq(9) != 258563 { panic(89703); };
    if sch(11) != 5293446 { panic(89704); };
}
