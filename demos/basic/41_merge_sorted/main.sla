@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 对标 tsgosa 123_merge：双指针归并 [1,3,5] + [2,4,6] -> [1,2,3,4,5,6]。

fn main() -> i32 {
    let a = [1, 3, 5];
    let b = [2, 4, 6];
    let c: Vec<i32> = Vec::new();
    let i = 0;
    let j = 0;
    while i < 3 && j < 3 {
        if a[i] < b[j] {
            c.push(a[i]);
            i = i + 1;
        } else {
            c.push(b[j]);
            j = j + 1;
        };
    }
    while i < 3 {
        c.push(a[i]);
        i = i + 1;
    }
    while j < 3 {
        c.push(b[j]);
        j = j + 1;
    }
    println("{},{},{}", len(c), c[0], c[5]);
    return 0;
}

@test "basic 41 merge sorted"() {
    let a = [1, 3, 5];
    let b = [2, 4, 6];
    let c: Vec<i32> = Vec::new();
    let i = 0;
    let j = 0;
    while i < 3 && j < 3 {
        if a[i] < b[j] {
            c.push(a[i]);
            i = i + 1;
        } else {
            c.push(b[j]);
            j = j + 1;
        };
    }
    while i < 3 {
        c.push(a[i]);
        i = i + 1;
    }
    while j < 3 {
        c.push(b[j]);
        j = j + 1;
    }
    if len(c) != 6 { panic(4101); };
    if c[0] != 1 { panic(4102); };
    if c[5] != 6 { panic(4103); };
}
