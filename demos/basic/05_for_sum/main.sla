@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 05_for_sum：for range + 偶数过滤，0+2+...+8 = 20。

fn for_sum_even(limit: i32) -> i32 {
    let t: i32 = 0;
    for i in 0..limit {
        if i % 2 == 0 {
            t = t + i;
        };
    }
    return t;
}

fn main() -> i32 {
    println("{}", for_sum_even(10));
    return 0;
}

@test "basic 05 for sum even"() {
    if for_sum_even(10) != 20 { panic(501); };
    if for_sum_even(0) != 0 { panic(502); };
    if for_sum_even(5) != 6 { panic(503); };
}
