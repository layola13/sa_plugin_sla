@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 对标 tsgosa 1234_shift_loop：循环左移翻倍（16）。
// 与 52 的乘法翻倍同值不同机制：此处 `x = x << 1`（`<<=` 无 token，
// 用显式赋值，见 119）。

fn main() -> i32 {
    let x = 1;
    let i = 0;
    while i < 4 {
        x = x << 1;
        i = i + 1;
    }
    println("{}", x);
    return 0;
}

@test "basic 170 shift loop"() {
    let x = 1;
    let i = 0;
    while i < 4 {
        x = x << 1;
        i = i + 1;
    }
    if x != 16 { panic(17001); };
}
