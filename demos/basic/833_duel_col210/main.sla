@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类次对角列对峙：建表 vs 三角数 n(n-1)/2（(9,8)：36 对 36；(10,9)：45 对 45）。
// 意对标 832_stir2_col210（列源互补；828 首列对峙体例合流）。

fn sst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn tri(n: int) -> int {
    return n * (n - 1) / 2;
}

fn main() -> i32 {
    println("{},{},{},{}", sst(9, 8), tri(9), sst(10, 9), tri(10));
    return 0;
}

@test "basic 833 duel col210"() {
    if sst(9, 8) != 36 { panic(83301); };
    if tri(9) != 36 { panic(83302); };
    if sst(10, 9) != 45 { panic(83303); };
    if tri(10) != 45 { panic(83304); };
}
