@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Fubini 对峙：行和式 Σk!·S(n,k) == 组合递推 F(n)=Σ_{k=0}^{n-1}C(n,k)·F(k)
//（n=4：75 对 75；n=5：541 对 541）。
// 意对标 588 fubini（单实现见源；286 系对峙体例）。

fn stirling2(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = kk * t[(nn - 1) * w + kk] + t[(nn - 1) * w + kk - 1];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn fubini(n: int) -> int {
    let s = 0;
    let k = 1;
    while k <= n {
        s = s + fact(k) * stirling2(n, k);
        k = k + 1;
    }
    return s;
}

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn fubini_rec(n: int) -> int {
    let f: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        f.push(0);
        i = i + 1;
    }
    f[0] = 1;
    let m = 1;
    while m <= n {
        let acc = 0;
        let k = 0;
        while k < m {
            acc = acc + binom_mul(m, k) * f[k];
            k = k + 1;
        }
        f[m] = acc;
        m = m + 1;
    }
    return f[n];
}

fn main() -> i32 {
    println("{},{},{},{}", fubini(4), fubini_rec(4), fubini(5), fubini_rec(5));
    return 0;
}

@test "basic 591 duel fubini"() {
    if fubini(4) != 75 { panic(59101); };
    if fubini_rec(4) != 75 { panic(59102); };
    if fubini(5) != 541 { panic(59103); };
    if fubini_rec(5) != 541 { panic(59104); };
    if fubini(5) != fubini_rec(5) { panic(59105); };
}
