@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// 全排列对峙：P(n,n) == fact(n)（n=5：120 对 120；n=6：720 对 720）。
// 意对标 572 perm（单实现见源；286 系对峙体例）。

fn perm(n: int, k: int) -> int {
    let r = 1;
    let i = 0;
    while i < k {
        r = r * (n - i);
        i = i + 1;
    }
    return r;
}

fn fact(n: int) -> int {
    let r = 1;
    let i = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    println("{},{},{},{}", perm(5, 5), fact(5), perm(6, 6), fact(6));
    return 0;
}

@test "basic 573 duel permfact"() {
    if perm(5, 5) != 120 { panic(57301); };
    if fact(5) != 120 { panic(57302); };
    if perm(6, 6) != 720 { panic(57303); };
    if fact(6) != 720 { panic(57304); };
    if perm(6, 6) != fact(6) { panic(57305); };
}
