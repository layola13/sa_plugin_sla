@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 数短递推 R(n)=(n-1)(2R(n-1)+3R(n-2))/(n+1)（先乘后除精确整除）。
// R(3)=1，R(4)=3，R(5)=6（639 做短递推/卷积对峙）。
// 意对标 626_motzkin（Motzkin 姐妹序列；M(n)=R(n)+R(n+1)，643 做桥接）。

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", rio(3), rio(4), rio(5));
    return 0;
}

@test "basic 636 riordan"() {
    if rio(3) != 1 { panic(63601); };
    if rio(4) != 3 { panic(63602); };
    if rio(5) != 6 { panic(63603); };
    if rio(2) != 1 { panic(63604); };
}
