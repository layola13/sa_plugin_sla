@import "sa_std/dns.sla"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/status.sla"

// DEF-NETSVC-NAMEBYPORT-SAB regression: a builtin enum constructor
// (Ok / Err / Some) whose payload is a direct move out of a struct
// field must transfer the field's cell to the enum exactly once.
// The SAB lowering used to leave the field slot pointing at the
// moved cell, so the parent binding's deep drop freed the buffer
// the enum owned (signal 11 / free(): invalid pointer in the
// caller; net_service_name_by_port over the real /etc/services
// was the in-std victim). Sibling shapes that were always green
// (two-step let bind, direct field return, plain call argument)
// are pinned in the layering probes of the fixing line, not here.
// Panic codes 677xx.

struct Hit {
    port: u16,
    name: Vec<u8>,
    status: i32,
}

fn bytes_of(s: String) -> Vec<u8> {
    let v: Vec<u8> = Vec::new();
    let p: ptr = STR_PTR(s);
    let n: u64 = len(s) as u64;
    let i: u64 = 0;
    while i < n {
        v.push(PTR_BYTE_AT(p, i));
        i = i + 1;
    }
    return v;
}

fn make_hit() -> Hit {
    return Hit { port: 80, name: bytes_of("http"), status: 0 };
}

// 0 = the name is exactly "http"; nonzero identifies the mismatch.
fn http_status(nm: Vec<u8>) -> u64 {
    let sl: Slice<u8> = VEC_AS_SLICE(nm);
    let n: u64 = 0;
    SLICE_GET_LEN(n, sl);
    if n != 4 { return 1; };
    let b0: u8 = 0;
    SLICE_GET(b0, sl, 0);
    if b0 != 104 { return 2; };
    let b3: u8 = 0;
    SLICE_GET(b3, sl, 3);
    if b3 != 112 { return 3; };
    return 0;
}

fn take_ok_direct() -> Result<Vec<u8>, i32> {
    let h = make_hit();
    if h.status != 0 { return Err(h.status); };
    return Ok(h.name);
}

fn take_ok_letbound() -> Result<Vec<u8>, i32> {
    let h = make_hit();
    if h.status != 0 { return Err(h.status); };
    let r = Ok(h.name);
    return r;
}

fn take_err_field() -> Result<u16, Vec<u8>> {
    let h = make_hit();
    return Err(h.name);
}

fn take_some_field() -> Option<Vec<u8>> {
    let h = make_hit();
    return Some(h.name);
}

@test "sab ctor ok of struct field move"() {
    match take_ok_direct() {
        Ok(nm) => { if http_status(nm) != 0 { panic(67711); }; },
        Err(e) => { panic(67712); },
    };
}

@test "sab ctor let-bound ok of struct field move"() {
    match take_ok_letbound() {
        Ok(nm) => { if http_status(nm) != 0 { panic(67721); }; },
        Err(e) => { panic(67722); },
    };
}

@test "sab ctor err of struct field move"() {
    match take_err_field() {
        Ok(p) => { panic(67731); },
        Err(nm) => { if http_status(nm) != 0 { panic(67732); }; },
    };
}

@test "sab ctor some of struct field move"() {
    match take_some_field() {
        Some(nm) => { if http_status(nm) != 0 { panic(67741); }; },
        None => { panic(67742); },
    };
}

@test "decl net service name by port"() {
    match net_service_name_by_port(80, bytes_of("tcp")) {
        Ok(nm) => { if http_status(nm) != 0 { panic(67751); }; },
        Err(e) => { panic(67752); },
    };
    match net_service_name_by_port(59999, bytes_of("tcp")) {
        Ok(nm) => { panic(67753); },
        Err(e) => { if e != 3 { panic(67754); }; },
    };
}
