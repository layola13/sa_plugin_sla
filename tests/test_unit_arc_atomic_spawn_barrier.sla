@import "sa_std/core/arc.sa"
@import "sa_std/sync/atomic.sa"
@import "sa_std/thread.sa"
@import "sa_std/core/result.sa"

// Regression (DEF-3 + DEF-4, found by the pre-push canary gate):
// `Arc::new(AtomicI32::new(0))` clones passed by value into spawned
// workers. Two stacked defects made this shape unusable:
//  - DEF-3: the AtomicI32::new temporary was materialized in a
//    stack_alloc cell and then moved into ARC_NEW, which the checker
//    correctly rejected with StackEscape (trap 1025) on both backends.
//    The cell constructors (Atomic*/Cell) now heap-allocate, like
//    Mutex::new and struct call results already did.
//  - DEF-4: a by-value Arc parameter was released through the raw
//    argument register, which the SA backend treats as a plain owned
//    pointer: it freed the shared box with no strong-count decrement,
//    so the second/third worker double-freed (signal 6). By-value
//    Arc/Rc parameters are now adopted into a body-local register at
//    function entry.
// This is the demos/rosetta/123_barrier_sync shape reduced to a unit
// test (demos are not corpus-swept, which is how both defects hid).
// Pre-fix: trap 1025 (sa and sab). With only DEF-3 fixed: signal 6.

fn barrier_worker(barrier: Arc<AtomicI32>) -> i32 {
    let _old = (*barrier).fetch_add(1, Ordering::SeqCst);
    while (*barrier).load(Ordering::SeqCst) < 3 {
    }
    return 1;
}

fn barrier_release_count() -> i32 {
    let barrier = Arc::new(AtomicI32::new(0));

    let left = barrier.clone();
    let middle = barrier.clone();
    let right = barrier.clone();

    let a = thread::spawn(^|| barrier_worker(left));
    let b = thread::spawn(^|| barrier_worker(middle));
    let c = thread::spawn(^|| barrier_worker(right));

    let av = a.join().unwrap();
    let bv = b.join().unwrap();
    let cv = c.join().unwrap();
    return av + bv + cv;
}

@test "arc atomic spawn barrier"() {
    if barrier_release_count() != 3 {
        panic(9601);
    };
}
