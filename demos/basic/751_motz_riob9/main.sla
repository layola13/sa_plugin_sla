@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Motzkin-Riordan 续桥 R(9)=232，R(10)=603，M(9)=232+603=835（桥恒等续高位）。
// 意对标 643_rio_bridge × 746_motz9（两族桥接续高位；753 做续桥对峙）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{},{}", rio(9), rio(10), moz(9));
    return 0;
}

@test "basic 751 motz rio bridge9"() {
    if rio(9) != 232 { panic(75101); };
    if rio(10) != 603 { panic(75102); };
    if moz(9) != 835 { panic(75103); };
    if rio(9) + rio(10) != moz(9) { panic(75104); };
}
