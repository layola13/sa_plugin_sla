@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian 第 6 行 1,57,302,302,57,1（行和 720=6!；行和循环求和）。
// 意对标 667_eul_row（低位行互补；同式高位行复算）。

fn eul(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (mm - nn) * t[(mm - 1) * w + nn - 1] + (nn + 1) * t[(mm - 1) * w + nn];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn esum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eul(n, k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{}", eul(6, 1), eul(6, 2), esum(6));
    return 0;
}

@test "basic 673 eul row6"() {
    if eul(6, 1) != 57 { panic(67301); };
    if eul(6, 2) != 302 { panic(67302); };
    if esum(6) != 720 { panic(67303); };
    if eul(6, 5) != 1 { panic(67304); };
}
