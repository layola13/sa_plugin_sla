@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 换零钱对峙：硬币 {1,3,4} 凑 6（DP 解 4，暴力三重循环解 4，双实现一致性锁定）。
// 意对标 529 coinchange（{1,2,5} 版互补；此处加暴力枚举对峙，286 系体例）。

fn coin_dp(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    let s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    k = 3;
    s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    k = 4;
    s = k;
    while s <= n {
        dp[s] = dp[s] + dp[s - k];
        s = s + 1;
    }
    return dp[n];
}

fn coin_brute(n: int) -> int {
    let cnt = 0;
    let a = 0;
    while a <= n {
        let b = 0;
        while b * 3 <= n {
            let c = 0;
            while c * 4 <= n {
                if a + b * 3 + c * 4 == n { cnt = cnt + 1; };
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return cnt;
}

fn main() -> i32 {
    println("{},{}", coin_dp(6), coin_brute(6));
    return 0;
}

@test "basic 535 coin duel"() {
    if coin_dp(6) != 4 { panic(53501); };
    if coin_brute(6) != 4 { panic(53502); };
    if coin_dp(6) != coin_brute(6) { panic(53503); };
    if coin_dp(4) != 3 { panic(53504); };
}
