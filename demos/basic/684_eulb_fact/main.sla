@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 行和即公式：ebsum(3)=48，ebsum(4)=384，ebsum(5)=3840（2^n·n! 桥）。
// 意对标 677_eulb_row × 230_fact_iter（两族桥接；685 做三向收束）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn ebsum(n: int) -> int {
    let s = 0;
    let k = 0;
    while k <= n {
        s = s + eub(n, k);
        k = k + 1;
    }
    return s;
}

fn p2f(n: int) -> int {
    let p = 1;
    let i = 0;
    while i < n {
        p = p * 2;
        i = i + 1;
    }
    let f = 1;
    let j = 1;
    while j <= n {
        f = f * j;
        j = j + 1;
    }
    return p * f;
}

fn main() -> i32 {
    println("{},{},{}", ebsum(3), ebsum(4), ebsum(5));
    return 0;
}

@test "basic 684 eulb fact"() {
    if ebsum(3) != 48 { panic(68401); };
    if ebsum(4) != 384 { panic(68402); };
    if ebsum(5) != 3840 { panic(68403); };
    if p2f(5) != 3840 { panic(68404); };
}
