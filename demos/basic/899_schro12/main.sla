@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 大 Schröder 续高位四 S(12)=27297738（S(11)=5293446 对 5293446；卷积和 22004292）。
// 意对标 896_schro11（n=11 版互补；900 做高位对峙）。

fn sch(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 2; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k < ii {
            s = s + t[k] * t[ii - 1 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn main() -> i32 {
    println("{},{}", sch(12), sch(11));
    return 0;
}

@test "basic 899 schro12"() {
    if sch(12) != 27297738 { panic(89901); };
    if sch(11) != 5293446 { panic(89902); };
    if sch(10) != 1037718 { panic(89903); };
    if sch(12) - sch(11) != 22004292 { panic(89904); };
}
