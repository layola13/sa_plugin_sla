@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Eulerian-B 续对称性：B(6,1)=B(6,5)=722，B(7,1)=B(7,6)=2179（镜像双算一致）。
// 意对标 806_eulb6（单格版互补；行列镜像互锁，681 体例续高位）。

fn eub(n: int, m: int) -> int {
    let w = m + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + m {
        t.push(0);
        i = i + 1;
    }
    let a = 0;
    while a <= n {
        t[a * w] = 1;
        a = a + 1;
    }
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= m {
            t[mm * w + nn] = (2 * nn + 1) * t[(mm - 1) * w + nn] + (2 * mm - 2 * nn + 1) * t[(mm - 1) * w + nn - 1];
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + m];
}

fn main() -> i32 {
    println("{},{},{},{}", eub(6, 1), eub(6, 5), eub(7, 1), eub(7, 6));
    return 0;
}

@test "basic 811 eulb sym67"() {
    if eub(6, 1) != 722 { panic(81101); };
    if eub(6, 5) != 722 { panic(81102); };
    if eub(7, 1) != 2179 { panic(81103); };
    if eub(7, 6) != 2179 { panic(81104); };
}
