@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 双实现对峙：卷积 vs 商式（n=9：4862 对 4862；n=10：16796 对 16796）。
// 意对标 856_cat9 × 857_cat_conv9（两源单实现见各源；728 体例续高位）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn catc(n: int) -> int {
    if n == 0 { return 1; };
    let s = 0;
    let i = 0;
    while i < n {
        s = s + catc(i) * catc(n - 1 - i);
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", catc(9), catd(9), catc(10), catd(10));
    return 0;
}

@test "basic 858 duel cat9"() {
    if catc(9) != 4862 { panic(85801); };
    if catd(9) != 4862 { panic(85802); };
    if catc(10) != 16796 { panic(85803); };
    if catd(10) != 16796 { panic(85804); };
}
