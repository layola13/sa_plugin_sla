@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 二类高位对峙：建表 vs 递归（(8,3)：966 对 966；(8,4)：1701 对 1701）。
// 意对标 698_stir28 × 699_duel_stir27（高位源与对峙体例合流）。

fn svt(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + nn * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn rs2(n: int, k: int) -> int {
    if k == 0 {
        if n == 0 { return 1; };
        return 0;
    };
    if k > n { return 0; };
    if k == n { return 1; };
    return rs2(n - 1, k - 1) + k * rs2(n - 1, k);
}

fn main() -> i32 {
    println("{},{},{},{}", svt(8, 3), rs2(8, 3), svt(8, 4), rs2(8, 4));
    return 0;
}

@test "basic 700 duel stir28"() {
    if svt(8, 3) != 966 { panic(70001); };
    if rs2(8, 3) != 966 { panic(70002); };
    if svt(8, 4) != 1701 { panic(70003); };
    if rs2(8, 4) != 1701 { panic(70004); };
}
