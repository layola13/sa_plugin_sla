@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// Mertens 双实现对峙（直接 μ 版 vs ω 奇偶重算版：M(10)=-1 双边）。
// 意对标 423 楔形对峙的求和版（421 互补）。

fn mobius(n: int) -> int {
    if n == 1 { return 1; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        if m % d == 0 {
            c = c + 1;
            m = m / d;
            if m % d == 0 { return 0; };
        };
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    if c % 2 == 0 { return 1; };
    return 0 - 1;
}

fn mert_a(n: int) -> int {
    let s = 0;
    let k = 1;
    while k <= n {
        s = s + mobius(k);
        k = k + 1;
    }
    return s;
}

fn omega(n: int) -> int {
    if n < 2 { return 0; };
    let c = 0;
    let m = n;
    let d = 2;
    while d * d <= m {
        if m % d == 0 {
            c = c + 1;
            while m % d == 0 { m = m / d; }
        };
        d = d + 1;
    }
    if m > 1 { c = c + 1; };
    return c;
}

fn is_squarefree(n: int) -> int {
    if n < 1 { return 0; };
    let d = 2;
    while d * d <= n {
        if n % (d * d) == 0 { return 0; };
        d = d + 1;
    }
    return 1;
}

fn mu_b(n: int) -> int {
    if n == 1 { return 1; };
    if is_squarefree(n) != 1 { return 0; };
    if omega(n) % 2 == 0 { return 1; };
    return 0 - 1;
}

fn mert_b(n: int) -> int {
    let s = 0;
    let k = 1;
    while k <= n {
        s = s + mu_b(k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{}", mert_a(10), mert_b(10));
    return 0;
}

@test "basic 424 duel mertens"() {
    if mert_a(10) != 0 - 1 { panic(42401); };
    if mert_b(10) != 0 - 1 { panic(42402); };
    if mert_a(10) != mert_b(10) { panic(42403); };
    if mert_a(5) != 0 - 2 { panic(42404); };
}
