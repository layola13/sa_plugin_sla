@test "smoke1 sa_std_net_socket_setsockopt"() {
    let a = s1_udp(59930);
    let val = [0u8; 4];
    val[0] = 0;
    val[1] = 0;
    val[2] = 1;
    val[3] = 0;
    let vbp: ptr = PTR_BYTE_ADD(&val, 0);
    let rc = sla_std_net_socket_setsockopt(a, 1, 8, vbp, 4);
    if rc != 0 { panic(59931); };
    let out = [0u64; 4];
    sla_std_net_socket_getsockopt_int(a, 1, 8, &out[0]);
    if out[0] < 65536 { panic(59932); };
    sla_std_close(a);
}

@test "smoke1 sa_std_net_socket_getsockopt"() {
    let a = s1_udp(59940);
    sla_std_net_socket_setsockopt_int(a, 1, 8, 65536);
    let buf = [0u8; 8];
    let olen = [0u64; 4];
    let rc = sla_std_net_socket_getsockopt(a, 1, 8, &buf[0], 8, &olen[0]);
    if rc != 0 { panic(59941); };
    if olen[0] != 4 { panic(59942); };
    // Kernel doubles SO_RCVBUF on readback: 65536 -> 131072,
    // whose LE bytes are 00 00 02 00.
    if buf[2] != 2 { panic(59943); };
    sla_std_close(a);
}

@test "smoke1 sa_std_net_udp_recv_multi"() {
    let a = s1_udp(59950);
    let b = s1_udp(59951);
    let aport = s1_udp_port(a, 59952);
    let wr = [0u64; 4];
    sla_std_net_udp_send_to(b, STR_PTR("one"), STR_LEN("one"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (aport as u32), &wr[0]);
    sla_std_net_udp_send_to(b, STR_PTR("two!"), STR_LEN("two!"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), (aport as u32), &wr[0]);
    let big = [0u8; 1024];
    let slot = [0u64; 4];
    let bp: u64 = 0;
    let s1bp5: ptr = PTR_BYTE_ADD(&big, 0);
    PTR_ADDR(bp, s1bp5);
    slot[0] = bp;
    let count = [0u64; 4];
    let lens = [0u64; 4];
    let addrs = [0u64; 4];
    let rc = sla_std_net_udp_recv_multi(a, &slot[0], 1024, 64, 2, &count[0], &lens[0], &addrs[0]);
    if rc != 0 { panic(59953); };
    if count[0] != 2 { panic(59954); };
    let total = lens[0] + lens[1];
    if total != 7 { panic(59955); };
    sla_std_close(a);
    sla_std_close(b);
}
