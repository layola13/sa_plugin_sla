@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// 自共轭分拆计数 == 互异奇部数分拆（奇硬币 0-1 背包：sc(6)=1，sc(8)=2，sc(9)=2）。
// 意对标 538 前身 526 distinct（全硬币互异版互补；此处限奇硬币）。

fn selfconj(n: int) -> int {
    let dp: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        dp.push(0);
        i = i + 1;
    }
    dp[0] = 1;
    let k = 1;
    while k <= n {
        let s = n;
        while s >= k {
            dp[s] = dp[s] + dp[s - k];
            s = s - 1;
        }
        k = k + 2;
    }
    return dp[n];
}

fn main() -> i32 {
    println("{},{},{}", selfconj(6), selfconj(8), selfconj(9));
    return 0;
}

@test "basic 538 selfconj"() {
    if selfconj(6) != 1 { panic(53801); };
    if selfconj(8) != 2 { panic(53802); };
    if selfconj(9) != 2 { panic(53803); };
}
