@import "sa_std/vec.sa"
@import "sa_std/hashmap.sa"
@import "sa_std/btree_map.sa"
@import "sa_std/core/option.sa"

fn arr_sum(values: [int; 4]) -> int {
    let it = values.iter();
    return it.sum();
}

@test "gap surfaces"() {
    let v: Vec<i32> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    if v.iter().sum() != 6 { panic(11); };
    let m = HashMap::new();
    m.insert("a", 1);
    if m.len() != 1 { panic(12); };
    let b = BTreeMap::new();
    b.insert("a", 1);
    if arr_sum([1, 2, 3, 4]) != 10 { panic(14); };
}
