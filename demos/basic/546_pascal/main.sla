@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Pascal 递推建表 C(n,k)=C(n-1,k-1)+C(n-1,k)（拍扁二维表，531 范式）。
// C(8,4)=70，C(9,4)=126，C(10,5)=252。
// 意对标 531 stirling2（同为拍扁加权三角；此处权为 0/1）。

fn binom(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let nn = 1;
    while nn <= n {
        t[nn * w] = 1;
        let kk = 1;
        while kk <= k {
            if kk <= nn {
                t[nn * w + kk] = t[(nn - 1) * w + kk - 1] + t[(nn - 1) * w + kk];
            };
            kk = kk + 1;
        }
        nn = nn + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", binom(8, 4), binom(9, 4), binom(10, 5));
    return 0;
}

@test "basic 546 pascal"() {
    if binom(8, 4) != 70 { panic(54601); };
    if binom(9, 4) != 126 { panic(54602); };
    if binom(10, 5) != 252 { panic(54603); };
    if binom(6, 0) != 1 { panic(54604); };
}
