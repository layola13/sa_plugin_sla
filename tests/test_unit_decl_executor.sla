@import "sa_std/executor.sla"
@import "sa_std/task.sai"
@import "sa_std/core/box.sa"

// DEF-DECL-REST carriers: SAB registry declared entries from
// sa_std/executor.sla (executor_start / executor_share /
// executor_call / executor_stop / exec_loop) and the two helper
// entries declared in sa_std/executor_test.sla (counter_handler /
// call_worker), which live outside the sla tests/ tree and so had
// no in-tree carrier. The shapes are the std's own reference
// consumer forms: a single-owner executor goroutine running a
// counter handler; four shared-handle workers adding through it.
// Panic codes 680xx.

struct ExecCounter {
    n: u64,
}

fn counter_handler(state: ptr, op: u64, arg: u64) -> u64 {
    let s: *ExecCounter = state as *ExecCounter;
    if op == 1 {
        (*s).n = (*s).n + arg;
        return (*s).n;
    };
    if op == 2 {
        return (*s).n;
    };
    if op == 3 {
        (*s).n = (*s).n * arg;
        return (*s).n;
    };
    return 999999999999;
}

struct CallJob {
    ex: Executor,
    adds: u64,
}

fn call_worker(job: *CallJob) {
    let ex = (*job).ex;
    let i: u64 = 0;
    while i < (*job).adds {
        let r = executor_call(&ex, 1, 1);
        i = i + 1;
    }
}

@test "decl executor serializes concurrent callers"() {
    let state = Box::into_raw(Box::new(ExecCounter { n: 0 }));
    let ex = executor_start(counter_handler, state as ptr, 64);
    let job1 = Box::into_raw(Box::new(CallJob { ex: executor_share(&ex), adds: 25 }));
    let h1 = go call_worker(job1);
    let job2 = Box::into_raw(Box::new(CallJob { ex: executor_share(&ex), adds: 25 }));
    let h2 = go call_worker(job2);
    let job3 = Box::into_raw(Box::new(CallJob { ex: executor_share(&ex), adds: 25 }));
    let h3 = go call_worker(job3);
    let job4 = Box::into_raw(Box::new(CallJob { ex: executor_share(&ex), adds: 25 }));
    let h4 = go call_worker(job4);
    let st1 = sa_task_join(h1);
    if st1 != 0 { panic(68001); };
    let st2 = sa_task_join(h2);
    if st2 != 0 { panic(68001); };
    let st3 = sa_task_join(h3);
    if st3 != 0 { panic(68001); };
    let st4 = sa_task_join(h4);
    if st4 != 0 { panic(68001); };
    let total = executor_call(&ex, 2, 0);
    if total != 100 { panic(68002); };
    let final_state = executor_stop(ex);
    if final_state != state as ptr { panic(68003); };
    let fs: *ExecCounter = final_state as *ExecCounter;
    if (*fs).n != 100 { panic(68004); };
    let sb = unsafe { Box::from_raw(fs) };
}

@test "decl executor stop drains and hands state back"() {
    let state = Box::into_raw(Box::new(ExecCounter { n: 0 }));
    let ex = executor_start(counter_handler, state as ptr, 8);
    let r1 = executor_call(&ex, 1, 40);
    if r1 != 40 { panic(68011); };
    let r2 = executor_call(&ex, 3, 2);
    if r2 != 80 { panic(68012); };
    let r3 = executor_call(&ex, 2, 0);
    if r3 != 80 { panic(68013); };
    let final_state = executor_stop(ex);
    if final_state != state as ptr { panic(68014); };
    let fs: *ExecCounter = final_state as *ExecCounter;
    if (*fs).n != 80 { panic(68015); };
    let sb = unsafe { Box::from_raw(fs) };
}

@test "decl executor handler ops direct"() {
    let state = Box::into_raw(Box::new(ExecCounter { n: 5 }));
    if counter_handler(state as ptr, 1, 10) != 15 { panic(68021); };
    if counter_handler(state as ptr, 3, 4) != 60 { panic(68022); };
    if counter_handler(state as ptr, 2, 0) != 60 { panic(68023); };
    if counter_handler(state as ptr, 77, 0) != 999999999999 { panic(68024); };
    let sb = unsafe { Box::from_raw(state as *ExecCounter) };
}

@test "decl executor call worker direct"() {
    let state = Box::into_raw(Box::new(ExecCounter { n: 0 }));
    let ex = executor_start(counter_handler, state as ptr, 8);
    let job = Box::into_raw(Box::new(CallJob { ex: executor_share(&ex), adds: 30 }));
    call_worker(job);
    let total = executor_call(&ex, 2, 0);
    if total != 30 { panic(68031); };
    let final_state = executor_stop(ex);
    let fs: *ExecCounter = final_state as *ExecCounter;
    if (*fs).n != 30 { panic(68032); };
    let sb = unsafe { Box::from_raw(fs) };
}
