@test "smoke1 sa_cookie_clear_expiry"() {
    let h = s1_new(54150);
    sla_cookie_set_expires(h, 1893456000);
    sla_cookie_set_max_age(h, 7200);
    let rc = sla_cookie_clear_expiry(h);
    if rc != 0 { panic(54151); };
    let out = [0u64; 4];
    let rc2 = sla_cookie_expires(h, &out[0]);
    if rc2 == 0 {
        if out[0] != 0 { panic(54152); };
    };
    let rc3 = sla_cookie_max_age(h, &out[0]);
    if rc3 == 0 {
        if out[0] != 0 { panic(54153); };
    };
    sla_cookie_free(^h);
}

