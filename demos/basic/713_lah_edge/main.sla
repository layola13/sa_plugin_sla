@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Lah 对角边 L(n,n-1)=n(n-1)：L(6,5)=30，L(7,6)=42，L(8,7)=56（边值恒等）。
// 意对标 706_lah7（内格版互补；715 做三向收束）。

fn ltb(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm + nn - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn eprod(n: int) -> int {
    return n * (n - 1);
}

fn main() -> i32 {
    println("{},{},{}", ltb(6, 5), ltb(7, 6), ltb(8, 7));
    return 0;
}

@test "basic 713 lah edge"() {
    if ltb(6, 5) != 30 { panic(71301); };
    if ltb(7, 6) != 42 { panic(71302); };
    if ltb(8, 7) != 56 { panic(71303); };
    if eprod(8) != 56 { panic(71304); };
}
