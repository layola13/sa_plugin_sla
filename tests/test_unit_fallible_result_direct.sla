@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/net.sai"
@import "sa_std/text/regex.sai"
@import "sa_std/testing/assert.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// A_min (fallible `T!`) corpus, direct-extern surface: every call
// materializes `Result<T, i32>` — Ok carries the payload, Err carries
// the nonzero runtime status word, and the payload slot is never read
// on the Err arm. Error cases are built from real failures (missing
// file, refused connection) or from invalid handles (closing handle 0
// fails with the invalid-handle status in the runtime registry —
// never a real double free).
//
// Shape note: results are let-bound before matching, and matches are
// sequenced at one level per function. Two stock match-codegen
// defects (registered separately with minimal repros) make the other
// shapes unusable today for ANY Result producer: a bare scrutinee in
// a fall-through match leaks the result register on the text backend,
// and a match nested inside a match arm traps UseAfterMove on the
// SAB backend.

@test "fallible direct hook ok payload"() {
    let r = sa_test_fallible_i32_value(42);
    match r {
        Ok(v) => {
            if v != 42 {
                panic(45101);
            };
        },
        Err(e) => {
            panic(45102);
        },
    };
}

@test "fallible direct fs read family ok and err"() {
    let path = "test_unit_fallible_result_direct.tmp";
    let data = "fallible corpus payload";
    let miss = "missing_fallible_direct_9f3.txt";
    if sa_fs_write_file(STR_PTR(path), STR_LEN(path), STR_PTR(data), STR_LEN(data)) != 0 {
        panic(45110);
    };
    let r1 = sa_fs_read_file(STR_PTR(path), STR_LEN(path), 4096);
    match r1 {
        Ok(b) => {
            if sa_fs_read_buffer_len(b) != STR_LEN(data) {
                panic(45111);
            };
            if sa_fs_read_buffer_free(b) != 0 {
                panic(45112);
            };
        },
        Err(e) => {
            panic(45113);
        },
    };
    let r2 = sa_fs_read_file(STR_PTR(miss), STR_LEN(miss), 4096);
    match r2 {
        Ok(b) => {
            panic(45114);
        },
        Err(e) => {
            if e == 0 {
                panic(45115);
            };
        },
    };
    let r3 = sa_fs_read_to_string(STR_PTR(path), STR_LEN(path), 4096);
    match r3 {
        Ok(b) => {
            if sa_fs_read_buffer_len(b) != STR_LEN(data) {
                panic(45116);
            };
            if sa_fs_read_buffer_free(b) != 0 {
                panic(45117);
            };
        },
        Err(e) => {
            panic(45118);
        },
    };
    let r4 = sa_fs_read_file_base64(STR_PTR(path), STR_LEN(path), 4096);
    match r4 {
        Ok(b) => {
            if sa_fs_read_buffer_len(b) == 0 {
                panic(45119);
            };
            if sa_fs_read_buffer_free(b) != 0 {
                panic(45120);
            };
        },
        Err(e) => {
            panic(45121);
        },
    };
    let metadata: u64 = 0;
    let mr = sa_fs_metadata(STR_PTR(path), STR_LEN(path));
    match mr {
        Ok(m) => {
            metadata = m;
        },
        Err(e) => {
            panic(45124);
        },
    };
    let fr = sa_fs_metadata_free(metadata);
    match fr {
        Ok(p) => {
            if p != 0 {
                panic(45122);
            };
        },
        Err(e) => {
            panic(45123);
        },
    };
    let r5 = sa_fs_metadata(STR_PTR(miss), STR_LEN(miss));
    match r5 {
        Ok(m) => {
            panic(45125);
        },
        Err(e) => {
            if e == 0 {
                panic(45126);
            };
        },
    };
    let r6 = sa_fs_metadata_json(STR_PTR(path), STR_LEN(path));
    match r6 {
        Ok(b) => {
            if sa_fs_read_buffer_len(b) == 0 {
                panic(45127);
            };
            if sa_fs_read_buffer_free(b) != 0 {
                panic(45128);
            };
        },
        Err(e) => {
            panic(45129);
        },
    };
    let r7 = sa_fs_metadata_free(0);
    match r7 {
        Ok(p) => {
            panic(45130);
        },
        Err(e) => {
            if e == 0 {
                panic(45131);
            };
        },
    };
}

