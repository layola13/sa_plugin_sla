@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Riordan 双实现对峙：短递推 vs Motzkin 卷积（n=4：3 对 3；n=5：6 对 6）。
// 卷积 R(n)=sum R(k)M(n-2-k)（n=5：4+0+1+1=6）。
// 意对标 636_riordan × 卷积版（两源单实现见各源；286 系对峙体例）。

fn moz(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 1; };
    let ii = 2;
    while ii <= n {
        let s = t[ii - 1];
        let k = 0;
        while k <= ii - 2 {
            s = s + t[k] * t[ii - 2 - k];
            k = k + 1;
        }
        t[ii] = s;
        ii = ii + 1;
    }
    return t[n];
}

fn rio(n: int) -> int {
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    if n >= 1 { t[1] = 0; };
    let ii = 2;
    while ii <= n {
        t[ii] = (ii - 1) * (2 * t[ii - 1] + 3 * t[ii - 2]) / (ii + 1);
        ii = ii + 1;
    }
    return t[n];
}

fn rconv(n: int) -> int {
    if n == 0 { return 1; };
    if n == 1 { return 0; };
    let s = 0;
    let k = 0;
    while k <= n - 2 {
        s = s + rconv(k) * moz(n - 2 - k);
        k = k + 1;
    }
    return s;
}

fn main() -> i32 {
    println("{},{},{},{}", rio(4), rconv(4), rio(5), rconv(5));
    return 0;
}

@test "basic 639 duel rio"() {
    if rio(4) != 3 { panic(63901); };
    if rconv(4) != 3 { panic(63902); };
    if rio(5) != 6 { panic(63903); };
    if rconv(5) != 6 { panic(63904); };
}
