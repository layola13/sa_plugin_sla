@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Stirling 一类第 9 行左部 c(9,2)=109584，c(9,3)=118124，c(9,4)=67284（同式再上三行）。
// 意对标 686_stir17（n=7 版互补；819 做建表/递归对峙）。

fn cst(n: int, k: int) -> int {
    let w = k + 1;
    let t: Vec<i32> = Vec::new();
    let i = 0;
    while i <= n * w + k {
        t.push(0);
        i = i + 1;
    }
    t[0] = 1;
    let mm = 1;
    while mm <= n {
        let nn = 1;
        while nn <= k {
            if nn <= mm {
                t[mm * w + nn] = t[(mm - 1) * w + nn - 1] + (mm - 1) * t[(mm - 1) * w + nn];
            };
            nn = nn + 1;
        }
        mm = mm + 1;
    }
    return t[n * w + k];
}

fn main() -> i32 {
    println("{},{},{}", cst(9, 2), cst(9, 3), cst(9, 4));
    return 0;
}

@test "basic 816 stir19"() {
    if cst(9, 2) != 109584 { panic(81601); };
    if cst(9, 3) != 118124 { panic(81602); };
    if cst(9, 4) != 67284 { panic(81603); };
    if cst(8, 3) != 13132 { panic(81604); };
}
