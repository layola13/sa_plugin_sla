    if rc != 0 { panic(59440); };
    let out = [0u64; 4];
    let rc2 = sla_std_net_tcp_listener_only_v6(lh[0], &out[0]);
    if rc2 != 0 { panic(59441); };
    // This runtime creates inet6 listeners with V6ONLY already on.
    if out[0] != 1 { panic(59442); };
    sla_std_close(lh[0]);
}

fn s1_udp(code: i32) -> u64 {
    let cell = [0u64; 4];
    let rc = sla_std_net_udp_bind(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 0, &cell[0]);
    if rc != 0 { panic(code); };
    if cell[0] == 0 { panic(code + 1); };
    return cell[0];
}

fn s1_udp_port(sock: u64, code: i32) -> u64 {
    let addr = [0u64; 4];
    let rc = sla_std_net_udp_local_addr(sock, &addr[0]);
    if rc != 0 { panic(code); };
    return (sla_net_addr_port(addr[0]) as u64);
}

