@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

// Catalan 商式高位 C(9)=4862，C(10)=16796（C(2n,n)/(n+1) 先乘后除精确整除）。
// 意对标 727_cat_div8（n=7/8 版互补；858 做卷积/商式对峙）。

fn binom_mul(n: int, k: int) -> int {
    let kk = k;
    if kk > n - kk { kk = n - kk; };
    let r = 1;
    let i = 0;
    while i < kk {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

fn catd(n: int) -> int {
    return binom_mul(2 * n, n) / (n + 1);
}

fn main() -> i32 {
    println("{},{}", catd(9), catd(10));
    return 0;
}

@test "basic 856 cat9"() {
    if catd(9) != 4862 { panic(85601); };
    if catd(10) != 16796 { panic(85602); };
    if catd(8) != 1430 { panic(85603); };
    if binom_mul(18, 9) != 48620 { panic(85604); };
}
